      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Catalog</string>
          <string name="Source"><![CDATA[--[[
	Catalog
	Every cosmetic in the game. All items are built from primitive parts and
	colours, so no external assets are needed. Cosmetics never change gameplay.

	Item fields:
		Id, Name, Category, Price, Color (Color3), Secondary (Color3?), Style (string?),
		RequiredTier (reputation tier name, optional), Default (owned by everyone)
]]

local Catalog = {}

Catalog.Categories = { "Shirt", "Shorts", "Socks", "Boots", "Headwear", "Trail" }

local items = {
	-- Shirts
	{ Id = "shirt_white", Name = "Plain White Tee", Category = "Shirt", Price = 0, Color = Color3.fromRGB(235, 235, 235), Default = true },
	{ Id = "shirt_charcoal", Name = "Charcoal Tee", Category = "Shirt", Price = 120, Color = Color3.fromRGB(52, 54, 60) },
	{ Id = "shirt_royal", Name = "Royal Training Top", Category = "Shirt", Price = 200, Color = Color3.fromRGB(38, 76, 196) },
	{ Id = "shirt_crimson", Name = "Crimson Jersey", Category = "Shirt", Price = 200, Color = Color3.fromRGB(176, 26, 40) },
	{ Id = "shirt_mint", Name = "Mint Hoodie", Category = "Shirt", Price = 350, Color = Color3.fromRGB(140, 230, 190) },
	{ Id = "shirt_sunset", Name = "Sunset Windbreaker", Category = "Shirt", Price = 500, Color = Color3.fromRGB(255, 142, 60) },
	{ Id = "shirt_lilac", Name = "Lilac Drill Top", Category = "Shirt", Price = 450, Color = Color3.fromRGB(176, 150, 255), RequiredTier = "Local" },
	{ Id = "shirt_gold", Name = "Gold Thread Jersey", Category = "Shirt", Price = 2500, Color = Color3.fromRGB(230, 184, 60), RequiredTier = "Star" },

	-- Shorts
	{ Id = "shorts_black", Name = "Black Shorts", Category = "Shorts", Price = 0, Color = Color3.fromRGB(28, 28, 32), Default = true },
	{ Id = "shorts_white", Name = "White Shorts", Category = "Shorts", Price = 100, Color = Color3.fromRGB(240, 240, 240) },
	{ Id = "shorts_navy", Name = "Navy Shorts", Category = "Shorts", Price = 150, Color = Color3.fromRGB(24, 34, 80) },
	{ Id = "shorts_camo", Name = "Olive Cargo", Category = "Shorts", Price = 300, Color = Color3.fromRGB(86, 96, 54) },
	{ Id = "shorts_red", Name = "Track Reds", Category = "Shorts", Price = 300, Color = Color3.fromRGB(190, 30, 40), RequiredTier = "Local" },

	-- Socks
	{ Id = "socks_white", Name = "White Socks", Category = "Socks", Price = 0, Color = Color3.fromRGB(245, 245, 245), Default = true },
	{ Id = "socks_black", Name = "Black Socks", Category = "Socks", Price = 60, Color = Color3.fromRGB(20, 20, 22) },
	{ Id = "socks_teal", Name = "Teal Socks", Category = "Socks", Price = 120, Color = Color3.fromRGB(30, 170, 170) },
	{ Id = "socks_pink", Name = "Hot Pink Socks", Category = "Socks", Price = 180, Color = Color3.fromRGB(255, 80, 170) },

	-- Boots
	{ Id = "boots_black", Name = "Classic Blacks", Category = "Boots", Price = 0, Color = Color3.fromRGB(18, 18, 18), Default = true },
	{ Id = "boots_white", Name = "Cloud Whites", Category = "Boots", Price = 250, Color = Color3.fromRGB(250, 250, 250) },
	{ Id = "boots_volt", Name = "Volt Strikers", Category = "Boots", Price = 400, Color = Color3.fromRGB(205, 255, 64) },
	{ Id = "boots_blaze", Name = "Blaze Runners", Category = "Boots", Price = 400, Color = Color3.fromRGB(255, 90, 40) },
	{ Id = "boots_ice", Name = "Ice Glide", Category = "Boots", Price = 700, Color = Color3.fromRGB(150, 220, 255), RequiredTier = "Regular" },
	{ Id = "boots_gold", Name = "Golden Touch", Category = "Boots", Price = 3000, Color = Color3.fromRGB(240, 196, 70), RequiredTier = "Legend" },

	-- Headwear (built from parts)
	{ Id = "head_none", Name = "Nothing", Category = "Headwear", Price = 0, Color = Color3.new(1, 1, 1), Style = "None", Default = true },
	{ Id = "head_band_white", Name = "White Headband", Category = "Headwear", Price = 80, Color = Color3.fromRGB(240, 240, 240), Style = "Headband" },
	{ Id = "head_band_red", Name = "Red Headband", Category = "Headwear", Price = 80, Color = Color3.fromRGB(200, 30, 40), Style = "Headband" },
	{ Id = "head_cap_black", Name = "Black Cap", Category = "Headwear", Price = 220, Color = Color3.fromRGB(26, 26, 28), Style = "Cap" },
	{ Id = "head_cap_volt", Name = "Volt Cap", Category = "Headwear", Price = 260, Color = Color3.fromRGB(205, 255, 64), Style = "Cap" },
	{ Id = "head_beanie_grey", Name = "Grey Beanie", Category = "Headwear", Price = 200, Color = Color3.fromRGB(120, 124, 130), Style = "Beanie" },
	{ Id = "head_beanie_orange", Name = "Orange Beanie", Category = "Headwear", Price = 240, Color = Color3.fromRGB(255, 120, 30), Style = "Beanie", RequiredTier = "Local" },
	{ Id = "head_crown", Name = "Concrete Crown", Category = "Headwear", Price = 5000, Color = Color3.fromRGB(240, 196, 70), Style = "Crown", RequiredTier = "Legend" },

	-- Trails (character effect)
	{ Id = "trail_none", Name = "No Trail", Category = "Trail", Price = 0, Color = Color3.new(1, 1, 1), Style = "None", Default = true },
	{ Id = "trail_white", Name = "Chalk Dust", Category = "Trail", Price = 400, Color = Color3.fromRGB(255, 255, 255), Style = "Trail" },
	{ Id = "trail_volt", Name = "Volt Streak", Category = "Trail", Price = 800, Color = Color3.fromRGB(205, 255, 64), Secondary = Color3.fromRGB(40, 200, 120), Style = "Trail", RequiredTier = "Regular" },
	{ Id = "trail_fire", Name = "Afterburn", Category = "Trail", Price = 1200, Color = Color3.fromRGB(255, 200, 60), Secondary = Color3.fromRGB(255, 50, 20), Style = "Trail", RequiredTier = "Skilled" },
}

Catalog.Items = {} :: { [string]: any }
Catalog.ByCategory = {} :: { [string]: { any } }

for _, category in Catalog.Categories do
	Catalog.ByCategory[category] = {}
end

for index, item in items do
	item.Order = index
	Catalog.Items[item.Id] = item
	table.insert(Catalog.ByCategory[item.Category], item)
end

function Catalog.Get(id: string)
	return Catalog.Items[id]
end

function Catalog.DefaultEquipped(): { [string]: string }
	local equipped = {}
	for _, category in Catalog.Categories do
		for _, item in Catalog.ByCategory[category] do
			if item.Default then
				equipped[category] = item.Id
				break
			end
		end
	end
	return equipped
end

function Catalog.DefaultInventory(): { [string]: boolean }
	local inventory = {}
	for id, item in Catalog.Items do
		if item.Default then
			inventory[id] = true
		end
	end
	return inventory
end

return Catalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config
	Central tuning for the whole game. Server and client both read this module.
	Change numbers here instead of hunting through systems.
]]

local Config = {}

Config.GameName = "CONCRETE KINGS"
Config.CurrencyName = "Kicks"
Config.DataStoreName = "ConcreteKings_PlayerData_v1"

-------------------------------------------------------------------------------
-- Controls (single place to rebind everything)
-- Each action lists keyboard/mouse inputs, gamepad inputs and whether a touch
-- button should be created on mobile.
-------------------------------------------------------------------------------
Config.Controls = {
	Sprint = {
		Keyboard = { Enum.KeyCode.LeftShift },
		Gamepad = { Enum.KeyCode.ButtonR2 },
		Touch = true,
		TouchTitle = "Sprint",
	},
	Pass = {
		Keyboard = { Enum.UserInputType.MouseButton1 },
		Gamepad = { Enum.KeyCode.ButtonA },
		Touch = true,
		TouchTitle = "Pass",
	},
	Shoot = {
		-- Hold to charge, release to shoot
		Keyboard = { Enum.UserInputType.MouseButton2 },
		Gamepad = { Enum.KeyCode.ButtonB },
		Touch = true,
		TouchTitle = "Shoot",
	},
	ThroughBall = {
		Keyboard = { Enum.KeyCode.F },
		Gamepad = { Enum.KeyCode.ButtonY },
		Touch = true,
		TouchTitle = "Through",
	},
	Lob = {
		-- Space lobs when you have the ball, otherwise it is a normal jump
		Keyboard = { Enum.KeyCode.Space },
		Gamepad = { Enum.KeyCode.ButtonX },
		Touch = true,
		TouchTitle = "Lob",
	},
	Tackle = {
		Keyboard = { Enum.KeyCode.E },
		Gamepad = { Enum.KeyCode.ButtonL2 },
		Touch = true,
		TouchTitle = "Tackle",
	},
	SkillMove = {
		Keyboard = { Enum.KeyCode.Q },
		Gamepad = { Enum.KeyCode.ButtonL1 },
		Touch = true,
		TouchTitle = "Skill",
	},
	CameraMode = {
		Keyboard = { Enum.KeyCode.C },
		Gamepad = { Enum.KeyCode.ButtonR3 },
		Touch = false,
	},
	Menu = {
		Keyboard = { Enum.KeyCode.M },
		Gamepad = { Enum.KeyCode.ButtonSelect },
		Touch = false,
	},
}

-------------------------------------------------------------------------------
-- Movement
-------------------------------------------------------------------------------
Config.Movement = {
	BaseWalkSpeed = 16,
	BaseSprintSpeed = 23,
	PaceWalkBonus = 2, -- extra walk speed at 99 pace
	PaceSprintBonus = 3, -- extra sprint speed at 99 pace
	DribbleSpeedMultiplier = 0.92,
	SprintRampTime = 0.35, -- seconds to reach full sprint speed
	StaminaMax = 100,
	StaminaDrainPerSecond = 16,
	StaminaRegenPerSecond = 12,
	StaminaRegenDelay = 0.8,
	StaminaAttributeBonus = 0.5, -- up to +50% drain efficiency at 99 stamina
}

-------------------------------------------------------------------------------
-- Ball
-------------------------------------------------------------------------------
Config.Ball = {
	Size = 2.2,
	Density = 0.35,
	Friction = 0.35,
	Elasticity = 0.55,
	GravityScale = 0.5, -- custom ball gravity, lower feels floatier
	GroundDrag = 0.9, -- horizontal velocity decay per second while rolling
	AirDrag = 0.12,
	ControlRadius = 3.4, -- horizontal distance from root part to take the ball
	ControlHeight = 5, -- max height above the pitch to take the ball
	KickerCooldown = 0.45, -- seconds before a kicker can retake their own kick
	TackledCooldown = 0.9,
	DribbleDistance = 2.7, -- studs in front of the player
	DribbleStiffness = 14,
	MaxDribbleLeash = 9, -- server resets possession if the ball is further than this
	HardTouchSpeed = 70, -- above this, first touch can fail and deflect
}

Config.Kick = {
	PassMinSpeed = 42,
	PassMaxSpeed = 85,
	PassLift = 3,
	PassAssistAngle = 40, -- degrees; teammates inside this cone get targeted
	ThroughLeadTime = 0.9,
	LobFlightTime = 1.05,
	LobMaxRange = 80,
	ShotMinSpeed = 68,
	ShotMaxSpeed = 118,
	ShotMinLift = 12,
	ShotMaxLift = 40,
	ShotAssistAngle = 45,
	ShotMaxErrorDegrees = 7, -- at 0 shooting, scales down with attribute
	MaxChargeTime = 0.9,
	RateLimit = 0.2,
	ReachRadius = 4.5, -- one-touch kicks allowed on a free ball this close
}

Config.Tackle = {
	Range = 6.5,
	Cooldown = 1.2,
	BaseSuccess = 0.62,
	AttributeSwing = 0.35, -- (defending - dribbling)/99 * swing
	FailSlowTime = 0.6,
	EvadeWindow = 0.5, -- seconds of tackle immunity after a skill move
}

Config.SkillMove = {
	Cooldown = 0.9,
	DashSpeed = 34,
	DashTime = 0.18,
}

-------------------------------------------------------------------------------
-- Matches
-------------------------------------------------------------------------------
Config.Match = {
	TeamSize = 3,
	DurationSeconds = 240,
	MatchFoundSeconds = 4, -- "MATCH FOUND" then "TEAM A vs TEAM B"
	KickoffCountdown = 3,
	GoalCelebrationSeconds = 4,
	ResultsSeconds = 9,
	MinHumansToStart = 1,
	FillWithBots = true, -- empty slots are filled by Ground Regulars (bots)
	BotFillDelay = 8, -- seconds the queue waits for humans before adding bots
	MercyGoalDifference = 7,
}

-- Pitch layout. Length runs along X. Team A defends the -X goal and attacks +X.
-- SurfaceY is the height of the playing surface.
Config.Pitches = {
	{
		Id = "Pitch1",
		DisplayName = "THE CAGE",
		Area = "CommunityCourt",
		Center = Vector3.new(0, 0, 0),
		SurfaceY = 0.4,
		Length = 112,
		Width = 64,
		GoalWidth = 16,
		GoalHeight = 8,
		GoalDepth = 5,
		WallHeight = 12,
		ColliderHeight = 60,
		QueuePad = Vector3.new(0, 0, 52), -- relative to Center
	},
}

Config.Hub = {
	Spawn = Vector3.new(0, 1, 92),
	PracticeArea = Vector3.new(118, 0, 10),
	Locker = Vector3.new(-110, 0, 60),
	-- Locked teaser gates for the next areas (world progression)
	AreaGates = {
		{ Area = "StreetCourt", Name = "STREET COURT", RequiredTier = "Local", Position = Vector3.new(0, 0, -120) },
		{ Area = "UrbanArena", Name = "URBAN ARENA", RequiredTier = "Skilled", Position = Vector3.new(-150, 0, -40) },
	},
}

Config.Teams = {
	A = { Name = "VOLT", Color = Color3.fromRGB(205, 255, 64), Dark = Color3.fromRGB(40, 52, 12) },
	B = { Name = "EMBER", Color = Color3.fromRGB(255, 110, 54), Dark = Color3.fromRGB(58, 22, 10) },
}

-- Reward formula inputs (server only uses these, client shows them)
Config.Rewards = {
	XP = { Played = 60, Win = 80, Draw = 35, Goal = 30, Assist = 20, Pass = 3, Tackle = 8, SkillMove = 2, CapPerMatch = 600 },
	Kicks = { Played = 25, Win = 40, Draw = 15, Goal = 10, Assist = 6, CapPerMatch = 200 },
	Reputation = { Played = 2, Win = 10, Draw = 5, Goal = 2, Assist = 1 },
	LevelUpKicks = 50,
}

Config.Attributes = {
	List = { "Pace", "Shooting", "Passing", "Dribbling", "BallControl", "Defending", "Physicality", "Stamina" },
	Start = 50,
	Max = 99,
	PointsPerLevel = 2,
}

Config.DataStore = {
	AutosaveInterval = 90,
	SessionLockTimeout = 600, -- seconds before a lock from a dead server is considered stale
	LoadRetries = 6,
	SaveRetries = 4,
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Cosmetics</string>
          <string name="Source"><![CDATA[--[[
	Cosmetics
	Applies an "equipped" table to a character model. Used by the server for real
	characters and by the client for the locker preview, so both always match.
]]

local Catalog = require(script.Parent.Catalog)

local Cosmetics = {}

local COSMETIC_TAG = "CK_Cosmetic"

-- Which body parts each slot colours (R15 and R6 names)
local SLOT_PARTS = {
	Shirt = { "UpperTorso", "LeftUpperArm", "RightUpperArm", "Torso" },
	Shorts = { "LowerTorso", "LeftUpperLeg", "RightUpperLeg", "Left Leg", "Right Leg" },
	Socks = { "LeftLowerLeg", "RightLowerLeg" },
	Boots = { "LeftFoot", "RightFoot" },
}

local function clearOld(character: Model)
	for _, d in character:GetDescendants() do
		if d:GetAttribute(COSMETIC_TAG) then
			d:Destroy()
		end
	end
end

local function weldTo(part: BasePart, to: BasePart, offset: CFrame)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CFrame = to.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = to
	weld.Part1 = part
	weld.Parent = part
	part:SetAttribute(COSMETIC_TAG, true)
	part.Parent = to.Parent
end

local function newPart(name: string, size: Vector3, color: Color3, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.Fabric
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	return p
end

local function buildHeadwear(character: Model, item)
	local head = character:FindFirstChild("Head") :: BasePart?
	if not head or item.Style == "None" then
		return
	end
	local hs = head.Size
	if item.Style == "Headband" then
		local band = newPart("CK_Headband", Vector3.new(0.35, hs.X * 1.08, hs.X * 1.08), item.Color, Enum.PartType.Cylinder)
		weldTo(band, head, CFrame.new(0, hs.Y * 0.18, 0) * CFrame.Angles(0, 0, math.rad(90)))
	elseif item.Style == "Cap" then
		local crown = newPart("CK_CapTop", Vector3.new(hs.X * 1.05, hs.Y * 0.45, hs.Z * 1.05), item.Color)
		weldTo(crown, head, CFrame.new(0, hs.Y * 0.42, 0))
		local brim = newPart("CK_CapBrim", Vector3.new(hs.X * 0.9, 0.12, hs.Z * 0.6), item.Color)
		weldTo(brim, head, CFrame.new(0, hs.Y * 0.22, -hs.Z * 0.72))
	elseif item.Style == "Beanie" then
		local beanie = newPart("CK_Beanie", Vector3.new(hs.X * 1.12, hs.X * 1.12, hs.X * 1.12), item.Color, Enum.PartType.Ball)
		weldTo(beanie, head, CFrame.new(0, hs.Y * 0.3, 0.02))
		local pom = newPart("CK_Pom", Vector3.new(0.45, 0.45, 0.45), Color3.new(1, 1, 1), Enum.PartType.Ball)
		weldTo(pom, head, CFrame.new(0, hs.Y * 0.95, 0))
	elseif item.Style == "Crown" then
		local ring = newPart("CK_Crown", Vector3.new(0.5, hs.X * 1.05, hs.X * 1.05), item.Color, Enum.PartType.Cylinder)
		ring.Material = Enum.Material.Metal
		weldTo(ring, head, CFrame.new(0, hs.Y * 0.62, 0) * CFrame.Angles(0, 0, math.rad(90)))
		for i = 0, 4 do
			local spike = newPart("CK_CrownSpike", Vector3.new(0.25, 0.45, 0.25), item.Color)
			spike.Material = Enum.Material.Metal
			local a = (i / 5) * math.pi * 2
			weldTo(spike, head, CFrame.new(math.cos(a) * hs.X * 0.45, hs.Y * 0.9, math.sin(a) * hs.X * 0.45))
		end
	end
end

local function buildTrail(character: Model, item)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or item.Style == "None" then
		return
	end
	local a0 = Instance.new("Attachment")
	a0.Name = "CK_TrailTop"
	a0.Position = Vector3.new(0, 0.6, 0.4)
	a0:SetAttribute(COSMETIC_TAG, true)
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Name = "CK_TrailBottom"
	a1.Position = Vector3.new(0, -2.4, 0.4)
	a1:SetAttribute(COSMETIC_TAG, true)
	a1.Parent = root
	local trail = Instance.new("Trail")
	trail.Name = "CK_Trail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.35
	trail.MinLength = 0.2
	trail.LightEmission = 0.6
	trail.FaceCamera = true
	trail.Color = ColorSequence.new(item.Color, item.Secondary or item.Color)
	trail.Transparency = NumberSequence.new(0.35, 1)
	trail:SetAttribute(COSMETIC_TAG, true)
	trail.Parent = root
end

--[[
	equipped: { Shirt = id, Shorts = id, ... }
	shirtOverride: optional Color3 (team bib colour during matches)
]]
function Cosmetics.Apply(character: Model, equipped: { [string]: string }, shirtOverride: Color3?)
	if not character then
		return
	end
	clearOld(character)

	-- Remove avatar clothing so kit colours show. Hair/face accessories are kept.
	for _, child in character:GetChildren() do
		if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") then
			child:Destroy()
		end
	end

	for slot, partNames in SLOT_PARTS do
		local item = Catalog.Get(equipped[slot] or "")
		local color = item and item.Color
		if slot == "Shirt" and shirtOverride then
			color = shirtOverride
		end
		if color then
			for _, partName in partNames do
				local part = character:FindFirstChild(partName)
				if part and part:IsA("BasePart") then
					part.Color = color
				end
			end
		end
	end

	-- BodyColors would overwrite our part colours on respawn/refresh, so drop it.
	local bodyColors = character:FindFirstChildOfClass("BodyColors")
	if bodyColors then
		bodyColors:Destroy()
	end

	local headwear = Catalog.Get(equipped.Headwear or "")
	if headwear and headwear.Style ~= "None" then
		-- Hide hats from the Roblox avatar so they do not clip with our headwear.
		for _, child in character:GetChildren() do
			if child:IsA("Accessory") and child.AccessoryType == Enum.AccessoryType.Hat then
				child:Destroy()
			end
		end
		buildHeadwear(character, headwear)
	end

	local trail = Catalog.Get(equipped.Trail or "")
	if trail then
		buildTrail(character, trail)
	end
end

return Cosmetics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">KickMath</string>
          <string name="Source"><![CDATA[--[[
	KickMath
	Pure functions that turn a kick request into a ball velocity. The server is the
	only caller that applies the result; it lives in Shared so it can be unit
	tested and so the client could predict trajectories later.

	Directions are flattened to the XZ plane. Attribute alphas are 0..1.
]]

local Config = require(script.Parent.Config)

local KickMath = {}

export type Mate = { Position: Vector3, Velocity: Vector3, Id: any }

local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	if f.Magnitude < 1e-4 then
		return Vector3.new(0, 0, -1)
	end
	return f.Unit
end
KickMath.Flat = flat

local function angleBetween(a: Vector3, b: Vector3): number
	return math.deg(math.acos(math.clamp(a:Dot(b), -1, 1)))
end

-- Rotates a flat direction around Y by degrees.
local function rotateY(dir: Vector3, degrees: number): Vector3
	local r = math.rad(degrees)
	local c, s = math.cos(r), math.sin(r)
	return Vector3.new(dir.X * c - dir.Z * s, 0, dir.X * s + dir.Z * c)
end
KickMath.RotateY = rotateY

function KickMath.EffectiveGravity(gravity: number): number
	return gravity * Config.Ball.GravityScale
end

-- Picks the teammate best matching the aim direction (nil if nobody in the cone).
function KickMath.FindPassTarget(origin: Vector3, dir: Vector3, mates: { Mate }, maxAngle: number, maxRange: number): Mate?
	local best, bestScore = nil, math.huge
	for _, mate in mates do
		local offset = mate.Position - origin
		local dist = Vector3.new(offset.X, 0, offset.Z).Magnitude
		if dist > 3 and dist <= maxRange then
			local angle = angleBetween(dir, flat(offset))
			if angle <= maxAngle then
				local score = angle + dist * 0.15
				if score < bestScore then
					best, bestScore = mate, score
				end
			end
		end
	end
	return best
end

--[[
	params = {
		Kind = "Pass" | "Through" | "Lob" | "Shot",
		Origin = Vector3, Direction = Vector3, Power = 0..1,
		Passing, Shooting = attribute alphas (0..1),
		Mates = { Mate }, GoalCenter = Vector3?, GoalWidth = number?,
		Gravity = workspace gravity, Random = Random,
	}
	Returns: velocity (Vector3), target mate (Mate?)
]]
function KickMath.Compute(params): (Vector3, Mate?)
	local k = Config.Kick
	local rng: Random = params.Random or Random.new()
	local dir = flat(params.Direction)
	local origin = params.Origin
	local power = math.clamp(params.Power or 0.5, 0, 1)
	local passing = math.clamp(params.Passing or 0.5, 0, 1)
	local shooting = math.clamp(params.Shooting or 0.5, 0, 1)
	local g = KickMath.EffectiveGravity(params.Gravity or 196.2)
	local kind = params.Kind

	if kind == "Pass" or kind == "Through" then
		local target = KickMath.FindPassTarget(origin, dir, params.Mates or {}, k.PassAssistAngle, 100)
		local aim
		if target then
			aim = target.Position
			if kind == "Through" then
				local lead = target.Velocity * k.ThroughLeadTime
				aim += Vector3.new(lead.X, 0, lead.Z) + flat(target.Position - origin) * 6
			end
		else
			aim = origin + dir * (if kind == "Through" then 45 else 30)
		end
		local offset = aim - origin
		local dist = Vector3.new(offset.X, 0, offset.Z).Magnitude
		local aimDir = flat(offset)
		local errorDeg = (1 - passing) * 4 * (rng:NextNumber() * 2 - 1)
		aimDir = rotateY(aimDir, errorDeg)
		local speed = math.clamp(dist * 1.3 + 30, k.PassMinSpeed, k.PassMaxSpeed) * (0.92 + 0.08 * passing)
		return aimDir * speed + Vector3.new(0, k.PassLift, 0), target
	elseif kind == "Lob" then
		local target = KickMath.FindPassTarget(origin, dir, params.Mates or {}, k.PassAssistAngle, k.LobMaxRange)
		local aim
		if target then
			aim = target.Position + Vector3.new(target.Velocity.X, 0, target.Velocity.Z) * 0.5
		else
			aim = origin + dir * math.clamp(18 + power * k.LobMaxRange, 18, k.LobMaxRange)
		end
		local offset = aim - origin
		local dist = math.min(Vector3.new(offset.X, 0, offset.Z).Magnitude, k.LobMaxRange)
		local t = k.LobFlightTime
		local aimDir = rotateY(flat(offset), (1 - passing) * 5 * (rng:NextNumber() * 2 - 1))
		local horizontal = dist / t
		local vertical = g * t / 2
		return aimDir * horizontal + Vector3.new(0, vertical, 0), target
	elseif kind == "Shot" then
		local shotDir = dir
		if params.GoalCenter then
			local width = params.GoalWidth or 16
			local goalAim = params.GoalCenter + Vector3.new(0, 0, (rng:NextNumber() * 2 - 1) * (width / 2 - 2))
			local goalDir = flat(goalAim - origin)
			if angleBetween(dir, goalDir) <= k.ShotAssistAngle then
				shotDir = flat(dir:Lerp(goalDir, 0.6))
			end
		end
		local errorDeg = (1 - shooting) * k.ShotMaxErrorDegrees * (0.5 + power * 0.5) * (rng:NextNumber() * 2 - 1)
		shotDir = rotateY(shotDir, errorDeg)
		local speed = (k.ShotMinSpeed + (k.ShotMaxSpeed - k.ShotMinSpeed) * power) * (0.85 + 0.15 * shooting)
		local lift = k.ShotMinLift + (k.ShotMaxLift - k.ShotMinLift) * power
		return shotDir * speed + Vector3.new(0, lift, 0), nil
	end

	error("Unknown kick kind " .. tostring(kind))
end

-- Tackle success chance from attributes (alphas 0..1).
function KickMath.TackleChance(defending: number, dribbling: number): number
	local t = Config.Tackle
	return math.clamp(t.BaseSuccess + (defending - dribbling) * t.AttributeSwing, 0.2, 0.92)
end

-- Chance to cleanly control a hard incoming ball.
function KickMath.FirstTouchChance(ballControl: number, speed: number): number
	local hard = Config.Ball.HardTouchSpeed
	if speed <= hard then
		return 1
	end
	local over = math.clamp((speed - hard) / 50, 0, 1)
	return math.clamp(1 - over * (0.75 - 0.5 * ballControl), 0.25, 1)
end

return KickMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Progression</string>
          <string name="Source"><![CDATA[--[[
	Progression
	Pure functions for levels, titles, reputation tiers and match rewards.
	No Roblox services are used so this can be unit tested outside Studio.
]]

local Config = require(script.Parent.Config)

local Progression = {}

-- Original level titles. A title applies from its level upwards.
Progression.LevelTitles = {
	{ Level = 1, Title = "Fresh Laces" },
	{ Level = 5, Title = "Block Baller" },
	{ Level = 10, Title = "Cage Prospect" },
	{ Level = 15, Title = "Corner Shop Hero" },
	{ Level = 20, Title = "Postcode Star" },
	{ Level = 30, Title = "Concrete King" },
}

-- Reputation tiers, separate from level. Unlocks areas and cosmetics.
Progression.ReputationTiers = {
	{ Name = "Unknown", Min = 0 },
	{ Name = "Local", Min = 100 },
	{ Name = "Regular", Min = 300 },
	{ Name = "Skilled", Min = 700 },
	{ Name = "Star", Min = 1500 },
	{ Name = "Legend", Min = 3000 },
}

Progression.MaxLevel = 50

-- XP needed to go from `level` to `level + 1`.
function Progression.XPToNext(level: number): number
	return math.floor(100 * level ^ 1.35)
end

-- Adds XP to a level/xp pair and returns the new level, the leftover xp and how
-- many levels were gained. Never exceeds MaxLevel.
function Progression.ApplyXP(level: number, xp: number, gained: number): (number, number, number)
	local levelsGained = 0
	xp += math.max(0, gained)
	while level < Progression.MaxLevel and xp >= Progression.XPToNext(level) do
		xp -= Progression.XPToNext(level)
		level += 1
		levelsGained += 1
	end
	if level >= Progression.MaxLevel then
		level = Progression.MaxLevel
		xp = math.min(xp, Progression.XPToNext(level))
	end
	return level, xp, levelsGained
end

function Progression.GetTitle(level: number): string
	local title = Progression.LevelTitles[1].Title
	for _, entry in Progression.LevelTitles do
		if level >= entry.Level then
			title = entry.Title
		end
	end
	return title
end

-- Returns tier index (1-based), tier name, and the reputation needed for the next tier (or nil).
function Progression.GetReputationTier(reputation: number): (number, string, number?)
	local index = 1
	for i, tier in Progression.ReputationTiers do
		if reputation >= tier.Min then
			index = i
		end
	end
	local nextTier = Progression.ReputationTiers[index + 1]
	return index, Progression.ReputationTiers[index].Name, nextTier and nextTier.Min or nil
end

function Progression.TierIndexByName(name: string): number
	for i, tier in Progression.ReputationTiers do
		if tier.Name == name then
			return i
		end
	end
	return 1
end

--[[
	Computes match rewards from a stat line.
	stats = { Goals, Assists, Passes, Tackles, SkillMoves }
	result = "Win" | "Draw" | "Loss"
]]
function Progression.ComputeMatchRewards(stats, result: string)
	local r = Config.Rewards
	local goals = stats.Goals or 0
	local assists = stats.Assists or 0

	local xp = r.XP.Played
		+ goals * r.XP.Goal
		+ assists * r.XP.Assist
		+ math.min(stats.Passes or 0, 40) * r.XP.Pass
		+ math.min(stats.Tackles or 0, 20) * r.XP.Tackle
		+ math.min(stats.SkillMoves or 0, 30) * r.XP.SkillMove
	local kicks = r.Kicks.Played + goals * r.Kicks.Goal + assists * r.Kicks.Assist
	local rep = r.Reputation.Played + goals * r.Reputation.Goal + assists * r.Reputation.Assist

	if result == "Win" then
		xp += r.XP.Win
		kicks += r.Kicks.Win
		rep += r.Reputation.Win
	elseif result == "Draw" then
		xp += r.XP.Draw
		kicks += r.Kicks.Draw
		rep += r.Reputation.Draw
	end

	return {
		XP = math.min(xp, r.XP.CapPerMatch),
		Kicks = math.min(kicks, r.Kicks.CapPerMatch),
		Reputation = rep,
	}
end

-- Attribute value (0..1) used by gameplay formulas.
function Progression.AttributeAlpha(value: number?): number
	local v = value or Config.Attributes.Start
	return math.clamp(v / Config.Attributes.Max, 0, 1)
end

-- Rough skill rating used for team balancing.
function Progression.SkillRating(profile): number
	local stats = profile.Stats
	local played = math.max(stats.Matches, 1)
	local winRate = stats.Wins / played
	local total = 0
	for _, name in Config.Attributes.List do
		total += profile.Attributes[name] or Config.Attributes.Start
	end
	return profile.Level * 2 + winRate * 20 + total / #Config.Attributes.List
end

return Progression
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--[[
	Remotes
	Declares every network endpoint in one place. The server creates them,
	the client waits for them. Usage: Remotes.Get("Kick")
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

-- Client -> Server events
local EVENTS = {
	"RequestQueue", -- (join: boolean)
	"Kick", -- (kind: string, direction: Vector3, power: number)
	"Tackle", -- ()
	"SkillMove", -- ()
	"UpdateSettings", -- (settings table)
	-- Server -> Client events
	"ProfileUpdated", -- (profile table)
	"MatchEvent", -- (kind: string, payload: table)
	"Notify", -- (text: string, kind: string?)
	"BallEvent", -- (kind: string, payload) for sounds/effects
}

-- Client -> Server requests with a reply
local FUNCTIONS = {
	"GetProfile",
	"PurchaseItem", -- (itemId) -> ok, message
	"EquipItem", -- (itemId) -> ok, message
	"SpendAttribute", -- (attributeName) -> ok, message
}

local FOLDER_NAME = "Remotes"

local folder: Folder

local function getFolder(): Folder
	if folder then
		return folder
	end
	if RunService:IsServer() then
		local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if not existing then
			existing = Instance.new("Folder")
			existing.Name = FOLDER_NAME
			existing.Parent = ReplicatedStorage
		end
		folder = existing :: Folder
	else
		folder = ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
	end
	return folder
end

-- Server: create all remotes. Safe to call more than once.
function Remotes.Init()
	assert(RunService:IsServer(), "Remotes.Init is server only")
	local f = getFolder()
	for _, name in EVENTS do
		if not f:FindFirstChild(name) then
			local r = Instance.new("RemoteEvent")
			r.Name = name
			r.Parent = f
		end
	end
	for _, name in FUNCTIONS do
		if not f:FindFirstChild(name) then
			local r = Instance.new("RemoteFunction")
			r.Name = name
			r.Parent = f
		end
	end
end

function Remotes.Get(name: string): any
	local f = getFolder()
	if RunService:IsServer() then
		local r = f:FindFirstChild(name)
		assert(r, "Unknown remote " .. name)
		return r
	end
	return f:WaitForChild(name)
end

return Remotes
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="10">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="11">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="12">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Server bootstrap. Init() every service in dependency order (create state,
	no cross-service calls), then Start() them (connect events, start loops).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
Remotes.Init()

local Services = script.Parent:WaitForChild("Services")

local order = {
	"DataService",
	"ProgressionService",
	"InventoryService",
	"MapBuilder",
	"BallService",
	"BotService",
	"MatchService",
	"MatchmakingService",
	"LeaderboardService",
	"AmbientService",
}

local loaded = {}
for _, name in order do
	loaded[name] = require(Services:WaitForChild(name))
end
for _, name in order do
	loaded[name].Init()
end
for _, name in order do
	local ok, err = pcall(loaded[name].Start)
	if not ok then
		warn(string.format("[Main] %s failed to start: %s", name, tostring(err)))
	end
end

print("[Concrete Kings] server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="13">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Actors</string>
            <string name="Source"><![CDATA[--[[
	Actors
	Treats real players and bots the same way for ball/match code.
	An actor is either a Player or a bot table: { IsBot = true, Name, Model, Attributes }.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Progression = require(Shared.Progression)

local ProgressionService = require(script.Parent.ProgressionService)

local Actors = {}

function Actors.IsBot(actor): boolean
	return type(actor) == "table" and actor.IsBot == true
end

function Actors.GetCharacter(actor): Model?
	if Actors.IsBot(actor) then
		return actor.Model
	end
	return (actor :: Player).Character
end

function Actors.GetRoot(actor): BasePart?
	local character = Actors.GetCharacter(actor)
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function Actors.GetHumanoid(actor): Humanoid?
	local character = Actors.GetCharacter(actor)
	return character and character:FindFirstChildOfClass("Humanoid")
end

function Actors.IsAlive(actor): boolean
	local humanoid = Actors.GetHumanoid(actor)
	return humanoid ~= nil and humanoid.Health > 0 and Actors.GetRoot(actor) ~= nil
end

function Actors.GetName(actor): string
	if Actors.IsBot(actor) then
		return actor.Name
	end
	return (actor :: Player).DisplayName
end

-- Unique id used in replicated attributes. Players use their UserId, bots a negative id.
function Actors.GetId(actor): number
	if Actors.IsBot(actor) then
		return actor.Id
	end
	return (actor :: Player).UserId
end

-- Raw attribute value (0..99)
function Actors.GetAttribute(actor, name: string): number
	if Actors.IsBot(actor) then
		return actor.Attributes[name] or Config.Attributes.Start
	end
	return ProgressionService.GetAttribute(actor, name)
end

-- Attribute as 0..1
function Actors.Alpha(actor, name: string): number
	return Progression.AttributeAlpha(Actors.GetAttribute(actor, name))
end

return Actors
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">AmbientService</string>
            <string name="Source"><![CDATA[--[[
	AmbientService
	Keeps the Grounds feeling alive: spectators cheering in the stands, locals
	chatting and emoting around the plaza, and walkers moving between points.
	NPCs are server-owned, cheap (no per-frame logic) and never touch match balls.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Cosmetics = require(Shared.Cosmetics)
local Catalog = require(Shared.Catalog)

local MapBuilder = require(script.Parent.MapBuilder)
local NPCAnimator = require(script.Parent.NPCAnimator)

local AmbientService = {}

local rng = Random.new()
local SKIN_TONES = {
	Color3.fromRGB(255, 220, 190), Color3.fromRGB(234, 184, 146), Color3.fromRGB(198, 134, 94),
	Color3.fromRGB(141, 85, 54), Color3.fromRGB(96, 58, 38),
}

local function randomKit()
	local kit = {}
	for _, category in { "Shirt", "Shorts", "Socks", "Boots" } do
		local options = Catalog.ByCategory[category]
		kit[category] = options[rng:NextInteger(1, #options)].Id
	end
	kit.Headwear = if rng:NextNumber() < 0.4 then "head_cap_black" else "head_none"
	kit.Trail = "trail_none"
	return kit
end

local function spawnNPC(name: string, cframe: CFrame)
	local desc = Instance.new("HumanoidDescription")
	local skin = SKIN_TONES[rng:NextInteger(1, #SKIN_TONES)]
	desc.HeadColor, desc.LeftArmColor, desc.RightArmColor = skin, skin, skin
	desc.TorsoColor, desc.LeftLegColor, desc.RightLegColor = skin, skin, skin
	local model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	model.Name = name
	local animate = model:FindFirstChild("Animate")
	if animate then
		animate:Destroy()
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	humanoid.DisplayName = name
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	Cosmetics.Apply(model, randomKit(), nil)
	model:PivotTo(cframe)
	model.Parent = MapBuilder.GetRoot().NPCs
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	return model, humanoid, NPCAnimator.Attach(model)
end

local EMOTES = { "Cheer", "Wave", "Laugh", "Point", "Dance", "Dance2", "Dance3" }

local function spectator(position: Vector3, lookAt: Vector3)
	local _, _, anim = spawnNPC("Fan", CFrame.lookAt(position, Vector3.new(lookAt.X, position.Y, lookAt.Z)))
	if not anim then
		return
	end
	task.spawn(function()
		while true do
			task.wait(rng:NextNumber(4, 12))
			anim.PlayEmote(if rng:NextNumber() < 0.6 then "Cheer" else "Point", false)
		end
	end)
end

local function hangout(position: Vector3, lookAt: Vector3)
	local _, _, anim = spawnNPC("Local", CFrame.lookAt(position, Vector3.new(lookAt.X, position.Y, lookAt.Z)))
	if not anim then
		return
	end
	task.spawn(function()
		while true do
			task.wait(rng:NextNumber(5, 14))
			anim.PlayEmote(EMOTES[rng:NextInteger(1, #EMOTES)], false)
		end
	end)
end

local function walker(points: { Vector3 })
	local model, humanoid = spawnNPC("Walker", CFrame.new(points[1] + Vector3.new(0, 3, 0)))
	humanoid.WalkSpeed = rng:NextNumber(7, 10)
	task.spawn(function()
		local i = 1
		while model.Parent do
			i = i % #points + 1
			humanoid:MoveTo(points[i])
			humanoid.MoveToFinished:Wait()
			task.wait(rng:NextNumber(1, 5))
		end
	end)
end

function AmbientService.Init() end

function AmbientService.Start()
	local pitch = Config.Pitches[1]
	local c = pitch.Center
	local standZ = c.Z - pitch.Width / 2 - 1
	-- Fans in the stands (rows match MapBuilder stand steps)
	for _ = 1, 8 do
		local row = rng:NextInteger(0, 4)
		local x = c.X + rng:NextNumber(-pitch.Length * 0.35, pitch.Length * 0.35)
		local z = standZ - 6 - row * 3
		local y = 1.4 + row * 2.8 + 3
		spectator(Vector3.new(x, y, z), c)
	end
	-- Locals around the plaza and practice court
	local spots = {
		{ Vector3.new(-30, 3, 58), Vector3.new(-26, 3, 62) },
		{ Vector3.new(-26, 3, 62), Vector3.new(-30, 3, 58) },
		{ Vector3.new(34, 3, 104), Vector3.new(30, 3, 100) },
		{ Config.Hub.PracticeArea + Vector3.new(-26, 3, 8), Config.Hub.PracticeArea },
		{ Config.Hub.Locker + Vector3.new(16, 3, -14), Config.Hub.Locker },
	}
	for _, spot in spots do
		hangout(spot[1], spot[2])
	end
	-- Walkers
	walker({ Vector3.new(-120, 0, 110), Vector3.new(120, 0, 110), Vector3.new(120, 0, -95), Vector3.new(-120, 0, -95) })
	walker({ Vector3.new(80, 0, 70), Vector3.new(-80, 0, 70), Vector3.new(-80, 0, 100) })
	walker({ Vector3.new(150, 0, -60), Vector3.new(150, 0, 60) })
end

return AmbientService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">BallService</string>
            <string name="Source"><![CDATA[--[[
	BallService
	Server-authoritative footballs.

	How the ball works:
	  * Free ball: owned by the server, simulated by Roblox physics plus custom
	    gravity (VectorForce) and custom rolling/air drag applied here.
	  * Possessed by a player: network ownership is handed to that player so the
	    dribble is perfectly smooth on their screen (client BallController steers
	    it). The server keeps checking the ball stays within a short leash of the
	    player, otherwise possession is dropped.
	  * Possessed by a bot: the server steers it.
	  * Kicks, tackles and possession changes are only decided here. Clients send
	    intents (Kick/Tackle/SkillMove) and the server validates them.
	  * Balls never collide with characters (collision groups). Contact with
	    players is handled by our own control/deflection logic instead, which is
	    what keeps the ball from behaving like a random physics object.

	Each ball has a `Handlers` table so the owner (MatchService or practice)
	decides who may touch it and receives callbacks for stats.
]]

local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local KickMath = require(Shared.KickMath)
local Remotes = require(Shared.Remotes)

local Actors = require(script.Parent.Actors)
local MapBuilder = require(script.Parent.MapBuilder)

local BallService = {}

local BALL_GROUP = "CK_Ball"
local CHARACTER_GROUP = "CK_Characters"
local KICK_KINDS = { Pass = true, Through = true, Lob = true, Shot = true }

local balls = {} -- list of ball objects
local nextBallId = 0
local rng = Random.new()

local lastKick: { [any]: number } = {}
local lastTackle: { [any]: number } = {}
local lastSkill: { [any]: number } = {}
local evadeUntil: { [any]: number } = {}

local ballEvent

-------------------------------------------------------------------------------
-- Collision groups
-------------------------------------------------------------------------------
local function setupCollisionGroups()
	for _, name in { BALL_GROUP, CHARACTER_GROUP } do
		if not PhysicsService:IsCollisionGroupRegistered(name) then
			PhysicsService:RegisterCollisionGroup(name)
		end
	end
	PhysicsService:CollisionGroupSetCollidable(BALL_GROUP, CHARACTER_GROUP, false)
end

function BallService.TagCharacter(character: Model)
	local function tag(d)
		if d:IsA("BasePart") then
			d.CollisionGroup = CHARACTER_GROUP
		end
	end
	for _, d in character:GetDescendants() do
		tag(d)
	end
	character.DescendantAdded:Connect(tag)
end

-------------------------------------------------------------------------------
-- Ball creation
-------------------------------------------------------------------------------
local function buildBallPart(id: number): Part
	local cfg = Config.Ball
	local p = Instance.new("Part")
	p.CFrame = CFrame.new()
	p.Name = "Ball_" .. id
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.one * cfg.Size
	p.Color = Color3.fromRGB(250, 250, 250)
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CustomPhysicalProperties = PhysicalProperties.new(cfg.Density, cfg.Friction, cfg.Elasticity, 1, 1)
	p.CollisionGroup = BALL_GROUP
	p.CastShadow = true

	-- Panels so the spin is visible
	local r = cfg.Size / 2
	local dirs = {
		Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 1, 0),
		Vector3.new(0, -1, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1),
	}
	for i, d in dirs do
		local patch = Instance.new("Part")
		patch.Name = "Panel" .. i
		patch.Shape = Enum.PartType.Cylinder
		patch.Size = Vector3.new(0.1, r * 0.9, r * 0.9)
		patch.Color = Color3.fromRGB(20, 20, 24)
		patch.Material = Enum.Material.SmoothPlastic
		patch.CanCollide = false
		patch.CanQuery = false
		patch.CanTouch = false
		patch.Massless = true
		patch.CFrame = CFrame.lookAt(d * (r - 0.03), d * 2) * CFrame.Angles(0, math.rad(90), 0)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = p
		weld.Part1 = patch
		weld.Parent = patch
		patch.Parent = p
	end

	local att = Instance.new("Attachment")
	att.Name = "Center"
	att.Parent = p
	local antiGravity = Instance.new("VectorForce")
	antiGravity.Name = "CustomGravity"
	antiGravity.Attachment0 = att
	antiGravity.RelativeTo = Enum.ActuatorRelativeTo.World
	antiGravity.ApplyAtCenterOfMass = true
	antiGravity.Parent = p

	p:SetAttribute("PossessorId", 0)
	return p
end

local function updateGravityForce(ball)
	local part = ball.Part
	local force = part:FindFirstChild("CustomGravity") :: VectorForce
	force.Force = Vector3.new(0, part:GetMass() * Workspace.Gravity * (1 - Config.Ball.GravityScale), 0)
end

--[[
	opts = {
		SpawnPosition = Vector3,
		SurfaceY = number,
		Bounds = { Center = Vector3, HalfSize = Vector3 }?,
		Handlers = {
			GetActors = () -> { actor },            -- who may touch this ball
			GetMates = (actor) -> { actor },         -- for pass assist
			GetAttackGoal = (actor) -> (Vector3?, number?), -- goal centre + width
			OnPossession = (ball, actor, previousTouch)?,
			OnKick = (ball, actor, kind)?,
			OnTackle = (ball, tackler, victim, success)?,
			OnSkillMove = (ball, actor)?,
			OnOutOfBounds = (ball)?,
		}
	}
]]
function BallService.CreateBall(opts)
	nextBallId += 1
	local part = buildBallPart(nextBallId)
	part.CFrame = CFrame.new(opts.SpawnPosition)
	part:SetAttribute("SurfaceY", opts.SurfaceY or 0)
	part.Parent = MapBuilder.GetRoot().Balls

	local ball = {
		Id = nextBallId,
		Part = part,
		SpawnPosition = opts.SpawnPosition,
		SurfaceY = opts.SurfaceY or 0,
		Bounds = opts.Bounds,
		Handlers = opts.Handlers,
		Possessor = nil,
		Frozen = false,
		NoTouchUntil = {},
		Touches = {}, -- recent touch history, newest last
		Destroyed = false,
	}
	part:SetNetworkOwner(nil)
	updateGravityForce(ball)
	table.insert(balls, ball)
	return ball
end

function BallService.DestroyBall(ball)
	ball.Destroyed = true
	local idx = table.find(balls, ball)
	if idx then
		table.remove(balls, idx)
	end
	ball.Part:Destroy()
end

-------------------------------------------------------------------------------
-- Possession helpers
-------------------------------------------------------------------------------
local function recordTouch(ball, actor, kind: string)
	table.insert(ball.Touches, { Actor = actor, Kind = kind, Time = os.clock() })
	if #ball.Touches > 8 then
		table.remove(ball.Touches, 1)
	end
end

function BallService.GetLastTouch(ball)
	return ball.Touches[#ball.Touches]
end

local function setOwnerServer(ball)
	if not ball.Part.Anchored then
		pcall(function()
			ball.Part:SetNetworkOwner(nil)
		end)
	end
end

local function clearPossession(ball)
	if ball.Possessor and not Actors.IsBot(ball.Possessor) then
		(ball.Possessor :: Player):SetAttribute("HasBall", false)
	end
	ball.Possessor = nil
	ball.Part:SetAttribute("PossessorId", 0)
	setOwnerServer(ball)
end

local function setPossessor(ball, actor)
	local previous = BallService.GetLastTouch(ball)
	if ball.Possessor and ball.Possessor ~= actor then
		clearPossession(ball)
	end
	ball.Possessor = actor
	ball.Part:SetAttribute("PossessorId", Actors.GetId(actor))
	recordTouch(ball, actor, "Control")
	if Actors.IsBot(actor) then
		setOwnerServer(ball)
	else
		(actor :: Player):SetAttribute("HasBall", true)
		pcall(function()
			ball.Part:SetNetworkOwner(actor)
		end)
	end
	if ball.Handlers.OnPossession then
		ball.Handlers.OnPossession(ball, actor, previous)
	end
end

function BallService.Reset(ball, position: Vector3?)
	clearPossession(ball)
	local part = ball.Part
	part.Anchored = false
	part.AssemblyLinearVelocity = Vector3.zero
	part.AssemblyAngularVelocity = Vector3.zero
	part.CFrame = CFrame.new(position or ball.SpawnPosition)
	setOwnerServer(ball)
	table.clear(ball.Touches)
	table.clear(ball.NoTouchUntil)
	ball.Frozen = false
end

-- Freeze in place (goal celebrations, kickoff countdowns)
function BallService.SetFrozen(ball, frozen: boolean)
	ball.Frozen = frozen
	if frozen then
		clearPossession(ball)
		ball.Part.AssemblyLinearVelocity = Vector3.zero
		ball.Part.AssemblyAngularVelocity = Vector3.zero
		ball.Part.Anchored = true
	else
		ball.Part.Anchored = false
		setOwnerServer(ball)
	end
end

function BallService.ReleaseActor(actor)
	for _, ball in balls do
		if ball.Possessor == actor then
			clearPossession(ball)
		end
	end
	lastKick[actor] = nil
	lastTackle[actor] = nil
	lastSkill[actor] = nil
	evadeUntil[actor] = nil
end

local function canUse(ball, actor): boolean
	if ball.Frozen or not Actors.IsAlive(actor) then
		return false
	end
	for _, a in ball.Handlers.GetActors() do
		if a == actor then
			return true
		end
	end
	return false
end

-------------------------------------------------------------------------------
-- Kicks
-------------------------------------------------------------------------------
local function isFiniteVector(v): boolean
	return typeof(v) == "Vector3" and v.X == v.X and v.Y == v.Y and v.Z == v.Z
		and math.abs(v.X) < 1e6 and math.abs(v.Y) < 1e6 and math.abs(v.Z) < 1e6
end

local function mateInfos(ball, actor)
	local infos = {}
	for _, mate in ball.Handlers.GetMates(actor) do
		local root = Actors.GetRoot(mate)
		if mate ~= actor and root then
			table.insert(infos, { Position = root.Position, Velocity = root.AssemblyLinearVelocity, Id = mate })
		end
	end
	return infos
end

-- Finds the ball this actor may kick right now (possessed, or free and within reach).
local function findKickableBall(actor)
	local root = Actors.GetRoot(actor)
	if not root then
		return nil
	end
	for _, ball in balls do
		if ball.Possessor == actor then
			return ball
		end
	end
	local now = os.clock()
	for _, ball in balls do
		if not ball.Possessor and canUse(ball, actor) and (ball.NoTouchUntil[actor] or 0) < now then
			if (ball.Part.Position - root.Position).Magnitude <= Config.Kick.ReachRadius then
				return ball
			end
		end
	end
	return nil
end

function BallService.Kick(actor, kind: string, direction: Vector3, power: number): boolean
	if not KICK_KINDS[kind] or not isFiniteVector(direction) or type(power) ~= "number" or power ~= power then
		return false
	end
	local now = os.clock()
	if lastKick[actor] and now - lastKick[actor] < Config.Kick.RateLimit then
		return false
	end
	local ball = findKickableBall(actor)
	if not ball or not canUse(ball, actor) then
		return false
	end
	local root = Actors.GetRoot(actor) :: BasePart
	lastKick[actor] = now

	if direction.Magnitude < 0.05 then
		direction = root.CFrame.LookVector
	end
	local goalCenter, goalWidth = ball.Handlers.GetAttackGoal(actor)
	local velocity = KickMath.Compute({
		Kind = kind,
		Origin = ball.Part.Position,
		Direction = direction,
		Power = math.clamp(power, 0, 1),
		Passing = Actors.Alpha(actor, "Passing"),
		Shooting = Actors.Alpha(actor, "Shooting"),
		Mates = mateInfos(ball, actor),
		GoalCenter = goalCenter,
		GoalWidth = goalWidth,
		Gravity = Workspace.Gravity,
		Random = rng,
	})

	clearPossession(ball)
	local part = ball.Part
	-- If the replicated ball lags far behind the kicker, snap it to their feet first.
	local flatDir = KickMath.Flat(velocity)
	local feet = Vector3.new(root.Position.X, ball.SurfaceY + Config.Ball.Size / 2 + 0.05, root.Position.Z) + flatDir * 2
	if (part.Position - feet).Magnitude > 4 then
		part.CFrame = CFrame.new(feet)
	end
	part.AssemblyLinearVelocity = velocity
	part.AssemblyAngularVelocity = Vector3.yAxis:Cross(flatDir) * (velocity.Magnitude / (Config.Ball.Size / 2)) * 0.3

	ball.NoTouchUntil[actor] = now + Config.Ball.KickerCooldown
	recordTouch(ball, actor, kind)
	ballEvent:FireAllClients("Kick", { Position = part.Position, Speed = velocity.Magnitude, Kind = kind })
	if ball.Handlers.OnKick then
		ball.Handlers.OnKick(ball, actor, kind)
	end
	return true
end

-------------------------------------------------------------------------------
-- Tackles and skill moves
-------------------------------------------------------------------------------
function BallService.Tackle(actor): (boolean, string?)
	local now = os.clock()
	if lastTackle[actor] and now - lastTackle[actor] < Config.Tackle.Cooldown then
		return false, "cooldown"
	end
	local root = Actors.GetRoot(actor)
	if not root or not Actors.IsAlive(actor) then
		return false, "dead"
	end
	lastTackle[actor] = now

	for _, ball in balls do
		local victim = ball.Possessor
		if victim and victim ~= actor and canUse(ball, actor) then
			local mates = ball.Handlers.GetMates(actor)
			local isMate = table.find(mates, victim) ~= nil
			local victimRoot = Actors.GetRoot(victim)
			if not isMate and victimRoot then
				local offset = victimRoot.Position - root.Position
				local dist = Vector3.new(offset.X, 0, offset.Z).Magnitude
				local facing = root.CFrame.LookVector:Dot(KickMath.Flat(offset))
				if dist <= Config.Tackle.Range and facing > -0.3 then
					local success
					if (evadeUntil[victim] or 0) > now then
						success = false
					else
						local chance = KickMath.TackleChance(Actors.Alpha(actor, "Defending"), Actors.Alpha(victim, "Dribbling"))
						-- Physicality gives a small edge in shoulder-to-shoulder duels
						chance += (Actors.Alpha(actor, "Physicality") - Actors.Alpha(victim, "Physicality")) * 0.1
						success = rng:NextNumber() < chance
					end

					if success then
						clearPossession(ball)
						local away = KickMath.Flat(root.Position - ball.Part.Position)
						ball.Part.AssemblyLinearVelocity = away * 14 + Vector3.new(0, 4, 0)
						ball.NoTouchUntil[victim] = now + Config.Ball.TackledCooldown
						recordTouch(ball, actor, "Tackle")
					end
					ballEvent:FireAllClients("Tackle", { Position = root.Position, Success = success })
					if not success and not Actors.IsBot(actor) then
						ballEvent:FireClient(actor, "TackleFailed", { Duration = Config.Tackle.FailSlowTime })
					elseif not success then
						actor.SlowUntil = now + Config.Tackle.FailSlowTime
					end
					if ball.Handlers.OnTackle then
						ball.Handlers.OnTackle(ball, actor, victim, success)
					end
					return success, "attempt"
				end
			end
		end
	end
	return false, "whiff"
end

function BallService.SkillMove(actor): boolean
	local now = os.clock()
	if lastSkill[actor] and now - lastSkill[actor] < Config.SkillMove.Cooldown then
		return false
	end
	lastSkill[actor] = now
	evadeUntil[actor] = now + Config.Tackle.EvadeWindow
	for _, ball in balls do
		if ball.Possessor == actor then
			recordTouch(ball, actor, "Skill")
			if ball.Handlers.OnSkillMove then
				ball.Handlers.OnSkillMove(ball, actor)
			end
			return true
		end
	end
	return false
end

-------------------------------------------------------------------------------
-- Simulation step
-------------------------------------------------------------------------------
local function stepPossessed(ball)
	local actor = ball.Possessor
	local root = Actors.GetRoot(actor)
	if not root or not canUse(ball, actor) then
		clearPossession(ball)
		return
	end
	local part = ball.Part
	local offset = part.Position - root.Position
	if Vector3.new(offset.X, 0, offset.Z).Magnitude > Config.Ball.MaxDribbleLeash or math.abs(offset.Y) > 8 then
		-- Lost the ball (lag spike, fell behind, or a client misbehaving)
		clearPossession(ball)
		return
	end
	if Actors.IsBot(actor) then
		local target = root.Position + root.CFrame.LookVector * Config.Ball.DribbleDistance
		target = Vector3.new(target.X, ball.SurfaceY + Config.Ball.Size / 2, target.Z)
		local rootVel = root.AssemblyLinearVelocity
		local desired = (target - part.Position) * Config.Ball.DribbleStiffness + Vector3.new(rootVel.X, 0, rootVel.Z)
		if desired.Magnitude > 70 then
			desired = desired.Unit * 70
		end
		part.AssemblyLinearVelocity = desired
	end
end

local function stepFree(ball, dt: number)
	local part = ball.Part
	local cfg = Config.Ball
	local vel = part.AssemblyLinearVelocity
	local height = part.Position.Y - (ball.SurfaceY + cfg.Size / 2)
	local grounded = height < 0.35

	-- Custom drag
	local drag = if grounded then cfg.GroundDrag else cfg.AirDrag
	local factor = math.exp(-drag * dt)
	part.AssemblyLinearVelocity = Vector3.new(vel.X * factor, vel.Y, vel.Z * factor)

	-- Control / deflection by nearby actors
	local now = os.clock()
	local best, bestDist = nil, math.huge
	for _, actor in ball.Handlers.GetActors() do
		if (ball.NoTouchUntil[actor] or 0) < now and Actors.IsAlive(actor) then
			local root = Actors.GetRoot(actor) :: BasePart
			local offset = part.Position - root.Position
			local horizontal = Vector3.new(offset.X, 0, offset.Z).Magnitude
			if horizontal <= cfg.ControlRadius and offset.Y < cfg.ControlHeight - 3 and offset.Y > -4 and horizontal < bestDist then
				best, bestDist = actor, horizontal
			end
		end
	end
	if best then
		local speed = vel.Magnitude
		local chance = KickMath.FirstTouchChance(Actors.Alpha(best, "BallControl"), speed)
		if rng:NextNumber() <= chance then
			setPossessor(ball, best)
		else
			-- Heavy touch: the ball bounces off the player
			local root = Actors.GetRoot(best) :: BasePart
			local away = KickMath.Flat(part.Position - root.Position)
			part.AssemblyLinearVelocity = away * speed * 0.35 + Vector3.new(0, 8, 0)
			ball.NoTouchUntil[best] = now + 0.35
			recordTouch(ball, best, "Deflect")
			ballEvent:FireAllClients("Deflect", { Position = part.Position })
		end
	end
end

local function step(dt: number)
	for i = #balls, 1, -1 do
		local ball = balls[i]
		if ball and not ball.Destroyed and not ball.Frozen then
			local pos = ball.Part.Position
			local outOfBounds = pos.Y < ball.SurfaceY - 15
			if ball.Bounds and not outOfBounds then
				local rel = pos - ball.Bounds.Center
				local hs = ball.Bounds.HalfSize
				outOfBounds = math.abs(rel.X) > hs.X or math.abs(rel.Z) > hs.Z or rel.Y > hs.Y
			end
			if outOfBounds then
				if ball.Handlers.OnOutOfBounds then
					ball.Handlers.OnOutOfBounds(ball)
				else
					BallService.Reset(ball)
				end
			elseif ball.Possessor then
				stepPossessed(ball)
			else
				stepFree(ball, dt)
			end
		end
	end
end

-------------------------------------------------------------------------------
-- Practice balls (free to use by anyone not in a match)
-------------------------------------------------------------------------------
local function practiceActors()
	local list = {}
	for _, player in Players:GetPlayers() do
		if not player:GetAttribute("MatchId") then
			table.insert(list, player)
		end
	end
	return list
end

local function createPracticeBalls()
	local center = Config.Hub.PracticeArea
	local handlers = {
		GetActors = practiceActors,
		GetMates = function()
			return practiceActors()
		end,
		GetAttackGoal = function()
			return center + Vector3.new(20, 2, 0), 12
		end,
	}
	for i = 1, 3 do
		BallService.CreateBall({
			SpawnPosition = center + Vector3.new(-6 + i * 3, 3, -4 + i * 2),
			SurfaceY = 0.2,
			Bounds = { Center = center, HalfSize = Vector3.new(30, 60, 30) },
			Handlers = handlers,
		})
	end
end

-------------------------------------------------------------------------------
function BallService.Init()
	setupCollisionGroups()
	ballEvent = Remotes.Get("BallEvent")
end

function BallService.Start()
	local function onCharacter(character: Model)
		BallService.TagCharacter(character)
	end
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(onCharacter)
		if player.Character then
			onCharacter(player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in Players:GetPlayers() do
		onPlayer(p)
	end
	Players.PlayerRemoving:Connect(function(player)
		BallService.ReleaseActor(player)
		for _, ball in balls do
			ball.NoTouchUntil[player] = nil
		end
	end)

	-- Remotes: clients only send intents
	Remotes.Get("Kick").OnServerEvent:Connect(function(player, kind, direction, power)
		if type(kind) ~= "string" then
			return
		end
		BallService.Kick(player, kind, direction, power)
	end)
	Remotes.Get("Tackle").OnServerEvent:Connect(function(player)
		BallService.Tackle(player)
	end)
	Remotes.Get("SkillMove").OnServerEvent:Connect(function(player)
		BallService.SkillMove(player)
	end)

	createPracticeBalls()
	RunService.Heartbeat:Connect(step)
end

return BallService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">BotService</string>
            <string name="Source"><![CDATA[--[[
	BotService
	"Ground Regulars": AI footballers that fill empty match slots so a match can
	always start, even with one human. Bots are server-owned R15 rigs that use the
	same BallService API as players (no special powers).

	AI runs on a fixed 0.15s tick for all bots together, not per-frame.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Cosmetics = require(Shared.Cosmetics)
local KickMath = require(Shared.KickMath)

local Actors = require(script.Parent.Actors)
local BallService = require(script.Parent.BallService)
local MapBuilder = require(script.Parent.MapBuilder)
local NPCAnimator = require(script.Parent.NPCAnimator)

local BotService = {}

local AI_TICK = 0.15
local NAMES = {
	"Dex", "Kofi", "Mateo", "Rio", "Jax", "Nico", "Sami", "Theo", "Zane", "Malik",
	"Yusuf", "Leo", "Ivo", "Bo", "Remy", "Tariq", "Enzo", "Caz", "Obi", "Luca",
}
local SKIN_TONES = {
	Color3.fromRGB(255, 220, 190), Color3.fromRGB(234, 184, 146), Color3.fromRGB(198, 134, 94),
	Color3.fromRGB(141, 85, 54), Color3.fromRGB(96, 58, 38), Color3.fromRGB(60, 38, 28),
}
local SHORTS = { "shorts_black", "shorts_white", "shorts_navy" }
local BOOTS = { "boots_black", "boots_white", "boots_volt", "boots_blaze" }

local bots = {}
local nextBotId = 0
local rng = Random.new()

local function buildRig(name: string): Model
	local desc = Instance.new("HumanoidDescription")
	local skin = SKIN_TONES[rng:NextInteger(1, #SKIN_TONES)]
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.TorsoColor = skin
	desc.LeftLegColor = skin
	desc.RightLegColor = skin
	local model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	model.Name = name
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	humanoid.DisplayName = name
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	humanoid.NameDisplayDistance = 60
	humanoid.BreakJointsOnDeath = false
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	-- Remove any client Animate script the factory may have added; NPCAnimator handles it.
	local animate = model:FindFirstChild("Animate")
	if animate then
		animate:Destroy()
	end
	return model
end

function BotService.CreateBot(team: string)
	nextBotId += 1
	local name = NAMES[rng:NextInteger(1, #NAMES)]
	local model = buildRig(name)
	local attributes = {}
	for _, attr in Config.Attributes.List do
		attributes[attr] = rng:NextInteger(44, 62)
	end
	local bot = {
		IsBot = true,
		Id = -nextBotId,
		Name = name,
		Model = model,
		Attributes = attributes,
		Team = team,
		Match = nil,
		Role = 1,
		SlowUntil = 0,
		PossessedSince = 0,
		Animator = nil,
	}
	local kit = {
		Shirt = "shirt_white",
		Shorts = SHORTS[rng:NextInteger(1, #SHORTS)],
		Socks = "socks_white",
		Boots = BOOTS[rng:NextInteger(1, #BOOTS)],
		Headwear = "head_none",
		Trail = "trail_none",
	}
	Cosmetics.Apply(model, kit, Config.Teams[team].Color)
	model:PivotTo(CFrame.new(0, -200, 0)) -- out of sight until the match places it
	model.Parent = MapBuilder.GetRoot().NPCs
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	root.Anchored = true
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	BallService.TagCharacter(model)
	bot.Animator = NPCAnimator.Attach(model)
	bots[bot] = true
	return bot
end

function BotService.AssignMatch(bot, match, team: string)
	bot.Match = match
	bot.Team = team
	bot.Role = #match.Teams[team]
end

function BotService.DestroyBot(bot)
	bots[bot] = nil
	BallService.ReleaseActor(bot)
	if bot.Model then
		bot.Model:Destroy()
	end
	bot.Model = nil
	bot.Match = nil
end

-------------------------------------------------------------------------------
-- AI
-------------------------------------------------------------------------------
local function flatDist(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function closestToPoint(actors, point: Vector3)
	local best, bestDist = nil, math.huge
	for _, actor in actors do
		local root = Actors.GetRoot(actor)
		if root then
			local d = flatDist(root.Position, point)
			if d < bestDist then
				best, bestDist = actor, d
			end
		end
	end
	return best, bestDist
end

local function clampToPitch(match, pos: Vector3): Vector3
	local p = match.Pitch
	local x = math.clamp(pos.X, p.Center.X - p.Length / 2 + 3, p.Center.X + p.Length / 2 - 3)
	local z = math.clamp(pos.Z, p.Center.Z - p.Width / 2 + 3, p.Center.Z + p.Width / 2 - 3)
	return Vector3.new(x, p.SurfaceY, z)
end

local function nearestOpponentDistance(match, team: string, point: Vector3): number
	local _, d = closestToPoint(match.Teams[if team == "A" then "B" else "A"], point)
	return d
end

local function choosePassTarget(bot, match, root: BasePart, attackDir: number)
	local best, bestScore = nil, -math.huge
	for _, mate in match.Teams[bot.Team] do
		local mateRoot = Actors.GetRoot(mate)
		if mate ~= bot and mateRoot then
			local space = nearestOpponentDistance(match, bot.Team, mateRoot.Position)
			local progress = (mateRoot.Position.X - root.Position.X) * attackDir
			local dist = flatDist(mateRoot.Position, root.Position)
			if dist > 6 and dist < 70 then
				local score = space * 1.2 + progress * 0.6 - dist * 0.15
				if score > bestScore then
					best, bestScore = mateRoot, score
				end
			end
		end
	end
	return best, bestScore
end

local function think(bot)
	local match = bot.Match
	local humanoid = Actors.GetHumanoid(bot)
	local root = Actors.GetRoot(bot)
	if not match or not humanoid or not root or not match.Ball then
		return
	end
	if match.State ~= "Playing" then
		humanoid:Move(Vector3.zero)
		return
	end

	local now = os.clock()
	local ball = match.Ball
	local ballPos = ball.Part.Position
	local team = bot.Team
	local attackDir = if team == "A" then 1 else -1
	local attackGoal = match:GetAttackGoal(team)
	local ownGoal = match:GetAttackGoal(if team == "A" then "B" else "A")
	local pace = Actors.Alpha(bot, "Pace")

	local walk = Config.Movement.BaseWalkSpeed + pace * Config.Movement.PaceWalkBonus
	local sprint = Config.Movement.BaseSprintSpeed + pace * Config.Movement.PaceSprintBonus
	local speed = walk
	local target: Vector3

	local possessor = ball.Possessor
	if possessor == bot then
		if bot.PossessedSince == 0 then
			bot.PossessedSince = now
		end
		local held = now - bot.PossessedSince
		local goalDist = flatDist(root.Position, attackGoal)
		local pressure = nearestOpponentDistance(match, team, root.Position)
		speed = walk * Config.Movement.DribbleSpeedMultiplier

		if goalDist < 40 and held > 0.4 and rng:NextNumber() < 0.45 then
			local aim = attackGoal + Vector3.new(0, 0, rng:NextNumber(-5, 5))
			BallService.Kick(bot, "Shot", KickMath.Flat(aim - root.Position), rng:NextNumber(0.55, 0.95))
			return
		end
		if (pressure < 8 and held > 0.5) or held > 4 then
			local mateRoot, score = choosePassTarget(bot, match, root, attackDir)
			if mateRoot and (score > 0 or pressure < 6) and rng:NextNumber() < 0.6 then
				local kind = if rng:NextNumber() < 0.2 then "Through" else "Pass"
				BallService.Kick(bot, kind, KickMath.Flat(mateRoot.Position - root.Position), 0.6)
				return
			elseif pressure < 6 and rng:NextNumber() < 0.25 then
				BallService.SkillMove(bot)
			end
		end
		-- Dribble toward goal, drifting away from the nearest defender
		local lateral = math.sin(now * 0.8 + bot.Id) * 10
		target = Vector3.new(attackGoal.X, root.Position.Y, attackGoal.Z + lateral)
	else
		bot.PossessedSince = 0
		local possessorTeam = possessor and match:GetTeam(possessor)
		local chaser = closestToPoint(match.Teams[team], ballPos)

		if possessorTeam == team then
			-- Support run: get ahead of the ball carrier, spread out by role
			local lane = if bot.Role % 2 == 0 then -1 else 1
			target = ballPos + Vector3.new(attackDir * 16, 0, lane * 14)
		elseif possessor then
			-- Opponent has it: closest bot presses, others drop goal-side
			if chaser == bot then
				local carrierRoot = Actors.GetRoot(possessor)
				target = carrierRoot and carrierRoot.Position or ballPos
				speed = sprint
				if carrierRoot and flatDist(carrierRoot.Position, root.Position) < Config.Tackle.Range - 1 and rng:NextNumber() < 0.35 then
					BallService.Tackle(bot)
				end
			else
				local lane = if bot.Role % 2 == 0 then -1 else 1
				target = ballPos:Lerp(ownGoal, 0.45) + Vector3.new(0, 0, lane * 8)
			end
		else
			-- Loose ball
			if chaser == bot then
				local vel = ball.Part.AssemblyLinearVelocity
				target = ballPos + Vector3.new(vel.X, 0, vel.Z) * 0.25
				speed = sprint
			else
				local lane = if bot.Role % 2 == 0 then -1 else 1
				local depth = if bot.Role == 1 then 6 else -14
				target = Vector3.new(ballPos.X + attackDir * depth, root.Position.Y, match.Pitch.Center.Z + lane * 14)
			end
		end
	end

	if bot.SlowUntil > now then
		speed = 8
	end
	humanoid.WalkSpeed = speed
	local dest = clampToPitch(match, target)
	if flatDist(dest, root.Position) < 1.5 then
		humanoid:Move(Vector3.zero)
	else
		humanoid:MoveTo(Vector3.new(dest.X, root.Position.Y, dest.Z))
	end
end

function BotService.Init() end

function BotService.Start()
	task.spawn(function()
		while true do
			task.wait(AI_TICK)
			for bot in bots do
				if bot.Match then
					local ok, err = pcall(think, bot)
					if not ok then
						warn("[BotService] " .. tostring(err))
					end
				end
			end
		end
	end)
end

return BotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--[[
	DataService
	Loads, session-locks, autosaves and releases player profiles.

	Safety rules:
	  * A profile is only saved if it was loaded successfully (never overwrite good
	    data with an empty table after a failed load).
	  * Every write goes through UpdateAsync and checks that this server still owns
	    the session lock. If another server stole the lock we stop saving.
	  * Loads retry with backoff; a lock held by a live server is waited on, a lock
	    older than Config.DataStore.SessionLockTimeout is treated as stale.
	  * In Studio without API access the game still runs with temporary,
	    non-saving profiles.

	Stored value shape: { Data = <profile>, Lock = { JobId, Time } | nil, SavedAt }
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)

local DataService = {}

local JOB_ID = if game.JobId ~= "" then game.JobId else ("Studio_" .. HttpService:GenerateGUID(false))

local store: DataStore? = nil
local profiles: { [Player]: any } = {}
local meta: { [Player]: { CanSave: boolean, Dirty: boolean, Saving: boolean } } = {}
local loadedCallbacks = {}
local releasingCallbacks = {}
local shuttingDown = false

local function makeTemplate()
	local attributes = {}
	for _, name in Config.Attributes.List do
		attributes[name] = Config.Attributes.Start
	end
	return {
		Version = 1,
		Level = 1,
		XP = 0,
		Kicks = 150,
		Reputation = 0,
		AttributePoints = 0,
		Attributes = attributes,
		Stats = {
			Matches = 0,
			Wins = 0,
			Draws = 0,
			Losses = 0,
			Goals = 0,
			Assists = 0,
			Passes = 0,
			Tackles = 0,
			SkillMoves = 0,
			WinStreak = 0,
			BestWinStreak = 0,
		},
		Inventory = Catalog.DefaultInventory(),
		Equipped = Catalog.DefaultEquipped(),
		UnlockedAreas = { CommunityCourt = true },
		Challenges = {},
		Settings = { CameraSensitivity = 1, CameraMode = "Follow", ShowControls = true },
		FirstJoin = os.time(),
	}
end

-- Fill in any keys missing from older saves without touching existing values.
local function reconcile(data, template)
	for key, value in template do
		if data[key] == nil then
			if type(value) == "table" then
				data[key] = table.clone(value)
				reconcile(data[key], value)
			else
				data[key] = value
			end
		elseif type(value) == "table" and type(data[key]) == "table" then
			reconcile(data[key], value)
		end
	end
	return data
end

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

local function retry(attempts: number, fn: () -> any): (boolean, any)
	local lastErr
	for i = 1, attempts do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		warn(string.format("[DataService] attempt %d/%d failed: %s", i, attempts, tostring(result)))
		if i < attempts then
			task.wait(math.min(2 ^ i, 16))
		end
	end
	return false, lastErr
end

-- Returns: status ("ok" | "locked" | "error"), data
local function tryLoad(player: Player)
	local result = nil
	local lockedByOther = false
	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync(keyFor(player), function(stored)
			stored = stored or {}
			local lock = stored.Lock
			if lock and lock.JobId ~= JOB_ID and (os.time() - (lock.Time or 0)) < Config.DataStore.SessionLockTimeout then
				lockedByOther = true
				return nil -- cancel the write, leave data untouched
			end
			lockedByOther = false
			stored.Lock = { JobId = JOB_ID, Time = os.time() }
			stored.Data = reconcile(stored.Data or makeTemplate(), makeTemplate())
			result = stored.Data
			return stored
		end)
	end)
	if not ok then
		return "error", err
	end
	if lockedByOther then
		return "locked", nil
	end
	return "ok", result
end

local function loadProfile(player: Player)
	for attempt = 1, Config.DataStore.LoadRetries do
		local status, data = tryLoad(player)
		if status == "ok" then
			return data
		end
		if not player.Parent then
			return nil
		end
		if status == "error" and RunService:IsStudio() then
			-- Usually "Studio access to API services" is off; do not stall testing.
			warn("[DataService] " .. tostring(data))
			return nil
		end
		warn(string.format("[DataService] load %s for %s (attempt %d)", status, player.Name, attempt))
		-- A locked session usually means the player just left another server that is
		-- still saving. Wait a bit longer for it to release.
		task.wait(if status == "locked" then 6 else math.min(2 ^ attempt, 12))
	end
	return nil
end

-- Writes the profile. release = true clears the session lock.
local function saveProfile(player: Player, release: boolean): boolean
	local profile = profiles[player]
	local m = meta[player]
	if not profile or not m or not m.CanSave or not store then
		return false
	end
	-- Avoid two overlapping saves for the same player.
	while m.Saving do
		task.wait(0.1)
	end
	m.Saving = true
	local lostLock = false
	local ok = retry(Config.DataStore.SaveRetries, function()
		(store :: DataStore):UpdateAsync(keyFor(player), function(stored)
			stored = stored or {}
			local lock = stored.Lock
			if lock and lock.JobId ~= JOB_ID then
				lostLock = true
				return nil
			end
			stored.Data = profile
			stored.SavedAt = os.time()
			stored.Lock = if release then nil else { JobId = JOB_ID, Time = os.time() }
			return stored
		end)
	end)
	m.Saving = false
	if lostLock then
		warn("[DataService] session lock lost for " .. player.Name .. "; data will no longer be saved here")
		m.CanSave = false
		if player.Parent and not release then
			player:Kick("Your data was opened on another server. Please rejoin.")
		end
		return false
	end
	if ok then
		m.Dirty = false
	end
	return ok
end

function DataService.Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStores unavailable, using temporary profiles: " .. tostring(result))
	end
end

local function onPlayerAdded(player: Player)
	local data = nil
	local canSave = false

	if store then
		data = loadProfile(player)
		if data then
			canSave = true
		elseif RunService:IsStudio() then
			warn("[DataService] Studio load failed, enable 'Studio Access to API Services' to test saving")
		else
			if player.Parent then
				player:Kick("Could not load your data. Please rejoin in a moment.")
			end
			return
		end
	end

	if not player.Parent then
		-- Left while loading: release the lock we may have taken.
		if canSave and store then
			profiles[player] = data
			meta[player] = { CanSave = true, Dirty = false, Saving = false }
			saveProfile(player, true)
			profiles[player] = nil
			meta[player] = nil
		end
		return
	end

	if not data then
		data = makeTemplate()
	end

	profiles[player] = data
	meta[player] = { CanSave = canSave, Dirty = false, Saving = false }
	player:SetAttribute("ProfileLoaded", true)

	for _, callback in loadedCallbacks do
		task.spawn(callback, player, data)
	end
end

local function onPlayerRemoving(player: Player)
	if not profiles[player] then
		return
	end
	for _, callback in releasingCallbacks do
		local ok, err = pcall(callback, player, profiles[player])
		if not ok then
			warn("[DataService] release callback error: " .. tostring(err))
		end
	end
	saveProfile(player, true)
	profiles[player] = nil
	meta[player] = nil
end

function DataService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	-- Autosave loop, staggered so we do not hit DataStore limits in one burst.
	task.spawn(function()
		while not shuttingDown do
			task.wait(Config.DataStore.AutosaveInterval)
			for player in profiles do
				if shuttingDown then
					break
				end
				task.spawn(saveProfile, player, false)
				task.wait(1)
			end
		end
	end)

	game:BindToClose(function()
		shuttingDown = true
		if not store then
			return
		end
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				saveProfile(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

function DataService.GetProfile(player: Player)
	return profiles[player]
end

-- Waits up to `timeout` seconds for a profile to load.
function DataService.WaitForProfile(player: Player, timeout: number?)
	local deadline = os.clock() + (timeout or 30)
	while not profiles[player] and player.Parent and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

function DataService.MarkDirty(player: Player)
	local m = meta[player]
	if m then
		m.Dirty = true
	end
end

function DataService.OnProfileLoaded(callback: (Player, any) -> ())
	table.insert(loadedCallbacks, callback)
	for player, data in profiles do
		task.spawn(callback, player, data)
	end
end

-- Called just before a profile is saved and released (player leaving).
function DataService.OnProfileReleasing(callback: (Player, any) -> ())
	table.insert(releasingCallbacks, callback)
end

DataService._makeTemplate = makeTemplate
DataService._reconcile = reconcile

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[--[[
	InventoryService (also handles customization)
	Server-validated purchases and equips, and applies the equipped kit to the
	character every time it spawns. During matches a team colour replaces the shirt.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared.Catalog)
local Cosmetics = require(Shared.Cosmetics)
local Progression = require(Shared.Progression)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local ProgressionService = require(script.Parent.ProgressionService)

local InventoryService = {}

local teamColorOverride: { [Player]: Color3? } = {}
local lastRequest: { [Player]: number } = {}

local function rateLimited(player: Player): boolean
	local now = os.clock()
	if lastRequest[player] and now - lastRequest[player] < 0.25 then
		return true
	end
	lastRequest[player] = now
	return false
end

function InventoryService.ApplyToCharacter(player: Player)
	local character = player.Character
	local profile = DataService.GetProfile(player)
	if character and profile then
		Cosmetics.Apply(character, profile.Equipped, teamColorOverride[player])
	end
end

-- Used by MatchService: nil clears the override.
function InventoryService.SetTeamColor(player: Player, color: Color3?)
	teamColorOverride[player] = color
	InventoryService.ApplyToCharacter(player)
end

local function meetsTier(profile, item): boolean
	if not item.RequiredTier then
		return true
	end
	local tierIndex = Progression.GetReputationTier(profile.Reputation)
	return tierIndex >= Progression.TierIndexByName(item.RequiredTier)
end

local function purchase(player: Player, itemId)
	if rateLimited(player) then
		return false, "Slow down"
	end
	if type(itemId) ~= "string" then
		return false, "Invalid item"
	end
	local item = Catalog.Get(itemId)
	local profile = DataService.GetProfile(player)
	if not item or not profile then
		return false, "Invalid item"
	end
	if profile.Inventory[itemId] then
		return false, "Already owned"
	end
	if not meetsTier(profile, item) then
		return false, "Requires reputation: " .. item.RequiredTier
	end
	if not ProgressionService.SpendKicks(player, item.Price) then
		return false, "Not enough Kicks"
	end
	profile.Inventory[itemId] = true
	DataService.MarkDirty(player)
	ProgressionService.Sync(player)
	return true, "Bought " .. item.Name
end

local function equip(player: Player, itemId)
	if rateLimited(player) then
		return false, "Slow down"
	end
	if type(itemId) ~= "string" then
		return false, "Invalid item"
	end
	local item = Catalog.Get(itemId)
	local profile = DataService.GetProfile(player)
	if not item or not profile then
		return false, "Invalid item"
	end
	if not profile.Inventory[itemId] then
		return false, "You do not own this"
	end
	profile.Equipped[item.Category] = itemId
	DataService.MarkDirty(player)
	ProgressionService.Sync(player)
	InventoryService.ApplyToCharacter(player)
	return true, "Equipped " .. item.Name
end

function InventoryService.Init() end

function InventoryService.Start()
	Remotes.Get("PurchaseItem").OnServerInvoke = purchase
	Remotes.Get("EquipItem").OnServerInvoke = equip

	local function hookPlayer(player: Player)
		player.CharacterAppearanceLoaded:Connect(function()
			InventoryService.ApplyToCharacter(player)
		end)
		player.CharacterAdded:Connect(function()
			-- CharacterAppearanceLoaded can fire before the profile loads, so also
			-- apply shortly after spawn.
			task.delay(1, InventoryService.ApplyToCharacter, player)
		end)
	end
	Players.PlayerAdded:Connect(hookPlayer)
	for _, p in Players:GetPlayers() do
		hookPlayer(p)
	end

	DataService.OnProfileLoaded(function(player)
		InventoryService.ApplyToCharacter(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		teamColorOverride[player] = nil
		lastRequest[player] = nil
	end)
end

return InventoryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--[[
	LeaderboardService (MVP)
	Fills the physical board in the plaza with the top players in this server
	by level, plus wins/goals. A global board (OrderedDataStore) comes next.
]]

local Players = game:GetService("Players")

local DataService = require(script.Parent.DataService)
local MapBuilder = require(script.Parent.MapBuilder)

local LeaderboardService = {}

local rows = {}

local function buildBoard(board: BasePart)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Brightness = 1.4
	gui.Parent = board

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0.14, 0)
	title.BackgroundColor3 = Color3.fromRGB(205, 255, 64)
	title.Text = "TOP OF THE GROUNDS"
	title.Font = Enum.Font.GothamBlack
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(14, 14, 18)
	title.Parent = gui

	local header = Instance.new("TextLabel")
	header.Size = UDim2.new(1, 0, 0.08, 0)
	header.Position = UDim2.fromScale(0, 0.15)
	header.BackgroundTransparency = 1
	header.Text = "  #   PLAYER                         LVL   WINS   GOALS"
	header.Font = Enum.Font.GothamBold
	header.TextScaled = true
	header.TextXAlignment = Enum.TextXAlignment.Left
	header.TextColor3 = Color3.fromRGB(160, 160, 170)
	header.Parent = gui

	for i = 1, 8 do
		local row = Instance.new("TextLabel")
		row.Size = UDim2.new(1, -20, 0.085, 0)
		row.Position = UDim2.new(0, 10, 0.24 + (i - 1) * 0.094, 0)
		row.BackgroundColor3 = if i % 2 == 0 then Color3.fromRGB(28, 28, 34) else Color3.fromRGB(22, 22, 28)
		row.Font = Enum.Font.GothamMedium
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = Color3.new(1, 1, 1)
		row.Text = ""
		row.Parent = gui
		rows[i] = row
	end
end

local function refresh()
	local entries = {}
	for _, player in Players:GetPlayers() do
		local profile = DataService.GetProfile(player)
		if profile then
			table.insert(entries, { Name = player.DisplayName, Level = profile.Level, Wins = profile.Stats.Wins, Goals = profile.Stats.Goals, XP = profile.XP })
		end
	end
	table.sort(entries, function(a, b)
		if a.Level ~= b.Level then
			return a.Level > b.Level
		end
		return a.XP > b.XP
	end)
	for i, row in rows do
		local e = entries[i]
		if e then
			row.Text = string.format("  %d   %-28s  %3d   %4d   %5d", i, string.sub(e.Name, 1, 20), e.Level, e.Wins, e.Goals)
		else
			row.Text = ""
		end
	end
end

function LeaderboardService.Init() end

function LeaderboardService.Start()
	local board = MapBuilder.GetRoot().Hub:FindFirstChild("Leaderboard")
	if not board then
		return
	end
	buildBoard(board)
	task.spawn(function()
		while true do
			refresh()
			task.wait(10)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[--[[
	MapBuilder
	Builds the Grounds hub at server start: lighting, the asphalt plaza, the caged
	3v3 pitch with goals, stands, floodlights, surrounding buildings with graffiti,
	the Locker, the practice court, area gates and street furniture.

	Everything is generated from Config so the layout stays in sync with the
	match and ball systems. If you hand-build a map later, keep the same names
	(Workspace.Grounds.Pitches.<Id>) and attributes, and remove this service.
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local MapBuilder = {}

local root: Folder

local COLORS = {
	Asphalt = Color3.fromRGB(46, 48, 54),
	Concrete = Color3.fromRGB(150, 150, 146),
	GrassA = Color3.fromRGB(56, 140, 60),
	GrassB = Color3.fromRGB(48, 124, 52),
	Line = Color3.fromRGB(245, 245, 240),
	Fence = Color3.fromRGB(40, 42, 46),
	Volt = Config.Teams.A.Color,
	Ember = Config.Teams.B.Color,
}

local function part(props): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		if k ~= "Parent" then
			(p :: any)[k] = v
		end
	end
	p.Parent = props.Parent
	return p
end

local function folder(name: string, parent: Instance): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function collider(cf: CFrame, size: Vector3, parent: Instance, name: string?)
	return part({
		Name = name or "Collider",
		CFrame = cf,
		Size = size,
		Transparency = 1,
		CanQuery = false,
		CastShadow = false,
		Parent = parent,
	})
end

local function signText(target: BasePart, face: Enum.NormalId, text: string, color: Color3, font: Enum.Font, opts)
	opts = opts or {}
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = opts.PixelsPerStud or 20
	gui.LightInfluence = opts.LightInfluence or 0
	gui.Brightness = opts.Brightness or 1.5
	gui.Parent = target
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = font
	label.TextColor3 = color
	label.Rotation = opts.Rotation or 0
	label.Parent = gui
	if opts.Gradient then
		local g = Instance.new("UIGradient")
		g.Color = opts.Gradient
		g.Parent = label
	end
	if opts.Stroke then
		local s = Instance.new("UIStroke")
		s.Color = opts.Stroke
		s.Thickness = 3
		s.Parent = label
	end
	return gui, label
end

-------------------------------------------------------------------------------
-- Lighting
-------------------------------------------------------------------------------
local function buildLighting()
	Lighting.ClockTime = 17.4
	Lighting.Brightness = 2.4
	Lighting.Ambient = Color3.fromRGB(60, 56, 70)
	Lighting.OutdoorAmbient = Color3.fromRGB(120, 112, 130)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.25
	pcall(function()
		Lighting.Technology = Enum.Technology.Future
	end)

	for _, child in Lighting:GetChildren() do
		if child:IsA("PostEffect") or child:IsA("Atmosphere") or child:IsA("Sky") then
			child:Destroy()
		end
	end

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.32
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(255, 196, 160)
	atmosphere.Decay = Color3.fromRGB(110, 90, 120)
	atmosphere.Glare = 0.4
	atmosphere.Haze = 1.6
	atmosphere.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 30
	bloom.Threshold = 1.6
	bloom.Parent = Lighting

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Contrast = 0.12
	cc.Saturation = 0.12
	cc.TintColor = Color3.fromRGB(255, 244, 236)
	cc.Parent = Lighting

	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.06
	rays.Spread = 0.6
	rays.Parent = Lighting
end

-------------------------------------------------------------------------------
-- Pitch
-------------------------------------------------------------------------------
local function line(parent, cf: CFrame, sizeX: number, sizeZ: number)
	return part({
		Name = "Line",
		CFrame = cf,
		Size = Vector3.new(sizeX, 0.05, sizeZ),
		Color = COLORS.Line,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
		Parent = parent,
	})
end

local function circle(parent, center: Vector3, radius: number, segments: number, thickness: number)
	for i = 0, segments - 1 do
		local a = (i + 0.5) / segments * math.pi * 2
		local segLength = 2 * math.pi * radius / segments + 0.15
		local pos = center + Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius)
		line(parent, CFrame.lookAt(pos, center) * CFrame.Angles(0, math.pi / 2, 0), segLength, thickness)
	end
end

local function buildGoal(parent: Instance, pitch, side: number, teamColor: Color3)
	-- side = -1 for the -X goal (Team A defends), +1 for the +X goal (Team B defends)
	local c = pitch.Center
	local y = pitch.SurfaceY
	local halfL = pitch.Length / 2
	local gw, gh, gd = pitch.GoalWidth, pitch.GoalHeight, pitch.GoalDepth
	local goalX = c.X + side * halfL
	local model = Instance.new("Model")
	model.Name = if side < 0 then "GoalA" else "GoalB"
	model.Parent = parent

	local postSize = 0.7
	for _, z in { -gw / 2, gw / 2 } do
		part({
			Name = "Post",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(gh, postSize, postSize),
			CFrame = CFrame.new(goalX, y + gh / 2, c.Z + z) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.new(1, 1, 1),
			Material = Enum.Material.Metal,
			Parent = model,
		})
	end
	part({
		Name = "Crossbar",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(gw + postSize, postSize, postSize),
		CFrame = CFrame.new(goalX, y + gh, c.Z) * CFrame.Angles(0, math.rad(90), 0),
		Color = Color3.new(1, 1, 1),
		Material = Enum.Material.Metal,
		Parent = model,
	})

	-- Net (visual + collision so the ball stays in)
	local netProps = {
		Color = Color3.fromRGB(230, 230, 230),
		Material = Enum.Material.Fabric,
		Transparency = 0.55,
		CastShadow = false,
		Parent = model,
	}
	local backX = goalX + side * gd
	local function net(name, cf, size)
		local p = part(netProps)
		p.Name = name
		p.CFrame = cf
		p.Size = size
		return p
	end
	net("NetBack", CFrame.new(backX + side * 0.1, y + gh / 2, c.Z), Vector3.new(0.2, gh, gw))
	net("NetTop", CFrame.new(goalX + side * gd / 2, y + gh + 0.1, c.Z), Vector3.new(gd, 0.2, gw))
	net("NetSideL", CFrame.new(goalX + side * gd / 2, y + gh / 2, c.Z - gw / 2 - 0.1), Vector3.new(gd, gh, 0.2))
	net("NetSideR", CFrame.new(goalX + side * gd / 2, y + gh / 2, c.Z + gw / 2 + 0.1), Vector3.new(gd, gh, 0.2))

	-- Coloured goal box floor so each end is readable at a glance
	part({
		Name = "GoalFloor",
		CFrame = CFrame.new(goalX + side * gd / 2, y - 0.05, c.Z),
		Size = Vector3.new(gd, 0.2, gw),
		Color = teamColor,
		Material = Enum.Material.Neon,
		Transparency = 0.6,
		CanCollide = false,
		Parent = model,
	})
	return model
end

local function buildPitch(parent: Instance, pitch)
	local model = folder(pitch.Id, parent)
	local c = pitch.Center
	local y = pitch.SurfaceY
	local L, W = pitch.Length, pitch.Width
	local halfL, halfW = L / 2, W / 2

	-- Stripes
	local stripes = 8
	for i = 0, stripes - 1 do
		local x = c.X - halfL + (i + 0.5) * (L / stripes)
		part({
			Name = "Turf",
			CFrame = CFrame.new(x, y - 0.5, c.Z),
			Size = Vector3.new(L / stripes, 1, W),
			Color = if i % 2 == 0 then COLORS.GrassA else COLORS.GrassB,
			Material = Enum.Material.Grass,
			Parent = model,
		})
	end
	-- Concrete border slab around the turf
	part({
		Name = "Border",
		CFrame = CFrame.new(c.X, y - 0.6, c.Z),
		Size = Vector3.new(L + 2 * pitch.GoalDepth + 6, 1, W + 6),
		Color = COLORS.Concrete,
		Material = Enum.Material.Concrete,
		Parent = model,
	})

	-- Markings
	local lines = folder("Lines", model)
	local ly = y + 0.03
	local t = 0.45
	line(lines, CFrame.new(c.X, ly, c.Z - halfW + t / 2), L, t)
	line(lines, CFrame.new(c.X, ly, c.Z + halfW - t / 2), L, t)
	line(lines, CFrame.new(c.X - halfL + t / 2, ly, c.Z), t, W)
	line(lines, CFrame.new(c.X + halfL - t / 2, ly, c.Z), t, W)
	line(lines, CFrame.new(c.X, ly, c.Z), t, W)
	circle(lines, Vector3.new(c.X, ly, c.Z), 9, 28, t)
	part({
		Name = "CenterSpot",
		Shape = Enum.PartType.Cylinder,
		CFrame = CFrame.new(c.X, ly, c.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Size = Vector3.new(0.05, 1.2, 1.2),
		Color = COLORS.Line,
		CanCollide = false,
		CanQuery = false,
		Parent = lines,
	})
	local boxDepth, boxWidth = 14, 30
	for _, side in { -1, 1 } do
		local gx = c.X + side * halfL
		local bx = gx - side * boxDepth
		line(lines, CFrame.new(bx, ly, c.Z), t, boxWidth)
		line(lines, CFrame.new(gx - side * boxDepth / 2, ly, c.Z - boxWidth / 2), boxDepth, t)
		line(lines, CFrame.new(gx - side * boxDepth / 2, ly, c.Z + boxWidth / 2), boxDepth, t)
	end

	-- Goals
	buildGoal(model, pitch, -1, COLORS.Volt)
	buildGoal(model, pitch, 1, COLORS.Ember)

	-- Cage: visible fence + tall invisible colliders (ball and players stay inside)
	local cage = folder("Cage", model)
	local wallH = pitch.WallHeight
	local colH = pitch.ColliderHeight
	local gw = pitch.GoalWidth

	local function fenceRun(from: Vector3, to: Vector3, exact: boolean?)
		local mid = (from + to) / 2
		local length = (to - from).Magnitude
		local cf = CFrame.lookAt(mid, to)
		-- mesh panel
		part({
			Name = "FencePanel",
			CFrame = cf * CFrame.new(0, wallH / 2, 0),
			Size = Vector3.new(0.15, wallH, length),
			Color = COLORS.Fence,
			Material = Enum.Material.DiamondPlate,
			Transparency = 0.7,
			CanCollide = false,
			CastShadow = false,
			Parent = cage,
		})
		part({
			Name = "TopRail",
			CFrame = cf * CFrame.new(0, wallH, 0),
			Size = Vector3.new(0.5, 0.5, length),
			Color = COLORS.Fence,
			Material = Enum.Material.Metal,
			Parent = cage,
		})
		local posts = math.max(1, math.floor(length / 8))
		for i = 0, posts do
			local p = from:Lerp(to, i / posts)
			part({
				Name = "Post",
				CFrame = CFrame.new(p.X, p.Y + wallH / 2, p.Z),
				Size = Vector3.new(0.5, wallH, 0.5),
				Color = COLORS.Fence,
				Material = Enum.Material.Metal,
				Parent = cage,
			})
		end
		collider(cf * CFrame.new(0, colH / 2, 0), Vector3.new(2, colH, if exact then length else length + 2), cage, "CageCollider")
	end

	local base = y
	local nW = c.Z - halfW - 1
	local sW = c.Z + halfW + 1
	local eX = c.X + halfL + 1
	local wX = c.X - halfL - 1
	-- long sides
	fenceRun(Vector3.new(wX, base, nW), Vector3.new(eX, base, nW))
	fenceRun(Vector3.new(wX, base, sW), Vector3.new(eX, base, sW))
	-- goal ends, leaving a gap for each goal mouth
	for _, x in { wX, eX } do
		fenceRun(Vector3.new(x, base, nW), Vector3.new(x, base, c.Z - gw / 2 - 0.6), true)
		fenceRun(Vector3.new(x, base, c.Z + gw / 2 + 0.6), Vector3.new(x, base, sW), true)
	end
	-- Behind each goal: collider wall so a ball in the net never escapes
	for _, side in { -1, 1 } do
		local x = c.X + side * (halfL + pitch.GoalDepth + 1.5)
		collider(CFrame.new(x, base + colH / 2, c.Z), Vector3.new(2, colH, gw + 4), cage, "GoalBackCollider")
		collider(CFrame.new(c.X + side * (halfL + 1 + pitch.GoalDepth / 2), base + colH / 2 + pitch.GoalHeight + 0.4, c.Z), Vector3.new(pitch.GoalDepth + 2, colH, gw + 4), cage, "GoalTopCollider")
	end
	-- Roof
	collider(CFrame.new(c.X, base + colH, c.Z), Vector3.new(L + 20, 2, W + 6), cage, "Roof")

	-- Floodlights in each corner
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local px = c.X + sx * (halfL + 4)
			local pz = c.Z + sz * (halfW + 4)
			part({
				Name = "LightPole",
				CFrame = CFrame.new(px, base + 16, pz),
				Size = Vector3.new(1, 32, 1),
				Color = COLORS.Fence,
				Material = Enum.Material.Metal,
				Parent = cage,
			})
			local head = part({
				Name = "LightHead",
				CFrame = CFrame.lookAt(Vector3.new(px, base + 32, pz), Vector3.new(c.X, base, c.Z)),
				Size = Vector3.new(5, 3, 1),
				Color = Color3.fromRGB(255, 250, 230),
				Material = Enum.Material.Neon,
				Parent = cage,
			})
			local spot = Instance.new("SpotLight")
			spot.Face = Enum.NormalId.Front
			spot.Angle = 70
			spot.Range = 60
			spot.Brightness = 2.2
			spot.Color = Color3.fromRGB(255, 246, 225)
			spot.Shadows = false
			spot.Parent = head
		end
	end

	-- Name board above the north fence
	local board = part({
		Name = "PitchSign",
		CFrame = CFrame.new(c.X, base + wallH + 4, nW - 0.5),
		Size = Vector3.new(30, 5, 0.6),
		Color = Color3.fromRGB(16, 16, 20),
		Parent = cage,
	})
	signText(board, Enum.NormalId.Front, pitch.DisplayName .. "  ·  3v3", Color3.fromRGB(255, 255, 255), Enum.Font.GothamBlack, { Brightness = 2 })
	signText(board, Enum.NormalId.Back, pitch.DisplayName .. "  ·  3v3", Color3.fromRGB(255, 255, 255), Enum.Font.GothamBlack, { Brightness = 2 })

	-- Spectator stands on the north side
	local stands = folder("Stands", model)
	for row = 0, 4 do
		part({
			Name = "Step",
			CFrame = CFrame.new(c.X, base + row * 1.4 + 0.7, nW - 6 - row * 3),
			Size = Vector3.new(L * 0.8, 1.4 + row * 2.8, 3),
			Color = if row % 2 == 0 then Color3.fromRGB(70, 74, 82) else Color3.fromRGB(84, 88, 96),
			Material = Enum.Material.Concrete,
			Parent = stands,
		})
	end

	-- Queue pad
	local padPos = c + pitch.QueuePad
	local pad = part({
		Name = "QueuePad",
		Shape = Enum.PartType.Cylinder,
		CFrame = CFrame.new(padPos.X, 0.25, padPos.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Size = Vector3.new(0.5, 14, 14),
		Color = COLORS.Volt,
		Material = Enum.Material.Neon,
		Transparency = 0.15,
		Parent = model,
	})
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "QueuePrompt"
	prompt.ActionText = "Join Queue"
	prompt.ObjectText = pitch.DisplayName .. " 3v3"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.R
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	prompt.Parent = pad

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "QueueBoard"
	billboard.Size = UDim2.fromOffset(260, 90)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 8, 0)
	billboard.AlwaysOnTop = false
	billboard.MaxDistance = 160
	billboard.Parent = pad
	local qLabel = Instance.new("TextLabel")
	qLabel.Name = "Label"
	qLabel.Size = UDim2.fromScale(1, 1)
	qLabel.BackgroundColor3 = Color3.fromRGB(14, 14, 18)
	qLabel.BackgroundTransparency = 0.2
	qLabel.TextColor3 = Color3.new(1, 1, 1)
	qLabel.Font = Enum.Font.GothamBold
	qLabel.TextScaled = true
	qLabel.Text = pitch.DisplayName .. "\nQUEUE 0/6"
	qLabel.Parent = billboard
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = qLabel

	model:SetAttribute("PitchId", pitch.Id)
	return model
end

-------------------------------------------------------------------------------
-- Hub dressing
-------------------------------------------------------------------------------
local GRAFFITI = {
	{ Text = "CONCRETE KINGS", Color = Color3.fromRGB(205, 255, 64), Stroke = Color3.fromRGB(20, 40, 10) },
	{ Text = "NO LIMITS", Color = Color3.fromRGB(255, 110, 54), Stroke = Color3.fromRGB(60, 10, 0) },
	{ Text = "PLAY. LOSE. RUN IT BACK.", Color = Color3.fromRGB(120, 220, 255), Stroke = Color3.fromRGB(10, 30, 60) },
	{ Text = "BALL DON'T LIE", Color = Color3.fromRGB(255, 120, 220), Stroke = Color3.fromRGB(60, 0, 40) },
	{ Text = "EST. ON THE BLOCK", Color = Color3.fromRGB(255, 220, 90), Stroke = Color3.fromRGB(60, 40, 0) },
}

local function building(parent, position: Vector3, size: Vector3, color: Color3, graffitiIndex: number?, facing: Vector3)
	local cf = CFrame.lookAt(position + Vector3.new(0, size.Y / 2, 0), position + Vector3.new(0, size.Y / 2, 0) + facing)
	local body = part({
		Name = "Building",
		CFrame = cf,
		Size = size,
		Color = color,
		Material = Enum.Material.Brick,
		Parent = parent,
	})
	part({
		Name = "Roofline",
		CFrame = cf * CFrame.new(0, size.Y / 2 + 0.5, 0),
		Size = Vector3.new(size.X + 1, 1, size.Z + 1),
		Color = Color3.fromRGB(40, 40, 44),
		Material = Enum.Material.Concrete,
		Parent = parent,
	})
	-- Window strips on the front face
	local floors = math.floor(size.Y / 9)
	for f = 1, floors do
		local wy = -size.Y / 2 + f * 9 - 2
		if wy < size.Y / 2 - 3 then
			part({
				Name = "Windows",
				CFrame = cf * CFrame.new(0, wy, -size.Z / 2 - 0.05),
				Size = Vector3.new(size.X * 0.8, 3, 0.2),
				Color = if (f + math.floor(position.X)) % 3 == 0 then Color3.fromRGB(255, 214, 140) else Color3.fromRGB(40, 60, 80),
				Material = if (f + math.floor(position.X)) % 3 == 0 then Enum.Material.Neon else Enum.Material.Glass,
				CanCollide = false,
				Parent = parent,
			})
		end
	end
	if graffitiIndex then
		local g = GRAFFITI[(graffitiIndex - 1) % #GRAFFITI + 1]
		local wall = part({
			Name = "GraffitiWall",
			CFrame = cf * CFrame.new(0, -size.Y / 2 + 5, -size.Z / 2 - 0.06),
			Size = Vector3.new(size.X * 0.9, 8, 0.1),
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
			Parent = parent,
		})
		signText(wall, Enum.NormalId.Front, g.Text, g.Color, Enum.Font.PermanentMarker, {
			Stroke = g.Stroke,
			LightInfluence = 0.6,
			Brightness = 1,
			Rotation = -3,
		})
	end
	return body
end

local function bench(parent, cf: CFrame)
	part({ Name = "BenchSeat", CFrame = cf * CFrame.new(0, 1.6, 0), Size = Vector3.new(8, 0.4, 2), Color = Color3.fromRGB(150, 90, 50), Material = Enum.Material.WoodPlanks, Parent = parent })
	part({ Name = "BenchBack", CFrame = cf * CFrame.new(0, 2.8, 0.9), Size = Vector3.new(8, 2, 0.3), Color = Color3.fromRGB(150, 90, 50), Material = Enum.Material.WoodPlanks, Parent = parent })
	for _, x in { -3.4, 3.4 } do
		part({ Name = "BenchLeg", CFrame = cf * CFrame.new(x, 0.7, 0), Size = Vector3.new(0.4, 1.4, 1.8), Color = COLORS.Fence, Material = Enum.Material.Metal, Parent = parent })
	end
	local seat = Instance.new("Seat")
	seat.Name = "Seat"
	seat.Anchored = true
	seat.Transparency = 1
	seat.Size = Vector3.new(7, 0.2, 1.6)
	seat.CFrame = cf * CFrame.new(0, 1.85, 0)
	seat.Parent = parent
end

local function streetLight(parent, position: Vector3)
	part({ Name = "LampPost", CFrame = CFrame.new(position + Vector3.new(0, 7, 0)), Size = Vector3.new(0.6, 14, 0.6), Color = COLORS.Fence, Material = Enum.Material.Metal, Parent = parent })
	local lamp = part({ Name = "Lamp", CFrame = CFrame.new(position + Vector3.new(0, 14.2, 0)), Size = Vector3.new(1.6, 0.8, 1.6), Color = Color3.fromRGB(255, 220, 160), Material = Enum.Material.Neon, Parent = parent })
	local light = Instance.new("PointLight")
	light.Range = 22
	light.Brightness = 1.4
	light.Color = Color3.fromRGB(255, 214, 160)
	light.Parent = lamp
end

local function buildLocker(parent)
	local pos = Config.Hub.Locker
	local model = folder("Locker", parent)
	local cf = CFrame.lookAt(pos, pos + Vector3.new(1, 0, 0))
	part({ Name = "Floor", CFrame = cf * CFrame.new(0, 0.1, 0), Size = Vector3.new(30, 0.2, 22), Color = Color3.fromRGB(30, 30, 34), Material = Enum.Material.Marble, Parent = model })
	part({ Name = "BackWall", CFrame = cf * CFrame.new(0, 8, 11), Size = Vector3.new(30, 16, 1), Color = Color3.fromRGB(26, 26, 30), Material = Enum.Material.Concrete, Parent = model })
	part({ Name = "SideWallL", CFrame = cf * CFrame.new(-15, 8, 0), Size = Vector3.new(1, 16, 22), Color = Color3.fromRGB(26, 26, 30), Material = Enum.Material.Concrete, Parent = model })
	part({ Name = "SideWallR", CFrame = cf * CFrame.new(15, 8, 0), Size = Vector3.new(1, 16, 22), Color = Color3.fromRGB(26, 26, 30), Material = Enum.Material.Concrete, Parent = model })
	part({ Name = "Roof", CFrame = cf * CFrame.new(0, 16.5, 0), Size = Vector3.new(32, 1, 24), Color = Color3.fromRGB(20, 20, 24), Material = Enum.Material.Concrete, Parent = model })
	local sign = part({ Name = "Sign", CFrame = cf * CFrame.new(0, 13.5, -11.2), Size = Vector3.new(24, 4, 0.4), Color = Color3.fromRGB(12, 12, 14), Parent = model })
	signText(sign, Enum.NormalId.Front, "THE LOCKER", Config.Teams.A.Color, Enum.Font.GothamBlack, { Brightness = 3 })
	part({ Name = "NeonStrip", CFrame = cf * CFrame.new(0, 11.2, -11.2), Size = Vector3.new(30, 0.3, 0.3), Color = Config.Teams.A.Color, Material = Enum.Material.Neon, Parent = model })
	-- Mannequin plinths
	for _, x in { -9, 0, 9 } do
		part({ Name = "Plinth", CFrame = cf * CFrame.new(x, 1, 6), Size = Vector3.new(4, 2, 4), Color = Color3.fromRGB(240, 240, 240), Material = Enum.Material.Marble, Parent = model })
	end
	local counter = part({ Name = "Counter", CFrame = cf * CFrame.new(0, 2, -2), Size = Vector3.new(10, 4, 3), Color = Color3.fromRGB(230, 230, 230), Material = Enum.Material.Marble, Parent = model })
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Open Locker"
	prompt.ObjectText = "Customize your player"
	prompt.HoldDuration = 0
	prompt.KeyboardKeyCode = Enum.KeyCode.R
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("OpensUI", "Locker")
	prompt.Parent = counter
	local light = Instance.new("PointLight")
	light.Range = 26
	light.Brightness = 2
	light.Parent = counter
	return model
end

local function buildPractice(parent)
	local pos = Config.Hub.PracticeArea
	local model = folder("Practice", parent)
	part({ Name = "Court", CFrame = CFrame.new(pos + Vector3.new(0, 0.1, 0)), Size = Vector3.new(44, 0.2, 44), Color = Color3.fromRGB(70, 90, 160), Material = Enum.Material.Slate, Parent = model })
	-- mini goal on the east edge
	local gx = pos.X + 20
	for _, z in { -6, 6 } do
		part({ Name = "Post", CFrame = CFrame.new(gx, 3, pos.Z + z), Size = Vector3.new(0.6, 6, 0.6), Color = Color3.new(1, 1, 1), Material = Enum.Material.Metal, Parent = model })
	end
	part({ Name = "Bar", CFrame = CFrame.new(gx, 6, pos.Z), Size = Vector3.new(0.6, 0.6, 12.6), Color = Color3.new(1, 1, 1), Material = Enum.Material.Metal, Parent = model })
	part({ Name = "Net", CFrame = CFrame.new(gx + 3, 3, pos.Z), Size = Vector3.new(0.2, 6, 12), Color = Color3.new(1, 1, 1), Material = Enum.Material.Fabric, Transparency = 0.55, Parent = model })
	-- low walls so practice balls do not roll away
	for _, spec in {
		{ CFrame.new(pos.X, 1.5, pos.Z - 22), Vector3.new(44, 3, 1) },
		{ CFrame.new(pos.X, 1.5, pos.Z + 22), Vector3.new(44, 3, 1) },
		{ CFrame.new(pos.X + 24, 1.5, pos.Z), Vector3.new(1, 3, 44) },
	} do
		part({ Name = "Wall", CFrame = spec[1], Size = spec[2], Color = Color3.fromRGB(230, 230, 235), Material = Enum.Material.Concrete, Parent = model })
	end
	local sign = part({ Name = "Sign", CFrame = CFrame.new(pos.X, 6, pos.Z - 22.6), Size = Vector3.new(20, 4, 0.4), Color = Color3.fromRGB(14, 14, 18), Parent = model })
	signText(sign, Enum.NormalId.Back, "PRACTICE COURT", Color3.fromRGB(120, 220, 255), Enum.Font.GothamBlack, { Brightness = 2 })
	signText(sign, Enum.NormalId.Front, "PRACTICE COURT", Color3.fromRGB(120, 220, 255), Enum.Font.GothamBlack, { Brightness = 2 })
	return model
end

local function buildAreaGate(parent, gate)
	local model = folder("Gate_" .. gate.Area, parent)
	local pos = gate.Position
	local facing = (Vector3.new(0, pos.Y, 0) - pos).Unit
	local cf = CFrame.lookAt(pos, pos + facing)
	part({ Name = "PillarL", CFrame = cf * CFrame.new(-11, 9, 0), Size = Vector3.new(3, 18, 3), Color = Color3.fromRGB(60, 60, 66), Material = Enum.Material.Concrete, Parent = model })
	part({ Name = "PillarR", CFrame = cf * CFrame.new(11, 9, 0), Size = Vector3.new(3, 18, 3), Color = Color3.fromRGB(60, 60, 66), Material = Enum.Material.Concrete, Parent = model })
	local shutter = part({ Name = "Shutter", CFrame = cf * CFrame.new(0, 7, 0), Size = Vector3.new(19, 14, 0.6), Color = Color3.fromRGB(110, 112, 118), Material = Enum.Material.CorrodedMetal, Parent = model })
	local header = part({ Name = "Header", CFrame = cf * CFrame.new(0, 16, -0.4), Size = Vector3.new(25, 4, 1), Color = Color3.fromRGB(14, 14, 18), Parent = model })
	signText(header, Enum.NormalId.Front, gate.Name, Color3.fromRGB(255, 255, 255), Enum.Font.GothamBlack, { Brightness = 2 })
	signText(shutter, Enum.NormalId.Front, "LOCKED\nReputation: " .. gate.RequiredTier .. "\nComing soon", Color3.fromRGB(255, 220, 90), Enum.Font.GothamBold, { LightInfluence = 0.5 })
	return model
end

local function buildHub(parent)
	local hub = folder("Hub", parent)

	-- Ground plaza
	part({ Name = "Asphalt", CFrame = CFrame.new(0, -0.5, 0), Size = Vector3.new(420, 1, 340), Color = COLORS.Asphalt, Material = Enum.Material.Asphalt, Parent = hub })
	-- Walkway from spawn to pitch
	part({ Name = "Walkway", CFrame = CFrame.new(0, 0.05, 72), Size = Vector3.new(24, 0.1, 44), Color = COLORS.Concrete, Material = Enum.Material.Pavement, Parent = hub })

	-- Spawn
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "GroundsSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 0.4, 12)
	spawn.CFrame = CFrame.new(Config.Hub.Spawn) * CFrame.Angles(0, 0, 0)
	spawn.Color = Config.Teams.A.Color
	spawn.Material = Enum.Material.Neon
	spawn.Transparency = 0.4
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = hub

	-- Buildings around the edge, facing inwards
	local buildings = folder("Buildings", hub)
	local palette = {
		Color3.fromRGB(150, 70, 56),
		Color3.fromRGB(110, 100, 92),
		Color3.fromRGB(70, 82, 100),
		Color3.fromRGB(160, 120, 80),
		Color3.fromRGB(90, 60, 70),
	}
	local idx = 0
	for x = -180, 180, 45 do
		idx += 1
		local h = 30 + (idx * 13) % 28
		building(buildings, Vector3.new(x, 0, -150), Vector3.new(40, h, 18), palette[idx % #palette + 1], if idx % 2 == 0 then idx else nil, Vector3.new(0, 0, 1))
		building(buildings, Vector3.new(x, 0, 150), Vector3.new(40, h + 6, 18), palette[(idx + 2) % #palette + 1], if idx % 2 == 1 then idx else nil, Vector3.new(0, 0, -1))
	end
	for z = -110, 110, 55 do
		idx += 1
		local h = 28 + (idx * 7) % 24
		building(buildings, Vector3.new(-195, 0, z), Vector3.new(50, h, 16), palette[idx % #palette + 1], if idx % 3 == 0 then idx else nil, Vector3.new(1, 0, 0))
		building(buildings, Vector3.new(195, 0, z), Vector3.new(50, h, 16), palette[(idx + 1) % #palette + 1], if idx % 3 == 1 then idx else nil, Vector3.new(-1, 0, 0))
	end

	-- Street furniture
	local furniture = folder("Furniture", hub)
	for _, x in { -40, -20, 20, 40 } do
		bench(furniture, CFrame.lookAt(Vector3.new(x, 0, 48), Vector3.new(x, 0, 30)))
	end
	for _, x in { -25, 25 } do
		bench(furniture, CFrame.lookAt(Vector3.new(x, 0, 96), Vector3.new(0, 0, 96)))
	end
	for x = -150, 150, 50 do
		streetLight(furniture, Vector3.new(x, 0, 120))
		streetLight(furniture, Vector3.new(x, 0, -118))
	end
	for z = -80, 80, 40 do
		streetLight(furniture, Vector3.new(-165, 0, z))
		streetLight(furniture, Vector3.new(165, 0, z))
	end
	-- Cones and bins for life
	for i = 1, 10 do
		local a = i * 0.7
		part({
			Name = "Cone",
			CFrame = CFrame.new(Config.Hub.PracticeArea + Vector3.new(math.cos(a) * 12, 0.8, math.sin(a) * 12)),
			Size = Vector3.new(1, 1.6, 1),
			Color = Color3.fromRGB(255, 120, 30),
			Material = Enum.Material.Plastic,
			Parent = furniture,
		})
	end

	-- Physical leaderboard board (filled by LeaderboardService)
	part({
		Name = "Leaderboard",
		CFrame = CFrame.lookAt(Vector3.new(-56, 9, 60), Vector3.new(0, 9, 90)),
		Size = Vector3.new(18, 14, 1),
		Color = Color3.fromRGB(14, 14, 18),
		Parent = hub,
	})
	part({ Name = "LeaderboardLeg", CFrame = CFrame.new(-56, 1, 60), Size = Vector3.new(2, 2, 2), Color = COLORS.Fence, Parent = hub })

	buildLocker(hub)
	buildPractice(hub)
	for _, gate in Config.Hub.AreaGates do
		buildAreaGate(hub, gate)
	end

	return hub
end

function MapBuilder.Init()
	local existing = Workspace:FindFirstChild("Grounds")
	if existing then
		existing:Destroy()
	end
	-- Remove the default baseplate/spawn from a blank place
	for _, name in { "Baseplate", "SpawnLocation" } do
		local d = Workspace:FindFirstChild(name)
		if d then
			d:Destroy()
		end
	end

	root = folder("Grounds", Workspace)
	buildLighting()
	local pitches = folder("Pitches", root)
	for _, pitch in Config.Pitches do
		buildPitch(pitches, pitch)
	end
	buildHub(root)
	folder("Balls", root)
	folder("NPCs", root)
end

function MapBuilder.Start() end

function MapBuilder.GetRoot(): Folder
	return root
end

function MapBuilder.GetPitchModel(pitchId: string): Instance?
	return root and root.Pitches:FindFirstChild(pitchId)
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">MatchService</string>
            <string name="Source"><![CDATA[--[[
	MatchService
	Runs small-sided matches on each pitch.

	Flow (one coroutine per match):
	  MatchFound (rosters shown) -> Kickoff countdown -> Playing
	    -> Goal (celebration) -> Kickoff -> Playing ... -> Ended (results, rewards)
	    -> players returned to the Grounds -> Idle

	Replication: ReplicatedStorage.Matches.<PitchId> (a Configuration) carries
	attributes every client can read: State, ScoreA, ScoreB, EndsAt, TimeLeft,
	QueueCount, QueueNeeded. Players in a match get attributes MatchId, Team
	and AttackDir. One-off moments (match found, goal, results) go through the
	MatchEvent remote.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local Actors = require(script.Parent.Actors)
local BallService = require(script.Parent.BallService)
local BotService = require(script.Parent.BotService)
local InventoryService = require(script.Parent.InventoryService)
local ProgressionService = require(script.Parent.ProgressionService)

local MatchService = {}

local PASS_KINDS = { Pass = true, Through = true, Lob = true }

local matches: { [string]: any } = {}
local matchEvent

local Match = {}
Match.__index = Match

local function otherTeam(team: string): string
	return if team == "A" then "B" else "A"
end

local function newStatLine()
	return { Goals = 0, Assists = 0, Passes = 0, Tackles = 0, SkillMoves = 0, Shots = 0 }
end

function Match.new(pitch)
	local self = setmetatable({}, Match)
	self.Pitch = pitch
	self.Id = pitch.Id
	self.State = "Idle"
	self.Teams = { A = {}, B = {} }
	self.TeamOf = {} -- actor -> "A"/"B"
	self.Stats = {} -- actor -> stat line
	self.Score = { A = 0, B = 0 }
	self.TimeLeft = Config.Match.DurationSeconds
	self.Ball = nil
	self.GoalConnection = nil
	self.PendingGoal = nil
	self.Aborted = false

	local folder = ReplicatedStorage:FindFirstChild("Matches")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Matches"
		folder.Parent = ReplicatedStorage
	end
	local state = Instance.new("Configuration")
	state.Name = pitch.Id
	state.Parent = folder
	self.StateObject = state
	state:SetAttribute("PitchName", pitch.DisplayName)
	state:SetAttribute("TeamSize", Config.Match.TeamSize)
	state:SetAttribute("CenterX", pitch.Center.X)
	state:SetAttribute("CenterZ", pitch.Center.Z)
	self:SetState("Idle")
	self:PublishScore()
	return self
end

function Match:SetState(state: string)
	self.State = state
	self.StateObject:SetAttribute("State", state)
end

function Match:PublishScore()
	self.StateObject:SetAttribute("ScoreA", self.Score.A)
	self.StateObject:SetAttribute("ScoreB", self.Score.B)
end

function Match:PublishTimer(running: boolean)
	self.StateObject:SetAttribute("TimeLeft", math.max(0, self.TimeLeft))
	self.StateObject:SetAttribute("EndsAt", if running then Workspace:GetServerTimeNow() + self.TimeLeft else 0)
end

function Match:IsBusy(): boolean
	return self.State ~= "Idle"
end

function Match:GetAllActors()
	local list = {}
	for _, team in { "A", "B" } do
		for _, actor in self.Teams[team] do
			table.insert(list, actor)
		end
	end
	return list
end

function Match:GetHumans()
	local list = {}
	for _, actor in self:GetAllActors() do
		if not Actors.IsBot(actor) then
			table.insert(list, actor)
		end
	end
	return list
end

function Match:GetTeam(actor): string?
	return self.TeamOf[actor]
end

function Match:GetMates(actor)
	local team = self.TeamOf[actor]
	return if team then self.Teams[team] else {}
end

-- Goal that `team` attacks. Team A attacks +X.
function Match:GetAttackGoal(team: string): Vector3
	local p = self.Pitch
	local dir = if team == "A" then 1 else -1
	return Vector3.new(p.Center.X + dir * p.Length / 2, p.SurfaceY + p.GoalHeight / 2, p.Center.Z)
end

function Match:FireToHumans(kind: string, payload)
	for _, player in self:GetHumans() do
		matchEvent:FireClient(player, kind, payload)
	end
end

-- Broadcast to everyone (spectators get goal banners etc.)
function Match:FireAll(kind: string, payload)
	payload.PitchId = self.Id
	matchEvent:FireAllClients(kind, payload)
end

-------------------------------------------------------------------------------
-- Positions
-------------------------------------------------------------------------------
local FORMATIONS = {
	[1] = { Vector3.new(-10, 0, 0) },
	[2] = { Vector3.new(-8, 0, -6), Vector3.new(-24, 0, 8) },
	[3] = { Vector3.new(-7, 0, 0), Vector3.new(-24, 0, -14), Vector3.new(-24, 0, 14) },
	[4] = { Vector3.new(-7, 0, -6), Vector3.new(-7, 0, 6), Vector3.new(-26, 0, -14), Vector3.new(-26, 0, 14) },
	[5] = { Vector3.new(-7, 0, 0), Vector3.new(-18, 0, -16), Vector3.new(-18, 0, 16), Vector3.new(-32, 0, -8), Vector3.new(-32, 0, 8) },
}

function Match:GetSpawnCFrame(team: string, index: number, kickoffTeam: string?): CFrame
	local p = self.Pitch
	local count = math.max(#self.Teams[team], 1)
	local formation = FORMATIONS[math.min(count, 5)]
	local offset = formation[((index - 1) % #formation) + 1]
	if kickoffTeam == team and index == 1 then
		offset = Vector3.new(-2.5, 0, 0) -- take the kickoff
	end
	local dir = if team == "A" then 1 else -1
	local pos = Vector3.new(p.Center.X + offset.X * dir, p.SurfaceY + 3.2, p.Center.Z + offset.Z * dir)
	return CFrame.lookAt(pos, pos + Vector3.new(dir, 0, 0))
end

local function setAnchored(actor, anchored: boolean)
	local root = Actors.GetRoot(actor)
	if root then
		root.Anchored = anchored
	end
end

function Match:PlaceActors(kickoffTeam: string?, anchored: boolean)
	for _, team in { "A", "B" } do
		for i, actor in self.Teams[team] do
			local character = Actors.GetCharacter(actor)
			if character then
				local root = Actors.GetRoot(actor)
				if root then
					root.AssemblyLinearVelocity = Vector3.zero
				end
				character:PivotTo(self:GetSpawnCFrame(team, i, kickoffTeam))
				setAnchored(actor, anchored)
				if Actors.IsBot(actor) then
					local humanoid = Actors.GetHumanoid(actor)
					if humanoid and root then
						humanoid:MoveTo(root.Position)
					end
				end
			end
		end
	end
end

function Match:SetAllAnchored(anchored: boolean)
	for _, actor in self:GetAllActors() do
		setAnchored(actor, anchored)
	end
end

-------------------------------------------------------------------------------
-- Ball and goal detection
-------------------------------------------------------------------------------
function Match:CreateBall()
	local p = self.Pitch
	local spawnPos = Vector3.new(p.Center.X, p.SurfaceY + Config.Ball.Size / 2 + 0.1, p.Center.Z)
	self.Ball = BallService.CreateBall({
		SpawnPosition = spawnPos,
		SurfaceY = p.SurfaceY,
		Bounds = {
			Center = p.Center,
			HalfSize = Vector3.new(p.Length / 2 + p.GoalDepth + 6, p.ColliderHeight + 10, p.Width / 2 + 6),
		},
		Handlers = {
			GetActors = function()
				if self.State == "Playing" then
					return self:GetAllActors()
				end
				return {}
			end,
			GetMates = function(actor)
				return self:GetMates(actor)
			end,
			GetAttackGoal = function(actor)
				local team = self.TeamOf[actor]
				if not team then
					return nil, nil
				end
				return self:GetAttackGoal(team), p.GoalWidth
			end,
			OnPossession = function(_, actor, previous)
				if previous and PASS_KINDS[previous.Kind] and previous.Actor ~= actor
					and self.TeamOf[previous.Actor] == self.TeamOf[actor] and self.Stats[previous.Actor] then
					self.Stats[previous.Actor].Passes += 1
				end
			end,
			OnKick = function(_, actor, kind)
				if kind == "Shot" and self.Stats[actor] then
					self.Stats[actor].Shots += 1
				end
			end,
			OnTackle = function(_, tackler, _victim, success)
				if success and self.Stats[tackler] then
					self.Stats[tackler].Tackles += 1
				end
			end,
			OnSkillMove = function(_, actor)
				if self.Stats[actor] then
					self.Stats[actor].SkillMoves += 1
				end
			end,
			OnOutOfBounds = function(ball)
				-- Should not happen inside the cage, but never lose the ball.
				BallService.Reset(ball, spawnPos)
			end,
		},
	})
	self.SpawnPosition = spawnPos
end

-- Returns "A"/"B" for the team that scored, or nil.
function Match:CheckGoal(): string?
	local p = self.Pitch
	local pos = self.Ball.Part.Position
	local r = Config.Ball.Size / 2
	local rel = pos - p.Center
	if math.abs(rel.Z) > p.GoalWidth / 2 or pos.Y > p.SurfaceY + p.GoalHeight then
		return nil
	end
	local line = p.Length / 2 + r
	if rel.X > line then
		return "A" -- in the +X goal that B defends
	elseif rel.X < -line then
		return "B"
	end
	return nil
end

function Match:ResolveGoalCredit(scoringTeam: string)
	local touches = self.Ball.Touches
	local last = touches[#touches]
	local scorer = last and last.Actor
	if not scorer or self.TeamOf[scorer] ~= scoringTeam then
		return nil, nil, true -- own goal (or no touch)
	end
	local i = #touches
	while i >= 1 and touches[i].Actor == scorer do
		i -= 1
	end
	local prev = touches[i]
	local assister = nil
	if prev and PASS_KINDS[prev.Kind] and self.TeamOf[prev.Actor] == scoringTeam and os.clock() - prev.Time < 15 then
		assister = prev.Actor
	end
	return scorer, assister, false
end

-------------------------------------------------------------------------------
-- Roster management
-------------------------------------------------------------------------------
function Match:AddActor(actor, team: string)
	table.insert(self.Teams[team], actor)
	self.TeamOf[actor] = team
	self.Stats[actor] = self.Stats[actor] or newStatLine()
	if Actors.IsBot(actor) then
		BotService.AssignMatch(actor, self, team)
	else
		local player = actor :: Player
		player:SetAttribute("MatchId", self.Id)
		player:SetAttribute("Team", team)
		player:SetAttribute("AttackDir", if team == "A" then 1 else -1)
		InventoryService.SetTeamColor(player, Config.Teams[team].Color)
	end
end

local function clearPlayerMatchAttributes(player: Player)
	player:SetAttribute("MatchId", nil)
	player:SetAttribute("Team", nil)
	player:SetAttribute("AttackDir", nil)
	player:SetAttribute("HasBall", false)
end

local function returnToGrounds(player: Player)
	clearPlayerMatchAttributes(player)
	BallService.ReleaseActor(player)
	InventoryService.SetTeamColor(player, nil)
	local character = player.Character
	if character then
		local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			root.Anchored = false
		end
		local offset = Vector3.new(math.random(-8, 8), 3, math.random(-6, 6))
		character:PivotTo(CFrame.new(Config.Hub.Spawn + offset))
	end
end

-- A player left or disconnected mid-match.
function Match:RemoveActor(actor)
	local team = self.TeamOf[actor]
	if not team then
		return
	end
	local idx = table.find(self.Teams[team], actor)
	if idx then
		table.remove(self.Teams[team], idx)
	end
	self.TeamOf[actor] = nil
	BallService.ReleaseActor(actor)
	if not Actors.IsBot(actor) and (actor :: Player).Parent then
		returnToGrounds(actor)
	end

	if #self:GetHumans() == 0 then
		self.Aborted = true
		return
	end
	if Config.Match.FillWithBots and self.State ~= "Ended" then
		local bot = BotService.CreateBot(team)
		self:AddActor(bot, team)
		if self.Ball then
			bot.Model:PivotTo(self:GetSpawnCFrame(team, #self.Teams[team], nil))
			setAnchored(bot, self.State == "Kickoff")
		end
	end
end

-------------------------------------------------------------------------------
-- Match flow
-------------------------------------------------------------------------------
local function waitOrAbort(self, seconds: number): boolean
	local deadline = os.clock() + seconds
	while os.clock() < deadline do
		if self.Aborted then
			return false
		end
		task.wait(0.1)
	end
	return not self.Aborted
end

function Match:Kickoff(kickoffTeam: string?)
	BallService.Reset(self.Ball, self.SpawnPosition)
	BallService.SetFrozen(self.Ball, true)
	self:PlaceActors(kickoffTeam, true)
	self:SetState("Kickoff")
	self:PublishTimer(false)
	local countdown = Config.Match.KickoffCountdown
	self.StateObject:SetAttribute("CountdownEnds", Workspace:GetServerTimeNow() + countdown)
	self:FireAll("Countdown", { Seconds = countdown })
	if not waitOrAbort(self, countdown) then
		return false
	end
	self:SetAllAnchored(false)
	BallService.SetFrozen(self.Ball, false)
	self:SetState("Playing")
	self:PublishTimer(true)
	return true
end

function Match:PlayUntilStop(): string
	-- Returns "Goal", "Time", "Abort"
	local result = nil
	local last = os.clock()
	self.GoalConnection = RunService.Heartbeat:Connect(function()
		if result or self.State ~= "Playing" then
			return
		end
		local now = os.clock()
		self.TimeLeft -= now - last
		last = now
		if self.Aborted then
			result = "Abort"
			return
		end
		local scoringTeam = self:CheckGoal()
		if scoringTeam then
			self.PendingGoal = scoringTeam
			result = "Goal"
		elseif self.TimeLeft <= 0 then
			result = "Time"
		end
	end)
	while not result do
		task.wait()
	end
	self.GoalConnection:Disconnect()
	self.GoalConnection = nil
	return result
end

function Match:HandleGoal()
	local team = self.PendingGoal
	self.PendingGoal = nil
	self.Score[team] += 1
	self:PublishScore()
	local scorer, assister, ownGoal = self:ResolveGoalCredit(team)
	if scorer and self.Stats[scorer] then
		self.Stats[scorer].Goals += 1
	end
	if assister and self.Stats[assister] then
		self.Stats[assister].Assists += 1
	end
	BallService.SetFrozen(self.Ball, true)
	self:SetState("Goal")
	self:PublishTimer(false)
	self:FireAll("Goal", {
		Team = team,
		Scorer = scorer and Actors.GetName(scorer) or nil,
		ScorerId = scorer and Actors.GetId(scorer) or nil,
		Assister = assister and Actors.GetName(assister) or nil,
		OwnGoal = ownGoal,
		ScoreA = self.Score.A,
		ScoreB = self.Score.B,
		BallPosition = self.Ball.Part.Position,
	})
	return waitOrAbort(self, Config.Match.GoalCelebrationSeconds)
end

function Match:BuildResults()
	local list = {}
	for _, actor in self:GetAllActors() do
		local s = self.Stats[actor] or newStatLine()
		table.insert(list, {
			Name = Actors.GetName(actor),
			Id = Actors.GetId(actor),
			Team = self.TeamOf[actor],
			IsBot = Actors.IsBot(actor),
			Goals = s.Goals,
			Assists = s.Assists,
			Passes = s.Passes,
			Tackles = s.Tackles,
			Shots = s.Shots,
			Rating = s.Goals * 3 + s.Assists * 2 + s.Tackles + s.Passes * 0.3 + s.Shots * 0.2,
		})
	end
	table.sort(list, function(a, b)
		return a.Rating > b.Rating
	end)
	return list
end

function Match:Finish(awardRewards: boolean)
	self:SetState("Ended")
	self:PublishTimer(false)
	if self.Ball then
		BallService.SetFrozen(self.Ball, true)
	end
	self:SetAllAnchored(false)

	local results = self:BuildResults()
	local winner = if self.Score.A > self.Score.B then "A" elseif self.Score.B > self.Score.A then "B" else nil
	for _, player in self:GetHumans() do
		local team = self.TeamOf[player]
		local outcome = if winner == nil then "Draw" elseif winner == team then "Win" else "Loss"
		local rewards = nil
		if awardRewards then
			rewards = ProgressionService.ApplyMatchResult(player, self.Stats[player] or newStatLine(), outcome)
		end
		matchEvent:FireClient(player, "Results", {
			PitchId = self.Id,
			Outcome = outcome,
			MyTeam = team,
			ScoreA = self.Score.A,
			ScoreB = self.Score.B,
			MyStats = self.Stats[player],
			Rewards = rewards,
			Players = results,
			Aborted = not awardRewards,
		})
	end
end

function Match:Cleanup()
	for _, actor in self:GetAllActors() do
		if Actors.IsBot(actor) then
			BotService.DestroyBot(actor)
		elseif (actor :: Player).Parent then
			returnToGrounds(actor)
		end
	end
	if self.Ball then
		BallService.DestroyBall(self.Ball)
		self.Ball = nil
	end
	self.Teams = { A = {}, B = {} }
	self.TeamOf = {}
	self.Stats = {}
	self.Score = { A = 0, B = 0 }
	self.TimeLeft = Config.Match.DurationSeconds
	self.Aborted = false
	self:PublishScore()
	self:PublishTimer(false)
	self:SetState("Idle")
end

function Match:Run()
	local rosters = { A = {}, B = {} }
	for _, team in { "A", "B" } do
		for _, actor in self.Teams[team] do
			table.insert(rosters[team], { Name = Actors.GetName(actor), Id = Actors.GetId(actor), IsBot = Actors.IsBot(actor) })
		end
	end
	self:SetState("MatchFound")
	self:FireToHumans("MatchFound", { PitchId = self.Id, PitchName = self.Pitch.DisplayName, Teams = rosters })

	local completed = false
	if waitOrAbort(self, Config.Match.MatchFoundSeconds) then
		self:CreateBall()
		local kickoffTeam = if math.random() < 0.5 then "A" else "B"
		local running = self:Kickoff(kickoffTeam)
		while running do
			local stop = self:PlayUntilStop()
			if stop == "Goal" then
				local scored = self.PendingGoal
				if not self:HandleGoal() then
					break
				end
				if math.abs(self.Score.A - self.Score.B) >= Config.Match.MercyGoalDifference then
					completed = true
					break
				end
				running = self:Kickoff(otherTeam(scored))
			elseif stop == "Time" then
				completed = true
				break
			else
				break
			end
		end
	end

	self:Finish(completed)
	-- Give players a moment to see the final whistle, then send them back.
	task.wait(3)
	self:Cleanup()
end

-------------------------------------------------------------------------------
-- Public API
-------------------------------------------------------------------------------
function MatchService.GetMatch(pitchId: string)
	return matches[pitchId]
end

function MatchService.GetMatches()
	return matches
end

function MatchService.GetMatchForActor(actor)
	for _, match in matches do
		if match.TeamOf[actor] then
			return match
		end
	end
	return nil
end

-- teams = { A = { actors }, B = { actors } }; humans only, bots are added here.
function MatchService.StartMatch(pitchId: string, teams)
	local match = matches[pitchId]
	assert(match and not match:IsBusy(), "Pitch is busy")
	for _, team in { "A", "B" } do
		for _, actor in teams[team] do
			match:AddActor(actor, team)
		end
		if Config.Match.FillWithBots then
			while #match.Teams[team] < Config.Match.TeamSize do
				match:AddActor(BotService.CreateBot(team), team)
			end
		end
	end
	match.TimeLeft = Config.Match.DurationSeconds
	task.spawn(function()
		local ok, err = pcall(match.Run, match)
		if not ok then
			warn("[MatchService] match crashed: " .. tostring(err))
			pcall(match.Cleanup, match)
		end
	end)
	return match
end

function MatchService.Init()
	matchEvent = Remotes.Get("MatchEvent")
	for _, pitch in Config.Pitches do
		matches[pitch.Id] = Match.new(pitch)
	end
end

function MatchService.Start()
	Players.PlayerRemoving:Connect(function(player)
		local match = MatchService.GetMatchForActor(player)
		if match then
			match:RemoveActor(player)
		end
	end)

	-- Respawned mid-match: put the player back on the pitch in their team kit.
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			local match = MatchService.GetMatchForActor(player)
			if not match then
				-- Safety net: never leave a non-match player stuck on the cage roof
				-- (e.g. if they spawned before the map finished building).
				task.wait(0.5)
				local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if root and root.Position.Y > 30 and not player:GetAttribute("MatchId") then
					character:PivotTo(CFrame.new(Config.Hub.Spawn + Vector3.new(0, 3, 0)))
				end
				return
			end
			task.wait(0.2)
			local team = match.TeamOf[player]
			if team and character.Parent then
				local index = table.find(match.Teams[team], player) or 1
				character:PivotTo(match:GetSpawnCFrame(team, index, nil))
				InventoryService.SetTeamColor(player, Config.Teams[team].Color)
				if match.State == "Kickoff" then
					setAnchored(player, true)
				end
			end
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in Players:GetPlayers() do
		onPlayer(p)
	end
end

return MatchService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">MatchmakingService</string>
            <string name="Source"><![CDATA[--[[
	MatchmakingService
	One queue per pitch. Players join from the queue pad (ProximityPrompt) or the
	PLAY button. Once a second it checks every idle pitch:
	  * enough humans for a full game -> start immediately
	  * fewer humans, but the oldest has waited Config.Match.BotFillDelay -> start
	    and fill the empty slots with bots
	Teams are balanced with a snake draft on skill rating.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Progression = require(Shared.Progression)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local MapBuilder = require(script.Parent.MapBuilder)
local MatchService = require(script.Parent.MatchService)

local MatchmakingService = {}

local queues: { [string]: { { Player: Player, JoinedAt: number } } } = {}
local notifyRemote

local function findEntry(queue, player: Player): number?
	for i, entry in queue do
		if entry.Player == player then
			return i
		end
	end
	return nil
end

local function publish(pitchId: string)
	local queue = queues[pitchId]
	local match = MatchService.GetMatch(pitchId)
	local needed = Config.Match.TeamSize * 2
	if match then
		match.StateObject:SetAttribute("QueueCount", #queue)
		match.StateObject:SetAttribute("QueueNeeded", needed)
		local oldest = queue[1]
		match.StateObject:SetAttribute("BotFillAt", if oldest and Config.Match.FillWithBots then oldest.JoinedAt + Config.Match.BotFillDelay else 0)
	end
	local model = MapBuilder.GetPitchModel(pitchId)
	local pad = model and model:FindFirstChild("QueuePad")
	local label = pad and pad:FindFirstChild("QueueBoard") and pad.QueueBoard:FindFirstChild("Label")
	if label then
		local stateText = if match and match:IsBusy() then "MATCH IN PROGRESS" else "WAITING FOR PLAYERS"
		label.Text = string.format("%s · %dv%d\nQUEUE %d/%d\n%s", match and match.Pitch.DisplayName or pitchId, Config.Match.TeamSize, Config.Match.TeamSize, #queue, needed, stateText)
	end
end

function MatchmakingService.GetQueuedPitch(player: Player): string?
	for pitchId, queue in queues do
		if findEntry(queue, player) then
			return pitchId
		end
	end
	return nil
end

function MatchmakingService.Leave(player: Player)
	for pitchId, queue in queues do
		local idx = findEntry(queue, player)
		if idx then
			table.remove(queue, idx)
			player:SetAttribute("QueuedPitch", nil)
			publish(pitchId)
		end
	end
end

function MatchmakingService.Join(player: Player, pitchId: string?): (boolean, string)
	pitchId = pitchId or Config.Pitches[1].Id
	local queue = queues[pitchId :: string]
	if not queue then
		return false, "Unknown pitch"
	end
	if player:GetAttribute("MatchId") then
		return false, "You are already in a match"
	end
	if not DataService.GetProfile(player) then
		return false, "Still loading your profile"
	end
	if findEntry(queue, player) then
		return true, "Already queued"
	end
	MatchmakingService.Leave(player)
	table.insert(queue, { Player = player, JoinedAt = os.time() })
	player:SetAttribute("QueuedPitch", pitchId)
	publish(pitchId :: string)
	return true, "Joined the queue"
end

-- Snake draft by skill so both teams end up with similar strength.
function MatchmakingService.BalanceTeams(players: { Player })
	local rated = {}
	for _, player in players do
		local profile = DataService.GetProfile(player)
		table.insert(rated, { Player = player, Rating = profile and Progression.SkillRating(profile) or 0 })
	end
	table.sort(rated, function(a, b)
		return a.Rating > b.Rating
	end)
	local teams = { A = {}, B = {} }
	local pattern = { "A", "B", "B", "A" }
	for i, entry in rated do
		local team = pattern[((i - 1) % 4) + 1]
		table.insert(teams[team], entry.Player)
	end
	-- With odd numbers keep team sizes within one of each other
	while #teams.A > #teams.B + 1 do
		table.insert(teams.B, table.remove(teams.A))
	end
	while #teams.B > #teams.A + 1 do
		table.insert(teams.A, table.remove(teams.B))
	end
	return teams
end

local function tryStart(pitchId: string)
	local match = MatchService.GetMatch(pitchId)
	local queue = queues[pitchId]
	if not match or match:IsBusy() then
		return
	end
	-- Drop anyone who left or is otherwise unavailable
	for i = #queue, 1, -1 do
		local p = queue[i].Player
		if not p.Parent or p:GetAttribute("MatchId") or not p.Character then
			table.remove(queue, i)
			if p.Parent then
				p:SetAttribute("QueuedPitch", nil)
			end
		end
	end

	local full = Config.Match.TeamSize * 2
	local ready = #queue >= full
	if not ready and Config.Match.FillWithBots and #queue >= Config.Match.MinHumansToStart then
		ready = os.time() - queue[1].JoinedAt >= Config.Match.BotFillDelay
	end
	if not ready then
		publish(pitchId)
		return
	end

	local chosen = {}
	for _ = 1, math.min(full, #queue) do
		local entry = table.remove(queue, 1)
		entry.Player:SetAttribute("QueuedPitch", nil)
		table.insert(chosen, entry.Player)
	end
	local teams = MatchmakingService.BalanceTeams(chosen)
	MatchService.StartMatch(pitchId, teams)
	publish(pitchId)
end

function MatchmakingService.Init()
	notifyRemote = Remotes.Get("Notify")
	for _, pitch in Config.Pitches do
		queues[pitch.Id] = {}
	end
end

function MatchmakingService.Start()
	Remotes.Get("RequestQueue").OnServerEvent:Connect(function(player, join)
		if join == true then
			local _, message = MatchmakingService.Join(player, nil)
			notifyRemote:FireClient(player, message, "info")
		else
			MatchmakingService.Leave(player)
			notifyRemote:FireClient(player, "Left the queue", "info")
		end
	end)

	-- Queue pads
	for _, pitch in Config.Pitches do
		local model = MapBuilder.GetPitchModel(pitch.Id)
		local prompt = model and model:FindFirstChild("QueuePad") and model.QueuePad:FindFirstChild("QueuePrompt")
		if prompt then
			prompt.Triggered:Connect(function(player)
				if MatchmakingService.GetQueuedPitch(player) == pitch.Id then
					MatchmakingService.Leave(player)
					notifyRemote:FireClient(player, "Left the queue", "info")
				else
					local _, message = MatchmakingService.Join(player, pitch.Id)
					notifyRemote:FireClient(player, message, "info")
				end
			end)
		end
		publish(pitch.Id)
	end

	Players.PlayerRemoving:Connect(MatchmakingService.Leave)

	task.spawn(function()
		while true do
			task.wait(1)
			for pitchId in queues do
				local ok, err = pcall(tryStart, pitchId)
				if not ok then
					warn("[Matchmaking] " .. tostring(err))
				end
			end
		end
	end)
end

return MatchmakingService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">NPCAnimator</string>
            <string name="Source"><![CDATA[--[[
	NPCAnimator
	Minimal server-side animator for bots and ambient NPCs (they have no Animate
	LocalScript). Uses Roblox's default R15 animation set and emote animations,
	so no custom assets are required.
]]

local NPCAnimator = {}

NPCAnimator.Ids = {
	Idle = "rbxassetid://507766388",
	Walk = "rbxassetid://913402848",
	Run = "rbxassetid://913376220",
	Wave = "rbxassetid://507770239",
	Point = "rbxassetid://507770453",
	Dance = "rbxassetid://507771019",
	Dance2 = "rbxassetid://507776043",
	Dance3 = "rbxassetid://507777268",
	Laugh = "rbxassetid://507770818",
	Cheer = "rbxassetid://507770677",
}

local animationCache: { [string]: Animation } = {}

local function getAnimation(name: string): Animation
	local anim = animationCache[name]
	if not anim then
		anim = Instance.new("Animation")
		anim.AnimationId = NPCAnimator.Ids[name]
		animationCache[name] = anim
	end
	return anim
end

-- Attaches locomotion animations. Returns a controller with :PlayEmote(name, looped).
function NPCAnimator.Attach(model: Model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil
	end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	local tracks = {}
	local function track(name: string, priority: Enum.AnimationPriority): AnimationTrack?
		if tracks[name] then
			return tracks[name]
		end
		local ok, t = pcall(function()
			return (animator :: Animator):LoadAnimation(getAnimation(name))
		end)
		if ok and t then
			t.Priority = priority
			tracks[name] = t
			return t
		end
		return nil
	end

	local current: string? = nil
	local emoteTrack: AnimationTrack? = nil

	local function setLocomotion(name: string)
		if current == name then
			return
		end
		if current and tracks[current] then
			tracks[current]:Stop(0.2)
		end
		current = name
		local t = track(name, Enum.AnimationPriority.Core)
		if t then
			t.Looped = true
			t:Play(0.2)
		end
	end

	setLocomotion("Idle")
	humanoid.Running:Connect(function(speed)
		if speed > 17.5 then
			setLocomotion("Run")
		elseif speed > 0.75 then
			setLocomotion("Walk")
		else
			setLocomotion("Idle")
		end
		if speed > 0.75 and emoteTrack then
			emoteTrack:Stop(0.2)
			emoteTrack = nil
		end
	end)

	local controller = {}
	function controller.PlayEmote(name: string, looped: boolean?)
		if emoteTrack then
			emoteTrack:Stop(0.2)
		end
		local t = track(name, Enum.AnimationPriority.Action)
		if t then
			t.Looped = looped == true
			t:Play(0.2)
			emoteTrack = t
		end
	end
	function controller.StopEmote()
		if emoteTrack then
			emoteTrack:Stop(0.2)
			emoteTrack = nil
		end
	end
	return controller
end

return NPCAnimator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">ProgressionService</string>
            <string name="Source"><![CDATA[--[[
	ProgressionService
	The only code allowed to change XP, level, Kicks (currency), reputation,
	attributes and lifetime stats. Also replicates the profile to its owner and
	keeps the Roblox player-list leaderstats in sync.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Progression = require(Shared.Progression)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)

local ProgressionService = {}

local pendingSync: { [Player]: boolean } = {}
local profileUpdated

local function updateLeaderstats(player: Player, profile)
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		stats = Instance.new("Folder")
		stats.Name = "leaderstats"
		stats.Parent = player
		for _, name in { "Level", "Wins", "Goals" } do
			local v = Instance.new("IntValue")
			v.Name = name
			v.Parent = stats
		end
	end
	stats.Level.Value = profile.Level
	stats.Wins.Value = profile.Stats.Wins
	stats.Goals.Value = profile.Stats.Goals

	-- Attributes other systems (and other clients) read cheaply
	local _, tierName = Progression.GetReputationTier(profile.Reputation)
	player:SetAttribute("Level", profile.Level)
	player:SetAttribute("Title", Progression.GetTitle(profile.Level))
	player:SetAttribute("RepTier", tierName)
end

-- Batches profile replication to once per frame per player.
function ProgressionService.Sync(player: Player)
	if pendingSync[player] then
		return
	end
	pendingSync[player] = true
	task.defer(function()
		pendingSync[player] = nil
		local profile = DataService.GetProfile(player)
		if profile and player.Parent then
			updateLeaderstats(player, profile)
			profileUpdated:FireClient(player, profile)
		end
	end)
end

local function notify(player: Player, text: string, kind: string?)
	Remotes.Get("Notify"):FireClient(player, text, kind or "info")
end

function ProgressionService.AddXP(player: Player, amount: number)
	local profile = DataService.GetProfile(player)
	if not profile or amount <= 0 then
		return
	end
	local oldTitle = Progression.GetTitle(profile.Level)
	local level, xp, gained = Progression.ApplyXP(profile.Level, profile.XP, math.floor(amount))
	profile.Level = level
	profile.XP = xp
	if gained > 0 then
		profile.AttributePoints += gained * Config.Attributes.PointsPerLevel
		profile.Kicks += gained * Config.Rewards.LevelUpKicks
		notify(player, string.format("LEVEL UP! You reached level %d", level), "levelup")
		local newTitle = Progression.GetTitle(level)
		if newTitle ~= oldTitle then
			notify(player, "New title unlocked: " .. newTitle, "levelup")
		end
	end
	DataService.MarkDirty(player)
	ProgressionService.Sync(player)
end

function ProgressionService.AddKicks(player: Player, amount: number)
	local profile = DataService.GetProfile(player)
	if not profile or amount <= 0 then
		return
	end
	profile.Kicks += math.floor(amount)
	DataService.MarkDirty(player)
	ProgressionService.Sync(player)
end

-- Returns true if the player could afford it (and the Kicks were removed).
function ProgressionService.SpendKicks(player: Player, amount: number): boolean
	local profile = DataService.GetProfile(player)
	if not profile or amount < 0 or profile.Kicks < amount then
		return false
	end
	profile.Kicks -= amount
	DataService.MarkDirty(player)
	ProgressionService.Sync(player)
	return true
end

function ProgressionService.AddReputation(player: Player, amount: number)
	local profile = DataService.GetProfile(player)
	if not profile or amount <= 0 then
		return
	end
	local oldIndex = Progression.GetReputationTier(profile.Reputation)
	profile.Reputation += math.floor(amount)
	local newIndex, newName = Progression.GetReputationTier(profile.Reputation)
	if newIndex > oldIndex then
		notify(player, "Reputation up! The Grounds now know you as: " .. newName, "levelup")
	end
	DataService.MarkDirty(player)
	ProgressionService.Sync(player)
end

-- statDeltas: { Goals = 1, ... } added to lifetime stats
function ProgressionService.AddStats(player: Player, statDeltas: { [string]: number })
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	for key, delta in statDeltas do
		if type(profile.Stats[key]) == "number" then
			profile.Stats[key] += delta
		end
	end
	DataService.MarkDirty(player)
	ProgressionService.Sync(player)
end

-- Applies the end of match result for one player and returns the reward summary.
function ProgressionService.ApplyMatchResult(player: Player, matchStats, result: string)
	local profile = DataService.GetProfile(player)
	if not profile then
		return nil
	end
	local before = { Level = profile.Level, XP = profile.XP, Reputation = profile.Reputation }
	local rewards = Progression.ComputeMatchRewards(matchStats, result)

	local s = profile.Stats
	s.Matches += 1
	s.Goals += matchStats.Goals or 0
	s.Assists += matchStats.Assists or 0
	s.Passes += matchStats.Passes or 0
	s.Tackles += matchStats.Tackles or 0
	s.SkillMoves += matchStats.SkillMoves or 0
	if result == "Win" then
		s.Wins += 1
		s.WinStreak += 1
		s.BestWinStreak = math.max(s.BestWinStreak, s.WinStreak)
	elseif result == "Draw" then
		s.Draws += 1
		s.WinStreak = 0
	else
		s.Losses += 1
		s.WinStreak = 0
	end

	ProgressionService.AddKicks(player, rewards.Kicks)
	ProgressionService.AddReputation(player, rewards.Reputation)
	ProgressionService.AddXP(player, rewards.XP)

	rewards.Before = before
	rewards.After = { Level = profile.Level, XP = profile.XP, Reputation = profile.Reputation }
	return rewards
end

function ProgressionService.GetAttribute(player: Player, name: string): number
	local profile = DataService.GetProfile(player)
	if profile and profile.Attributes[name] then
		return profile.Attributes[name]
	end
	return Config.Attributes.Start
end

local VALID_ATTRIBUTE = {}
for _, name in Config.Attributes.List do
	VALID_ATTRIBUTE[name] = true
end

function ProgressionService.Init()
	profileUpdated = Remotes.Get("ProfileUpdated")
end

function ProgressionService.Start()
	DataService.OnProfileLoaded(function(player)
		ProgressionService.Sync(player)
	end)

	Remotes.Get("GetProfile").OnServerInvoke = function(player)
		return DataService.WaitForProfile(player, 20)
	end

	Remotes.Get("SpendAttribute").OnServerInvoke = function(player, name)
		if type(name) ~= "string" or not VALID_ATTRIBUTE[name] then
			return false, "Unknown attribute"
		end
		local profile = DataService.GetProfile(player)
		if not profile then
			return false, "Profile not loaded"
		end
		if profile.AttributePoints <= 0 then
			return false, "No attribute points. Level up to earn more!"
		end
		if profile.Attributes[name] >= Config.Attributes.Max then
			return false, "Already maxed"
		end
		profile.AttributePoints -= 1
		profile.Attributes[name] += 1
		DataService.MarkDirty(player)
		ProgressionService.Sync(player)
		return true, name .. " +1"
	end

	Remotes.Get("UpdateSettings").OnServerEvent:Connect(function(player, settings)
		local profile = DataService.GetProfile(player)
		if not profile or type(settings) ~= "table" then
			return
		end
		local sens = settings.CameraSensitivity
		if type(sens) == "number" and sens == sens then
			profile.Settings.CameraSensitivity = math.clamp(sens, 0.2, 3)
		end
		if settings.CameraMode == "Follow" or settings.CameraMode == "Broadcast" then
			profile.Settings.CameraMode = settings.CameraMode
		end
		if type(settings.ShowControls) == "boolean" then
			profile.Settings.ShowControls = settings.ShowControls
		end
		DataService.MarkDirty(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		pendingSync[player] = nil
	end)
end

return ProgressionService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="26">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">60</float>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="27">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source"><![CDATA[--[[
	ClientState
	Local cache of the player's profile (read-only copy sent by the server) and
	shared UI flags. Controllers listen to ClientState.Changed.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local ClientState = {}

ClientState.Profile = nil
ClientState.MenuOpen = false -- any full-screen panel open (unlocks the mouse)
ClientState.Stamina = 100
ClientState.Charge = 0 -- shot charge 0..1, -1 when not charging

local changed = Instance.new("BindableEvent")
ClientState.Changed = changed.Event

function ClientState.SetProfile(profile)
	if type(profile) ~= "table" then
		return
	end
	ClientState.Profile = profile
	changed:Fire(profile)
end

function ClientState.Init()
	Remotes.Get("ProfileUpdated").OnClientEvent:Connect(ClientState.SetProfile)
	task.spawn(function()
		local ok, profile = pcall(function()
			return Remotes.Get("GetProfile"):InvokeServer()
		end)
		if ok and profile and not ClientState.Profile then
			ClientState.SetProfile(profile)
		end
	end)
end

function ClientState.GetAttribute(name: string): number
	local p = ClientState.Profile
	return (p and p.Attributes and p.Attributes[name]) or 50
end

return ClientState
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="30">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="31">
            <Properties>
              <string name="Name">BallController</string>
              <string name="Source"><![CDATA[--[[
	BallController (client)
	When the server hands us network ownership of a ball (we have possession),
	we steer it in front of our feet every physics step so dribbling feels
	instant. The server still validates distance and decides every kick.

	Also exposes helpers the InputController uses: GetMyBall / GetNearestBall.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local BallController = {}

local player = Players.LocalPlayer
local ballsFolder: Instance? = nil
local dribbleConnection: RBXScriptConnection? = nil
local myBall: BasePart? = nil

local function getRoot(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function getHumanoid(): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function getBalls(): { BasePart }
	if not ballsFolder then
		local grounds = Workspace:FindFirstChild("Grounds")
		ballsFolder = grounds and grounds:FindFirstChild("Balls")
	end
	if not ballsFolder then
		return {}
	end
	local list = {}
	for _, child in (ballsFolder :: Instance):GetChildren() do
		if child:IsA("BasePart") then
			table.insert(list, child)
		end
	end
	return list
end

function BallController.GetMyBall(): BasePart?
	for _, ball in getBalls() do
		if ball:GetAttribute("PossessorId") == player.UserId then
			return ball
		end
	end
	return nil
end

function BallController.GetNearestBall(maxDistance: number): BasePart?
	local root = getRoot()
	if not root then
		return nil
	end
	local best, bestDist = nil, maxDistance
	for _, ball in getBalls() do
		local d = (ball.Position - root.Position).Magnitude
		if d <= bestDist then
			best, bestDist = ball, d
		end
	end
	return best
end

local function dribbleStep(_dt: number)
	local ball = myBall
	local root = getRoot()
	local humanoid = getHumanoid()
	if not ball or not ball.Parent or not root or not humanoid then
		return
	end
	if ball:GetAttribute("PossessorId") ~= player.UserId then
		return
	end
	local cfg = Config.Ball
	local moveDir = humanoid.MoveDirection
	local forward = if moveDir.Magnitude > 0.1 then moveDir.Unit else root.CFrame.LookVector
	forward = Vector3.new(forward.X, 0, forward.Z)
	if forward.Magnitude < 1e-3 then
		forward = Vector3.new(0, 0, -1)
	end
	forward = forward.Unit

	local surfaceY = ball:GetAttribute("SurfaceY") or 0
	local radius = ball.Size.X / 2
	local rootVel = root.AssemblyLinearVelocity
	local target = root.Position + forward * cfg.DribbleDistance
	target = Vector3.new(target.X, surfaceY + radius, target.Z)

	local delta = target - ball.Position
	local horizontal = Vector3.new(delta.X, 0, delta.Z) * cfg.DribbleStiffness + Vector3.new(rootVel.X, 0, rootVel.Z)
	if horizontal.Magnitude > 75 then
		horizontal = horizontal.Unit * 75
	end
	local vy = math.clamp(delta.Y * 10, -40, 15)
	local velocity = Vector3.new(horizontal.X, vy, horizontal.Z)
	ball.AssemblyLinearVelocity = velocity
	ball.AssemblyAngularVelocity = Vector3.new(velocity.Z, 0, -velocity.X) / radius
end

local function refreshPossession()
	local ball = BallController.GetMyBall()
	myBall = ball
	if ball and not dribbleConnection then
		dribbleConnection = RunService.PreSimulation:Connect(dribbleStep)
	elseif not ball and dribbleConnection then
		dribbleConnection:Disconnect()
		dribbleConnection = nil
	end
end

function BallController.Init() end

function BallController.Start()
	-- The server mirrors possession onto the player as the HasBall attribute,
	-- so we only run the dribble loop while we actually have the ball.
	player:GetAttributeChangedSignal("HasBall"):Connect(function()
		task.defer(refreshPossession)
	end)
	-- Safety net in case attribute order races the ball attribute.
	task.spawn(function()
		while true do
			task.wait(0.5)
			refreshPossession()
		end
	end)
end

function BallController.HasBall(): boolean
	return player:GetAttribute("HasBall") == true
end

return BallController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="32">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--[[
	CameraController (client)
	Outside matches the normal Roblox camera is used. In a match we take over:

	  Follow    - elevated third-person behind the player. Mouse (locked to the
	              centre), right stick or touch drag turns it. Sensitivity setting.
	  Broadcast - fixed side-on-from-behind view facing the goal you attack,
	              framing you and the ball. Great for mobile/gamepad.

	Important moments (kickoff, goals, full time) blend to the ball/goal. All
	motion is exponentially smoothed; there is no camera shake.
	Toggle with C (Config.Controls.CameraMode).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.Parent.ClientState)
local BallController = require(script.Parent.BallController)

local CameraController = {}

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

local active = false
local mode = "Follow"
local yaw = 0
local pitch = math.rad(-20)
local focus = Vector3.zero
local camPos = Vector3.zero
local goalFocus: Vector3? = nil
local goalFocusUntil = 0

local FOLLOW_DISTANCE = 20
local FOLLOW_HEIGHT = 7
local BROADCAST_BACK = 34
local BROADCAST_HEIGHT = 24

local function smooth(rate: number, dt: number): number
	return 1 - math.exp(-rate * dt)
end

local function getRoot(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function getMatchState(): Instance?
	local matchId = player:GetAttribute("MatchId")
	local matches = ReplicatedStorage:FindFirstChild("Matches")
	return matchId and matches and matches:FindFirstChild(matchId)
end

local function sensitivity(): number
	local p = ClientState.Profile
	return (p and p.Settings and p.Settings.CameraSensitivity) or 1
end

local function matchBall(): BasePart?
	local root = getRoot()
	if not root then
		return nil
	end
	return BallController.GetNearestBall(150)
end

local function setActive(on: boolean)
	if on == active then
		return
	end
	active = on
	if on then
		camera.CameraType = Enum.CameraType.Scriptable
		local root = getRoot()
		local dir = player:GetAttribute("AttackDir") or 1
		yaw = if dir > 0 then math.rad(-90) else math.rad(90)
		if root then
			focus = root.Position
			camPos = camera.CFrame.Position
		end
	else
		camera.CameraType = Enum.CameraType.Custom
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			camera.CameraSubject = humanoid
		end
	end
end

function CameraController.ToggleMode()
	mode = if mode == "Follow" then "Broadcast" else "Follow"
	Remotes.Get("UpdateSettings"):FireServer({ CameraMode = mode })
end

function CameraController.GetMode(): string
	return mode
end

local function update(dt: number)
	local state = getMatchState()
	local matchState = state and state:GetAttribute("State")
	local inMatch = state ~= nil and matchState ~= nil and matchState ~= "Idle" and matchState ~= "MatchFound"
	setActive(inMatch)
	if not active then
		return
	end

	local root = getRoot()
	if not root then
		return
	end

	local attackDir = player:GetAttribute("AttackDir") or 1
	local ball = matchBall()
	local ballPos = ball and ball.Position or root.Position

	-- Mouse lock only for Follow mode on PC, and never while a menu is open.
	local lockMouse = mode == "Follow" and not ClientState.MenuOpen and UserInputService.KeyboardEnabled
	UserInputService.MouseBehavior = if lockMouse then Enum.MouseBehavior.LockCenter else Enum.MouseBehavior.Default

	local desiredFocus: Vector3
	local desiredPos: Vector3
	local now = os.clock()

	if goalFocus and now < goalFocusUntil then
		-- Goal replay-style framing
		desiredFocus = goalFocus
		desiredPos = goalFocus + Vector3.new(-attackDir * 26, 14, 18)
	elseif matchState == "Kickoff" or matchState == "Ended" then
		-- Wide view from behind our half
		desiredFocus = ballPos:Lerp(root.Position, 0.3)
		desiredPos = desiredFocus + Vector3.new(-attackDir * 46, 30, 0)
	elseif mode == "Broadcast" then
		desiredFocus = root.Position:Lerp(ballPos, 0.35) + Vector3.new(attackDir * 8, 0, 0)
		desiredPos = desiredFocus + Vector3.new(-attackDir * BROADCAST_BACK, BROADCAST_HEIGHT, 0)
	else
		-- Follow: orbit by input, slight lean toward the ball
		if lockMouse then
			local delta = UserInputService:GetMouseDelta()
			yaw -= delta.X * 0.0045 * sensitivity()
			pitch = math.clamp(pitch - delta.Y * 0.003 * sensitivity(), math.rad(-45), math.rad(-8))
		end
		desiredFocus = root.Position + Vector3.new(0, 2, 0)
		local toBall = ballPos - root.Position
		if toBall.Magnitude < 40 then
			desiredFocus += Vector3.new(toBall.X, 0, toBall.Z) * 0.15
		end
		local rot = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
		desiredPos = desiredFocus + rot:VectorToWorldSpace(Vector3.new(0, 0, FOLLOW_DISTANCE)) + Vector3.new(0, FOLLOW_HEIGHT * 0.3, 0)
	end

	focus = focus:Lerp(desiredFocus, smooth(10, dt))
	camPos = camPos:Lerp(desiredPos, smooth(8, dt))
	camera.CFrame = CFrame.lookAt(camPos, focus)
end

-- Gamepad right stick / touch drag for the Follow camera
local function onInputChanged(input: InputObject, processed: boolean)
	if not active or mode ~= "Follow" then
		return
	end
	if input.KeyCode == Enum.KeyCode.Thumbstick2 then
		local v = input.Position
		if v.Magnitude > 0.15 then
			yaw -= v.X * 0.06 * sensitivity()
			pitch = math.clamp(pitch + v.Y * 0.03 * sensitivity(), math.rad(-45), math.rad(-8))
		end
	elseif input.UserInputType == Enum.UserInputType.Touch and not processed then
		-- Only drags on the right half of the screen turn the camera
		if input.Position.X > camera.ViewportSize.X * 0.5 then
			yaw -= input.Delta.X * 0.008 * sensitivity()
			pitch = math.clamp(pitch - input.Delta.Y * 0.005 * sensitivity(), math.rad(-45), math.rad(-8))
		end
	end
end

function CameraController.Init() end

function CameraController.Start()
	ClientState.Changed:Connect(function(profile)
		if profile.Settings and (profile.Settings.CameraMode == "Follow" or profile.Settings.CameraMode == "Broadcast") then
			mode = profile.Settings.CameraMode
		end
	end)
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		mode = "Broadcast"
	end

	Remotes.Get("MatchEvent").OnClientEvent:Connect(function(kind, payload)
		if kind == "Goal" and payload.PitchId == player:GetAttribute("MatchId") and payload.BallPosition then
			goalFocus = payload.BallPosition
			goalFocusUntil = os.clock() + 3
		end
	end)

	UserInputService.InputChanged:Connect(onInputChanged)
	RunService:BindToRenderStep("CK_Camera", Enum.RenderPriority.Camera.Value + 1, update)
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="33">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--[[
	InputController (client)
	Binds every action listed in Config.Controls through ContextActionService,
	which gives keyboard/mouse, Xbox/PlayStation gamepads and mobile touch
	buttons from the same code. Rebind controls in Config.Controls only.

	The client only sends intents (Kick/Tackle/SkillMove). The server decides.
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.Parent.ClientState)
local BallController = require(script.Parent.BallController)
local MovementController = require(script.Parent.MovementController)

local InputController = {}

local player = Players.LocalPlayer
local kickRemote, tackleRemote, skillRemote
local chargeStart: number? = nil
local skillSide = 1
local lastTackle = 0
local lastSkill = 0

local Sink = Enum.ContextActionResult.Sink
local Pass = Enum.ContextActionResult.Pass

-- Other modules register callbacks for non-football actions (camera, menu)
InputController.ActionCallbacks = {}

local function canKick(): boolean
	if BallController.HasBall() then
		return true
	end
	return BallController.GetNearestBall(Config.Kick.ReachRadius) ~= nil
end

-- Kick direction: where you are moving, otherwise where the camera looks.
function InputController.GetAimDirection(): Vector3
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.MoveDirection.Magnitude > 0.1 then
		return humanoid.MoveDirection.Unit
	end
	local look = Workspace.CurrentCamera.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude > 1e-3 then
		return flat.Unit
	end
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root and root.CFrame.LookVector or Vector3.new(0, 0, -1)
end

local function kick(kind: string, power: number)
	kickRemote:FireServer(kind, InputController.GetAimDirection(), power)
end

local handlers = {}

function handlers.Sprint(state: Enum.UserInputState)
	MovementController.SetSprinting(state == Enum.UserInputState.Begin)
	return Pass
end

function handlers.Pass(state: Enum.UserInputState)
	if ClientState.MenuOpen then
		return Pass
	end
	if state == Enum.UserInputState.Begin and canKick() then
		kick("Pass", 0.5)
		return Sink
	end
	return Pass
end

function handlers.ThroughBall(state: Enum.UserInputState)
	if state == Enum.UserInputState.Begin and canKick() then
		kick("Through", 0.6)
		return Sink
	end
	return Pass
end

function handlers.Lob(state: Enum.UserInputState)
	-- Space: lob when we have the ball, otherwise let the jump through
	if state == Enum.UserInputState.Begin and BallController.HasBall() then
		kick("Lob", 0.55)
		return Sink
	end
	return Pass
end

function handlers.Shoot(state: Enum.UserInputState)
	if ClientState.MenuOpen then
		return Pass
	end
	if state == Enum.UserInputState.Begin then
		if canKick() then
			chargeStart = os.clock()
			ClientState.Charge = 0
			return Sink
		end
		return Pass
	elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
		if chargeStart then
			local power = math.clamp((os.clock() - chargeStart) / Config.Kick.MaxChargeTime, 0.15, 1)
			chargeStart = nil
			ClientState.Charge = -1
			if state == Enum.UserInputState.End and canKick() then
				kick("Shot", power)
			end
			return Sink
		end
	end
	return Pass
end

function handlers.Tackle(state: Enum.UserInputState)
	if state ~= Enum.UserInputState.Begin or BallController.HasBall() then
		return Pass
	end
	local now = os.clock()
	if now - lastTackle < Config.Tackle.Cooldown then
		return Sink
	end
	lastTackle = now
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		MovementController.Dash(root.CFrame.LookVector, 30, 0.2)
	end
	tackleRemote:FireServer()
	return Sink
end

function handlers.SkillMove(state: Enum.UserInputState)
	if state ~= Enum.UserInputState.Begin or not BallController.HasBall() then
		return Pass
	end
	local now = os.clock()
	if now - lastSkill < Config.SkillMove.Cooldown then
		return Sink
	end
	lastSkill = now
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		-- Alternate left/right cuts
		skillSide = -skillSide
		MovementController.Dash(root.CFrame.RightVector * skillSide + root.CFrame.LookVector * 0.4, Config.SkillMove.DashSpeed, Config.SkillMove.DashTime)
	end
	skillRemote:FireServer()
	return Sink
end

function handlers.CameraMode(state: Enum.UserInputState)
	if state == Enum.UserInputState.Begin and InputController.ActionCallbacks.CameraMode then
		InputController.ActionCallbacks.CameraMode()
		return Sink
	end
	return Pass
end

function handlers.Menu(state: Enum.UserInputState)
	if state == Enum.UserInputState.Begin and InputController.ActionCallbacks.Menu then
		InputController.ActionCallbacks.Menu()
		return Sink
	end
	return Pass
end

-- Touch button layout (relative to the default jump button area)
local TOUCH_POSITIONS = {
	Shoot = UDim2.new(1, -95, 1, -230),
	Pass = UDim2.new(1, -175, 1, -170),
	ThroughBall = UDim2.new(1, -175, 1, -250),
	Lob = UDim2.new(1, -255, 1, -170),
	Tackle = UDim2.new(1, -255, 1, -90),
	SkillMove = UDim2.new(1, -255, 1, -250),
	Sprint = UDim2.new(1, -95, 1, -310),
}

local function bindAll()
	for actionName, binding in Config.Controls do
		local handler = handlers[actionName]
		if handler then
			local inputs = {}
			for _, input in binding.Keyboard or {} do
				table.insert(inputs, input)
			end
			for _, input in binding.Gamepad or {} do
				table.insert(inputs, input)
			end
			local function callback(_, state, _input)
				return handler(state)
			end
			ContextActionService:BindActionAtPriority("CK_" .. actionName, callback, binding.Touch == true, Enum.ContextActionPriority.High.Value, table.unpack(inputs))
			if binding.Touch then
				ContextActionService:SetTitle("CK_" .. actionName, binding.TouchTitle or actionName)
				if TOUCH_POSITIONS[actionName] then
					ContextActionService:SetPosition("CK_" .. actionName, TOUCH_POSITIONS[actionName])
				end
			end
		end
	end
end

function InputController.IsCharging(): boolean
	return chargeStart ~= nil
end

function InputController.GetChargeAlpha(): number
	if not chargeStart then
		return 0
	end
	return math.clamp((os.clock() - chargeStart) / Config.Kick.MaxChargeTime, 0, 1)
end

function InputController.IsTouch(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

function InputController.Init()
	kickRemote = Remotes.Get("Kick")
	tackleRemote = Remotes.Get("Tackle")
	skillRemote = Remotes.Get("SkillMove")
end

function InputController.Start()
	bindAll()
end

return InputController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">MovementController</string>
              <string name="Source"><![CDATA[--[[
	MovementController (client)
	Sprint with stamina, sprint acceleration ramp, dribble slowdown and the short
	slow after a failed tackle. Speeds scale gently with Pace/Stamina attributes.
	Also performs the local dash used by skill moves and tackles.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.Parent.ClientState)

local MovementController = {}

local player = Players.LocalPlayer
local sprintHeld = false
local sprintBlend = 0
local lastSprintTime = 0
local slowUntil = 0

function MovementController.SetSprinting(held: boolean)
	sprintHeld = held
end

local function getCharacterParts()
	local character = player.Character
	if not character then
		return nil, nil
	end
	return character:FindFirstChildOfClass("Humanoid"), character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- Short burst of velocity (skill-move sidestep / tackle lunge).
function MovementController.Dash(direction: Vector3, speed: number, duration: number)
	local _, root = getCharacterParts()
	if not root then
		return
	end
	local flat = Vector3.new(direction.X, 0, direction.Z)
	if flat.Magnitude < 1e-3 then
		return
	end
	local attachment = Instance.new("Attachment")
	attachment.Parent = root
	local lv = Instance.new("LinearVelocity")
	lv.Attachment0 = attachment
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	lv.PrimaryTangentAxis = Vector3.xAxis
	lv.SecondaryTangentAxis = Vector3.zAxis
	lv.PlaneVelocity = Vector2.new(flat.Unit.X * speed, flat.Unit.Z * speed)
	lv.MaxForce = 60000
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.Parent = root
	task.delay(duration, function()
		lv:Destroy()
		attachment:Destroy()
	end)
end

local function step(dt: number)
	local humanoid, root = getCharacterParts()
	if not humanoid or not root then
		return
	end
	local m = Config.Movement
	local paceAlpha = math.clamp(ClientState.GetAttribute("Pace") / Config.Attributes.Max, 0, 1)
	local staminaAlpha = math.clamp(ClientState.GetAttribute("Stamina") / Config.Attributes.Max, 0, 1)
	local now = os.clock()

	local moving = humanoid.MoveDirection.Magnitude > 0.1
	local canSprint = sprintHeld and moving and ClientState.Stamina > 0 and not root.Anchored
	if canSprint then
		sprintBlend = math.min(1, sprintBlend + dt / m.SprintRampTime)
		local drain = m.StaminaDrainPerSecond * (1 - staminaAlpha * m.StaminaAttributeBonus)
		ClientState.Stamina = math.max(0, ClientState.Stamina - drain * dt)
		lastSprintTime = now
	else
		sprintBlend = math.max(0, sprintBlend - dt / (m.SprintRampTime * 0.6))
		if now - lastSprintTime > m.StaminaRegenDelay then
			ClientState.Stamina = math.min(m.StaminaMax, ClientState.Stamina + m.StaminaRegenPerSecond * dt)
		end
	end

	local walk = m.BaseWalkSpeed + paceAlpha * m.PaceWalkBonus
	local sprint = m.BaseSprintSpeed + paceAlpha * m.PaceSprintBonus
	local speed = walk + (sprint - walk) * sprintBlend
	if player:GetAttribute("HasBall") then
		speed *= m.DribbleSpeedMultiplier
	end
	if now < slowUntil then
		speed *= 0.45
	end
	humanoid.WalkSpeed = speed
end

function MovementController.Init() end

function MovementController.Start()
	RunService.Heartbeat:Connect(step)
	Remotes.Get("BallEvent").OnClientEvent:Connect(function(kind, payload)
		if kind == "TackleFailed" then
			slowUntil = os.clock() + (payload and payload.Duration or 0.6)
		end
	end)
	player.CharacterAdded:Connect(function()
		ClientState.Stamina = Config.Movement.StaminaMax
		sprintBlend = 0
	end)
end

return MovementController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="35">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Client bootstrap. Controllers are initialised in order, then started.
]]

local ClientState = require(script.Parent:WaitForChild("ClientState"))
local Controllers = script.Parent:WaitForChild("Controllers")
local UI = script.Parent:WaitForChild("UI")

local BallController = require(Controllers:WaitForChild("BallController"))
local MovementController = require(Controllers:WaitForChild("MovementController"))
local InputController = require(Controllers:WaitForChild("InputController"))
local CameraController = require(Controllers:WaitForChild("CameraController"))
local UIController = require(UI:WaitForChild("UIController"))

local ordered = { ClientState, BallController, MovementController, InputController, CameraController, UIController }

for _, module in ordered do
	module.Init()
end

InputController.ActionCallbacks.CameraMode = CameraController.ToggleMode
InputController.ActionCallbacks.Menu = UIController.ToggleMenu

for _, module in ordered do
	if module.Start then
		module.Start()
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="36">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[--[[
	HUD
	Always-on interface: profile card (avatar, level, title, XP, Kicks,
	reputation), main menu buttons, stamina + shot charge bars, control hints,
	queue status pill and toast notifications.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Progression = require(Shared.Progression)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.Parent.ClientState)
local InputController = require(script.Parent.Parent.Controllers.InputController)
local UIKit = require(script.Parent.UIKit)

local T = UIKit.Theme
local new = UIKit.new

local HUD = {}

local player = Players.LocalPlayer
local refs = {}

local function buildProfileCard(gui: ScreenGui)
	local card = UIKit.Panel({
		Name = "ProfileCard",
		Size = UDim2.fromOffset(300, 92),
		Position = UDim2.fromOffset(16, 16),
		Parent = gui,
	})
	local avatar = new("ImageLabel", {
		Size = UDim2.fromOffset(68, 68),
		Position = UDim2.fromOffset(12, 12),
		BackgroundColor3 = T.PanelLight,
		Image = "",
		Parent = card,
	}, { UIKit.Corner(34), UIKit.Stroke(T.Accent, 2) })
	task.spawn(function()
		local ok, image = pcall(function()
			return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		end)
		if ok then
			avatar.Image = image
		end
	end)
	local levelBadge = new("TextLabel", {
		Size = UDim2.fromOffset(30, 22),
		Position = UDim2.fromOffset(56, 60),
		BackgroundColor3 = T.Accent,
		TextColor3 = T.AccentDark,
		Font = T.Heavy,
		TextSize = 14,
		Text = "1",
		Parent = card,
	}, { UIKit.Corner(8) })
	UIKit.Label({
		Size = UDim2.new(1, -100, 0, 22),
		Position = UDim2.fromOffset(92, 10),
		Text = player.DisplayName,
		Font = T.Heavy,
		TextSize = 18,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = card,
	})
	local title = UIKit.Label({
		Size = UDim2.new(1, -100, 0, 16),
		Position = UDim2.fromOffset(92, 32),
		Text = "Fresh Laces · Unknown",
		TextColor3 = T.Accent,
		Font = T.Bold,
		TextSize = 13,
		Parent = card,
	})
	local _, xpFill = UIKit.Bar({
		Size = UDim2.new(1, -104, 0, 8),
		Position = UDim2.fromOffset(92, 54),
		Parent = card,
	}, T.Accent)
	local kicks = UIKit.Label({
		Size = UDim2.new(0.5, -50, 0, 16),
		Position = UDim2.fromOffset(92, 66),
		Text = "◆ 0",
		TextColor3 = T.Gold,
		Font = T.Heavy,
		TextSize = 14,
		Parent = card,
	})
	local xpText = UIKit.Label({
		Size = UDim2.new(0.5, -60, 0, 16),
		Position = UDim2.new(0.5, 40, 0, 66),
		Text = "0 / 100 XP",
		TextColor3 = T.Muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		Font = T.Medium,
		TextSize = 12,
		Parent = card,
	})
	refs.Level = levelBadge
	refs.Title = title
	refs.XPFill = xpFill
	refs.Kicks = kicks
	refs.XPText = xpText
end

local function buildMenu(gui: ScreenGui, open: (string) -> ())
	local menu = new("Frame", {
		Name = "Menu",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(150, 260),
		Position = UDim2.new(0, 16, 0.5, -110),
		Parent = gui,
	}, { UIKit.List(Enum.FillDirection.Vertical, 8) })
	local entries = {
		{ "PLAY", "Play", T.Accent, T.AccentDark },
		{ "LOCKER", "Locker", T.PanelLight, T.Text },
		{ "PROFILE", "Profile", T.PanelLight, T.Text },
		{ "SETTINGS", "Settings", T.PanelLight, T.Text },
	}
	for i, e in entries do
		local button = UIKit.Button({
			Size = UDim2.new(1, 0, 0, 46),
			Text = e[1],
			BackgroundColor3 = e[3],
			TextColor3 = e[4],
			TextSize = 18,
			LayoutOrder = i,
			Parent = menu,
		}, function()
			open(e[2])
		end)
		if i == 1 then
			refs.PlayButton = button
		end
	end
	local hint = UIKit.Label({
		Size = UDim2.new(1, 0, 0, 16),
		Text = "M to toggle menu",
		TextColor3 = T.Muted,
		Font = T.Medium,
		TextSize = 12,
		LayoutOrder = 10,
		Parent = menu,
	})
	if InputController.IsTouch() then
		hint.Visible = false
	end
	refs.Menu = menu
end

local function buildBottom(gui: ScreenGui)
	local bottom = new("Frame", {
		Name = "Bottom",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.fromOffset(420, 70),
		Parent = gui,
	})
	UIKit.Label({
		Size = UDim2.fromOffset(80, 14),
		Position = UDim2.fromOffset(0, 0),
		Text = "STAMINA",
		TextColor3 = T.Muted,
		Font = T.Bold,
		TextSize = 11,
		Parent = bottom,
	})
	local _, stamina = UIKit.Bar({ Size = UDim2.new(1, 0, 0, 10), Position = UDim2.fromOffset(0, 16), Parent = bottom }, T.Accent)
	local chargeBack, charge = UIKit.Bar({ Size = UDim2.new(1, 0, 0, 8), Position = UDim2.fromOffset(0, 30), Visible = false, Parent = bottom }, T.Secondary)
	local controls = UIKit.Label({
		Size = UDim2.new(1, 0, 0, 16),
		Position = UDim2.fromOffset(0, 46),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = T.Muted,
		Font = T.Medium,
		TextSize = 12,
		Text = "LMB Pass · RMB Shoot (hold) · F Through · Space Lob · E Tackle · Q Skill · Shift Sprint · C Camera",
		Parent = bottom,
	})
	refs.Stamina = stamina
	refs.ChargeBack = chargeBack
	refs.Charge = charge
	refs.Controls = controls
	if InputController.IsTouch() then
		controls.Visible = false
	end
end

local function buildQueuePill(gui: ScreenGui)
	local pill = UIKit.Panel({
		Name = "QueuePill",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 16),
		Size = UDim2.fromOffset(380, 46),
		Visible = false,
		Parent = gui,
	})
	local text = UIKit.Label({
		Size = UDim2.new(1, -110, 1, 0),
		Position = UDim2.fromOffset(16, 0),
		Font = T.Bold,
		TextSize = 14,
		Text = "IN QUEUE",
		Parent = pill,
	})
	UIKit.Button({
		Size = UDim2.fromOffset(84, 30),
		Position = UDim2.new(1, -92, 0.5, -15),
		Text = "LEAVE",
		TextSize = 13,
		BackgroundColor3 = T.Danger,
		Parent = pill,
	}, function()
		Remotes.Get("RequestQueue"):FireServer(false)
	end)
	refs.QueuePill = pill
	refs.QueueText = text
end

local function buildToasts(gui: ScreenGui)
	local holder = new("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 16),
		Size = UDim2.fromOffset(320, 400),
		Parent = gui,
	}, { UIKit.List(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Right) })
	refs.Toasts = holder
end

function HUD.Toast(text: string, kind: string?)
	local holder = refs.Toasts
	if not holder then
		return
	end
	local color = if kind == "levelup" then T.Accent elseif kind == "error" then T.Danger else T.PanelLight
	local textColor = if kind == "levelup" then T.AccentDark else T.Text
	local toast = new("TextLabel", {
		Size = UDim2.fromOffset(320, 40),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.05,
		TextColor3 = textColor,
		Font = T.Bold,
		TextSize = 14,
		TextWrapped = true,
		Text = text,
		Parent = holder,
	}, { UIKit.Corner(10), UIKit.Padding(8) })
	task.delay(3.5, function()
		UIKit.Tween(toast, 0.4, { BackgroundTransparency = 1, TextTransparency = 1 })
		task.wait(0.45)
		toast:Destroy()
	end)
end

local function refreshProfile(profile)
	if not profile or not refs.Level then
		return
	end
	local _, tierName = Progression.GetReputationTier(profile.Reputation)
	refs.Level.Text = tostring(profile.Level)
	refs.Title.Text = Progression.GetTitle(profile.Level) .. " · " .. tierName
	local need = Progression.XPToNext(profile.Level)
	refs.XPFill.Size = UDim2.fromScale(math.clamp(profile.XP / need, 0, 1), 1)
	refs.XPText.Text = string.format("%s / %s XP", UIKit.FormatNumber(profile.XP), UIKit.FormatNumber(need))
	refs.Kicks.Text = "◆ " .. UIKit.FormatNumber(profile.Kicks) .. " " .. Config.CurrencyName
	if refs.Controls and profile.Settings then
		refs.Controls.Visible = profile.Settings.ShowControls ~= false and not InputController.IsTouch()
	end
end

local function updateFrame()
	if refs.Stamina then
		refs.Stamina.Size = UDim2.fromScale(ClientState.Stamina / Config.Movement.StaminaMax, 1)
		refs.Stamina.BackgroundColor3 = if ClientState.Stamina < 25 then T.Danger else T.Accent
	end
	if refs.Charge then
		local charging = InputController.IsCharging()
		refs.ChargeBack.Visible = charging
		refs.Charge.Size = UDim2.fromScale(InputController.GetChargeAlpha(), 1)
	end

	-- Queue pill
	local queued = player:GetAttribute("QueuedPitch")
	if refs.QueuePill then
		refs.QueuePill.Visible = queued ~= nil
		if queued then
			local matches = ReplicatedStorage:FindFirstChild("Matches")
			local state = matches and matches:FindFirstChild(queued)
			if state then
				local count = state:GetAttribute("QueueCount") or 0
				local needed = state:GetAttribute("QueueNeeded") or 6
				local text = string.format("IN QUEUE · %s · %d/%d", state:GetAttribute("PitchName") or "", count, needed)
				local fillAt = state:GetAttribute("BotFillAt") or 0
				if state:GetAttribute("State") ~= "Idle" then
					text ..= " · next game"
				elseif fillAt > 0 then
					local secondsLeft = math.max(0, math.ceil(fillAt - Workspace:GetServerTimeNow()))
					text ..= string.format(" · Regulars join in %ds", secondsLeft)
				end
				refs.QueueText.Text = text
			end
		end
	end

	-- Hide the menu during matches
	local inMatch = player:GetAttribute("MatchId") ~= nil
	if refs.Menu then
		refs.Menu.Visible = not inMatch
	end
end

function HUD.Create(gui: ScreenGui, openPanel: (string) -> ())
	buildProfileCard(gui)
	buildMenu(gui, openPanel)
	buildBottom(gui)
	buildQueuePill(gui)
	buildToasts(gui)
	ClientState.Changed:Connect(refreshProfile)
	refreshProfile(ClientState.Profile)
	RunService.Heartbeat:Connect(updateFrame)
	Remotes.Get("Notify").OnClientEvent:Connect(HUD.Toast)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">LockerPanel</string>
              <string name="Source"><![CDATA[--[[
	LockerPanel
	Customization + shop in one: browse every category, preview the item on a live
	copy of your character, then buy (server-validated) and equip.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared.Catalog)
local Config = require(Shared.Config)
local Cosmetics = require(Shared.Cosmetics)
local Progression = require(Shared.Progression)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.Parent.ClientState)
local UIKit = require(script.Parent.UIKit)

local T = UIKit.Theme
local new = UIKit.new

local LockerPanel = {}

local player = Players.LocalPlayer
local frame: Frame
local refs = {}
local category = "Shirt"
local selectedId: string? = nil
local preview: Model? = nil
local previewEquipped = {}
local spinConnection: RBXScriptConnection? = nil
local busy = false

local function tierAllows(item, profile): boolean
	if not item.RequiredTier then
		return true
	end
	local index = Progression.GetReputationTier(profile.Reputation)
	return index >= Progression.TierIndexByName(item.RequiredTier)
end

local function rebuildPreview()
	local viewport = refs.Viewport :: ViewportFrame
	if preview then
		preview:Destroy()
		preview = nil
	end
	local character = player.Character
	if not character then
		return
	end
	character.Archivable = true
	local clone = character:Clone()
	if not clone then
		return
	end
	for _, d in clone:GetDescendants() do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	local humanoid = clone:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	clone:PivotTo(CFrame.new(0, 0, 0))
	Cosmetics.Apply(clone, previewEquipped, nil)
	clone.Parent = refs.WorldModel
	preview = clone

	local cam = viewport.CurrentCamera or Instance.new("Camera")
	cam.FieldOfView = 30
	cam.CFrame = CFrame.lookAt(Vector3.new(0, 0.5, -13), Vector3.new(0, 0, 0))
	cam.Parent = viewport
	viewport.CurrentCamera = cam
end

local function updateActionBar()
	local profile = ClientState.Profile
	local item = selectedId and Catalog.Get(selectedId)
	if not profile or not item then
		refs.ItemName.Text = "Select an item"
		refs.ItemInfo.Text = ""
		refs.Action.Visible = false
		return
	end
	refs.ItemName.Text = item.Name
	refs.Action.Visible = true
	local owned = profile.Inventory[item.Id] == true
	local equipped = profile.Equipped[item.Category] == item.Id
	if equipped then
		refs.ItemInfo.Text = "Equipped"
		refs.Action.Text = "EQUIPPED"
		refs.Action.BackgroundColor3 = T.PanelLight
	elseif owned then
		refs.ItemInfo.Text = "Owned"
		refs.Action.Text = "EQUIP"
		refs.Action.BackgroundColor3 = T.Accent
		refs.Action.TextColor3 = T.AccentDark
	elseif not tierAllows(item, profile) then
		refs.ItemInfo.Text = "Unlocks at reputation: " .. item.RequiredTier
		refs.Action.Text = "LOCKED"
		refs.Action.BackgroundColor3 = T.PanelLight
		refs.Action.TextColor3 = T.Muted
	else
		refs.ItemInfo.Text = string.format("◆ %s %s", UIKit.FormatNumber(item.Price), Config.CurrencyName)
		local affordable = profile.Kicks >= item.Price
		refs.Action.Text = if affordable then "BUY" else "NEED MORE KICKS"
		refs.Action.BackgroundColor3 = if affordable then T.Gold else T.PanelLight
		refs.Action.TextColor3 = if affordable then T.AccentDark else T.Muted
	end
	if equipped then
		refs.Action.TextColor3 = T.Muted
	end
end

local function populateGrid()
	local grid = refs.Grid :: ScrollingFrame
	for _, child in grid:GetChildren() do
		if child:IsA("GuiButton") then
			child:Destroy()
		end
	end
	local profile = ClientState.Profile
	for i, item in Catalog.ByCategory[category] do
		local owned = profile and profile.Inventory[item.Id]
		local isEquipped = profile and profile.Equipped[item.Category] == item.Id
		local locked = profile and not owned and not tierAllows(item, profile)
		local tile = UIKit.Button({
			Text = "",
			LayoutOrder = i,
			BackgroundColor3 = if selectedId == item.Id then T.Stroke else T.PanelLight,
			Parent = grid,
		}, function()
			selectedId = item.Id
			previewEquipped[item.Category] = item.Id
			rebuildPreview()
			populateGrid()
			updateActionBar()
		end)
		new("Frame", {
			Size = UDim2.new(1, -20, 0, 54),
			Position = UDim2.fromOffset(10, 10),
			BackgroundColor3 = item.Color,
			Parent = tile,
		}, { UIKit.Corner(8) })
		UIKit.Label({
			Size = UDim2.new(1, -12, 0, 30),
			Position = UDim2.fromOffset(6, 66),
			Text = item.Name,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			Font = T.Bold,
			TextSize = 12,
			Parent = tile,
		})
		UIKit.Label({
			Size = UDim2.new(1, -12, 0, 16),
			Position = UDim2.fromOffset(6, 98),
			Text = if isEquipped then "EQUIPPED" elseif owned then "OWNED" elseif locked then ("🔒 " .. item.RequiredTier) else ("◆ " .. UIKit.FormatNumber(item.Price)),
			TextColor3 = if isEquipped then T.Accent elseif owned then T.Muted elseif locked then T.Danger else T.Gold,
			TextXAlignment = Enum.TextXAlignment.Center,
			Font = T.Heavy,
			TextSize = 12,
			Parent = tile,
		})
	end
end

local function selectCategory(name: string)
	category = name
	selectedId = nil
	for catName, tab in refs.Tabs do
		tab.BackgroundColor3 = if catName == name then T.Accent else T.PanelLight
		tab.TextColor3 = if catName == name then T.AccentDark else T.Text
	end
	populateGrid()
	updateActionBar()
end

local function onAction()
	if busy or not selectedId then
		return
	end
	local profile = ClientState.Profile
	local item = Catalog.Get(selectedId)
	if not profile or not item then
		return
	end
	busy = true
	local remoteName = if profile.Inventory[item.Id] then "EquipItem" else "PurchaseItem"
	local ok, result, message = pcall(function()
		return Remotes.Get(remoteName):InvokeServer(item.Id)
	end)
	busy = false
	refs.Status.Text = if ok then (message or "") else "Something went wrong"
	refs.Status.TextColor3 = if ok and result then T.Accent else T.Danger
	-- Buying immediately equips for a smoother flow
	if ok and result and remoteName == "PurchaseItem" then
		pcall(function()
			Remotes.Get("EquipItem"):InvokeServer(item.Id)
		end)
	end
end

function LockerPanel.Create(gui: ScreenGui, close: () -> ())
	frame = UIKit.Panel({
		Name = "Locker",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(860, 540),
		Visible = false,
		Parent = gui,
	})
	new("UISizeConstraint", { MaxSize = Vector2.new(860, 540), Parent = frame })
	UIKit.Label({
		Size = UDim2.new(1, -40, 0, 40),
		Position = UDim2.fromOffset(20, 12),
		Text = "THE LOCKER",
		Font = T.Heavy,
		TextSize = 28,
		Parent = frame,
	})
	UIKit.Button({
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.new(1, -52, 0, 12),
		Text = "✕",
		Parent = frame,
	}, close)

	-- Preview
	local previewBox = new("Frame", {
		Size = UDim2.new(0, 260, 1, -80),
		Position = UDim2.fromOffset(20, 64),
		BackgroundColor3 = T.Bg,
		Parent = frame,
	}, { UIKit.Corner(12) })
	new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(40, 46, 30), Color3.fromRGB(14, 15, 19)),
		Rotation = 90,
		Parent = previewBox,
	})
	local viewport = new("ViewportFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(180, 180, 190),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-1, -1, -1),
		Parent = previewBox,
	})
	refs.Viewport = viewport
	refs.WorldModel = new("WorldModel", { Parent = viewport })

	-- Category tabs
	local tabs = new("Frame", {
		Size = UDim2.new(1, -320, 0, 36),
		Position = UDim2.fromOffset(300, 64),
		BackgroundTransparency = 1,
		Parent = frame,
	}, { UIKit.List(Enum.FillDirection.Horizontal, 6) })
	refs.Tabs = {}
	for i, cat in Catalog.Categories do
		refs.Tabs[cat] = UIKit.Button({
			Size = UDim2.fromOffset(84, 36),
			Text = string.upper(cat),
			TextSize = 13,
			LayoutOrder = i,
			Parent = tabs,
		}, function()
			selectCategory(cat)
		end)
	end

	local grid = new("ScrollingFrame", {
		Size = UDim2.new(1, -320, 1, -200),
		Position = UDim2.fromOffset(300, 110),
		BackgroundTransparency = 1,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = frame,
	}, {
		new("UIGridLayout", { CellSize = UDim2.fromOffset(120, 120), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	refs.Grid = grid

	-- Action bar
	local bar = new("Frame", {
		Size = UDim2.new(1, -320, 0, 70),
		Position = UDim2.new(0, 300, 1, -84),
		BackgroundColor3 = T.Bg,
		Parent = frame,
	}, { UIKit.Corner(12) })
	refs.ItemName = UIKit.Label({ Size = UDim2.new(1, -220, 0, 24), Position = UDim2.fromOffset(14, 8), Font = T.Heavy, TextSize = 18, Text = "", Parent = bar })
	refs.ItemInfo = UIKit.Label({ Size = UDim2.new(1, -220, 0, 18), Position = UDim2.fromOffset(14, 32), TextColor3 = T.Gold, Font = T.Bold, TextSize = 14, Text = "", Parent = bar })
	refs.Status = UIKit.Label({ Size = UDim2.new(1, -220, 0, 14), Position = UDim2.fromOffset(14, 50), TextColor3 = T.Muted, Font = T.Medium, TextSize = 12, Text = "", Parent = bar })
	refs.Action = UIKit.Button({
		Size = UDim2.fromOffset(190, 46),
		Position = UDim2.new(1, -202, 0.5, -23),
		Text = "BUY",
		TextSize = 16,
		Parent = bar,
	}, onAction)

	ClientState.Changed:Connect(function()
		if frame.Visible then
			populateGrid()
			updateActionBar()
		end
	end)
end

function LockerPanel.Open()
	local profile = ClientState.Profile
	previewEquipped = profile and table.clone(profile.Equipped) or Catalog.DefaultEquipped()
	frame.Visible = true
	refs.Status.Text = ""
	selectCategory(category)
	rebuildPreview()
	if not spinConnection then
		local angle = 0
		spinConnection = RunService.RenderStepped:Connect(function(dt)
			if preview and preview.Parent then
				angle += dt * 0.6
				preview:PivotTo(CFrame.Angles(0, angle, 0))
			end
		end)
	end
end

function LockerPanel.Close()
	frame.Visible = false
	if spinConnection then
		spinConnection:Disconnect()
		spinConnection = nil
	end
	if preview then
		preview:Destroy()
		preview = nil
	end
end

return LockerPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">MatchHUD</string>
              <string name="Source"><![CDATA[--[[
	MatchHUD
	Scoreboard ("VOLT 2 — 1 EMBER") with the match clock, shown to players in the
	match and to spectators near the pitch. Big centre-screen moments:
	MATCH FOUND -> VOLT vs EMBER rosters -> 3, 2, 1, GO -> GOAL!
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local UIKit = require(script.Parent.UIKit)

local T = UIKit.Theme
local new = UIKit.new

local MatchHUD = {}

local player = Players.LocalPlayer
local refs = {}
local SPECTATE_DISTANCE = 110

local function teamBlock(parent, team: string, order: number)
	local info = Config.Teams[team]
	local block = new("Frame", {
		Size = UDim2.fromOffset(150, 52),
		BackgroundColor3 = info.Color,
		LayoutOrder = order,
		Parent = parent,
	}, { UIKit.Corner(10) })
	UIKit.Label({
		Size = UDim2.fromScale(1, 1),
		Text = info.Name,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = info.Dark,
		Font = T.Heavy,
		TextSize = 24,
		Parent = block,
	})
	return block
end

local function buildScoreboard(gui: ScreenGui)
	local board = new("Frame", {
		Name = "Scoreboard",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 14),
		Size = UDim2.fromOffset(440, 86),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundTransparency = 1,
		Parent = board,
	}, { UIKit.List(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center) })
	teamBlock(row, "A", 1)
	local score = new("TextLabel", {
		Size = UDim2.fromOffset(120, 52),
		BackgroundColor3 = T.Bg,
		BackgroundTransparency = 0.05,
		TextColor3 = T.Text,
		Font = T.Heavy,
		TextSize = 30,
		Text = "0 — 0",
		LayoutOrder = 2,
		Parent = row,
	}, { UIKit.Corner(10) })
	teamBlock(row, "B", 3)
	local timer = new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 58),
		Size = UDim2.fromOffset(110, 26),
		BackgroundColor3 = T.Bg,
		BackgroundTransparency = 0.1,
		TextColor3 = T.Accent,
		Font = T.Heavy,
		TextSize = 18,
		Text = "4:00",
		Parent = board,
	}, { UIKit.Corner(8) })
	refs.Board = board
	refs.Score = score
	refs.Timer = timer
end

local function buildCenter(gui: ScreenGui)
	local center = new("Frame", {
		Name = "Announce",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.38),
		Size = UDim2.fromOffset(900, 300),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local big = UIKit.Label({
		Name = "Big",
		Size = UDim2.new(1, 0, 0, 110),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = T.Heavy,
		TextSize = 96,
		Text = "",
		TextTransparency = 1,
		Parent = center,
	})
	new("UIStroke", { Thickness = 3, Color = Color3.new(0, 0, 0), Transparency = 0.3, Parent = big })
	local small = UIKit.Label({
		Name = "Small",
		Position = UDim2.fromOffset(0, 110),
		Size = UDim2.new(1, 0, 0, 40),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = T.Bold,
		TextSize = 26,
		Text = "",
		TextTransparency = 1,
		Parent = center,
	})
	new("UIStroke", { Thickness = 2, Color = Color3.new(0, 0, 0), Transparency = 0.4, Parent = small })

	-- Rosters "VOLT vs EMBER"
	local versus = new("Frame", {
		Name = "Versus",
		Position = UDim2.fromOffset(0, 160),
		Size = UDim2.new(1, 0, 0, 140),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = center,
	})
	local function rosterColumn(team: string, x: number)
		local col = UIKit.Panel({
			Position = UDim2.new(x, 0, 0, 0),
			Size = UDim2.new(0.4, 0, 1, 0),
			Parent = versus,
		})
		new("UIStroke", { Color = Config.Teams[team].Color, Thickness = 2, Parent = col })
		local list = new("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Parent = col,
		}, { UIKit.List(Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Center), UIKit.Padding(10) })
		return list
	end
	refs.RosterA = rosterColumn("A", 0.05)
	refs.RosterB = rosterColumn("B", 0.55)
	UIKit.Label({
		Position = UDim2.fromScale(0.45, 0.3),
		Size = UDim2.new(0.1, 0, 0, 40),
		Text = "VS",
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = T.Heavy,
		TextSize = 34,
		Parent = versus,
	})
	refs.Big = big
	refs.Small = small
	refs.Versus = versus
end

local announceToken = 0
function MatchHUD.Announce(bigText: string, smallText: string?, color: Color3?, duration: number?)
	announceToken += 1
	local token = announceToken
	refs.Big.Text = bigText
	refs.Big.TextColor3 = color or T.Text
	refs.Small.Text = smallText or ""
	refs.Big.TextTransparency = 1
	refs.Small.TextTransparency = 1
	refs.Big.TextSize = 130
	UIKit.Tween(refs.Big, 0.35, { TextTransparency = 0, TextSize = 96 }, Enum.EasingStyle.Back)
	UIKit.Tween(refs.Small, 0.35, { TextTransparency = 0 })
	task.delay(duration or 1.6, function()
		if token == announceToken then
			UIKit.Tween(refs.Big, 0.3, { TextTransparency = 1 })
			UIKit.Tween(refs.Small, 0.3, { TextTransparency = 1 })
		end
	end)
end

local function fillRoster(list: Frame, entries)
	for _, child in list:GetChildren() do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	for i, entry in entries do
		local isMe = entry.Id == player.UserId
		UIKit.Label({
			Size = UDim2.new(1, 0, 0, 24),
			TextXAlignment = Enum.TextXAlignment.Center,
			Text = entry.Name .. (if entry.IsBot then "  ·  REGULAR" else ""),
			TextColor3 = if isMe then T.Accent else (if entry.IsBot then T.Muted else T.Text),
			Font = if isMe then T.Heavy else T.Bold,
			TextSize = 18,
			LayoutOrder = i,
			Parent = list,
		})
	end
end

local function onMatchEvent(kind: string, payload)
	if kind == "MatchFound" then
		MatchHUD.Announce("MATCH FOUND", payload.PitchName .. " · 3v3", T.Accent, 1.4)
		task.delay(1.5, function()
			fillRoster(refs.RosterA, payload.Teams.A)
			fillRoster(refs.RosterB, payload.Teams.B)
			MatchHUD.Announce(Config.Teams.A.Name .. "  vs  " .. Config.Teams.B.Name, "Get ready", T.Text, 2.4)
			refs.Versus.Visible = true
			task.delay(2.5, function()
				refs.Versus.Visible = false
			end)
		end)
	elseif kind == "Countdown" then
		if payload.PitchId ~= player:GetAttribute("MatchId") then
			return
		end
		local seconds = payload.Seconds or 3
		task.spawn(function()
			for i = seconds, 1, -1 do
				MatchHUD.Announce(tostring(i), nil, T.Text, 0.8)
				task.wait(1)
			end
			MatchHUD.Announce("GO!", nil, T.Accent, 0.7)
		end)
	elseif kind == "Goal" then
		local inThisMatch = payload.PitchId == player:GetAttribute("MatchId")
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local nearby = root and payload.BallPosition and (root.Position - payload.BallPosition).Magnitude < SPECTATE_DISTANCE * 1.5
		if not inThisMatch and not nearby then
			return
		end
		local teamInfo = Config.Teams[payload.Team]
		local line
		if payload.OwnGoal then
			line = "Own goal!"
		elseif payload.Scorer then
			line = payload.Scorer .. (if payload.Assister then "  ·  assist " .. payload.Assister else "")
		end
		MatchHUD.Announce("GOAL!", line, teamInfo.Color, 3)
	end
end

local function nearestActiveMatch()
	local matches = ReplicatedStorage:FindFirstChild("Matches")
	if not matches then
		return nil
	end
	local myMatch = player:GetAttribute("MatchId")
	if myMatch then
		return matches:FindFirstChild(myMatch)
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return nil
	end
	for _, state in matches:GetChildren() do
		local s = state:GetAttribute("State")
		if s and s ~= "Idle" and s ~= "MatchFound" then
			local center = Vector3.new(state:GetAttribute("CenterX") or 0, root.Position.Y, state:GetAttribute("CenterZ") or 0)
			if (center - root.Position).Magnitude < SPECTATE_DISTANCE then
				return state
			end
		end
	end
	return nil
end

local lastUpdate = 0
local function update()
	local now = os.clock()
	if now - lastUpdate < 0.1 then
		return
	end
	lastUpdate = now
	local state = nearestActiveMatch()
	local s = state and state:GetAttribute("State")
	local show = s ~= nil and s ~= "Idle" and s ~= "MatchFound"
	refs.Board.Visible = show
	if not show then
		return
	end
	refs.Score.Text = string.format("%d — %d", state:GetAttribute("ScoreA") or 0, state:GetAttribute("ScoreB") or 0)
	local timeLeft
	local endsAt = state:GetAttribute("EndsAt") or 0
	if s == "Playing" and endsAt > 0 then
		timeLeft = endsAt - Workspace:GetServerTimeNow()
	else
		timeLeft = state:GetAttribute("TimeLeft") or 0
	end
	timeLeft = math.max(0, math.ceil(timeLeft))
	refs.Timer.Text = if s == "Ended" then "FULL TIME" else string.format("%d:%02d", timeLeft // 60, timeLeft % 60)
	refs.Timer.TextColor3 = if timeLeft <= 30 and s == "Playing" then T.Secondary else T.Accent
	refs.Timer.Size = if s == "Ended" then UDim2.fromOffset(130, 26) else UDim2.fromOffset(110, 26)
end

function MatchHUD.Create(gui: ScreenGui)
	buildScoreboard(gui)
	buildCenter(gui)
	Remotes.Get("MatchEvent").OnClientEvent:Connect(onMatchEvent)
	RunService.Heartbeat:Connect(update)
end

return MatchHUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">ProfilePanel</string>
              <string name="Source"><![CDATA[--[[
	ProfilePanel
	Level, title, reputation progress, lifetime stats and the attribute
	upgrade screen (points come from levelling up, never from purchases).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Progression = require(Shared.Progression)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.Parent.ClientState)
local UIKit = require(script.Parent.UIKit)

local T = UIKit.Theme
local new = UIKit.new

local ProfilePanel = {}

local player = Players.LocalPlayer
local frame: Frame
local refs = { Stats = {}, Attributes = {} }

local ATTRIBUTE_LABELS = {
	Pace = "PACE", Shooting = "SHOOTING", Passing = "PASSING", Dribbling = "DRIBBLING",
	BallControl = "BALL CONTROL", Defending = "DEFENDING", Physicality = "PHYSICAL", Stamina = "STAMINA",
}
local STAT_ORDER = {
	{ "Matches", "MATCHES" }, { "Wins", "WINS" }, { "Draws", "DRAWS" }, { "Losses", "LOSSES" },
	{ "Goals", "GOALS" }, { "Assists", "ASSISTS" }, { "Passes", "PASSES" }, { "Tackles", "TACKLES" },
	{ "SkillMoves", "SKILLS" }, { "BestWinStreak", "BEST STREAK" }, { "WinRate", "WIN RATE" },
}

local function refresh()
	local profile = ClientState.Profile
	if not profile or not frame then
		return
	end
	local tierIndex, tierName, nextMin = Progression.GetReputationTier(profile.Reputation)
	local tierMin = Progression.ReputationTiers[tierIndex].Min
	refs.Header.Text = string.format("LEVEL %d · %s", profile.Level, string.upper(Progression.GetTitle(profile.Level)))
	refs.RepText.Text = if nextMin
		then string.format("REPUTATION · %s  (%d / %d)", string.upper(tierName), profile.Reputation, nextMin)
		else string.format("REPUTATION · %s  (%d)", string.upper(tierName), profile.Reputation)
	refs.RepFill.Size = UDim2.fromScale(if nextMin then math.clamp((profile.Reputation - tierMin) / (nextMin - tierMin), 0, 1) else 1, 1)

	local s = profile.Stats
	for key, label in refs.Stats do
		if key == "WinRate" then
			label.Text = if s.Matches > 0 then string.format("%d%%", math.floor(s.Wins / s.Matches * 100 + 0.5)) else "—"
		else
			label.Text = UIKit.FormatNumber(s[key] or 0)
		end
	end

	refs.Points.Text = string.format("%d POINT%s TO SPEND", profile.AttributePoints, if profile.AttributePoints == 1 then "" else "S")
	refs.Points.TextColor3 = if profile.AttributePoints > 0 then T.Accent else T.Muted
	for name, r in refs.Attributes do
		local value = profile.Attributes[name] or Config.Attributes.Start
		r.Value.Text = tostring(value)
		r.Fill.Size = UDim2.fromScale(value / Config.Attributes.Max, 1)
		r.Plus.Visible = profile.AttributePoints > 0 and value < Config.Attributes.Max
	end
end

function ProfilePanel.Create(gui: ScreenGui, close: () -> ())
	frame = UIKit.Panel({
		Name = "Profile",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(820, 520),
		Visible = false,
		Parent = gui,
	})
	UIKit.Label({ Size = UDim2.new(1, -80, 0, 30), Position = UDim2.fromOffset(20, 12), Text = string.upper(player.DisplayName), Font = T.Heavy, TextSize = 28, Parent = frame })
	refs.Header = UIKit.Label({ Size = UDim2.new(1, -80, 0, 20), Position = UDim2.fromOffset(20, 44), TextColor3 = T.Accent, Font = T.Heavy, TextSize = 16, Text = "", Parent = frame })
	UIKit.Button({ Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -52, 0, 12), Text = "✕", Parent = frame }, close)

	refs.RepText = UIKit.Label({ Size = UDim2.new(0.5, -30, 0, 18), Position = UDim2.fromOffset(20, 74), TextColor3 = T.Muted, Font = T.Bold, TextSize = 13, Text = "", Parent = frame })
	local _, repFill = UIKit.Bar({ Size = UDim2.new(0.5, -30, 0, 8), Position = UDim2.fromOffset(20, 96), Parent = frame }, T.Secondary)
	refs.RepFill = repFill

	-- Stats grid (left)
	local stats = new("Frame", {
		Size = UDim2.new(0.5, -30, 1, -140),
		Position = UDim2.fromOffset(20, 120),
		BackgroundTransparency = 1,
		Parent = frame,
	}, { new("UIGridLayout", { CellSize = UDim2.fromOffset(120, 64), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
	for i, entry in STAT_ORDER do
		local cell = new("Frame", { BackgroundColor3 = T.PanelLight, LayoutOrder = i, Parent = stats }, { UIKit.Corner(10) })
		UIKit.Label({ Size = UDim2.new(1, -16, 0, 14), Position = UDim2.fromOffset(8, 8), TextColor3 = T.Muted, Font = T.Bold, TextSize = 11, Text = entry[2], Parent = cell })
		refs.Stats[entry[1]] = UIKit.Label({ Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 24), Font = T.Heavy, TextSize = 24, Text = "0", Parent = cell })
	end

	-- Attributes (right)
	local right = new("Frame", {
		Size = UDim2.new(0.5, -30, 1, -80),
		Position = UDim2.new(0.5, 10, 0, 70),
		BackgroundTransparency = 1,
		Parent = frame,
	})
	UIKit.Label({ Size = UDim2.new(1, 0, 0, 22), Text = "PLAYER ATTRIBUTES", Font = T.Heavy, TextSize = 18, Parent = right })
	refs.Points = UIKit.Label({ Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 24), Font = T.Bold, TextSize = 13, Text = "", Parent = right })
	for i, name in Config.Attributes.List do
		local y = 52 + (i - 1) * 46
		UIKit.Label({ Size = UDim2.new(0.5, 0, 0, 16), Position = UDim2.fromOffset(0, y), Text = ATTRIBUTE_LABELS[name] or name, Font = T.Bold, TextSize = 13, Parent = right })
		local value = UIKit.Label({ Size = UDim2.fromOffset(40, 16), Position = UDim2.new(1, -86, 0, y), Text = "50", TextXAlignment = Enum.TextXAlignment.Right, Font = T.Heavy, TextSize = 15, Parent = right })
		local _, fill = UIKit.Bar({ Size = UDim2.new(1, -50, 0, 10), Position = UDim2.fromOffset(0, y + 20), Parent = right }, T.Accent)
		local plus = UIKit.Button({
			Size = UDim2.fromOffset(36, 30),
			Position = UDim2.new(1, -38, 0, y),
			Text = "+",
			TextSize = 20,
			BackgroundColor3 = T.Accent,
			TextColor3 = T.AccentDark,
			Parent = right,
		}, function()
			pcall(function()
				Remotes.Get("SpendAttribute"):InvokeServer(name)
			end)
		end)
		refs.Attributes[name] = { Value = value, Fill = fill, Plus = plus }
	end
	UIKit.Label({
		Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.fromOffset(0, 52 + #Config.Attributes.List * 46),
		Text = "Earn points by levelling up. Attributes give small boosts; skill decides games.",
		TextWrapped = true,
		TextColor3 = T.Muted,
		Font = T.Medium,
		TextSize = 12,
		Parent = right,
	})

	ClientState.Changed:Connect(refresh)
end

function ProfilePanel.Open()
	frame.Visible = true
	refresh()
end

function ProfilePanel.Close()
	frame.Visible = false
end

return ProfilePanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">ResultsPanel</string>
              <string name="Source"><![CDATA[--[[
	ResultsPanel
	End-of-match screen: outcome, final score, your stat line, rewards with an
	animated XP bar, every player's line, and a one-click PLAY AGAIN.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Progression = require(Shared.Progression)
local Remotes = require(Shared.Remotes)

local UIKit = require(script.Parent.UIKit)

local T = UIKit.Theme
local new = UIKit.new

local ResultsPanel = {}

local player = Players.LocalPlayer
local frame: Frame
local refs = {}

local function clearList(list: Instance)
	for _, child in list:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

function ResultsPanel.Create(gui: ScreenGui, close: () -> ())
	frame = UIKit.Panel({
		Name = "Results",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(860, 540),
		Visible = false,
		Parent = gui,
	})
	refs.Outcome = UIKit.Label({ Size = UDim2.new(1, -40, 0, 60), Position = UDim2.fromOffset(20, 10), Font = T.Heavy, TextSize = 52, Text = "VICTORY", Parent = frame })
	refs.Score = UIKit.Label({ Size = UDim2.new(1, -40, 0, 26), Position = UDim2.fromOffset(22, 70), Font = T.Bold, TextSize = 20, TextColor3 = T.Muted, Text = "", Parent = frame })

	-- Left: your match + rewards
	local left = new("Frame", { Size = UDim2.new(0.42, -20, 1, -190), Position = UDim2.fromOffset(20, 110), BackgroundColor3 = T.Bg, Parent = frame }, { UIKit.Corner(12), UIKit.Padding(14) })
	UIKit.Label({ Size = UDim2.new(1, 0, 0, 20), Text = "YOUR MATCH", Font = T.Heavy, TextSize = 16, Parent = left })
	refs.MyLine = UIKit.Label({ Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 24), Font = T.Bold, TextSize = 14, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Text = "", Parent = left })
	UIKit.Label({ Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 78), Text = "REWARDS", Font = T.Heavy, TextSize = 16, Parent = left })
	refs.XP = UIKit.Label({ Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 102), Font = T.Heavy, TextSize = 18, TextColor3 = T.Accent, Text = "", Parent = left })
	refs.Kicks = UIKit.Label({ Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 126), Font = T.Heavy, TextSize = 18, TextColor3 = T.Gold, Text = "", Parent = left })
	refs.Rep = UIKit.Label({ Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 150), Font = T.Heavy, TextSize = 18, TextColor3 = T.Secondary, Text = "", Parent = left })
	refs.LevelText = UIKit.Label({ Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 184), Font = T.Bold, TextSize = 13, TextColor3 = T.Muted, Text = "", Parent = left })
	local _, xpFill = UIKit.Bar({ Size = UDim2.new(1, 0, 0, 10), Position = UDim2.fromOffset(0, 206), Parent = left }, T.Accent)
	refs.XPFill = xpFill

	-- Right: everyone's line
	local right = new("Frame", { Size = UDim2.new(0.58, -20, 1, -190), Position = UDim2.new(0.42, 10, 0, 110), BackgroundColor3 = T.Bg, Parent = frame }, { UIKit.Corner(12), UIKit.Padding(14) })
	UIKit.Label({ Size = UDim2.new(1, 0, 0, 20), Text = "PLAYER                         G    A    PASS  TKL", Font = T.Heavy, TextSize = 13, TextColor3 = T.Muted, Parent = right })
	refs.Table = new("Frame", { Size = UDim2.new(1, 0, 1, -26), Position = UDim2.fromOffset(0, 26), BackgroundTransparency = 1, Parent = right }, { UIKit.List(Enum.FillDirection.Vertical, 4) })

	-- Buttons
	UIKit.Button({
		Size = UDim2.fromOffset(240, 54),
		Position = UDim2.new(1, -260, 1, -70),
		Text = "PLAY AGAIN",
		TextSize = 20,
		BackgroundColor3 = T.Accent,
		TextColor3 = T.AccentDark,
		Parent = frame,
	}, function()
		Remotes.Get("RequestQueue"):FireServer(true)
		close()
	end)
	UIKit.Button({
		Size = UDim2.fromOffset(240, 54),
		Position = UDim2.new(1, -510, 1, -70),
		Text = "BACK TO THE GROUNDS",
		TextSize = 16,
		Parent = frame,
	}, close)
end

function ResultsPanel.Show(data)
	local outcomeText = if data.Aborted then "MATCH ENDED" elseif data.Outcome == "Win" then "VICTORY" elseif data.Outcome == "Draw" then "DRAW" else "DEFEAT"
	refs.Outcome.Text = outcomeText
	refs.Outcome.TextColor3 = if data.Outcome == "Win" then T.Accent elseif data.Outcome == "Draw" then T.Text else T.Secondary
	refs.Score.Text = string.format("%s %d — %d %s   ·   you played for %s", Config.Teams.A.Name, data.ScoreA, data.ScoreB, Config.Teams.B.Name, Config.Teams[data.MyTeam] and Config.Teams[data.MyTeam].Name or "?")

	local s = data.MyStats or {}
	refs.MyLine.Text = string.format("%d goals · %d assists · %d passes · %d tackles · %d shots · %d skills", s.Goals or 0, s.Assists or 0, s.Passes or 0, s.Tackles or 0, s.Shots or 0, s.SkillMoves or 0)

	local rewards = data.Rewards
	if rewards then
		refs.XP.Text = "+" .. UIKit.FormatNumber(rewards.XP) .. " XP"
		refs.Kicks.Text = "+" .. UIKit.FormatNumber(rewards.Kicks) .. " " .. Config.CurrencyName
		refs.Rep.Text = "+" .. rewards.Reputation .. " Reputation"
		local before, after = rewards.Before, rewards.After
		local leveled = after.Level > before.Level
		refs.LevelText.Text = if leveled then string.format("LEVEL UP!  %d → %d", before.Level, after.Level) else string.format("Level %d", after.Level)
		refs.LevelText.TextColor3 = if leveled then T.Accent else T.Muted
		refs.XPFill.Size = UDim2.fromScale(if leveled then 0 else before.XP / Progression.XPToNext(before.Level), 1)
		task.delay(0.4, function()
			UIKit.Tween(refs.XPFill, 1.2, { Size = UDim2.fromScale(math.clamp(after.XP / Progression.XPToNext(after.Level), 0, 1), 1) })
		end)
	else
		refs.XP.Text = "No rewards (match did not finish)"
		refs.Kicks.Text = ""
		refs.Rep.Text = ""
		refs.LevelText.Text = ""
		refs.XPFill.Size = UDim2.fromScale(0, 1)
	end

	clearList(refs.Table)
	for i, p in data.Players or {} do
		local color = Config.Teams[p.Team] and Config.Teams[p.Team].Color or T.Text
		local isMe = p.Id == player.UserId
		local rowFrame = new("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = if isMe then T.PanelLight else T.Panel, LayoutOrder = i, Parent = refs.Table }, { UIKit.Corner(6) })
		new("Frame", { Size = UDim2.new(0, 4, 1, -8), Position = UDim2.fromOffset(4, 4), BackgroundColor3 = color, Parent = rowFrame })
		UIKit.Label({
			Size = UDim2.new(0.55, -14, 1, 0),
			Position = UDim2.fromOffset(14, 0),
			Text = (if i == 1 then "★ " else "") .. p.Name .. (if p.IsBot then " (Regular)" else ""),
			TextTruncate = Enum.TextTruncate.AtEnd,
			Font = if isMe then T.Heavy else T.Bold,
			TextColor3 = if isMe then T.Accent else T.Text,
			TextSize = 14,
			Parent = rowFrame,
		})
		UIKit.Label({
			Size = UDim2.new(0.45, -10, 1, 0),
			Position = UDim2.new(0.55, 0, 0, 0),
			Text = string.format("%d    %d    %d    %d", p.Goals, p.Assists, p.Passes, p.Tackles),
			Font = T.Bold,
			TextSize = 14,
			Parent = rowFrame,
		})
	end

	frame.Visible = true
end

function ResultsPanel.Open()
	frame.Visible = true
end

function ResultsPanel.Close()
	frame.Visible = false
end

return ResultsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">SettingsPanel</string>
              <string name="Source"><![CDATA[--[[
	SettingsPanel
	Camera sensitivity, default match camera and control hints. Saved to the
	profile through UpdateSettings (server clamps values).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.Parent.ClientState)
local UIKit = require(script.Parent.UIKit)

local T = UIKit.Theme

local SettingsPanel = {}

local frame: Frame
local refs = {}
local settings = { CameraSensitivity = 1, CameraMode = "Follow", ShowControls = true }

local function push()
	Remotes.Get("UpdateSettings"):FireServer(settings)
	-- Apply locally right away; the server copy follows on the next profile sync.
	local profile = ClientState.Profile
	if profile then
		profile.Settings = table.clone(settings)
		ClientState.SetProfile(profile)
	end
end

local function refresh()
	refs.Sens.Text = string.format("%.1fx", settings.CameraSensitivity)
	refs.Mode.Text = string.upper(settings.CameraMode)
	refs.Hints.Text = if settings.ShowControls then "ON" else "OFF"
end

local function row(parent, y: number, label: string)
	UIKit.Label({ Size = UDim2.new(0.5, 0, 0, 40), Position = UDim2.fromOffset(20, y), Text = label, Font = T.Bold, TextSize = 16, Parent = parent })
end

function SettingsPanel.Create(gui: ScreenGui, close: () -> ())
	frame = UIKit.Panel({
		Name = "Settings",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(480, 300),
		Visible = false,
		Parent = gui,
	})
	UIKit.Label({ Size = UDim2.new(1, -80, 0, 30), Position = UDim2.fromOffset(20, 12), Text = "SETTINGS", Font = T.Heavy, TextSize = 26, Parent = frame })
	UIKit.Button({ Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -52, 0, 12), Text = "✕", Parent = frame }, close)

	row(frame, 70, "Camera sensitivity")
	UIKit.Button({ Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -170, 0, 70), Text = "−", Parent = frame }, function()
		settings.CameraSensitivity = math.max(0.2, math.floor((settings.CameraSensitivity - 0.1) * 10 + 0.5) / 10)
		refresh()
		push()
	end)
	refs.Sens = UIKit.Label({ Size = UDim2.fromOffset(70, 40), Position = UDim2.new(1, -126, 0, 70), TextXAlignment = Enum.TextXAlignment.Center, Font = T.Heavy, TextSize = 18, Text = "1.0x", Parent = frame })
	UIKit.Button({ Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -52, 0, 70), Text = "+", Parent = frame }, function()
		settings.CameraSensitivity = math.min(3, math.floor((settings.CameraSensitivity + 0.1) * 10 + 0.5) / 10)
		refresh()
		push()
	end)

	row(frame, 130, "Match camera (C)")
	refs.Mode = UIKit.Button({ Size = UDim2.fromOffset(158, 40), Position = UDim2.new(1, -170, 0, 130), Text = "FOLLOW", Parent = frame }, function()
		settings.CameraMode = if settings.CameraMode == "Follow" then "Broadcast" else "Follow"
		refresh()
		push()
	end)

	row(frame, 190, "Show control hints")
	refs.Hints = UIKit.Button({ Size = UDim2.fromOffset(158, 40), Position = UDim2.new(1, -170, 0, 190), Text = "ON", Parent = frame }, function()
		settings.ShowControls = not settings.ShowControls
		refresh()
		push()
	end)
end

function SettingsPanel.Open()
	local profile = ClientState.Profile
	if profile and profile.Settings then
		settings = table.clone(profile.Settings)
	end
	frame.Visible = true
	refresh()
end

function SettingsPanel.Close()
	frame.Visible = false
end

return SettingsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[--[[
	UIController
	Builds the whole interface into one ScreenGui and manages which full-screen
	panel is open (only one at a time). While a panel is open
	ClientState.MenuOpen is true, which unlocks the mouse in matches.
]]

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.Parent.ClientState)
local HUD = require(script.Parent.HUD)
local MatchHUD = require(script.Parent.MatchHUD)
local LockerPanel = require(script.Parent.LockerPanel)
local ProfilePanel = require(script.Parent.ProfilePanel)
local SettingsPanel = require(script.Parent.SettingsPanel)
local ResultsPanel = require(script.Parent.ResultsPanel)

local UIController = {}

local player = Players.LocalPlayer
local panels = {
	Locker = LockerPanel,
	Profile = ProfilePanel,
	Settings = SettingsPanel,
	Results = ResultsPanel,
}
local openPanel: string? = nil

function UIController.Close()
	if openPanel then
		panels[openPanel].Close()
		openPanel = nil
	end
	ClientState.MenuOpen = false
end

function UIController.Open(name: string)
	if name == "Play" then
		UIController.Close()
		if player:GetAttribute("QueuedPitch") then
			Remotes.Get("RequestQueue"):FireServer(false)
		else
			Remotes.Get("RequestQueue"):FireServer(true)
		end
		return
	end
	if openPanel == name then
		UIController.Close()
		return
	end
	-- Locker/Profile/Settings are hub-only; results can show anywhere.
	if name ~= "Results" and player:GetAttribute("MatchId") then
		return
	end
	UIController.Close()
	local panel = panels[name]
	if panel then
		openPanel = name
		ClientState.MenuOpen = true
		panel.Open()
	end
end

function UIController.ToggleMenu()
	if openPanel then
		UIController.Close()
	else
		UIController.Open("Profile")
	end
end

function UIController.Init() end

function UIController.Start()
	local gui = Instance.new("ScreenGui")
	gui.Name = "ConcreteKingsUI"
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	HUD.Create(gui, UIController.Open)
	MatchHUD.Create(gui)
	LockerPanel.Create(gui, UIController.Close)
	ProfilePanel.Create(gui, UIController.Close)
	SettingsPanel.Create(gui, UIController.Close)
	ResultsPanel.Create(gui, UIController.Close)

	ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
		if who == player and prompt:GetAttribute("OpensUI") then
			UIController.Open(prompt:GetAttribute("OpensUI"))
		end
	end)

	Remotes.Get("MatchEvent").OnClientEvent:Connect(function(kind, payload)
		if kind == "MatchFound" then
			UIController.Close()
		elseif kind == "Results" then
			task.delay(1.2, function()
				UIController.Close()
				openPanel = "Results"
				ClientState.MenuOpen = true
				ResultsPanel.Show(payload)
			end)
		end
	end)
end

return UIController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">UIKit</string>
              <string name="Source"><![CDATA[--[[
	UIKit
	Tiny helpers + the Concrete Kings visual identity: charcoal glass panels,
	volt-green accent, ember-orange secondary, heavy condensed type.
]]

local TweenService = game:GetService("TweenService")

local UIKit = {}

UIKit.Theme = {
	Bg = Color3.fromRGB(14, 15, 19),
	Panel = Color3.fromRGB(22, 24, 30),
	PanelLight = Color3.fromRGB(34, 37, 46),
	Stroke = Color3.fromRGB(60, 64, 76),
	Text = Color3.fromRGB(245, 246, 250),
	Muted = Color3.fromRGB(150, 155, 170),
	Accent = Color3.fromRGB(205, 255, 64),
	AccentDark = Color3.fromRGB(26, 32, 8),
	Secondary = Color3.fromRGB(255, 110, 54),
	Danger = Color3.fromRGB(255, 72, 88),
	Gold = Color3.fromRGB(240, 196, 70),
	Heavy = Enum.Font.GothamBlack,
	Bold = Enum.Font.GothamBold,
	Medium = Enum.Font.GothamMedium,
}

local T = UIKit.Theme

function UIKit.new(className: string, props, children)
	local inst = Instance.new(className)
	if inst:IsA("GuiObject") then
		(inst :: GuiObject).BorderSizePixel = 0
	end
	for k, v in props or {} do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function UIKit.Corner(radius: number?)
	return UIKit.new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function UIKit.Stroke(color: Color3?, thickness: number?, transparency: number?)
	return UIKit.new("UIStroke", {
		Color = color or T.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UIKit.Padding(px: number)
	return UIKit.new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
	})
end

function UIKit.List(direction: Enum.FillDirection?, padding: number?, align: Enum.HorizontalAlignment?)
	return UIKit.new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
	})
end

function UIKit.Panel(props)
	local frame = UIKit.new("Frame", {
		BackgroundColor3 = T.Panel,
		BackgroundTransparency = 0.08,
	})
	for k, v in props do
		if k ~= "Parent" then
			(frame :: any)[k] = v
		end
	end
	UIKit.Corner(14).Parent = frame
	UIKit.Stroke(T.Stroke, 1, 0.3).Parent = frame
	frame.Parent = props.Parent
	return frame
end

function UIKit.Label(props)
	local label = UIKit.new("TextLabel", {
		BackgroundTransparency = 1,
		TextColor3 = T.Text,
		Font = T.Bold,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	for k, v in props do
		if k ~= "Parent" then
			(label :: any)[k] = v
		end
	end
	label.Parent = props.Parent
	return label
end

function UIKit.Button(props, onClick: () -> ())
	local button = UIKit.new("TextButton", {
		BackgroundColor3 = T.PanelLight,
		TextColor3 = T.Text,
		Font = T.Heavy,
		TextSize = 16,
		AutoButtonColor = false,
	})
	for k, v in props do
		if k ~= "Parent" then
			(button :: any)[k] = v
		end
	end
	UIKit.Corner(10).Parent = button
	local base = button.BackgroundColor3
	button.MouseEnter:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.12), { BackgroundColor3 = base:Lerp(Color3.new(1, 1, 1), 0.12) }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.12), { BackgroundColor3 = base }):Play()
	end)
	button.Activated:Connect(onClick)
	button.Parent = props.Parent
	return button
end

-- Horizontal progress bar. Returns container, fill.
function UIKit.Bar(props, fillColor: Color3)
	local back = UIKit.new("Frame", {
		BackgroundColor3 = Color3.fromRGB(40, 42, 52),
	})
	for k, v in props do
		if k ~= "Parent" then
			(back :: any)[k] = v
		end
	end
	UIKit.Corner(6).Parent = back
	local fill = UIKit.new("Frame", {
		Name = "Fill",
		BackgroundColor3 = fillColor,
		Size = UDim2.fromScale(0, 1),
		Parent = back,
	})
	UIKit.Corner(6).Parent = fill
	back.Parent = props.Parent
	return back, fill
end

function UIKit.Tween(inst: Instance, time: number, goal, style: Enum.EasingStyle?)
	local tween = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), goal)
	tween:Play()
	return tween
end

function UIKit.FormatNumber(n: number): string
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	return formatted
end

return UIKit
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="45">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
