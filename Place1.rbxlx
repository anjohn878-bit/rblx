    <Item class="Folder" referent="3519">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="3520">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Central tuning for "Become a Delivery Driver".

	Everything a designer would want to tweak - ranks, vehicles, payouts, timers,
	town size - lives here so balance changes never need code changes elsewhere.
]]

local Config = {}

Config.GameName = "Become a Delivery Driver"
Config.DataStoreName = "BecomeADeliveryDriver_v1"
Config.AutosaveInterval = 60

-- Town layout (studs). WorldBuilder derives everything else from these. --------
Config.World = {
	Blocks = 5, -- blocks per side (odd, so the depot can sit in the middle)
	BlockSize = 150,
	RoadWidth = 36,
	SidewalkWidth = 8,
	GroundMargin = 120, -- grass beyond the outer roads
	HousesPerRow = 3,
}

-- Late-afternoon lighting (applied by the server at startup and baked into the place).
Config.Lighting = {
	ClockTime = 16.2,
	Brightness = 2.6,
	GeographicLatitude = 35,
}

-- Gameplay rules ------------------------------------------------------------
Config.DeliveryRadius = 14 -- how close to the marker counts as "arrived"
Config.DeliveryMaxSpeed = 38 -- must be slower than this to hand over the package
Config.OrderFailGrace = 45 -- seconds past the deadline before the customer cancels
Config.SummonCooldown = 2.5
Config.MaxPlausibleSpeed = 170 -- anti-cheat: nobody legitimately beats this (studs/s)
Config.StartingCash = 0

-- Economy -------------------------------------------------------------------
Config.Economy = {
	BasePay = 18,
	PayPerStud = 0.11,
	TimeBase = 20, -- seconds of slack on every order
	TimeSpeedFactor = 0.62, -- fraction of top speed we assume the driver averages
	TimeBonusMax = 0.35, -- up to +35% for a fast run
	StreakStep = 0.05, -- +5% per consecutive on-time delivery
	StreakMax = 0.5,
	XPBase = 12,
	XPPerStud = 0.02,
	XPPerStar = 4,
	LateXPMult = 0.5,
	TipByStars = { [1] = 0, [2] = 0, [3] = 0.08, [4] = 0.15, [5] = 0.25 },
	-- stars from (time used / time limit)
	StarThresholds = { 0.55, 0.75, 1.0, 1.35 }, -- <= each of these gives 5,4,3,2 stars; above gives 1
}

-- Ranks: more XP unlocks longer, better-paying orders ---------------------------
Config.Ranks = {
	{ Name = "Rookie", XP = 0, PayMult = 1.00, MinDist = 140, MaxDist = 420 },
	{ Name = "Courier", XP = 120, PayMult = 1.10, MinDist = 160, MaxDist = 560 },
	{ Name = "Driver", XP = 350, PayMult = 1.22, MinDist = 200, MaxDist = 720 },
	{ Name = "Pro Driver", XP = 800, PayMult = 1.38, MinDist = 260, MaxDist = 900 },
	{ Name = "Elite Courier", XP = 1600, PayMult = 1.55, MinDist = 320, MaxDist = 1100 },
	{ Name = "Road Legend", XP = 3000, PayMult = 1.80, MinDist = 380, MaxDist = 1300 },
	{ Name = "Delivery Master", XP = 5500, PayMult = 2.10, MinDist = 450, MaxDist = 1500 },
}

-- What's in the box. Fragile/hot stuff gets less time but pays more. ---------------
Config.Packages = {
	{ Name = "Pizza", TimeMult = 0.85, PayMult = 1.15 },
	{ Name = "Groceries", TimeMult = 1.00, PayMult = 1.00 },
	{ Name = "Parcel", TimeMult = 1.10, PayMult = 0.95 },
	{ Name = "Flowers", TimeMult = 0.90, PayMult = 1.10 },
	{ Name = "Birthday Cake", TimeMult = 0.85, PayMult = 1.20 },
	{ Name = "Electronics", TimeMult = 1.00, PayMult = 1.25 },
	{ Name = "Hot Takeout", TimeMult = 0.80, PayMult = 1.15 },
	{ Name = "Medicine", TimeMult = 0.90, PayMult = 1.10 },
}

-- Vehicles ------------------------------------------------------------------
-- MaxSpeed: studs/s. Accel: studs/s^2. Turn: rad/s at low speed. Grip: how quickly
-- sideways slide is killed (higher = more planted, lower = driftier).
-- The 3D model for each Id is designed in VehicleBuilder.
Config.Vehicles = {
	{
		Id = "Scooter",
		Name = "Delivery Scooter",
		Description = "Zippy and free. Every legend starts here.",
		Price = 0,
		RankRequired = 1,
		MaxSpeed = 46,
		Accel = 32,
		Turn = 2.9,
		Grip = 7,
		PayBonus = 0,
	},
	{
		Id = "Hatchback",
		Name = "City Hatch",
		Description = "A proper little car. Quicker and sturdier than the scooter.",
		Price = 450,
		RankRequired = 1,
		MaxSpeed = 62,
		Accel = 40,
		Turn = 2.5,
		Grip = 5.5,
		PayBonus = 0,
	},
	{
		Id = "Van",
		Name = "Cargo Van",
		Description = "Room for more parcels: +10% on every payout.",
		Price = 1400,
		RankRequired = 2,
		MaxSpeed = 70,
		Accel = 36,
		Turn = 2.1,
		Grip = 4.8,
		PayBonus = 0.10,
	},
	{
		Id = "Roadster",
		Name = "Street Roadster",
		Description = "Open-top speed machine. Hold on tight.",
		Price = 3800,
		RankRequired = 4,
		MaxSpeed = 92,
		Accel = 55,
		Turn = 2.6,
		Grip = 4.2,
		PayBonus = 0,
	},
	{
		Id = "Hyper",
		Name = "Hyper Courier",
		Description = "The fastest thing on four wheels. Barely legal.",
		Price = 11000,
		RankRequired = 6,
		MaxSpeed = 118,
		Accel = 70,
		Turn = 2.4,
		Grip = 3.8,
		PayBonus = 0.05,
	},
}

Config.VehicleById = {}
for _, vehicle in Config.Vehicles do
	Config.VehicleById[vehicle.Id] = vehicle
end
Config.DefaultVehicle = Config.Vehicles[1].Id

-- Street names. Rows run east-west, columns run north-south. ---------------------
Config.StreetNames = { "Maple St", "Oak St", "Pine St", "Cedar St", "Elm St", "Birch St" }
Config.AvenueNames = { "1st Ave", "2nd Ave", "3rd Ave", "4th Ave", "5th Ave", "6th Ave" }

return Config
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3521">
        <Properties>
          <string name="Name">Economy</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Pure money / XP / rank maths. No engine calls, so it is unit-tested outside Roblox
	(see tests/). Positions only need .X and .Z fields, so Vector3s and plain tables both work.
]]

local Config = require(script.Parent.Config)

local Economy = {}

local E = Config.Economy

-- Ranks -------------------------------------------------------------------------

function Economy.rankIndexForXp(xp: number): number
	local index = 1
	for i, rank in Config.Ranks do
		if xp >= rank.XP then
			index = i
		else
			break
		end
	end
	return index
end

-- Everything the HUD needs to draw the XP bar.
function Economy.rankInfo(xp: number)
	local index = Economy.rankIndexForXp(xp)
	local rank = Config.Ranks[index]
	local nextRank = Config.Ranks[index + 1]
	local fraction = 1
	if nextRank then
		fraction = (xp - rank.XP) / (nextRank.XP - rank.XP)
	end
	return {
		Index = index,
		Name = rank.Name,
		XPStart = rank.XP,
		XPNext = nextRank and nextRank.XP or nil,
		Fraction = math.clamp(fraction, 0, 1),
		PayMult = rank.PayMult,
	}
end

-- Orders ------------------------------------------------------------------------

-- Cars can't cut across blocks, so distance along the street grid is what matters.
function Economy.routeDistance(a, b): number
	return math.abs(a.X - b.X) + math.abs(a.Z - b.Z)
end

function Economy.timeLimit(distance: number, vehicleMaxSpeed: number, package): number
	local seconds = E.TimeBase + distance / (vehicleMaxSpeed * E.TimeSpeedFactor)
	return math.floor(seconds * package.TimeMult + 0.5)
end

function Economy.basePay(distance: number, rank, package, vehicle): number
	local pay = (E.BasePay + distance * E.PayPerStud) * rank.PayMult * package.PayMult
	pay *= 1 + (vehicle.PayBonus or 0)
	return math.floor(pay + 0.5)
end

function Economy.stars(timeUsed: number, timeLimit: number): number
	local ratio = timeUsed / timeLimit
	local thresholds = E.StarThresholds
	if ratio <= thresholds[1] then
		return 5
	elseif ratio <= thresholds[2] then
		return 4
	elseif ratio <= thresholds[3] then
		return 3
	elseif ratio <= thresholds[4] then
		return 2
	end
	return 1
end

-- The least time any legitimate driver could need; used to ignore teleport-style cheating.
function Economy.minTravelTime(distance: number): number
	return distance / Config.MaxPlausibleSpeed
end

-- Works out what a finished delivery earns.
-- order needs: Distance, TimeLimit, BasePay.  streakBefore = on-time deliveries in a row so far.
function Economy.settle(order, timeUsed: number, streakBefore: number)
	local onTime = timeUsed <= order.TimeLimit
	local stars = Economy.stars(timeUsed, order.TimeLimit)
	local base = order.BasePay

	local timeBonus, tip, streakBonus = 0, 0, 0
	if onTime then
		local ratio = timeUsed / order.TimeLimit
		local fraction = math.clamp((1 - ratio) / 0.5, 0, 1)
		timeBonus = math.floor(base * E.TimeBonusMax * fraction + 0.5)
		tip = math.floor(base * (E.TipByStars[stars] or 0) + 0.5)
		streakBonus = math.floor(base * math.min(E.StreakMax, streakBefore * E.StreakStep) + 0.5)
	end

	local xp = (E.XPBase + order.Distance * E.XPPerStud) * (onTime and 1 or E.LateXPMult) + stars * E.XPPerStar

	return {
		OnTime = onTime,
		Stars = stars,
		Base = base,
		TimeBonus = timeBonus,
		Tip = tip,
		StreakBonus = streakBonus,
		Total = base + timeBonus + tip + streakBonus,
		XP = math.floor(xp + 0.5),
	}
end

-- Formatting (kept here so server toasts and client UI agree) ---------------------

function Economy.formatMoney(amount: number): string
	local n = math.floor(amount + 0.5)
	local negative = n < 0
	local digits = tostring(math.abs(n))
	-- insert thousands separators
	local out = digits:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return (negative and "-$" or "$") .. out
end

function Economy.formatTime(seconds: number): string
	seconds = math.max(0, math.floor(seconds + 0.5))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

return Economy
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3522">
        <Properties>
          <string name="Name">Remotes</string>
          <ProtectedString name="Source"><![CDATA[--[[
	One place that declares every RemoteEvent / RemoteFunction.
	The server creates them the first time this module is required; clients wait for them.

	  Notify          server -> client   (message: string, kind: "info" | "success" | "warn" | "error")
	  DeliveryResult  server -> client   (result: table, see OrderService)
	  OpenGarage      server -> client   (no args)
	  CallVehicle     client -> server   (no args)
	  CancelOrder     client -> server   (no args)
	  GarageRequest   client -> server   (action: "Buy" | "Equip", vehicleId: string) -> { ok, message }
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = { "Notify", "DeliveryResult", "OpenGarage", "CallVehicle", "CancelOrder" }
local FUNCTIONS = { "GarageRequest" }

local Remotes = {}

if RunService:IsServer() then
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		for _, name in EVENTS do
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
		for _, name in FUNCTIONS do
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
		folder.Parent = ReplicatedStorage
	end
end

local folder = ReplicatedStorage:WaitForChild("Remotes")
for _, name in EVENTS do
	Remotes[name] = folder:WaitForChild(name)
end
for _, name in FUNCTIONS do
	Remotes[name] = folder:WaitForChild(name)
end

return Remotes
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3523">
        <Properties>
          <string name="Name">VehicleBuilder</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Builds vehicle models out of plain Parts (no asset ids needed).

	Used by the server to spawn drivable vehicles and by the garage UI to render previews.

	Layout of a built model (local space, chassis at the origin, front of the car points -Z):

	  Chassis      invisible collision hull; PrimaryPart. The only part that collides with the world.
	  Seat         VehicleSeat the driver sits in. Throttle/steer input is read from it.
	  Wheel_xx     cosmetic wheels joined to the chassis by Motor6Ds; clients spin them via Transform.
	  (everything else) cosmetic body panels, welded to the chassis, massless, non-colliding.

	Model attributes: VehicleId, MaxSpeed, Accel, Turn, Grip, WheelRadius, HullHalfHeight.
	HullHalfHeight is how far the chassis centre must sit above the ground.
]]

local Config = require(script.Parent.Config)

local VehicleBuilder = {}

-- Palette -------------------------------------------------------------------
local TYRE = Color3.fromRGB(28, 28, 32)
local SILVER = Color3.fromRGB(200, 204, 212)
local DARK = Color3.fromRGB(40, 42, 50)
local GLASS = Color3.fromRGB(150, 205, 235)
local ORANGE = Color3.fromRGB(255, 159, 28)
local HEADLIGHT = Color3.fromRGB(255, 244, 190)
local TAILLIGHT = Color3.fromRGB(255, 60, 60)

-- Designs -------------------------------------------------------------------
-- All heights ("G" suffix) are measured up from the ground.
local DESIGNS = {
	Hatchback = {
		Kind = "car",
		Width = 7,
		Length = 13,
		WheelRadius = 1.3,
		WheelWidth = 1.0,
		FloorG = 1.0,
		WaistH = 1.8,
		HoodLen = 4.5,
		RearLen = 3.2,
		Roof = true,
		Sign = "roof",
		BodyColor = Color3.fromRGB(222, 62, 62),
		AccentColor = Color3.fromRGB(245, 245, 248),
	},
	Van = {
		Kind = "car",
		Width = 8,
		Length = 16,
		WheelRadius = 1.5,
		WheelWidth = 1.1,
		FloorG = 1.2,
		WaistH = 2.0,
		HoodLen = 3.0,
		RearLen = 8.0,
		CargoHeight = 6.2,
		Roof = true,
		Sign = "roof",
		BodyColor = Color3.fromRGB(240, 242, 247),
		AccentColor = ORANGE,
	},
	Roadster = {
		Kind = "car",
		Width = 7.4,
		Length = 14.2,
		WheelRadius = 1.2,
		WheelWidth = 1.1,
		FloorG = 0.7,
		WaistH = 1.6,
		HoodLen = 5.5,
		RearLen = 2.8,
		Roof = false,
		Spoiler = true,
		Sign = "box",
		BodyColor = Color3.fromRGB(255, 196, 0),
		AccentColor = Color3.fromRGB(30, 30, 36),
	},
	Hyper = {
		Kind = "car",
		Width = 8,
		Length = 15.5,
		WheelRadius = 1.25,
		WheelWidth = 1.3,
		FloorG = 0.55,
		WaistH = 1.4,
		HoodLen = 6.2,
		RearLen = 3.0,
		Roof = false,
		Spoiler = true,
		Underglow = Color3.fromRGB(0, 230, 255),
		Sign = "box",
		BodyColor = Color3.fromRGB(26, 26, 34),
		AccentColor = Color3.fromRGB(0, 230, 255),
	},
	Scooter = {
		Kind = "scooter",
		BodyColor = ORANGE,
		AccentColor = Color3.fromRGB(245, 245, 248),
	},
}

-- Helpers -------------------------------------------------------------------

type Ctx = { Model: Model, Chassis: Part, HalfHeight: number }

local function newPart(ctx: Ctx, name: string, size: Vector3, position: Vector3, color: Color3, material: Enum.Material?): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = CFrame.new(position)
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = false
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = ctx.Model

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = ctx.Chassis
	weld.Part1 = part
	weld.Parent = part
	return part
end

local function addText(part: Part, face: Enum.NormalId, text: string, textColor: Color3, backColor: Color3?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = backColor and 0 or 1
	if backColor then
		label.BackgroundColor3 = backColor
	end
	label.Text = text
	label.TextColor3 = textColor
	label.TextScaled = true
	label.FontFace = Font.fromEnum(Enum.Font.GothamBold) -- FontFace (not Font) so the label can be saved into the place file
	label.Parent = gui
end

local function addWheel(ctx: Ctx, name: string, offset: Vector3, radius: number, width: number, front: boolean)
	local wheel = Instance.new("Part")
	wheel.Name = name
	wheel.Shape = Enum.PartType.Cylinder -- cylinder axis runs along X, which is the axle direction
	wheel.Size = Vector3.new(width, radius * 2, radius * 2)
	wheel.CFrame = CFrame.new(offset)
	wheel.Color = TYRE
	wheel.Material = Enum.Material.SmoothPlastic
	wheel.Anchored = false
	wheel.CanCollide = false
	wheel.CanTouch = false
	wheel.CanQuery = false
	wheel.Massless = true
	wheel.Parent = ctx.Model

	-- Two silver spokes so you can actually see the wheel turning.
	for i, spokeSize in
		{
			Vector3.new(width + 0.12, 0.45, radius * 1.5),
			Vector3.new(width + 0.12, radius * 1.5, 0.45),
		}
	do
		local spoke = Instance.new("Part")
		spoke.Name = "Spoke" .. i
		spoke.Size = spokeSize
		spoke.CFrame = CFrame.new(offset)
		spoke.Color = SILVER
		spoke.Material = Enum.Material.Metal
		spoke.Anchored = false
		spoke.CanCollide = false
		spoke.CanTouch = false
		spoke.CanQuery = false
		spoke.Massless = true
		spoke.Parent = ctx.Model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = wheel
		weld.Part1 = spoke
		weld.Parent = spoke
	end

	local motor = Instance.new("Motor6D")
	motor.Name = name
	motor.Part0 = ctx.Chassis
	motor.Part1 = wheel
	motor.C0 = CFrame.new(offset)
	motor.C1 = CFrame.new()
	motor:SetAttribute("Front", front)
	motor:SetAttribute("Radius", radius)
	motor.Parent = ctx.Chassis
end

local function newModel(spec, hullSize: Vector3): (Ctx, Model)
	local model = Instance.new("Model")
	model.Name = spec.Id

	local chassis = Instance.new("Part")
	chassis.Name = "Chassis"
	chassis.Size = hullSize
	chassis.CFrame = CFrame.new()
	chassis.Transparency = 1
	chassis.CanCollide = true
	chassis.CanQuery = false
	chassis.Anchored = false
	chassis.TopSurface = Enum.SurfaceType.Smooth
	chassis.BottomSurface = Enum.SurfaceType.Smooth
	-- Slippery so the arcade controller, not friction, decides how the car moves.
	chassis.CustomPhysicalProperties = PhysicalProperties.new(2.5, 0, 0, 100, 100)
	chassis.Parent = model
	model.PrimaryPart = chassis

	model:SetAttribute("VehicleId", spec.Id)
	model:SetAttribute("MaxSpeed", spec.MaxSpeed)
	model:SetAttribute("Accel", spec.Accel)
	model:SetAttribute("Turn", spec.Turn)
	model:SetAttribute("Grip", spec.Grip)
	model:SetAttribute("HullHalfHeight", hullSize.Y / 2)

	return { Model = model, Chassis = chassis, HalfHeight = hullSize.Y / 2 }, model
end

local function newSeat(ctx: Ctx, size: Vector3, position: Vector3): VehicleSeat
	local seat = Instance.new("VehicleSeat")
	seat.Name = "Seat"
	seat.Size = size
	seat.CFrame = CFrame.new(position)
	seat.Color = DARK
	seat.Material = Enum.Material.Fabric
	seat.Anchored = false
	seat.CanCollide = false
	seat.CanQuery = false
	seat.Massless = true
	seat.HeadsUpDisplay = false
	seat.MaxSpeed = 0 -- we drive the car ourselves; the built-in wheel motor logic is unused
	seat.TopSurface = Enum.SurfaceType.Smooth
	seat.BottomSurface = Enum.SurfaceType.Smooth
	seat.Parent = ctx.Model

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = ctx.Chassis
	weld.Part1 = seat
	weld.Parent = seat
	return seat
end

-- Car -----------------------------------------------------------------------

local function buildCar(spec, d)
	local width, length, wr = d.Width, d.Length, d.WheelRadius
	-- Collision hull: roughly wheel height, but always below the floor so the rider never sits inside it.
	local hullHeight = math.min(wr * 1.3, d.FloorG + 0.45)
	local ctx, model = newModel(spec, Vector3.new(width * 0.95, hullHeight, length * 0.97))
	local hh = ctx.HalfHeight

	-- Convert "height above ground" into chassis-local Y.
	local function Y(g: number): number
		return g - hh
	end

	local frontZ, rearZ = -length / 2, length / 2
	local floorTopG = d.FloorG + 0.5
	local seatTopG = floorTopG + 0.25
	local waistTopG = floorTopG + d.WaistH
	local cabinFrontZ = frontZ + d.HoodLen
	local cabinRearZ = rearZ - d.RearLen
	local cabinLen = cabinRearZ - cabinFrontZ
	local body, accent = d.BodyColor, d.AccentColor

	-- Floor, hood, and the block behind the cabin.
	newPart(ctx, "Floor", Vector3.new(width * 0.96, 0.5, length), Vector3.new(0, Y(d.FloorG + 0.25), 0), DARK)
	newPart(ctx, "Hood", Vector3.new(width, d.WaistH, d.HoodLen), Vector3.new(0, Y(floorTopG + d.WaistH / 2), frontZ + d.HoodLen / 2), body)
	newPart(ctx, "HoodStripe", Vector3.new(width * 0.3, 0.1, d.HoodLen * 0.98), Vector3.new(0, Y(waistTopG + 0.05), frontZ + d.HoodLen / 2), accent)

	local cargoHeight = d.CargoHeight
	if cargoHeight then
		newPart(ctx, "CargoBox", Vector3.new(width, cargoHeight, d.RearLen), Vector3.new(0, Y(floorTopG + cargoHeight / 2), rearZ - d.RearLen / 2), body)
		-- Orange stripe + branding on both sides and the back door.
		for _, sx in { -1, 1 } do
			local stripe = newPart(
				ctx,
				"CargoStripe",
				Vector3.new(0.12, 1.1, d.RearLen * 0.96),
				Vector3.new(sx * (width / 2 + 0.05), Y(floorTopG + cargoHeight * 0.45), rearZ - d.RearLen / 2),
				accent
			)
			addText(stripe, sx > 0 and Enum.NormalId.Right or Enum.NormalId.Left, "SWIFT DROP", Color3.new(1, 1, 1))
		end
		newPart(ctx, "CargoRearStripe", Vector3.new(width * 0.9, 1.1, 0.12), Vector3.new(0, Y(floorTopG + cargoHeight * 0.45), rearZ + 0.05), accent)
		newPart(
			ctx,
			"CargoRoofTrim",
			Vector3.new(width + 0.2, 0.3, d.RearLen + 0.2),
			Vector3.new(0, Y(floorTopG + cargoHeight + 0.1), rearZ - d.RearLen / 2),
			accent
		)
	else
		newPart(ctx, "Trunk", Vector3.new(width, d.WaistH, d.RearLen), Vector3.new(0, Y(floorTopG + d.WaistH / 2), rearZ - d.RearLen / 2), body)
	end

	-- Door panels either side of the driver.
	for _, sx in { -1, 1 } do
		newPart(
			ctx,
			"Door",
			Vector3.new(0.5, d.WaistH, cabinLen),
			Vector3.new(sx * (width / 2 - 0.25), Y(floorTopG + d.WaistH / 2), cabinFrontZ + cabinLen / 2),
			body
		)
		newPart(ctx, "DoorTrim", Vector3.new(0.55, 0.2, cabinLen), Vector3.new(sx * (width / 2 - 0.25), Y(waistTopG - 0.1), cabinFrontZ + cabinLen / 2), accent)
	end

	-- Driver seat (+ backrest).
	local seatZ = cabinFrontZ + cabinLen * 0.55
	newSeat(ctx, Vector3.new(2.6, 0.5, 2.4), Vector3.new(0, Y(seatTopG - 0.25), seatZ))
	newPart(ctx, "Backrest", Vector3.new(2.6, 2.2, 0.4), Vector3.new(0, Y(seatTopG + 1.1), seatZ + 1.4), DARK, Enum.Material.Fabric)

	-- Windscreen.
	local roofUnderG = seatTopG + 4.3
	local glassHeight = d.Roof and (roofUnderG - waistTopG) or 2.2
	local windscreen = newPart(
		ctx,
		"Windscreen",
		Vector3.new(width - 0.8, glassHeight, 0.25),
		Vector3.new(0, Y(waistTopG + glassHeight / 2), cabinFrontZ),
		GLASS,
		Enum.Material.Glass
	)
	windscreen.Transparency = 0.55

	if d.Roof then
		local roofLen = cabinLen + 0.8
		newPart(ctx, "Roof", Vector3.new(width - 0.2, 0.4, roofLen), Vector3.new(0, Y(roofUnderG + 0.2), cabinFrontZ + cabinLen / 2 + 0.2), body)
		local pillarHeight = roofUnderG - waistTopG
		for _, sx in { -1, 1 } do
			for _, pz in { cabinFrontZ + 0.2, cabinRearZ - 0.2 } do
				newPart(ctx, "Pillar", Vector3.new(0.45, pillarHeight, 0.45), Vector3.new(sx * (width / 2 - 0.4), Y(waistTopG + pillarHeight / 2), pz), accent)
			end
		end
		if d.Sign == "roof" then
			local sign = newPart(
				ctx,
				"RoofSign",
				Vector3.new(3.8, 1, 1.4),
				Vector3.new(0, Y(roofUnderG + 0.4 + 0.5), cabinFrontZ + cabinLen / 2),
				ORANGE,
				Enum.Material.Neon
			)
			addText(sign, Enum.NormalId.Front, "DELIVERY", Color3.fromRGB(30, 30, 36))
			addText(sign, Enum.NormalId.Back, "DELIVERY", Color3.fromRGB(30, 30, 36))
		end
	elseif d.Sign == "box" then
		local boxHeight = 1.7
		local box = newPart(
			ctx,
			"DeliveryBox",
			Vector3.new(3.6, boxHeight, math.min(2.4, d.RearLen - 0.4)),
			Vector3.new(0, Y(waistTopG + boxHeight / 2), rearZ - d.RearLen / 2),
			ORANGE
		)
		addText(box, Enum.NormalId.Back, "DELIVERY", Color3.fromRGB(30, 30, 36))
	end

	if d.Spoiler then
		local wingG = waistTopG + 1.9
		newPart(ctx, "Wing", Vector3.new(width - 0.6, 0.3, 1.8), Vector3.new(0, Y(wingG), rearZ - 0.4), accent)
		for _, sx in { -1, 1 } do
			newPart(
				ctx,
				"WingStrut",
				Vector3.new(0.4, wingG - waistTopG, 0.4),
				Vector3.new(sx * (width / 2 - 1.3), Y(waistTopG + (wingG - waistTopG) / 2), rearZ - 0.4),
				accent
			)
		end
	end

	if d.Underglow then
		for _, sx in { -1, 1 } do
			newPart(
				ctx,
				"Underglow",
				Vector3.new(0.25, 0.2, length * 0.55),
				Vector3.new(sx * (width / 2 + 0.05), Y(d.FloorG - 0.1), 0),
				d.Underglow,
				Enum.Material.Neon
			)
		end
	end

	-- Bumpers and lights.
	newPart(ctx, "FrontBumper", Vector3.new(width + 0.2, 0.7, 0.5), Vector3.new(0, Y(d.FloorG + 0.45), frontZ - 0.2), DARK)
	newPart(ctx, "RearBumper", Vector3.new(width + 0.2, 0.7, 0.5), Vector3.new(0, Y(d.FloorG + 0.45), rearZ + 0.2), DARK)
	for _, sx in { -1, 1 } do
		newPart(
			ctx,
			"Headlight",
			Vector3.new(1.5, 0.8, 0.3),
			Vector3.new(sx * (width / 2 - 1.6), Y(floorTopG + d.WaistH * 0.55), frontZ - 0.1),
			HEADLIGHT,
			Enum.Material.Neon
		)
		newPart(
			ctx,
			"Taillight",
			Vector3.new(1.2, 0.6, 0.3),
			Vector3.new(sx * (width / 2 - 1.2), Y(floorTopG + d.WaistH * 0.55), rearZ + 0.1),
			TAILLIGHT,
			Enum.Material.Neon
		)
	end

	-- Wheels.
	local wheelG = wr + 0.02
	local wheelX = width / 2 + 0.1
	local frontWheelZ, rearWheelZ = frontZ + 2.8, rearZ - 2.8
	addWheel(ctx, "Wheel_FL", Vector3.new(-wheelX, Y(wheelG), frontWheelZ), wr, d.WheelWidth, true)
	addWheel(ctx, "Wheel_FR", Vector3.new(wheelX, Y(wheelG), frontWheelZ), wr, d.WheelWidth, true)
	addWheel(ctx, "Wheel_RL", Vector3.new(-wheelX, Y(wheelG), rearWheelZ), wr, d.WheelWidth, false)
	addWheel(ctx, "Wheel_RR", Vector3.new(wheelX, Y(wheelG), rearWheelZ), wr, d.WheelWidth, false)

	model:SetAttribute("WheelRadius", wr)
	return model
end

-- Scooter -------------------------------------------------------------------

local function buildScooter(spec, d)
	local wr = 1.0
	local ctx, model = newModel(spec, Vector3.new(2.2, 1.0, 7.4))
	local hh = ctx.HalfHeight
	local function Y(g: number): number
		return g - hh
	end

	local body, accent = d.BodyColor, d.AccentColor

	-- Deck, fork, handlebar, light.
	newPart(ctx, "Deck", Vector3.new(2.2, 0.5, 6.0), Vector3.new(0, Y(1.15), 0), body)
	newPart(ctx, "DeckStripe", Vector3.new(0.5, 0.06, 5.8), Vector3.new(0, Y(1.43), 0), accent)
	newPart(ctx, "Column", Vector3.new(0.5, 3.6, 0.5), Vector3.new(0, Y(3.0), -2.8), DARK, Enum.Material.Metal)
	newPart(ctx, "Handlebar", Vector3.new(3.2, 0.4, 0.5), Vector3.new(0, Y(4.8), -2.7), DARK, Enum.Material.Metal)
	newPart(ctx, "Headlight", Vector3.new(0.9, 0.7, 0.3), Vector3.new(0, Y(4.0), -3.1), HEADLIGHT, Enum.Material.Neon)
	newPart(ctx, "FrontFender", Vector3.new(1.0, 0.2, 2.2), Vector3.new(0, Y(2.35), -3.4), body)

	-- Rider seat and the delivery box behind it.
	newSeat(ctx, Vector3.new(2.2, 0.4, 2.0), Vector3.new(0, Y(1.6), -0.4))
	local box = newPart(ctx, "DeliveryBox", Vector3.new(2.8, 2.6, 2.4), Vector3.new(0, Y(2.7), 2.2), ORANGE)
	addText(box, Enum.NormalId.Back, "DELIVERY", Color3.fromRGB(30, 30, 36))
	newPart(ctx, "BoxLid", Vector3.new(3.0, 0.25, 2.6), Vector3.new(0, Y(4.1), 2.2), accent)
	newPart(ctx, "Taillight", Vector3.new(1.0, 0.5, 0.3), Vector3.new(0, Y(1.9), 3.5), TAILLIGHT, Enum.Material.Neon)

	addWheel(ctx, "Wheel_F", Vector3.new(0, Y(wr + 0.02), -3.4), wr, 0.7, true)
	addWheel(ctx, "Wheel_R", Vector3.new(0, Y(wr + 0.02), 3.4), wr, 0.7, false)

	model:SetAttribute("WheelRadius", wr)
	return model
end

-- Public API ------------------------------------------------------------------

function VehicleBuilder.build(vehicleId: string): Model
	local spec = Config.VehicleById[vehicleId]
	local design = DESIGNS[vehicleId]
	assert(spec and design, "Unknown vehicle id: " .. tostring(vehicleId))
	if design.Kind == "scooter" then
		return buildScooter(spec, design)
	end
	return buildCar(spec, design)
end

-- Every vehicle in Config must have a design (and vice versa); checked by the tests.
function VehicleBuilder.hasDesign(vehicleId: string): boolean
	return DESIGNS[vehicleId] ~= nil
end

return VehicleBuilder
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="3524">
    <Properties>
      <string name="Name">ServerScriptService</string>
      <BinaryString name="AttributesSerialize"></BinaryString>
      <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
      <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
      <bool name="LoadStringEnabled">false</bool>
      <bool name="DefinesCapabilities">false</bool>
      <int64 name="SourceAssetId">-1</int64>
      <BinaryString name="Tags"></BinaryString>
      <UniqueId name="UniqueId">184acf13447c97560ad43f37000003ce</UniqueId>
    </Properties>
    <Item class="Folder" referent="3525">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="3526">
        <Properties>
          <string name="Name">DataService</string>
          <ProtectedString name="Source"><![CDATA[--[[
	DataStore persistence. Thin wrapper: all rules about *what* is saved live in Profile.

	Safety rules:
	  * Loads/saves are retried, because DataStores fail transiently.
	  * If a load fails for good, the profile is flagged Temporary and is never saved,
	    so a hiccup can't overwrite a player's real progress with an empty profile.
	  * In Studio with API access disabled everything still works - nothing is saved.
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Profile = require(script.Parent.Profile)

local DataService = {}

local ATTEMPTS = 3
local studioWarningShown = false

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

local function isStudioAccessError(err): boolean
	local text = string.lower(tostring(err))
	return string.find(text, "studio access to apis", 1, true) ~= nil or string.find(text, "studioaccesstoapisnotallowed", 1, true) ~= nil
end

-- Returns ok, result. Gives up immediately when retrying cannot help.
local function withRetries(fn: () -> any): (boolean, any)
	local lastError
	for attempt = 1, ATTEMPTS do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastError = result
		if isStudioAccessError(result) then
			break
		end
		if attempt < ATTEMPTS then
			task.wait(attempt * 1.5)
		end
	end
	return false, lastError
end

local function getStore()
	return DataStoreService:GetDataStore(Config.DataStoreName)
end

-- Always returns a usable profile; profile.Temporary tells you whether it can be saved.
function DataService.load(player: Player)
	local ok, data = withRetries(function()
		return getStore():GetAsync(keyFor(player))
	end)

	if ok then
		return Profile.fromSaved(data)
	end

	if isStudioAccessError(data) then
		if not studioWarningShown then
			studioWarningShown = true
			warn(
				"[DeliveryDriver] DataStore access is off, so progress will not be saved. Enable 'Studio Access to API Services' in Game Settings > Security to test saving."
			)
		end
	else
		warn(string.format("[DeliveryDriver] Could not load data for %s: %s", player.Name, tostring(data)))
	end

	local profile = Profile.new()
	profile.Temporary = true
	return profile
end

-- Returns true if the data was written.
function DataService.save(player: Player, profile): boolean
	if profile.Temporary then
		return false
	end
	local saved = Profile.toSaved(profile)
	local ok, err = withRetries(function()
		getStore():UpdateAsync(keyFor(player), function()
			return saved
		end)
	end)
	if not ok then
		warn(string.format("[DeliveryDriver] Could not save data for %s: %s", player.Name, tostring(err)))
	end
	return ok
end

return DataService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3527">
        <Properties>
          <string name="Name">GarageService</string>
          <ProtectedString name="Source"><![CDATA[--[[
	The vehicle shop: buying and equipping vehicles. The client's garage UI calls
	GarageRequest:InvokeServer(action, vehicleId); every rule is checked here (Profile does the
	actual work), never trusted from the client.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local OrderService = require(script.Parent.OrderService)
local PlayerService = require(script.Parent.PlayerService)
local Profile = require(script.Parent.Profile)
local VehicleService = require(script.Parent.VehicleService)

local GarageService = {}

local REQUEST_COOLDOWN = 0.3
local lastRequest = {} -- [Player] = os.clock()

local function reply(ok: boolean, message: string)
	return { ok = ok, message = message }
end

-- Pure-ish handler (also called directly by tests). Returns { ok, message }.
function GarageService.handle(player: Player, action, vehicleId)
	if type(action) ~= "string" or type(vehicleId) ~= "string" then
		return reply(false, "Bad request")
	end
	local spec = Config.VehicleById[vehicleId]
	if not spec then
		return reply(false, "Unknown vehicle")
	end
	local profile = PlayerService.get(player)
	if not profile then
		return reply(false, "Still loading your profile...")
	end

	-- Switching vehicles mid-delivery would let people dodge the time limit set for the old one.
	local busy = OrderService.hasOrder(player)
	local previous = profile.Equipped

	if action == "Buy" then
		local ok, reason = Profile.buy(profile, vehicleId)
		if not ok then
			return reply(false, reason or "Can't buy that")
		end
		if busy then
			profile.Equipped = previous
		end
		PlayerService.sync(player)
		if profile.Equipped ~= previous then
			VehicleService.swapEquipped(player)
		end
		if busy then
			return reply(true, "Bought the " .. spec.Name .. "! Finish your delivery to switch to it.")
		end
		return reply(true, "Bought the " .. spec.Name .. "!")
	elseif action == "Equip" then
		if busy and vehicleId ~= previous then
			return reply(false, "Finish your current delivery before switching vehicles.")
		end
		local ok, reason = Profile.equip(profile, vehicleId)
		if not ok then
			return reply(false, reason or "Can't equip that")
		end
		PlayerService.sync(player)
		if profile.Equipped ~= previous then
			VehicleService.swapEquipped(player)
		end
		return reply(true, spec.Name .. " equipped.")
	end

	return reply(false, "Unknown action")
end

function GarageService.start(world)
	Remotes.GarageRequest.OnServerInvoke = function(player, action, vehicleId)
		local now = os.clock()
		if lastRequest[player] and now - lastRequest[player] < REQUEST_COOLDOWN then
			return reply(false, "Slow down!")
		end
		lastRequest[player] = now
		return GarageService.handle(player, action, vehicleId)
	end

	world.GaragePrompt.Triggered:Connect(function(player)
		Remotes.OpenGarage:FireClient(player)
	end)

	game:GetService("Players").PlayerRemoving:Connect(function(player)
		lastRequest[player] = nil
	end)
end

return GarageService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="3528">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Server entry point for "Become a Delivery Driver".

	Order matters: Remotes first (creates the RemoteEvents), then the town, then the services
	that rely on both.
]]

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
require(Shared.Remotes)

local GarageService = require(script.Parent.GarageService)
local OrderService = require(script.Parent.OrderService)
local PlayerService = require(script.Parent.PlayerService)
local VehicleService = require(script.Parent.VehicleService)
local WorldBuilder = require(script.Parent.WorldBuilder)

local Config = require(Shared.Config)
for property, value in Config.Lighting do
	Lighting[property] = value
end

-- The place ships with the town baked in. If it's missing (e.g. scripts synced into an empty place), build it now.
local town = Workspace:FindFirstChild("Town")
if not town then
	town = WorldBuilder.build(Workspace)
end

-- The default template's baseplate and spawn would sit inside our ground.
for _, name in { "Baseplate", "SpawnLocation" } do
	local leftover = Workspace:FindFirstChild(name)
	if leftover then
		leftover:Destroy()
	end
end

local world = WorldBuilder.info(town)

PlayerService.start()
VehicleService.start()
OrderService.start(world)
GarageService.start(world)
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3529">
        <Properties>
          <string name="Name">OrderService</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Delivery orders: take one at the dispatch desk, drive to the marker, hand it over.

	All rules live in Orders (what an order is, when it counts as delivered) and Economy (what it
	pays). This module just connects them to players, prompts and the client.

	Each player's active order is published as attributes so the client UI can simply react:
	  OrderId (0 = none), OrderAddress, OrderDest, OrderPackage, OrderDistance, OrderReward,
	  OrderStart, OrderTimeLimit, OrderDeadline   (times are Workspace:GetServerTimeNow() values)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Orders = require(script.Parent.Orders)
local PlayerService = require(script.Parent.PlayerService)
local Profile = require(script.Parent.Profile)
local VehicleService = require(script.Parent.VehicleService)

local OrderService = {}

local TICK = 0.2
local SLOW_DOWN_COOLDOWN = 3
local RECENT_TO_AVOID = 3

local active = {} -- [Player] = order
local recentHouses = {} -- [Player] = { houseId, ... } most recent last
local lastSlowDownNotice = {} -- [Player] = os.clock()
local nextOrderId = 0
local world

local ORDER_ATTRIBUTES = {
	"OrderAddress",
	"OrderDest",
	"OrderPackage",
	"OrderDistance",
	"OrderReward",
	"OrderStart",
	"OrderTimeLimit",
	"OrderDeadline",
}

local function randomInt(a: number, b: number): number
	return math.random(a, b)
end

local function publish(player: Player, order)
	player:SetAttribute("OrderAddress", order.Address)
	player:SetAttribute("OrderDest", order.Dest)
	player:SetAttribute("OrderPackage", order.Package.Name)
	player:SetAttribute("OrderDistance", order.Distance)
	player:SetAttribute("OrderReward", order.BasePay)
	player:SetAttribute("OrderStart", order.StartTime)
	player:SetAttribute("OrderTimeLimit", order.TimeLimit)
	player:SetAttribute("OrderDeadline", order.StartTime + order.TimeLimit)
	player:SetAttribute("OrderId", order.Id) -- last: the client reacts to this one
end

local function clear(player: Player)
	active[player] = nil
	player:SetAttribute("OrderId", 0)
	for _, name in ORDER_ATTRIBUTES do
		player:SetAttribute(name, nil)
	end
end

local function rememberHouse(player: Player, houseId: number)
	local list = recentHouses[player] or {}
	table.insert(list, houseId)
	while #list > RECENT_TO_AVOID do
		table.remove(list, 1)
	end
	recentHouses[player] = list
end

local function avoidSet(player: Player)
	local set = {}
	for _, id in recentHouses[player] or {} do
		set[id] = true
	end
	return set
end

function OrderService.hasOrder(player: Player): boolean
	return active[player] ~= nil
end

function OrderService.take(player: Player)
	local profile = PlayerService.get(player)
	if not profile then
		return
	end
	if active[player] then
		PlayerService.notify(player, "Finish your current delivery first!", "warn")
		return
	end

	local vehicle = Config.VehicleById[profile.Equipped]
	local order = Orders.generate(world.Houses, world.DispatchPos, Profile.rankIndex(profile), vehicle, randomInt, avoidSet(player))
	nextOrderId += 1
	order.Id = nextOrderId
	order.StartTime = Workspace:GetServerTimeNow()
	active[player] = order
	publish(player, order)

	PlayerService.notify(player, string.format("New order: %s to %s. Follow the marker!", order.Package.Name, order.Address), "info")
	VehicleService.ensureVehicle(player)
end

local function complete(player: Player, order, elapsed: number)
	local profile = PlayerService.get(player)
	if not profile then
		clear(player)
		return
	end

	local result = Economy.settle(order, elapsed, profile.Streak)
	Profile.recordDelivery(profile, result.OnTime)
	local summary = PlayerService.award(player, result.Total, result.XP)
	rememberHouse(player, order.HouseId)
	clear(player)

	Remotes.DeliveryResult:FireClient(player, {
		Address = order.Address,
		Package = order.Package.Name,
		OnTime = result.OnTime,
		Stars = result.Stars,
		Base = result.Base,
		TimeBonus = result.TimeBonus,
		Tip = result.Tip,
		StreakBonus = result.StreakBonus,
		Total = result.Total,
		XP = result.XP,
		Streak = profile.Streak,
		Position = order.Dest,
		RankedUpTo = summary and summary.RankedUp and Config.Ranks[summary.NewRank].Name or nil,
	})
end

local function fail(player: Player)
	local profile = PlayerService.get(player)
	if profile then
		Profile.breakStreak(profile)
		PlayerService.sync(player)
	end
	clear(player)
	PlayerService.notify(player, "The customer gave up waiting and cancelled the order.", "error")
end

function OrderService.cancel(player: Player)
	if not active[player] then
		return
	end
	local profile = PlayerService.get(player)
	if profile then
		Profile.breakStreak(profile)
		PlayerService.sync(player)
	end
	clear(player)
	PlayerService.notify(player, "Order cancelled.", "warn")
end

local function tick()
	local now = Workspace:GetServerTimeNow()
	for player, order in active do
		local elapsed = now - order.StartTime
		if Orders.status(order, elapsed) == "failed" then
			fail(player)
		else
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if root and humanoid and humanoid.Health > 0 then
				local verdict = Orders.checkArrival(order, root.Position, root.AssemblyLinearVelocity.Magnitude, elapsed)
				if verdict == "deliver" then
					complete(player, order, elapsed)
				elseif verdict == "toofast" then
					local last = lastSlowDownNotice[player]
					if not last or os.clock() - last > SLOW_DOWN_COOLDOWN then
						lastSlowDownNotice[player] = os.clock()
						PlayerService.notify(player, "Slow down to hand over the package!", "warn")
					end
				end
			end
		end
	end
end

function OrderService.start(worldInfo)
	world = worldInfo

	world.DispatchPrompt.Triggered:Connect(function(player)
		OrderService.take(player)
	end)

	Remotes.CancelOrder.OnServerEvent:Connect(function(player)
		OrderService.cancel(player)
	end)

	Players.PlayerAdded:Connect(function(player)
		player:SetAttribute("OrderId", 0)
	end)
	for _, player in Players:GetPlayers() do
		player:SetAttribute("OrderId", 0)
	end

	Players.PlayerRemoving:Connect(function(player)
		active[player] = nil
		recentHouses[player] = nil
		lastSlowDownNotice[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(TICK)
			tick()
		end
	end)
end

return OrderService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3530">
        <Properties>
          <string name="Name">Orders</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Pure order logic: picking a destination, and deciding what a position/speed/time means.
	No engine calls - the OrderService wires this to players, prompts and attributes.

	An order is a plain table:
	  Id, HouseId, Address, Dest (Vector3), Distance, Package, TimeLimit, BasePay,
	  StartTime (server clock, set by the caller), VehicleId
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)

local Orders = {}

-- rng(a, b) must return an integer in [a, b].
-- avoidIds is a set of house ids to skip (recent deliveries) when there is any alternative.
function Orders.generate(houses, origin, rankIndex: number, vehicleSpec, rng, avoidIds)
	local rank = Config.Ranks[rankIndex]
	local candidates = {}
	local fallback = {}
	for _, house in houses do
		local distance = Economy.routeDistance(origin, house.MarkerPos)
		if distance >= rank.MinDist and distance <= rank.MaxDist then
			local entry = { House = house, Distance = distance }
			table.insert(fallback, entry)
			if not (avoidIds and avoidIds[house.Id]) then
				table.insert(candidates, entry)
			end
		end
	end

	if #candidates == 0 then
		candidates = fallback
	end
	if #candidates == 0 then
		-- Town too small for this rank's range: take the house closest to the middle of it.
		local target = (rank.MinDist + rank.MaxDist) / 2
		local best, bestScore = nil, math.huge
		for _, house in houses do
			local distance = Economy.routeDistance(origin, house.MarkerPos)
			local score = math.abs(distance - target)
			if score < bestScore then
				best, bestScore = { House = house, Distance = distance }, score
			end
		end
		assert(best, "no houses to deliver to")
		candidates = { best }
	end

	local pick = candidates[rng(1, #candidates)]
	local package = Config.Packages[rng(1, #Config.Packages)]
	local house = pick.House

	return {
		HouseId = house.Id,
		Address = house.Address,
		Dest = house.MarkerPos,
		Distance = pick.Distance,
		Package = package,
		TimeLimit = Economy.timeLimit(pick.Distance, vehicleSpec.MaxSpeed, package),
		BasePay = Economy.basePay(pick.Distance, rank, package, vehicleSpec),
		VehicleId = vehicleSpec.Id,
	}
end

-- What should happen right now, given where the player is and how fast they're going?
--   "none"     not at the marker
--   "toofast"  at the marker but must slow down
--   "early"    would deliver, but impossibly fast for the distance (teleport-style cheating); keep waiting
--   "deliver"  hand the package over
function Orders.checkArrival(order, position, speed: number, elapsed: number): string
	local dx, dz = position.X - order.Dest.X, position.Z - order.Dest.Z
	if math.sqrt(dx * dx + dz * dz) > Config.DeliveryRadius then
		return "none"
	end
	if speed > Config.DeliveryMaxSpeed then
		return "toofast"
	end
	if elapsed < Economy.minTravelTime(order.Distance) then
		return "early"
	end
	return "deliver"
end

-- "ok" while there's time, "late" once past the deadline, "failed" once the customer gives up.
function Orders.status(order, elapsed: number): string
	if elapsed <= order.TimeLimit then
		return "ok"
	elseif elapsed <= order.TimeLimit + Config.OrderFailGrace then
		return "late"
	end
	return "failed"
end

return Orders
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3531">
        <Properties>
          <string name="Name">PlayerService</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Owns every player's Profile for the session and mirrors it to the client.

	The client never receives profile tables. Instead the server publishes plain values as
	attributes on the Player instance, which replicate automatically (and are there for late
	joiners too):

	  Loaded, Cash, XP, RankIndex, RankName, RankXPStart, RankXPNext (-1 at max rank),
	  Deliveries, Streak, BestStreak, TotalEarned, Equipped, Owned (",Id,Id,")

	Order attributes (Order*) are published by OrderService.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local Profile = require(script.Parent.Profile)

local PlayerService = {}

local profiles = {} -- [Player] = profile

function PlayerService.get(player: Player)
	return profiles[player]
end

function PlayerService.notify(player: Player, message: string, kind: string?)
	Remotes.Notify:FireClient(player, message, kind or "info")
end

local function ownedString(profile): string
	local ids = {}
	for id in profile.Owned do
		table.insert(ids, id)
	end
	table.sort(ids)
	return "," .. table.concat(ids, ",") .. ","
end

local function setLeaderstat(folder: Folder, name: string, className: string, value)
	local stat = folder:FindFirstChild(name)
	if not stat then
		stat = Instance.new(className)
		stat.Name = name
		stat.Parent = folder
	end
	stat.Value = value
end

-- Pushes the profile out to attributes + the leaderboard.
function PlayerService.sync(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end

	local rank = Economy.rankInfo(profile.XP)
	player:SetAttribute("Cash", profile.Cash)
	player:SetAttribute("XP", profile.XP)
	player:SetAttribute("RankIndex", rank.Index)
	player:SetAttribute("RankName", rank.Name)
	player:SetAttribute("RankXPStart", rank.XPStart)
	player:SetAttribute("RankXPNext", rank.XPNext or -1)
	player:SetAttribute("Deliveries", profile.Deliveries)
	player:SetAttribute("Streak", profile.Streak)
	player:SetAttribute("BestStreak", profile.BestStreak)
	player:SetAttribute("TotalEarned", profile.TotalEarned)
	player:SetAttribute("Equipped", profile.Equipped)
	player:SetAttribute("Owned", ownedString(profile))

	local stats = player:FindFirstChild("leaderstats")
	if stats then
		setLeaderstat(stats, "Cash", "IntValue", profile.Cash)
		setLeaderstat(stats, "Deliveries", "IntValue", profile.Deliveries)
		setLeaderstat(stats, "Rank", "StringValue", rank.Name)
	end
end

-- Gives money + XP, announces a rank-up, and returns Profile.award's summary.
function PlayerService.award(player: Player, cash: number, xp: number)
	local profile = profiles[player]
	if not profile then
		return nil
	end
	local summary = Profile.award(profile, cash, xp)
	PlayerService.sync(player)
	if summary.RankedUp then
		PlayerService.notify(player, "RANK UP! You are now a " .. Config.Ranks[summary.NewRank].Name .. ".", "success")
	end
	return summary
end

local function onPlayerAdded(player: Player)
	player:SetAttribute("Loaded", false)

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	stats.Parent = player

	local profile = DataService.load(player)
	if not player.Parent then
		return -- left while loading
	end
	profiles[player] = profile
	PlayerService.sync(player)
	player:SetAttribute("Loaded", true)

	if profile.Temporary then
		PlayerService.notify(player, "Your save couldn't be loaded, so progress won't be saved this session.", "warn")
	end
end

local function onPlayerRemoving(player: Player)
	local profile = profiles[player]
	if profile then
		DataService.save(player, profile)
		profiles[player] = nil
	end
end

function PlayerService.start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	-- Periodic autosave, so a crash loses at most a minute of progress.
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for player, profile in profiles do
				task.spawn(DataService.save, player, profile)
			end
		end
	end)

	-- Server shutting down: save everyone and wait for the writes to finish.
	game:BindToClose(function()
		local pending = 0
		for player, profile in profiles do
			pending += 1
			task.spawn(function()
				DataService.save(player, profile)
				pending -= 1
			end)
		end
		while pending > 0 do
			task.wait(0.1)
		end
	end)
end

return PlayerService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3532">
        <Properties>
          <string name="Name">Profile</string>
          <ProtectedString name="Source"><![CDATA[--[[
	A player's saved progress, plus the rules for changing it. Plain tables only (no engine calls),
	so every rule here is unit-tested outside Roblox.

	Saved fields:   Cash, XP, Deliveries, TotalEarned, BestStreak, Owned (set of vehicle ids), Equipped
	Session fields: Streak, Temporary (true when the save failed to load, so we must not overwrite it)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)

local Profile = {}

local SAVED_FIELDS = { "Cash", "XP", "Deliveries", "TotalEarned", "BestStreak", "Owned", "Equipped" }

function Profile.new()
	return {
		Cash = Config.StartingCash,
		XP = 0,
		Deliveries = 0,
		TotalEarned = 0,
		BestStreak = 0,
		Owned = { [Config.DefaultVehicle] = true },
		Equipped = Config.DefaultVehicle,
		Streak = 0,
		Temporary = false,
	}
end

local function validNumber(value, fallback: number, minimum: number): number
	if type(value) == "number" and value == value and value >= minimum and value < 1e15 then
		return value
	end
	return fallback
end

-- Turns whatever came out of the DataStore (maybe nil, maybe from an older version) into a valid profile.
function Profile.fromSaved(data)
	local profile = Profile.new()
	if type(data) ~= "table" then
		return profile
	end

	profile.Cash = math.floor(validNumber(data.Cash, profile.Cash, 0))
	profile.XP = math.floor(validNumber(data.XP, profile.XP, 0))
	profile.Deliveries = math.floor(validNumber(data.Deliveries, 0, 0))
	profile.TotalEarned = math.floor(validNumber(data.TotalEarned, 0, 0))
	profile.BestStreak = math.floor(validNumber(data.BestStreak, 0, 0))

	if type(data.Owned) == "table" then
		for id, owned in data.Owned do
			if owned == true and Config.VehicleById[id] then
				profile.Owned[id] = true
			end
		end
	end
	if type(data.Equipped) == "string" and profile.Owned[data.Equipped] then
		profile.Equipped = data.Equipped
	end
	return profile
end

-- Only the fields worth keeping; session state stays out of the DataStore.
function Profile.toSaved(profile)
	local saved = {}
	for _, field in SAVED_FIELDS do
		saved[field] = profile[field]
	end
	saved.Owned = table.clone(profile.Owned)
	return saved
end

-- Vehicles ------------------------------------------------------------------------

function Profile.owns(profile, vehicleId: string): boolean
	return profile.Owned[vehicleId] == true
end

function Profile.rankIndex(profile): number
	return Economy.rankIndexForXp(profile.XP)
end

-- Returns ok, reason
function Profile.canBuy(profile, vehicleId: string): (boolean, string?)
	local spec = Config.VehicleById[vehicleId]
	if not spec then
		return false, "Unknown vehicle"
	end
	if Profile.owns(profile, vehicleId) then
		return false, "You already own this vehicle"
	end
	local rank = Profile.rankIndex(profile)
	if rank < spec.RankRequired then
		return false, "Requires rank " .. Config.Ranks[spec.RankRequired].Name
	end
	if profile.Cash < spec.Price then
		return false, "Not enough cash"
	end
	return true, nil
end

function Profile.buy(profile, vehicleId: string): (boolean, string?)
	local ok, reason = Profile.canBuy(profile, vehicleId)
	if not ok then
		return false, reason
	end
	local spec = Config.VehicleById[vehicleId]
	profile.Cash -= spec.Price
	profile.Owned[vehicleId] = true
	profile.Equipped = vehicleId
	return true, nil
end

function Profile.equip(profile, vehicleId: string): (boolean, string?)
	if not Config.VehicleById[vehicleId] then
		return false, "Unknown vehicle"
	end
	if not Profile.owns(profile, vehicleId) then
		return false, "You don't own this vehicle"
	end
	profile.Equipped = vehicleId
	return true, nil
end

-- Progress ------------------------------------------------------------------------

-- Adds earnings/XP and reports whether that ranked the player up.
function Profile.award(profile, cash: number, xp: number)
	local oldRank = Economy.rankIndexForXp(profile.XP)
	profile.Cash += cash
	profile.TotalEarned += cash
	profile.XP += xp
	local newRank = Economy.rankIndexForXp(profile.XP)
	return {
		RankedUp = newRank > oldRank,
		OldRank = oldRank,
		NewRank = newRank,
	}
end

-- Called after every finished order. onTime=false breaks the streak.
function Profile.recordDelivery(profile, onTime: boolean)
	profile.Deliveries += 1
	if onTime then
		profile.Streak += 1
		profile.BestStreak = math.max(profile.BestStreak, profile.Streak)
	else
		profile.Streak = 0
	end
end

function Profile.breakStreak(profile)
	profile.Streak = 0
end

return Profile
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3533">
        <Properties>
          <string name="Name">VehicleService</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Spawns, parks and cleans up each player's delivery vehicle.

	One vehicle per player. It is parked (anchored) whenever nobody is driving, which keeps
	empty cars from drifting around. Sitting in it unanchors it and hands physics ownership to
	the driver, whose VehicleController script then drives it (see client/VehicleController).

	Vehicles and characters are in separate collision groups that don't collide, so cars can't
	fling players and a parked car never blocks anyone on foot.
]]

local CollectionService = game:GetService("CollectionService")
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local VehicleBuilder = require(ReplicatedStorage.Shared.VehicleBuilder)
local PlayerService = require(script.Parent.PlayerService)

local VehicleService = {}

local VEHICLE_TAG = "DeliveryVehicle"
local GROUP_VEHICLES = "Vehicles"
local GROUP_CHARACTERS = "Characters"
local VOID_Y = -60
local RESIT_DELAY = 1.5 -- seconds a seat refuses touch-sitting after the driver gets out

local vehiclesFolder: Folder
local vehicles = {} -- [Player] = { Model, Chassis, Seat, Id }
local lastSummon = {} -- [Player] = os.clock()

-- Collision groups --------------------------------------------------------------------

local function setupCollisionGroups()
	local ok, err = pcall(function()
		for _, name in { GROUP_VEHICLES, GROUP_CHARACTERS } do
			if not PhysicsService:IsCollisionGroupRegistered(name) then
				PhysicsService:RegisterCollisionGroup(name)
			end
		end
		PhysicsService:CollisionGroupSetCollidable(GROUP_VEHICLES, GROUP_CHARACTERS, false)
	end)
	if not ok then
		warn("[DeliveryDriver] Could not set up collision groups: " .. tostring(err))
	end
end

local function putCharacterInGroup(character: Model)
	local function apply(descendant: Instance)
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = GROUP_CHARACTERS
		end
	end
	for _, descendant in character:GetDescendants() do
		apply(descendant)
	end
	character.DescendantAdded:Connect(apply)
end

-- Parking / driving ---------------------------------------------------------------------

local function ejectOccupant(entry, humanoid: Humanoid)
	local weld = entry.Seat:FindFirstChild("SeatWeld")
	if weld then
		weld:Destroy()
	end
	humanoid.Jump = true
end

local function onOccupantChanged(player: Player, entry)
	local humanoid = entry.Seat.Occupant
	if humanoid then
		local occupant = Players:GetPlayerFromCharacter(humanoid.Parent)
		if occupant ~= player then
			ejectOccupant(entry, humanoid) -- it's somebody else's car
			return
		end
		entry.Chassis.Anchored = false
		pcall(function()
			entry.Chassis:SetNetworkOwner(player)
		end)
		entry.Model:SetAttribute("Occupied", true)
	else
		entry.Model:SetAttribute("Occupied", false)
		-- Without this you'd be sat straight back down by touching the seat as you climb out.
		entry.Seat.Disabled = true
		task.delay(RESIT_DELAY, function()
			if entry.Model.Parent then
				entry.Seat.Disabled = false
			end
		end)
		-- Let it roll for a moment, then park it where it stopped.
		task.delay(0.4, function()
			if entry.Model.Parent and not entry.Seat.Occupant then
				entry.Chassis.Anchored = true
			end
		end)
	end
end

local function destroyVehicle(player: Player)
	local entry = vehicles[player]
	if entry then
		vehicles[player] = nil
		entry.Model:Destroy()
	end
end

local function createVehicle(player: Player, vehicleId: string)
	local model = VehicleBuilder.build(vehicleId)
	model.Name = player.Name .. "'s " .. Config.VehicleById[vehicleId].Name
	model:SetAttribute("OwnerUserId", player.UserId)

	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = GROUP_VEHICLES
		end
	end

	local entry = {
		Model = model,
		Chassis = model.PrimaryPart,
		Seat = model:FindFirstChild("Seat"),
		Id = vehicleId,
	}
	entry.Chassis.Anchored = true
	entry.Seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		onOccupantChanged(player, entry)
	end)
	CollectionService:AddTag(model, VEHICLE_TAG)
	vehicles[player] = entry
	return entry
end

-- Finding somewhere to put the car -------------------------------------------------------

local function findSpawnCFrame(root: BasePart, entry)
	local flatLook = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if flatLook.Magnitude < 0.1 then
		flatLook = Vector3.new(0, 0, -1)
	end
	flatLook = flatLook.Unit
	local right = flatLook:Cross(Vector3.yAxis)

	local ignore = { root.Parent, vehiclesFolder }
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = ignore
	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude
	overlapParams.FilterDescendantsInstances = ignore

	local size = entry.Model:GetExtentsSize()
	local hullHalf = entry.Model:GetAttribute("HullHalfHeight")
	local reach = size.Z / 2 + 6
	local offsets = {
		flatLook * reach,
		right * (size.X / 2 + 8),
		right * -(size.X / 2 + 8),
		flatLook * -reach,
		flatLook * (reach * 2.2),
	}

	for _, offset in offsets do
		local origin = root.Position + offset + Vector3.new(0, 6, 0)
		local hit = Workspace:Raycast(origin, Vector3.new(0, -40, 0), rayParams)
		if hit and hit.Normal.Y > 0.7 then
			local position = hit.Position + Vector3.new(0, hullHalf + 0.05, 0)
			local cframe = CFrame.lookAt(position, position + flatLook)
			-- Anything solid between the wheels' top and the roof means we'd be spawning inside something.
			local boxCFrame = cframe * CFrame.new(0, hullHalf + 2.5, 0)
			local boxSize = Vector3.new(size.X + 1, 3.5, size.Z + 1)
			local blocked = false
			for _, part in Workspace:GetPartBoundsInBox(boxCFrame, boxSize, overlapParams) do
				if part.CanCollide then
					blocked = true
					break
				end
			end
			if not blocked then
				return cframe
			end
		end
	end

	-- Nowhere clear: drop it just ahead of the player and let physics sort it out.
	local position = root.Position + flatLook * reach + Vector3.new(0, 3, 0)
	return CFrame.lookAt(position, position + flatLook)
end

local function seatPlayer(entry, humanoid: Humanoid, root: BasePart)
	entry.Seat.Disabled = false
	local ok = pcall(function()
		entry.Seat:Sit(humanoid)
	end)
	if not ok then
		-- Touching an enabled seat sits you in it.
		root.CFrame = entry.Seat.CFrame * CFrame.new(0, 2, 0)
	end
end

-- Public API ---------------------------------------------------------------------------------

function VehicleService.hasVehicle(player: Player): boolean
	return vehicles[player] ~= nil
end

-- Brings the player's equipped vehicle to them and sits them in it. Returns ok, message.
function VehicleService.summon(player: Player, ignoreCooldown: boolean?): (boolean, string?)
	local now = os.clock()
	if not ignoreCooldown and lastSummon[player] and now - lastSummon[player] < Config.SummonCooldown then
		return false, "Give it a moment..."
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root) or humanoid.Health <= 0 then
		return false, "You can't do that right now."
	end
	local profile = PlayerService.get(player)
	if not profile then
		return false, "Still loading your profile..."
	end

	local entry = vehicles[player]
	if entry and entry.Model.Parent and humanoid.SeatPart == entry.Seat then
		return true, nil -- already driving it
	end

	lastSummon[player] = now
	if entry and (entry.Id ~= profile.Equipped or not entry.Model.Parent) then
		destroyVehicle(player)
		entry = nil
	end
	if not entry then
		entry = createVehicle(player, profile.Equipped)
	end

	entry.Chassis.Anchored = true
	entry.Model:PivotTo(findSpawnCFrame(root, entry))
	if not entry.Model.Parent then
		entry.Model.Parent = vehiclesFolder
	end
	seatPlayer(entry, humanoid, root)
	return true, nil
end

-- After the equipped vehicle changed: swap the spawned one for the new model.
function VehicleService.swapEquipped(player: Player)
	if vehicles[player] then
		destroyVehicle(player)
		VehicleService.summon(player, true)
	end
end

-- Makes sure the player has a vehicle in the world (used when they take an order).
function VehicleService.ensureVehicle(player: Player)
	if not vehicles[player] then
		VehicleService.summon(player, true)
	end
end

function VehicleService.start()
	vehiclesFolder = Workspace:FindFirstChild("Vehicles")
	if not vehiclesFolder then
		vehiclesFolder = Instance.new("Folder")
		vehiclesFolder.Name = "Vehicles"
		vehiclesFolder.Parent = Workspace
	end

	setupCollisionGroups()

	local function watchPlayer(player: Player)
		player.CharacterAdded:Connect(putCharacterInGroup)
		if player.Character then
			putCharacterInGroup(player.Character)
		end
	end
	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		destroyVehicle(player)
		lastSummon[player] = nil
	end)

	Remotes.CallVehicle.OnServerEvent:Connect(function(player)
		local ok, message = VehicleService.summon(player)
		if not ok and message then
			PlayerService.notify(player, message, "warn")
		end
	end)

	-- Anything that somehow ends up under the map is brought back.
	task.spawn(function()
		while true do
			task.wait(2)
			for player, entry in vehicles do
				if entry.Chassis.Position.Y < VOID_Y then
					destroyVehicle(player)
					PlayerService.notify(player, "Your vehicle fell off the map. Press V to call it again.", "warn")
				end
			end
		end
	end)
end

return VehicleService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3534">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <ProtectedString name="Source"><![CDATA[--[[
	Generates the town: a grid of roads and blocks full of houses, with the delivery depot in the
	middle block. Everything is built from Parts, and the layout is deterministic.

	The place file ships with the town already baked into Workspace.Town (tools/build.luau runs
	this module), so it is visible in Studio's edit view. At runtime Main only calls build() if the
	town is missing (e.g. when the scripts are synced into an empty place with Rojo).

	World coordinates: origin at the centre of the town, ground surface at y = 0.1.
	Rows (z) are east-west roads, columns (x) are north-south roads.

	WorldBuilder.info(town) reads back what the game services need (houses, prompts, spawn).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local WorldBuilder = {}

local SURFACE_Y = 0.1 -- top of roads, sidewalks and lawns (everything is flush so cars never bump)
local THICKNESS = 0.2

-- Palette -----------------------------------------------------------------------
local ASPHALT = Color3.fromRGB(58, 60, 66)
local LINE_YELLOW = Color3.fromRGB(255, 206, 60)
local SIDEWALK = Color3.fromRGB(190, 190, 196)
local GRASS = Color3.fromRGB(96, 150, 78)
local GRASS_OUTER = Color3.fromRGB(84, 134, 68)
local LOT = Color3.fromRGB(112, 116, 126)
local NAVY = Color3.fromRGB(26, 34, 64)
local NAVY_LIGHT = Color3.fromRGB(40, 54, 98)
local ORANGE = Color3.fromRGB(255, 159, 28)
local CREAM = Color3.fromRGB(250, 244, 228)
local GLASS = Color3.fromRGB(150, 205, 235)

local WALL_COLORS = {
	Color3.fromRGB(236, 216, 186),
	Color3.fromRGB(214, 230, 236),
	Color3.fromRGB(240, 202, 202),
	Color3.fromRGB(208, 228, 202),
	Color3.fromRGB(246, 236, 184),
	Color3.fromRGB(202, 208, 238),
	Color3.fromRGB(236, 208, 228),
	Color3.fromRGB(226, 226, 230),
}
local ROOF_COLORS = {
	Color3.fromRGB(120, 60, 54),
	Color3.fromRGB(70, 74, 88),
	Color3.fromRGB(96, 76, 60),
	Color3.fromRGB(58, 90, 110),
	Color3.fromRGB(110, 110, 118),
}
local DOOR_COLORS = {
	Color3.fromRGB(150, 60, 50),
	Color3.fromRGB(56, 96, 140),
	Color3.fromRGB(70, 120, 80),
	Color3.fromRGB(230, 170, 60),
	Color3.fromRGB(90, 70, 60),
}

-- Deterministic RNG (so the baked town and a runtime-built town are identical) -------
local function makeRng(seed: number)
	local state = seed % 4294967296
	local function nextFloat(): number
		state = (state * 1664525 + 1013904223) % 4294967296
		return state / 4294967296
	end
	return {
		float = nextFloat,
		range = function(a: number, b: number): number
			return a + (b - a) * nextFloat()
		end,
		int = function(a: number, b: number): number
			return a + math.floor(nextFloat() * (b - a + 1))
		end,
		pick = function(list)
			return list[math.floor(nextFloat() * #list) + 1]
		end,
	}
end

-- Part helpers ------------------------------------------------------------------

local function addPart(
	parent: Instance,
	name: string,
	size: Vector3,
	position: Vector3,
	color: Color3,
	material: Enum.Material?,
	extra: { [string]: any }?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanTouch = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Size = size
	part.CFrame = CFrame.new(position)
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	if extra then
		for property, value in extra do
			(part :: any)[property] = value
		end
	end
	part.Parent = parent
	return part
end

-- Flat slab whose top face sits at SURFACE_Y.
local function addSlab(
	parent: Instance,
	name: string,
	centerX: number,
	centerZ: number,
	sizeX: number,
	sizeZ: number,
	color: Color3,
	material: Enum.Material?
): Part
	return addPart(parent, name, Vector3.new(sizeX, THICKNESS, sizeZ), Vector3.new(centerX, SURFACE_Y - THICKNESS / 2, centerZ), color, material)
end

local function addText(part: Part, face: Enum.NormalId, text: string, textColor: Color3, backColor: Color3?, pixelsPerStud: number?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud or 50
	gui.LightInfluence = 0
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = backColor and 0 or 1
	if backColor then
		label.BackgroundColor3 = backColor
	end
	label.Text = text
	label.TextColor3 = textColor
	label.TextScaled = true
	label.FontFace = Font.fromEnum(Enum.Font.GothamBold) -- FontFace (not Font) so the label can be saved into the place file
	label.Parent = gui
end

local function addFolder(parent: Instance, name: string): Folder
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

-- Geometry ---------------------------------------------------------------------

local function geometry()
	local w = Config.World
	local pitch = w.BlockSize + w.RoadWidth
	local span = w.Blocks * pitch + w.RoadWidth
	return {
		N = w.Blocks,
		Block = w.BlockSize,
		Road = w.RoadWidth,
		Sidewalk = w.SidewalkWidth,
		Pitch = pitch,
		Span = span,
		Ground = span + w.GroundMargin * 2,
		-- centre of block row/column i (1-based)
		BlockCenter = function(i: number): number
			return (i - (w.Blocks + 1) / 2) * pitch
		end,
		-- centre of road k (0-based, there are Blocks + 1 of them)
		RoadCenter = function(k: number): number
			return (k - w.Blocks / 2) * pitch
		end,
	}
end

-- Roads, lane markings, ground ------------------------------------------------------

local function buildGround(town: Folder, g)
	addPart(town, "Ground", Vector3.new(g.Ground, 2, g.Ground), Vector3.new(0, -1, 0), GRASS_OUTER, Enum.Material.Grass)

	-- Invisible walls so nobody can drive off the edge of the world.
	local walls = addFolder(town, "Boundary")
	local half = g.Ground / 2
	local wallHeight = 120
	local wallProps = { Transparency = 1, CanCollide = true, CanQuery = false }
	addPart(walls, "WallNorth", Vector3.new(g.Ground, wallHeight, 4), Vector3.new(0, wallHeight / 2, -half - 2), GRASS, nil, wallProps)
	addPart(walls, "WallSouth", Vector3.new(g.Ground, wallHeight, 4), Vector3.new(0, wallHeight / 2, half + 2), GRASS, nil, wallProps)
	addPart(walls, "WallWest", Vector3.new(4, wallHeight, g.Ground), Vector3.new(-half - 2, wallHeight / 2, 0), GRASS, nil, wallProps)
	addPart(walls, "WallEast", Vector3.new(4, wallHeight, g.Ground), Vector3.new(half + 2, wallHeight / 2, 0), GRASS, nil, wallProps)
end

local function addDashes(parent: Folder, centerX: number, centerZ: number, alongX: boolean)
	-- 7 dashes per block-length of road, never inside an intersection.
	for m = -3, 3 do
		local offset = m * 20
		if alongX then
			addPart(
				parent,
				"Dash",
				Vector3.new(9, 0.05, 0.7),
				Vector3.new(centerX + offset, SURFACE_Y + 0.025, centerZ),
				LINE_YELLOW,
				nil,
				{ CanCollide = false }
			)
		else
			addPart(
				parent,
				"Dash",
				Vector3.new(0.7, 0.05, 9),
				Vector3.new(centerX, SURFACE_Y + 0.025, centerZ + offset),
				LINE_YELLOW,
				nil,
				{ CanCollide = false }
			)
		end
	end
end

local function buildRoads(town: Folder, g)
	local roads = addFolder(town, "Roads")
	local markings = addFolder(town, "Markings")

	for k = 0, g.N do
		local z = g.RoadCenter(k)
		-- East-west roads run the full width of the town, intersections included.
		addSlab(roads, "RoadEW_" .. k, 0, z, g.Span, g.Road, ASPHALT, Enum.Material.Asphalt)
		for j = 1, g.N do
			addDashes(markings, g.BlockCenter(j), z, true)
		end

		-- North-south roads only cover the stretch between intersections.
		local x = g.RoadCenter(k)
		for i = 1, g.N do
			local zi = g.BlockCenter(i)
			addSlab(roads, "RoadNS_" .. k .. "_" .. i, x, zi, g.Road, g.Block, ASPHALT, Enum.Material.Asphalt)
			addDashes(markings, x, zi, false)
		end
	end
end

-- A block's sidewalk ring + inner lot (grass for housing, concrete for the depot).
local function buildBlockBase(parent: Folder, g, i: number, j: number, innerColor: Color3, innerMaterial: Enum.Material)
	local cx, cz = g.BlockCenter(j), g.BlockCenter(i)
	local s = g.Sidewalk
	local b = g.Block
	local inner = b - 2 * s
	local name = "Block_" .. i .. "_" .. j
	local model = Instance.new("Model")
	model.Name = name

	addSlab(model, "SidewalkN", cx, cz - b / 2 + s / 2, b, s, SIDEWALK, Enum.Material.Concrete)
	addSlab(model, "SidewalkS", cx, cz + b / 2 - s / 2, b, s, SIDEWALK, Enum.Material.Concrete)
	addSlab(model, "SidewalkW", cx - b / 2 + s / 2, cz, s, inner, SIDEWALK, Enum.Material.Concrete)
	addSlab(model, "SidewalkE", cx + b / 2 - s / 2, cz, s, inner, SIDEWALK, Enum.Material.Concrete)
	addSlab(model, "Lawn", cx, cz, inner, inner, innerColor, innerMaterial)

	model.Parent = parent
	return model
end

-- Street furniture ----------------------------------------------------------------

local function addTree(parent: Folder, rng, x: number, z: number)
	local trunkHeight = rng.range(5, 7)
	local leafSize = rng.range(8, 11)
	addPart(
		parent,
		"Trunk",
		Vector3.new(1.6, trunkHeight, 1.6),
		Vector3.new(x, SURFACE_Y + trunkHeight / 2, z),
		Color3.fromRGB(110, 80, 56),
		Enum.Material.Wood
	)
	local leaf = addPart(
		parent,
		"Leaves",
		Vector3.new(leafSize, leafSize, leafSize),
		Vector3.new(x, SURFACE_Y + trunkHeight + leafSize * 0.35, z),
		Color3.fromRGB(rng.int(62, 84), rng.int(128, 156), rng.int(60, 80)),
		Enum.Material.Grass,
		{ Shape = Enum.PartType.Ball }
	)
	leaf.CanCollide = false
end

local function addLamp(parent: Folder, x: number, z: number)
	addPart(parent, "LampPole", Vector3.new(0.8, 14, 0.8), Vector3.new(x, SURFACE_Y + 7, z), Color3.fromRGB(52, 54, 62), Enum.Material.Metal)
	addPart(
		parent,
		"LampHead",
		Vector3.new(2, 1.2, 2),
		Vector3.new(x, SURFACE_Y + 14.4, z),
		Color3.fromRGB(255, 240, 200),
		Enum.Material.Neon,
		{ CanCollide = false }
	)
end

local function addStreetSign(parent: Folder, x: number, z: number, streetName: string, avenueName: string)
	addPart(parent, "SignPole", Vector3.new(0.6, 12, 0.6), Vector3.new(x, SURFACE_Y + 6, z), Color3.fromRGB(70, 74, 84), Enum.Material.Metal)
	local green = Color3.fromRGB(28, 110, 70)
	local streetBoard = addPart(parent, "StreetSign", Vector3.new(9, 2, 0.3), Vector3.new(x, SURFACE_Y + 11, z), green, nil, { CanCollide = false })
	addText(streetBoard, Enum.NormalId.Front, streetName, Color3.new(1, 1, 1), green, 40)
	addText(streetBoard, Enum.NormalId.Back, streetName, Color3.new(1, 1, 1), green, 40)
	local avenueBoard = addPart(parent, "AvenueSign", Vector3.new(0.3, 2, 9), Vector3.new(x, SURFACE_Y + 8.6, z), green, nil, { CanCollide = false })
	addText(avenueBoard, Enum.NormalId.Left, avenueName, Color3.new(1, 1, 1), green, 40)
	addText(avenueBoard, Enum.NormalId.Right, avenueName, Color3.new(1, 1, 1), green, 40)
end

-- Houses ----------------------------------------------------------------------------

local DOOR_HEIGHT = 7.2

-- northSide: the house sits on the north edge of its block and faces the road to the north (-Z).
local function buildHouse(parent: Folder, g, rng, id: number, i: number, j: number, slot: number, northSide: boolean)
	local cx, cz = g.BlockCenter(j), g.BlockCenter(i)
	local dir = northSide and -1 or 1 -- direction the front of the house faces along Z
	local width = rng.range(27, 33)
	local depth = rng.range(22, 27)
	local height = rng.range(12, 15)
	local x = cx + (slot - 2) * 44
	local frontZ = cz + dir * 55
	local bodyZ = frontZ - dir * depth / 2
	local lawnEdgeZ = cz + dir * (g.Block / 2 - g.Sidewalk)
	local wall = rng.pick(WALL_COLORS)
	local roofColor = rng.pick(ROOF_COLORS)
	local doorColor = rng.pick(DOOR_COLORS)
	local face = northSide and Enum.NormalId.Front or Enum.NormalId.Back

	-- Address: north-row houses get even numbers, south-row odd, per street.
	local roadIndex = northSide and (i - 1) or i
	local street = Config.StreetNames[roadIndex + 1]
	local base = (j - 1) * Config.World.HousesPerRow + slot
	local number = base * 10 + (northSide and 2 or 1)
	local address = number .. " " .. street

	-- The delivery marker sits in the lane beside the house.
	local laneZ = cz + dir * (g.Block / 2 + g.Road / 4)
	local markerPos = Vector3.new(x, SURFACE_Y, laneZ)

	local model = Instance.new("Model")
	model.Name = "House_" .. id
	model:SetAttribute("HouseId", id)
	model:SetAttribute("Number", number)
	model:SetAttribute("Street", street)
	model:SetAttribute("Address", address)
	model:SetAttribute("MarkerPos", markerPos)

	local body = addPart(model, "Body", Vector3.new(width, height, depth), Vector3.new(x, SURFACE_Y + height / 2, bodyZ), wall, Enum.Material.Brick)
	model.PrimaryPart = body

	addPart(model, "Roof", Vector3.new(width + 2.4, 1.2, depth + 2.4), Vector3.new(x, SURFACE_Y + height + 0.6, bodyZ), roofColor, Enum.Material.Slate)
	addPart(
		model,
		"Chimney",
		Vector3.new(2.5, 4, 2.5),
		Vector3.new(x + width * 0.3, SURFACE_Y + height + 2.4, bodyZ - dir * depth * 0.2),
		Color3.fromRGB(150, 84, 70),
		Enum.Material.Brick
	)

	local out = dir * 0.2 -- features poke out of the front wall by this much
	addPart(
		model,
		"Door",
		Vector3.new(5, DOOR_HEIGHT, 0.5),
		Vector3.new(x, SURFACE_Y + DOOR_HEIGHT / 2, frontZ + out),
		doorColor,
		Enum.Material.Wood,
		{ CanCollide = false }
	)
	addPart(model, "Porch", Vector3.new(9, 0.5, 4), Vector3.new(x, SURFACE_Y + DOOR_HEIGHT + 0.9, frontZ + dir * 2), roofColor, nil, { CanCollide = false })
	for _, wx in { -9.5, 9.5 } do
		addPart(model, "WindowFrame", Vector3.new(7.4, 5.8, 0.3), Vector3.new(x + wx, SURFACE_Y + 6, frontZ + dir * 0.1), CREAM, nil, { CanCollide = false })
		local glass = addPart(
			model,
			"Window",
			Vector3.new(6.4, 4.8, 0.3),
			Vector3.new(x + wx, SURFACE_Y + 6, frontZ + dir * 0.25),
			GLASS,
			Enum.Material.Glass,
			{ CanCollide = false }
		)
		glass.Transparency = 0.35
	end

	local plaque = addPart(
		model,
		"NumberPlaque",
		Vector3.new(6.4, 2.6, 0.3),
		Vector3.new(x, SURFACE_Y + DOOR_HEIGHT + 2.4, frontZ + out),
		CREAM,
		nil,
		{ CanCollide = false }
	)
	addText(plaque, face, tostring(number), NAVY, nil, 60)

	-- Path from the front door out to the sidewalk.
	local pathLength = math.abs(frontZ - lawnEdgeZ)
	addPart(
		model,
		"Path",
		Vector3.new(5, 0.06, pathLength),
		Vector3.new(x, SURFACE_Y + 0.03, (frontZ + lawnEdgeZ) / 2),
		SIDEWALK,
		Enum.Material.Concrete,
		{ CanCollide = false }
	)

	model.Parent = parent
	return {
		Id = id,
		Number = number,
		Street = street,
		Address = address,
		MarkerPos = markerPos,
	}
end

-- Depot ---------------------------------------------------------------------------

local function addInvisibleAnchor(parent: Instance, name: string, position: Vector3): Part
	return addPart(parent, name, Vector3.new(1, 1, 1), position, Color3.new(1, 1, 1), nil, {
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})
end

local function buildDepot(town: Folder, g)
	local depot = Instance.new("Model")
	depot.Name = "Depot"

	-- Concrete yard inside the central block's sidewalks.
	local base = buildBlockBase(depot, g, (g.N + 1) / 2, (g.N + 1) / 2, LOT, Enum.Material.Concrete)
	base.Name = "Yard"

	-- Warehouse along the north edge of the yard; its front faces south (+Z).
	local warehouseZ = -44
	addPart(depot, "Warehouse", Vector3.new(90, 26, 38), Vector3.new(0, SURFACE_Y + 13, warehouseZ), NAVY_LIGHT, Enum.Material.Concrete)
	addPart(depot, "WarehouseRoof", Vector3.new(92, 1.5, 40), Vector3.new(0, SURFACE_Y + 26.75, warehouseZ), ORANGE)
	local frontWallZ = warehouseZ + 19 -- -25

	local sign = addPart(depot, "DepotSign", Vector3.new(60, 9, 0.6), Vector3.new(0, SURFACE_Y + 19.5, frontWallZ + 0.3), NAVY, nil, { CanCollide = false })
	addText(sign, Enum.NormalId.Back, "SWIFT DROP DEPOT", ORANGE, nil, 30)
	for _, dx in { -30, 30 } do
		addPart(
			depot,
			"RollerDoor",
			Vector3.new(16, 14, 0.4),
			Vector3.new(dx, SURFACE_Y + 7, frontWallZ + 0.2),
			Color3.fromRGB(150, 156, 168),
			Enum.Material.Metal,
			{ CanCollide = false }
		)
	end
	local office = addPart(
		depot,
		"OfficeWindow",
		Vector3.new(22, 6, 0.3),
		Vector3.new(0, SURFACE_Y + 6.5, frontWallZ + 0.15),
		GLASS,
		Enum.Material.Glass,
		{ CanCollide = false }
	)
	office.Transparency = 0.4

	-- Drive-up dispatch counter with an awning.
	addPart(depot, "DispatchCounter", Vector3.new(24, 4.4, 4), Vector3.new(0, SURFACE_Y + 2.2, -10), CREAM)
	addPart(depot, "CounterTop", Vector3.new(25, 0.4, 5), Vector3.new(0, SURFACE_Y + 4.6, -10), ORANGE)
	local counterSign = addPart(depot, "CounterSign", Vector3.new(16, 2.6, 0.2), Vector3.new(0, SURFACE_Y + 2.4, -7.9), NAVY, nil, { CanCollide = false })
	addText(counterSign, Enum.NormalId.Back, "DISPATCH", ORANGE, nil, 60)
	addPart(depot, "Awning", Vector3.new(34, 0.8, 16), Vector3.new(0, SURFACE_Y + 12, -16), ORANGE)
	for _, px in { -16, 16 } do
		addPart(depot, "AwningPost", Vector3.new(1.4, 12, 1.4), Vector3.new(px, SURFACE_Y + 6, -9), NAVY, Enum.Material.Metal)
	end

	local dispatchAnchor = addInvisibleAnchor(depot, "DispatchAnchor", Vector3.new(0, SURFACE_Y + 6, -7))
	local dispatchPrompt = Instance.new("ProximityPrompt")
	dispatchPrompt.Name = "Prompt"
	dispatchPrompt.ActionText = "Take Order"
	dispatchPrompt.ObjectText = "Dispatch"
	dispatchPrompt.KeyboardKeyCode = Enum.KeyCode.E
	dispatchPrompt.HoldDuration = 0.35
	dispatchPrompt.MaxActivationDistance = 24
	dispatchPrompt.RequiresLineOfSight = false
	dispatchPrompt.Parent = dispatchAnchor

	-- Yellow drive-up pad in front of the counter.
	local pad = addPart(
		depot,
		"PickupPad",
		Vector3.new(34, 0.1, 14),
		Vector3.new(0, SURFACE_Y + 0.05, 2),
		Color3.fromRGB(255, 200, 40),
		Enum.Material.Neon,
		{ CanCollide = false, Transparency = 0.35 }
	)
	addText(pad, Enum.NormalId.Top, "PICK UP HERE", NAVY, nil, 30)

	-- Garage on the east side of the yard; its doors face west.
	addPart(depot, "Garage", Vector3.new(34, 18, 30), Vector3.new(46, SURFACE_Y + 9, 28), Color3.fromRGB(70, 82, 118), Enum.Material.Concrete)
	addPart(depot, "GarageRoof", Vector3.new(36, 1.2, 32), Vector3.new(46, SURFACE_Y + 18.6, 28), ORANGE)
	for _, dz in { -9.5, 0, 9.5 } do
		addPart(
			depot,
			"GarageDoor",
			Vector3.new(0.5, 11, 8),
			Vector3.new(28.8, SURFACE_Y + 5.5, 28 + dz),
			Color3.fromRGB(160, 166, 178),
			Enum.Material.Metal,
			{ CanCollide = false }
		)
	end
	local garageSign = addPart(depot, "GarageSign", Vector3.new(0.6, 4, 22), Vector3.new(28.7, SURFACE_Y + 14.5, 28), NAVY, nil, { CanCollide = false })
	addText(garageSign, Enum.NormalId.Left, "GARAGE", ORANGE, nil, 40)

	local garageAnchor = addInvisibleAnchor(depot, "GarageAnchor", Vector3.new(25, SURFACE_Y + 4, 28))
	local garagePrompt = Instance.new("ProximityPrompt")
	garagePrompt.Name = "Prompt"
	garagePrompt.ActionText = "Open Garage"
	garagePrompt.ObjectText = "Vehicles"
	garagePrompt.KeyboardKeyCode = Enum.KeyCode.G
	garagePrompt.HoldDuration = 0
	garagePrompt.MaxActivationDistance = 24
	garagePrompt.RequiresLineOfSight = false
	garagePrompt.Parent = garageAnchor

	-- Where players appear.
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.AllowTeamChangeOnTouch = false
	spawn.Duration = 0
	-- Thin and non-colliding so cars drive straight over it; players still appear on top of it.
	spawn.Size = Vector3.new(14, 0.2, 14)
	spawn.CFrame = CFrame.new(0, SURFACE_Y + 0.1, 34)
	spawn.CanCollide = false
	spawn.Color = ORANGE
	spawn.Material = Enum.Material.Neon
	spawn.Transparency = 0.6
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.BottomSurface = Enum.SurfaceType.Smooth
	spawn.Parent = depot

	-- A few trees along the yard edge.
	local props = addFolder(depot, "Trees")
	local rng = makeRng(7)
	for _, pos in { Vector3.new(-56, 0, 50), Vector3.new(-56, 0, 20), Vector3.new(56, 0, -10), Vector3.new(-56, 0, -8) } do
		addTree(props, rng, pos.X, pos.Z)
	end

	depot.Parent = town
	town:SetAttribute("DispatchPos", dispatchAnchor.CFrame.Position)
	town:SetAttribute("SpawnPos", spawn.CFrame.Position)
	return depot
end

-- Public API ------------------------------------------------------------------------

function WorldBuilder.build(parent: Instance): Folder
	local g = geometry()
	local rng = makeRng(20240229)

	local town = Instance.new("Folder")
	town.Name = "Town"

	buildGround(town, g)
	buildRoads(town, g)

	local blocks = addFolder(town, "Blocks")
	local houses = addFolder(town, "Houses")
	local props = addFolder(town, "Props")
	local center = (g.N + 1) / 2

	local nextId = 1
	for i = 1, g.N do
		for j = 1, g.N do
			if not (i == center and j == center) then
				buildBlockBase(blocks, g, i, j, GRASS, Enum.Material.Grass)
				local cx, cz = g.BlockCenter(j), g.BlockCenter(i)

				for slot = 1, Config.World.HousesPerRow do
					buildHouse(houses, g, rng, nextId, i, j, slot, true)
					nextId += 1
					buildHouse(houses, g, rng, nextId, i, j, slot, false)
					nextId += 1
				end

				-- Backyard trees between the two rows of houses.
				for tx = -2, 2 do
					for tz = -1, 1, 2 do
						if rng.float() > 0.35 then
							addTree(props, rng, cx + tx * 24 + rng.range(-4, 4), cz + tz * 14 + rng.range(-4, 4))
						end
					end
				end

				-- Street lamps at the middle of each block edge.
				local lampOffset = g.Block / 2 - g.Sidewalk / 2
				addLamp(props, cx, cz - lampOffset)
				addLamp(props, cx, cz + lampOffset)
				addLamp(props, cx - lampOffset, cz)
				addLamp(props, cx + lampOffset, cz)
			end
		end
	end

	-- Street name signs at every intersection that has a block to its south-east.
	local signs = addFolder(props, "StreetSigns")
	for k = 0, g.N - 1 do
		for m = 0, g.N - 1 do
			local x = g.RoadCenter(k) + g.Road / 2 + g.Sidewalk / 2
			local z = g.RoadCenter(m) + g.Road / 2 + g.Sidewalk / 2
			addStreetSign(signs, x, z, Config.StreetNames[m + 1], Config.AvenueNames[k + 1])
		end
	end

	buildDepot(town, g)

	town.Parent = parent
	return town
end

-- Reads a built town back into the plain data the game services use.
function WorldBuilder.info(town: Folder)
	local houses = {}
	for _, model in town.Houses:GetChildren() do
		table.insert(houses, {
			Id = model:GetAttribute("HouseId"),
			Number = model:GetAttribute("Number"),
			Street = model:GetAttribute("Street"),
			Address = model:GetAttribute("Address"),
			MarkerPos = model:GetAttribute("MarkerPos"),
		})
	end
	table.sort(houses, function(a, b)
		return a.Id < b.Id
	end)

	local depot = town.Depot
	return {
		Town = town,
		Houses = houses,
		DispatchPos = town:GetAttribute("DispatchPos"),
		SpawnPos = town:GetAttribute("SpawnPos"),
		DispatchPrompt = depot.DispatchAnchor.Prompt,
		GaragePrompt = depot.GarageAnchor.Prompt,
		Spawn = depot.Spawn,
	}
end

return WorldBuilder
]]></ProtectedString>
