        </Properties>
        <Item class="ModuleScript" referent="3483">
          <Properties>
            <string name="Name">DriveModel</string>
            <ProtectedString name="Source"><![CDATA[--[[
	The arcade driving model, as pure maths (Vector3 in, Vector3 out) so it can be unit-tested.

	Rather than simulate wheels and suspension, the driver's client owns the car's physics and, every
	frame, sets its velocity from throttle/steering input and keeps it upright:

	  * Forward speed accelerates toward throttle * MaxSpeed (braking is stronger than accelerating).
	  * Sideways slide decays at rate Grip, which gives a little drift when you turn hard.
	  * Steering needs some forward speed, and eases off as you go faster (so top speed isn't twitchy).
	  * Angular velocity = yaw from steering + a correction that rolls the car back upright, so it
	    can never flip no matter what it hits. Y velocity is left alone, so gravity and collisions work.

	Conventions: the car faces its LookVector (-Z locally). Positive angular velocity about +Y turns
	left, so steering right (steer > 0) is negative yaw.
]]

local DriveModel = {}

DriveModel.COAST_DECEL = 0.45 -- fraction of Accel used to slow down with no throttle
DriveModel.BRAKE_MULT = 2.2 -- braking is this many times stronger than accelerating
DriveModel.REVERSE_FRACTION = 0.4 -- reverse top speed as a fraction of MaxSpeed
DriveModel.STEER_FULL_SPEED = 10 -- studs/s of forward speed at which steering is fully effective
DriveModel.TURN_FALLOFF = 0.45 -- how much steering is reduced at top speed
DriveModel.LEVEL_RATE = 8 -- how hard the car rights itself (1/s)
DriveModel.RECOVER_UP_Y = 0.3 -- if the car's up vector is flatter than this it is badly flipped

local function approach(value: number, target: number, maxDelta: number): number
	if value < target then
		return math.min(value + maxDelta, target)
	end
	return math.max(value - maxDelta, target)
end

-- stats: { MaxSpeed, Accel, Turn, Grip }
-- Returns newLinearVelocity, newAngularVelocity.
function DriveModel.step(velocity: Vector3, look: Vector3, up: Vector3, throttle: number, steer: number, stats, dt: number): (Vector3, Vector3)
	local leveling = up:Cross(Vector3.yAxis) * DriveModel.LEVEL_RATE

	local flatLook = Vector3.new(look.X, 0, look.Z)
	if flatLook.Magnitude < 1e-3 then
		return velocity, leveling -- pointing straight up/down: only try to right the car
	end
	local forward = flatLook.Unit
	local right = forward:Cross(Vector3.yAxis)

	local forwardSpeed = velocity:Dot(forward)
	local sideSpeed = velocity:Dot(right)

	-- Longitudinal: accelerate, brake, or coast.
	local target
	if throttle > 0 then
		target = throttle * stats.MaxSpeed
	elseif throttle < 0 then
		target = throttle * stats.MaxSpeed * DriveModel.REVERSE_FRACTION
	else
		target = 0
	end

	local rate
	if throttle == 0 then
		rate = stats.Accel * DriveModel.COAST_DECEL
	elseif (throttle > 0 and forwardSpeed >= 0) or (throttle < 0 and forwardSpeed <= 0) then
		rate = stats.Accel * math.abs(throttle)
	else
		rate = stats.Accel * DriveModel.BRAKE_MULT
	end
	forwardSpeed = approach(forwardSpeed, target, rate * dt)

	-- Lateral grip.
	sideSpeed *= math.exp(-stats.Grip * dt)

	-- Steering.
	local authority = math.clamp(math.abs(forwardSpeed) / DriveModel.STEER_FULL_SPEED, 0, 1)
	local speedFraction = math.clamp(math.abs(forwardSpeed) / stats.MaxSpeed, 0, 1)
	local turnRate = stats.Turn * (1 - DriveModel.TURN_FALLOFF * speedFraction) * authority
	local direction = forwardSpeed >= 0 and 1 or -1 -- steering inverts when reversing
	local yaw = -steer * turnRate * direction

	local newVelocity = forward * forwardSpeed + right * sideSpeed + Vector3.new(0, velocity.Y, 0)
	return newVelocity, Vector3.new(0, yaw, 0) + leveling
end

-- True when the car is so tilted that rolling back upright would take too long.
function DriveModel.needsRecovery(up: Vector3): boolean
	return up.Y < DriveModel.RECOVER_UP_Y
end

-- Where to put a badly flipped car: same spot, a little higher, facing the way its nose was pointing.
function DriveModel.recoveryCFrame(position: Vector3, look: Vector3): CFrame
	local yaw = 0
	if look.X ~= 0 or look.Z ~= 0 then
		yaw = math.atan2(-look.X, -look.Z)
	end
	return CFrame.new(position + Vector3.new(0, 3, 0)) * CFrame.Angles(0, yaw, 0)
end

return DriveModel
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3484">
          <Properties>
            <string name="Name">GarageUI</string>
            <ProtectedString name="Source"><![CDATA[--[[
	The garage: browse vehicles with live 3D previews, buy them, and pick which one to drive.

	All rules (price, rank, cash) are enforced by the server; this UI only displays state and sends
	requests via GarageRequest. Buttons reflect what the server will accept.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local VehicleBuilder = require(ReplicatedStorage.Shared.VehicleBuilder)
local State = require(script.Parent.State)
local Theme = require(script.Parent.Theme)
local UIKit = require(script.Parent.UIKit)

local GarageUI = {}

local CARD_WIDTH, CARD_HEIGHT = 190, 330

-- Best value across all vehicles, so stat bars are comparable.
local function maxima()
	local m = { Speed = 0, Accel = 0, Handling = 0 }
	for _, v in Config.Vehicles do
		m.Speed = math.max(m.Speed, v.MaxSpeed)
		m.Accel = math.max(m.Accel, v.Accel)
		m.Handling = math.max(m.Handling, v.Turn * math.sqrt(v.Grip))
	end
	return m
end

local function statBar(parent: Instance, name: string, fraction: number, order: number)
	local row = UIKit.create("Frame", {
		Name = name,
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	})
	UIKit.label({
		Size = UDim2.new(0, 70, 1, 0),
		Font = Theme.FontBold,
		TextSize = 11,
		TextColor3 = Theme.TextDim,
		Text = string.upper(name),
		Parent = row,
	})
	local track = UIKit.create("Frame", {
		Position = UDim2.new(0, 72, 0.5, -4),
		Size = UDim2.new(1, -72, 0, 8),
		BackgroundColor3 = Theme.NavyLight,
		BorderSizePixel = 0,
		Parent = row,
	}, { UIKit.corner(4) })
	UIKit.create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(math.clamp(fraction, 0.05, 1), 1),
		BackgroundColor3 = Theme.Orange,
		BorderSizePixel = 0,
		Parent = track,
	}, { UIKit.corner(4) })
end

-- A rotating 3D preview of a vehicle. Returns the ViewportFrame and a function(angle) to spin it.
local function buildPreview(vehicleId: string)
	local viewport = UIKit.create("ViewportFrame", {
		Name = "Preview",
		Size = UDim2.new(1, 0, 0, 120),
		BackgroundColor3 = Theme.NavyLight,
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		Ambient = Color3.fromRGB(150, 156, 175),
		LightColor = Color3.fromRGB(255, 244, 224),
		LightDirection = Vector3.new(-0.5, -1, -0.6),
	}, { UIKit.corner(10) })

	local model = VehicleBuilder.build(vehicleId)
	local pivot = model:GetPivot()
	local size = model:GetExtentsSize()
	model.Parent = viewport

	local camera = Instance.new("Camera")
	camera.FieldOfView = 38
	local focus = pivot.Position + Vector3.new(0, size.Y * 0.1, 0)
	local distance = math.max(size.X, size.Y, size.Z) * 1.75
	camera.CFrame = CFrame.lookAt(focus + Vector3.new(0, size.Y * 0.35, distance), focus)
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	local function spin(angle: number)
		model:PivotTo(CFrame.new(pivot.Position) * CFrame.Angles(0, angle, 0))
	end
	spin(math.rad(-35))
	return viewport, spin
end

-- deps.toast(message, kind)
function GarageUI.build(gui: ScreenGui, deps)
	local overlay = UIKit.create("TextButton", {
		Name = "Garage",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Text = "",
		AutoButtonColor = false,
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	})

	local window = UIKit.panel({
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(920, 470),
		BackgroundTransparency = 0.02,
		ZIndex = 11,
		Parent = overlay,
	})
	UIKit.autoScale(window)

	UIKit.label({
		Position = UDim2.fromOffset(24, 14),
		Size = UDim2.fromOffset(300, 36),
		Font = Theme.FontBold,
		TextSize = 30,
		Text = "GARAGE",
		ZIndex = 12,
		Parent = window,
	})
	local cashLabel = UIKit.label({
		Name = "Cash",
		Position = UDim2.new(1, -330, 0, 14),
		Size = UDim2.fromOffset(240, 36),
		Font = Theme.FontBold,
		TextSize = 26,
		TextColor3 = Theme.Green,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "$0",
		ZIndex = 12,
		Parent = window,
	})

	local garage = {}

	function garage.close()
		overlay.Visible = false
	end

	UIKit.button({
		Name = "CloseButton",
		Position = UDim2.new(1, -68, 0, 16),
		Size = UDim2.fromOffset(44, 36),
		Text = "X",
		BackgroundColor3 = Theme.NavyLighter,
		TextColor3 = Theme.Text,
		ZIndex = 12,
		OnClick = garage.close,
		Parent = window,
	})

	local list = UIKit.create("ScrollingFrame", {
		Name = "List",
		Position = UDim2.fromOffset(24, 70),
		Size = UDim2.new(1, -48, 1, -90),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollingDirection = Enum.ScrollingDirection.X,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ZIndex = 12,
		Parent = window,
	}, {
		UIKit.list({ FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 14) }),
	})

	local best = maxima()
	local cards = {} -- [vehicleId] = { Button, Status, Spin }

	local function request(action: string, vehicleId: string)
		task.spawn(function()
			local ok, reply = pcall(function()
				return Remotes.GarageRequest:InvokeServer(action, vehicleId)
			end)
			if ok and type(reply) == "table" then
				deps.toast(reply.message, reply.ok and "success" or "error")
			else
				deps.toast("Something went wrong - try again.", "error")
			end
		end)
	end

	for index, spec in Config.Vehicles do
		local card = UIKit.create("Frame", {
			Name = spec.Id,
			Size = UDim2.fromOffset(CARD_WIDTH, CARD_HEIGHT),
			BackgroundColor3 = Theme.NavyLight,
			BackgroundTransparency = 0.25,
			BorderSizePixel = 0,
			LayoutOrder = index,
			ZIndex = 12,
			Parent = list,
		}, {
			UIKit.corner(14),
			UIKit.padding(10),
		})
		local stroke = UIKit.stroke(Theme.NavyLighter, 2, 0.3)
		stroke.Parent = card

		local inner = UIKit.create("Frame", {
			Name = "Inner",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ZIndex = 12,
			Parent = card,
		}, {
			UIKit.list({ Padding = UDim.new(0, 6) }),
		})

		local preview, spin = buildPreview(spec.Id)
		preview.LayoutOrder = 1
		preview.Parent = inner

		UIKit.label({
			Size = UDim2.new(1, 0, 0, 22),
			Font = Theme.FontBold,
			TextSize = 17,
			Text = spec.Name,
			LayoutOrder = 2,
			Parent = inner,
		})
		UIKit.label({
			Size = UDim2.new(1, 0, 0, 30),
			Font = Theme.FontRegular,
			TextSize = 11,
			TextColor3 = Theme.TextDim,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			Text = spec.Description,
			LayoutOrder = 3,
			Parent = inner,
		})
		local stats = UIKit.create("Frame", {
			Size = UDim2.new(1, 0, 0, 62),
			BackgroundTransparency = 1,
			LayoutOrder = 4,
			Parent = inner,
		}, { UIKit.list({}) })
		statBar(stats, "Speed", spec.MaxSpeed / best.Speed, 1)
		statBar(stats, "Accel", spec.Accel / best.Accel, 2)
		statBar(stats, "Handling", spec.Turn * math.sqrt(spec.Grip) / best.Handling, 3)

		local status = UIKit.label({
			Name = "Status",
			Size = UDim2.new(1, 0, 0, 20),
			Font = Theme.FontBold,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Center,
			Text = "",
			LayoutOrder = 5,
			Parent = inner,
		})
		local button
		button = UIKit.button({
			Name = "ActionButton",
			Size = UDim2.new(1, 0, 0, 36),
			Text = "",
			LayoutOrder = 6,
			ZIndex = 13,
			OnClick = function()
				local action = button:GetAttribute("Action")
				if action then
					request(action, spec.Id)
				end
			end,
			Parent = inner,
		})

		cards[spec.Id] = { Frame = card, Stroke = stroke, Status = status, Button = button, Spin = spin }
	end

	-- Reflect ownership / cash / rank on every card.
	local function refresh()
		local cash = State.get("Cash", 0)
		local rank = State.get("RankIndex", 1)
		local equipped = State.get("Equipped", Config.DefaultVehicle)
		cashLabel.Text = Economy.formatMoney(cash)

		for _, spec in Config.Vehicles do
			local card = cards[spec.Id]
			local owned = State.owns(spec.Id)
			local isEquipped = equipped == spec.Id
			card.Stroke.Color = isEquipped and Theme.Orange or Theme.NavyLighter

			if isEquipped then
				card.Status.Text = "IN USE"
				card.Status.TextColor3 = Theme.Orange
				card.Button:SetAttribute("Action", nil)
				card.Button.Text = "EQUIPPED"
				UIKit.setButtonEnabled(card.Button, false, Theme.Orange)
			elseif owned then
				card.Status.Text = "OWNED"
				card.Status.TextColor3 = Theme.Green
				card.Button:SetAttribute("Action", "Equip")
				card.Button.Text = "EQUIP"
				UIKit.setButtonEnabled(card.Button, true, Theme.Green)
			elseif rank < spec.RankRequired then
				card.Status.Text = "LOCKED"
				card.Status.TextColor3 = Theme.Red
				card.Button:SetAttribute("Action", nil)
				card.Button.Text = "RANK: " .. string.upper(Config.Ranks[spec.RankRequired].Name)
				UIKit.setButtonEnabled(card.Button, false, Theme.Orange)
			else
				card.Status.Text = Economy.formatMoney(spec.Price)
				card.Status.TextColor3 = cash >= spec.Price and Theme.Green or Theme.Red
				card.Button:SetAttribute("Action", cash >= spec.Price and "Buy" or nil)
				card.Button.Text = "BUY"
				UIKit.setButtonEnabled(card.Button, cash >= spec.Price, Theme.Orange)
			end
		end
	end
	for _, name in { "Cash", "RankIndex", "Equipped", "Owned" } do
		State.watch(name, refresh)
	end

	-- Spin the previews only while the garage is open.
	local angle = 0
	UIKit.onFrame(function(dt)
		if not overlay.Visible then
			return
		end
		angle += dt * 0.9
		for _, card in cards do
			card.Spin(angle)
		end
	end)

	function garage.open()
		refresh()
		overlay.Visible = true
	end

	function garage.toggle()
		if overlay.Visible then
			garage.close()
		else
			garage.open()
		end
	end

	-- Clicking the dimmed background closes it (the window swallows clicks inside it).
	UIKit.on(overlay, "Activated", garage.close)
	window.Active = true

	-- Exposed for tests.
	garage.Overlay = overlay
	garage.Cards = cards
	garage.refresh = refresh
	return garage
end

return GarageUI
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3485">
          <Properties>
            <string name="Name">Hud</string>
            <ProtectedString name="Source"><![CDATA[--[[
	Always-on heads-up display:
	  top-left    cash, rank + XP bar, delivery streak
	  top-centre  what to do next (the objective banner)
	  left        Garage and "Call vehicle" buttons
	  bottom      speedometer while driving
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Economy = require(ReplicatedStorage.Shared.Economy)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.State)
local Theme = require(script.Parent.Theme)
local UIKit = require(script.Parent.UIKit)
local VehicleController = require(script.Parent.VehicleController)

local Hud = {}

local STREAK_STEP = 5 -- shown as +5% per streak step

-- deps.openGarage: function to open the garage UI
function Hud.build(gui: ScreenGui, deps)
	-- Stats card ------------------------------------------------------------------
	local card = UIKit.panel({
		Name = "StatsCard",
		Position = UDim2.new(0, 16, 0, 12),
		Size = UDim2.fromOffset(268, 92),
		Parent = gui,
	})
	UIKit.autoScale(card)

	local cashLabel = UIKit.label({
		Name = "Cash",
		Position = UDim2.new(0, 16, 0, 8),
		Size = UDim2.new(1, -32, 0, 36),
		Font = Theme.FontBold,
		TextSize = 32,
		TextColor3 = Theme.Green,
		Text = "$0",
		Parent = card,
	})
	local rankLabel = UIKit.label({
		Name = "Rank",
		Position = UDim2.new(0, 16, 0, 46),
		Size = UDim2.new(0.62, 0, 0, 18),
		Font = Theme.FontBold,
		TextSize = 14,
		TextColor3 = Theme.Text,
		Text = "ROOKIE",
		Parent = card,
	})
	local xpLabel = UIKit.label({
		Name = "XP",
		Position = UDim2.new(0.5, 0, 0, 46),
		Size = UDim2.new(0.5, -16, 0, 18),
		Font = Theme.FontMedium,
		TextSize = 13,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "0 / 120 XP",
		Parent = card,
	})
	local barTrack = UIKit.create("Frame", {
		Name = "XPBar",
		Position = UDim2.new(0, 16, 0, 70),
		Size = UDim2.new(1, -32, 0, 10),
		BackgroundColor3 = Theme.NavyLight,
		BorderSizePixel = 0,
		Parent = card,
	}, { UIKit.corner(5) })
	local barFill = UIKit.create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Orange,
		BorderSizePixel = 0,
		Parent = barTrack,
	}, { UIKit.corner(5) })

	local streakChip = UIKit.create("Frame", {
		Name = "StreakChip",
		Position = UDim2.new(0, 16, 0, 112),
		Size = UDim2.fromOffset(190, 28),
		BackgroundColor3 = Theme.Orange,
		BorderSizePixel = 0,
		Visible = false,
		Parent = gui,
	}, { UIKit.corner(14) })
	UIKit.autoScale(streakChip)
	local streakLabel = UIKit.label({
		Size = UDim2.fromScale(1, 1),
		Font = Theme.FontBold,
		TextSize = 14,
		TextColor3 = Theme.Navy,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = "",
		Parent = streakChip,
	})

	-- Objective banner --------------------------------------------------------------
	local banner = UIKit.panel({
		Name = "Objective",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.fromOffset(440, 40),
		Parent = gui,
	})
	UIKit.autoScale(banner)
	local objectiveLabel = UIKit.label({
		Name = "Text",
		Size = UDim2.new(1, -24, 1, 0),
		Position = UDim2.fromOffset(12, 0),
		Font = Theme.FontBold,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = true,
		Text = "",
		Parent = banner,
	})

	-- Buttons -------------------------------------------------------------------------
	local buttons = UIKit.create("Frame", {
		Name = "Buttons",
		Position = UDim2.new(0, 16, 0, 152),
		Size = UDim2.fromOffset(190, 100),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UIKit.list({ Padding = UDim.new(0, 8) }),
	})
	UIKit.autoScale(buttons)
	UIKit.button({
		Name = "GarageButton",
		Size = UDim2.new(1, 0, 0, 44),
		Text = "GARAGE",
		LayoutOrder = 1,
		BackgroundColor3 = Theme.NavyLighter,
		TextColor3 = Theme.Text,
		OnClick = deps.openGarage,
		Parent = buttons,
	})
	UIKit.button({
		Name = "CallButton",
		Size = UDim2.new(1, 0, 0, 44),
		Text = "MY VEHICLE  [V]",
		LayoutOrder = 2,
		OnClick = function()
			Remotes.CallVehicle:FireServer()
		end,
		Parent = buttons,
	})

	-- Speedometer ----------------------------------------------------------------------
	local speedo = UIKit.panel({
		Name = "Speedometer",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -20),
		Size = UDim2.fromOffset(220, 66),
		Visible = false,
		Parent = gui,
	})
	UIKit.autoScale(speedo)
	local speedLabel = UIKit.label({
		Name = "Speed",
		Position = UDim2.fromOffset(16, 4),
		Size = UDim2.new(0.6, 0, 0, 40),
		Font = Theme.FontBold,
		TextSize = 36,
		Text = "0",
		Parent = speedo,
	})
	UIKit.label({
		Position = UDim2.new(0.55, 0, 0, 14),
		Size = UDim2.new(0.45, -16, 0, 22),
		Font = Theme.FontBold,
		TextSize = 14,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "KM/H",
		Parent = speedo,
	})
	local speedTrack = UIKit.create("Frame", {
		Position = UDim2.new(0, 16, 1, -18),
		Size = UDim2.new(1, -32, 0, 8),
		BackgroundColor3 = Theme.NavyLight,
		BorderSizePixel = 0,
		Parent = speedo,
	}, { UIKit.corner(4) })
	local speedFill = UIKit.create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Orange,
		BorderSizePixel = 0,
		Parent = speedTrack,
	}, { UIKit.corner(4) })

	-- Live state ----------------------------------------------------------------------
	local function refreshMoney()
		cashLabel.Text = Economy.formatMoney(State.get("Cash", 0))
	end
	local function refreshRank()
		local xp = State.get("XP", 0)
		local info = Economy.rankInfo(xp)
		rankLabel.Text = string.format("RANK %d  %s", info.Index, string.upper(info.Name))
		if info.XPNext then
			xpLabel.Text = string.format("%d / %d XP", xp, info.XPNext)
		else
			xpLabel.Text = "MAX RANK"
		end
		UIKit.tween(barFill, 0.35, { Size = UDim2.fromScale(info.Fraction, 1) })
	end
	local function refreshStreak()
		local streak = State.get("Streak", 0)
		streakChip.Visible = streak > 0
		streakLabel.Text = string.format("STREAK x%d   +%d%% TIPS & BONUS", streak, math.min(streak * STREAK_STEP, 50))
	end
	State.watch("Cash", refreshMoney)
	State.watch("XP", refreshRank)
	State.watch("Streak", refreshStreak)

	-- Speedometer: show only while driving our own vehicle.
	local topSpeed = 1
	UIKit.onFrame(function()
		local model = VehicleController.currentVehicle()
		if not model or not model.PrimaryPart then
			speedo.Visible = false
			return
		end
		topSpeed = model:GetAttribute("MaxSpeed") or topSpeed
		local velocity = model.PrimaryPart.AssemblyLinearVelocity
		local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
		speedo.Visible = true
		speedLabel.Text = tostring(math.floor(speed * 0.8 + 0.5))
		speedFill.Size = UDim2.fromScale(math.clamp(speed / topSpeed, 0, 1), 1)
	end)

	local hud = {}

	function hud.setObjective(text: string)
		objectiveLabel.Text = text
	end

	-- Exposed for tests.
	hud.CashLabel = cashLabel
	hud.RankLabel = rankLabel
	hud.XPLabel = xpLabel
	hud.StreakChip = streakChip
	hud.StreakLabel = streakLabel
	hud.ObjectiveLabel = objectiveLabel
	hud.Speedometer = speedo
	return hud
end

return Hud
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="3486">
          <Properties>
            <string name="Name">Main</string>
            <ProtectedString name="Source"><![CDATA[--[[
	Client entry point: builds the UI, wires it to the state the server publishes, and starts the
	vehicle scripts. See the other modules in this folder for the details.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local GarageUI = require(script.Parent.GarageUI)
local Hud = require(script.Parent.Hud)
local OrderPanel = require(script.Parent.OrderPanel)
local Splash = require(script.Parent.Splash)
local State = require(script.Parent.State)
local UIKit = require(script.Parent.UIKit)
local VehicleController = require(script.Parent.VehicleController)
local VehicleVisuals = require(script.Parent.VehicleVisuals)
local Waypoint = require(script.Parent.Waypoint)

UIKit.watchViewport()
local gui = UIKit.createGui("DeliveryDriver")

-- Build the UI. Garage and hud both need to open/toast, so create the panel first.
local orders = OrderPanel.build(gui)
local garage = GarageUI.build(gui, { toast = orders.toast })
local hud = Hud.build(gui, { openGarage = garage.toggle })
local waypoint = Waypoint.build(gui)
Splash.build(gui)

-- Where should the arrow point? At the order if there is one, otherwise back to the depot.
local town = Workspace:WaitForChild("Town")
local dispatchPosition = town:GetAttribute("DispatchPos")

local function refreshGuidance()
	if State.get("OrderId", 0) > 0 then
		local destination = State.get("OrderDest")
		if destination then
			waypoint.setTarget({ Position = destination, Label = State.get("OrderAddress", ""), HideWithin = 0 }, true)
			hud.setObjective("Drive to the glowing ring and slow down to deliver")
			return
		end
	end
	waypoint.setTarget({ Position = dispatchPosition, Label = "DISPATCH DEPOT", HideWithin = 20 }, false)
	if State.get("Deliveries", 0) == 0 then
		hud.setObjective("Head to the DISPATCH counter and press E to take an order")
	else
		hud.setObjective("Head back to the depot for your next order")
	end
end
State.watch("OrderId", refreshGuidance)
State.watch("Deliveries", refreshGuidance)

-- Server events.
Remotes.Notify.OnClientEvent:Connect(orders.toast)
Remotes.OpenGarage.OnClientEvent:Connect(garage.open)
Remotes.DeliveryResult.OnClientEvent:Connect(function(result)
	orders.showResult(result)
	if result.Position then
		waypoint.celebrate(result.Position)
	end
end)

-- Press V to call your vehicle (the HUD button does the same for touch/gamepad).
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end
	if input.KeyCode == Enum.KeyCode.V then
		Remotes.CallVehicle:FireServer()
	end
end)

VehicleController.start()
VehicleVisuals.start()
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3487">
          <Properties>
            <string name="Name">OrderPanel</string>
            <ProtectedString name="Source"><![CDATA[--[[
	Everything about the current delivery:
	  * the order card (package, address, countdown, payout, cancel)
	  * toast notifications
	  * the "Delivered!" result popup with the payout breakdown
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Economy = require(ReplicatedStorage.Shared.Economy)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.State)
local Theme = require(script.Parent.Theme)
local UIKit = require(script.Parent.UIKit)

local OrderPanel = {}

local MAX_TOASTS = 4
local TOAST_SECONDS = 4.5
local RESULT_SECONDS = 5

local function timerColor(remaining: number, limit: number): Color3
	if remaining < 0 then
		return Theme.Red
	end
	local fraction = remaining / math.max(limit, 1)
	if fraction > 0.4 then
		return Theme.Green
	elseif fraction > 0.15 then
		return Theme.Yellow
	end
	return Theme.Red
end

function OrderPanel.build(gui: ScreenGui)
	-- Order card ----------------------------------------------------------------------
	local card = UIKit.panel({
		Name = "OrderCard",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 12),
		Size = UDim2.fromOffset(280, 178),
		Visible = false,
		Parent = gui,
	})
	UIKit.autoScale(card)

	UIKit.label({
		Position = UDim2.fromOffset(16, 10),
		Size = UDim2.new(1, -32, 0, 16),
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = Theme.Orange,
		Text = "CURRENT ORDER",
		Parent = card,
	})
	local packageLabel = UIKit.label({
		Name = "Package",
		Position = UDim2.fromOffset(16, 28),
		Size = UDim2.new(1, -32, 0, 18),
		Font = Theme.FontMedium,
		TextSize = 14,
		TextColor3 = Theme.TextDim,
		Text = "",
		Parent = card,
	})
	local addressLabel = UIKit.label({
		Name = "Address",
		Position = UDim2.fromOffset(16, 46),
		Size = UDim2.new(1, -32, 0, 28),
		Font = Theme.FontBold,
		TextSize = 24,
		TextScaled = false,
		Text = "",
		Parent = card,
	})
	local timerLabel = UIKit.label({
		Name = "Timer",
		Position = UDim2.fromOffset(16, 78),
		Size = UDim2.new(0.5, 0, 0, 44),
		Font = Theme.FontBold,
		TextSize = 40,
		TextColor3 = Theme.Green,
		Text = "0:00",
		Parent = card,
	})
	local timerCaption = UIKit.label({
		Name = "TimerCaption",
		Position = UDim2.fromOffset(16, 120),
		Size = UDim2.new(0.5, 0, 0, 16),
		Font = Theme.FontMedium,
		TextSize = 12,
		TextColor3 = Theme.TextDim,
		Text = "TIME LEFT",
		Parent = card,
	})
	local payLabel = UIKit.label({
		Name = "Pay",
		Position = UDim2.new(0.5, 0, 0, 84),
		Size = UDim2.new(0.5, -16, 0, 22),
		Font = Theme.FontBold,
		TextSize = 20,
		TextColor3 = Theme.Green,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "",
		Parent = card,
	})
	local distanceLabel = UIKit.label({
		Name = "Distance",
		Position = UDim2.new(0.5, 0, 0, 108),
		Size = UDim2.new(0.5, -16, 0, 18),
		Font = Theme.FontMedium,
		TextSize = 14,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "",
		Parent = card,
	})
	UIKit.button({
		Name = "CancelButton",
		Position = UDim2.new(1, -96, 1, -38),
		Size = UDim2.fromOffset(80, 28),
		Text = "CANCEL",
		TextSize = 13,
		BackgroundColor3 = Theme.NavyLighter,
		TextColor3 = Theme.TextDim,
		OnClick = function()
			Remotes.CancelOrder:FireServer()
		end,
		Parent = card,
	})
	UIKit.label({
		Position = UDim2.new(0, 16, 1, -38),
		Size = UDim2.new(1, -120, 0, 28),
		Font = Theme.FontMedium,
		TextSize = 12,
		TextColor3 = Theme.TextDim,
		TextWrapped = true,
		Text = "Slow down inside the ring to deliver.",
		Parent = card,
	})

	-- Toasts ------------------------------------------------------------------------------
	local toastHolder = UIKit.create("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 176),
		Size = UDim2.fromOffset(460, 200),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UIKit.list({
			Padding = UDim.new(0, 6),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}),
	})
	UIKit.autoScale(toastHolder)
	local toastOrder = 0

	local function toast(message: string, kind: string?)
		local accent = Theme.Kinds[kind or "info"] or Theme.Kinds.info
		toastOrder += 1
		local pill = UIKit.panel({
			Name = "Toast",
			Size = UDim2.fromOffset(0, 40), -- animates open
			LayoutOrder = toastOrder,
			ClipsDescendants = true,
			BackgroundTransparency = 0.05,
			Parent = toastHolder,
		})
		local stroke = pill:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = accent
			stroke.Transparency = 0
		end
		UIKit.create("Frame", {
			Position = UDim2.fromOffset(6, 6),
			Size = UDim2.new(0, 4, 1, -12),
			BackgroundColor3 = accent,
			BorderSizePixel = 0,
			Parent = pill,
		}, { UIKit.corner(2) })
		UIKit.label({
			Position = UDim2.fromOffset(16, 0),
			Size = UDim2.new(1, -28, 1, 0),
			Font = Theme.FontBold,
			TextSize = 16,
			TextWrapped = true,
			Text = message,
			Parent = pill,
		})
		UIKit.tween(pill, 0.2, { Size = UDim2.fromOffset(440, 40) })

		-- Oldest toasts make room when too many pile up.
		local children = toastHolder:GetChildren()
		local pills = {}
		for _, child in children do
			if child.Name == "Toast" then
				table.insert(pills, child)
			end
		end
		if #pills > MAX_TOASTS then
			table.sort(pills, function(a, b)
				return a.LayoutOrder < b.LayoutOrder
			end)
			pills[1]:Destroy()
		end

		task.delay(TOAST_SECONDS, function()
			if pill.Parent then
				UIKit.tween(pill, 0.25, { Size = UDim2.fromOffset(0, 40), BackgroundTransparency = 1 })
				task.delay(0.3, function()
					pill:Destroy()
				end)
			end
		end)
	end

	-- Result popup --------------------------------------------------------------------------
	local result = UIKit.panel({
		Name = "ResultCard",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.42, 0),
		Size = UDim2.fromOffset(340, 320),
		Visible = false,
		BackgroundTransparency = 0.05,
		Parent = gui,
	})
	UIKit.autoScale(result)
	local resultTitle = UIKit.label({
		Name = "Title",
		Position = UDim2.fromOffset(0, 14),
		Size = UDim2.new(1, 0, 0, 34),
		Font = Theme.FontBold,
		TextSize = 30,
		TextColor3 = Theme.Green,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = "DELIVERED!",
		Parent = result,
	})
	local resultAddress = UIKit.label({
		Name = "Address",
		Position = UDim2.fromOffset(0, 48),
		Size = UDim2.new(1, 0, 0, 20),
		Font = Theme.FontMedium,
		TextSize = 15,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = "",
		Parent = result,
	})
	local resultStars = UIKit.label({
		Name = "Stars",
		Position = UDim2.fromOffset(0, 72),
		Size = UDim2.new(1, 0, 0, 34),
		Font = Theme.FontBold,
		TextSize = 28,
		TextColor3 = Theme.Yellow,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = "",
		Parent = result,
	})
	local lines = UIKit.create("Frame", {
		Name = "Lines",
		Position = UDim2.fromOffset(24, 114),
		Size = UDim2.new(1, -48, 0, 130),
		BackgroundTransparency = 1,
		Parent = result,
	}, { UIKit.list({ Padding = UDim.new(0, 2) }) })
	local resultTotal = UIKit.label({
		Name = "Total",
		Position = UDim2.new(0, 0, 1, -62),
		Size = UDim2.new(1, 0, 0, 40),
		Font = Theme.FontBold,
		TextSize = 36,
		TextColor3 = Theme.Green,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = "",
		Parent = result,
	})
	local resultXP = UIKit.label({
		Name = "XP",
		Position = UDim2.new(0, 0, 1, -26),
		Size = UDim2.new(1, 0, 0, 20),
		Font = Theme.FontBold,
		TextSize = 14,
		TextColor3 = Theme.Orange,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = "",
		Parent = result,
	})
	local resultToken = 0

	local function addLine(index: number, name: string, value: string, color: Color3?)
		local row = UIKit.create("Frame", {
			Name = "Line" .. index,
			Size = UDim2.new(1, 0, 0, 24),
			BackgroundTransparency = 1,
			LayoutOrder = index,
			Parent = lines,
		})
		UIKit.label({
			Size = UDim2.fromScale(0.6, 1),
			TextSize = 16,
			TextColor3 = Theme.TextDim,
			Text = name,
			Parent = row,
		})
		UIKit.label({
			Position = UDim2.fromScale(0.6, 0),
			Size = UDim2.fromScale(0.4, 1),
			Font = Theme.FontBold,
			TextSize = 16,
			TextColor3 = color or Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Right,
			Text = value,
			Parent = row,
		})
	end

	local function showResult(data)
		resultToken += 1
		local token = resultToken
		for _, child in lines:GetChildren() do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end

		resultTitle.Text = data.OnTime and "DELIVERED!" or "DELIVERED... LATE"
		resultTitle.TextColor3 = data.OnTime and Theme.Green or Theme.Yellow
		resultAddress.Text = string.format("%s to %s", data.Package, data.Address)
		resultStars.Text = string.rep("★", data.Stars) .. string.rep("☆", 5 - data.Stars)

		local index = 0
		local function line(name, value, color)
			index += 1
			addLine(index, name, value, color)
		end
		line("Delivery fee", Economy.formatMoney(data.Base))
		if data.TimeBonus > 0 then
			line("Speed bonus", "+" .. Economy.formatMoney(data.TimeBonus), Theme.Green)
		end
		if data.Tip > 0 then
			line("Customer tip", "+" .. Economy.formatMoney(data.Tip), Theme.Green)
		end
		if data.StreakBonus > 0 then
			line(string.format("Streak x%d", data.Streak - 1), "+" .. Economy.formatMoney(data.StreakBonus), Theme.Orange)
		end
		if not data.OnTime then
			line("Late - no bonuses", "", Theme.Red)
		end

		resultTotal.Text = "+" .. Economy.formatMoney(data.Total)
		resultXP.Text = string.format("+%d XP", data.XP) .. (data.RankedUpTo and ("   -   RANK UP: " .. string.upper(data.RankedUpTo)) or "")

		result.Visible = true
		result.Position = UDim2.new(0.5, 0, 0.5, 0)
		UIKit.tween(result, 0.35, { Position = UDim2.new(0.5, 0, 0.42, 0) }, Enum.EasingStyle.Back)
		task.delay(RESULT_SECONDS, function()
			if token == resultToken then
				result.Visible = false
			end
		end)
	end

	-- Live updates --------------------------------------------------------------------------
	local function refreshOrder()
		local active = State.get("OrderId", 0) > 0
		card.Visible = active
		if not active then
			return
		end
		packageLabel.Text = string.upper(State.get("OrderPackage", ""))
		addressLabel.Text = State.get("OrderAddress", "")
		payLabel.Text = "~" .. Economy.formatMoney(State.get("OrderReward", 0))
		distanceLabel.Text = string.format("%d studs away", math.floor(State.get("OrderDistance", 0) + 0.5))
	end
	State.watch("OrderId", refreshOrder)

	UIKit.onFrame(function()
		if not card.Visible then
			return
		end
		local remaining = State.get("OrderDeadline", 0) - Workspace:GetServerTimeNow()
		local color = timerColor(remaining, State.get("OrderTimeLimit", 1))
		timerLabel.TextColor3 = color
		if remaining >= 0 then
			timerLabel.Text = Economy.formatTime(remaining)
			timerCaption.Text = "TIME LEFT"
		else
			timerLabel.Text = "+" .. Economy.formatTime(-remaining)
			timerCaption.Text = "LATE - NO BONUS"
		end
	end)

	local panel = {}
	panel.toast = toast
	panel.showResult = showResult

	-- Exposed for tests.
	panel.Card = card
	panel.Result = result
	panel.TimerLabel = timerLabel
	panel.ToastHolder = toastHolder
	return panel
end

return OrderPanel
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3488">
          <Properties>
            <string name="Name">Splash</string>
            <ProtectedString name="Source"><![CDATA[--[[
	Title card shown when you join: the game's name and a three-step "how to play".
	Fades out on click/tap or after a few seconds, and waits for the save to load first.
]]

local Config = require(game:GetService("ReplicatedStorage").Shared.Config)
local State = require(script.Parent.State)
local Theme = require(script.Parent.Theme)
local UIKit = require(script.Parent.UIKit)

local Splash = {}

local SHOW_SECONDS = 7

local STEPS = {
	{ "1", "Take an order", "Head to the DISPATCH counter in the depot (follow the arrow) and press E." },
	{ "2", "Hit the road", "Drive to the glowing ring (WASD / arrow keys / thumbstick). Press V to call your vehicle." },
	{ "3", "Get paid", "Slow down inside the ring. Fast, on-time runs earn bonuses, tips and streaks!" },
}

function Splash.build(gui: ScreenGui)
	local overlay = UIKit.create("TextButton", {
		Name = "Splash",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Navy,
		BackgroundTransparency = 0.05,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 50,
		Parent = gui,
	})

	local content = UIKit.create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(640, 420),
		BackgroundTransparency = 1,
		ZIndex = 51,
		Parent = overlay,
	})
	UIKit.autoScale(content)

	UIKit.label({
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(1, 0, 0, 22),
		Font = Theme.FontBold,
		TextSize = 16,
		TextColor3 = Theme.Orange,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = "SWIFT DROP DEPOT PRESENTS",
		ZIndex = 52,
		Parent = content,
	})
	UIKit.label({
		Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(1, 0, 0, 100),
		Font = Theme.FontBold,
		TextSize = 44,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = string.upper(Config.GameName),
		ZIndex = 52,
		Parent = content,
	})

	for index, step in STEPS do
		local row = UIKit.panel({
			Position = UDim2.fromOffset(0, 140 + (index - 1) * 74),
			Size = UDim2.new(1, 0, 0, 64),
			BackgroundColor3 = Theme.NavyLight,
			ZIndex = 52,
			Parent = content,
		})
		UIKit.create("Frame", {
			Position = UDim2.fromOffset(12, 12),
			Size = UDim2.fromOffset(40, 40),
			BackgroundColor3 = Theme.Orange,
			BorderSizePixel = 0,
			ZIndex = 53,
			Parent = row,
		}, {
			UIKit.corner(20),
			UIKit.label({
				Size = UDim2.fromScale(1, 1),
				Font = Theme.FontBold,
				TextSize = 22,
				TextColor3 = Theme.Navy,
				TextXAlignment = Enum.TextXAlignment.Center,
				Text = step[1],
				ZIndex = 54,
			}),
		})
		UIKit.label({
			Position = UDim2.fromOffset(66, 6),
			Size = UDim2.new(1, -80, 0, 24),
			Font = Theme.FontBold,
			TextSize = 18,
			Text = step[2],
			ZIndex = 53,
			Parent = row,
		})
		UIKit.label({
			Position = UDim2.fromOffset(66, 28),
			Size = UDim2.new(1, -80, 0, 32),
			Font = Theme.FontRegular,
			TextSize = 14,
			TextColor3 = Theme.TextDim,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			Text = step[3],
			ZIndex = 53,
			Parent = row,
		})
	end

	local prompt = UIKit.label({
		Position = UDim2.new(0, 0, 1, -28),
		Size = UDim2.new(1, 0, 0, 24),
		Font = Theme.FontBold,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = "Loading your profile...",
		ZIndex = 52,
		Parent = content,
	})

	local splash = {}
	local closed = false

	function splash.close()
		if closed then
			return
		end
		closed = true
		UIKit.tween(overlay, 0.5, { BackgroundTransparency = 1 })
		task.delay(0.5, function()
			overlay:Destroy()
		end)
		for _, descendant in content:GetDescendants() do
			if descendant:IsA("TextLabel") then
				UIKit.tween(descendant, 0.4, { TextTransparency = 1 })
			end
		end
	end

	UIKit.on(overlay, "Activated", function()
		if State.get("Loaded", false) then
			splash.close()
		end
	end)

	-- Ready to play as soon as the profile is loaded; auto-close shortly after.
	State.watch("Loaded", function(loaded)
		if loaded then
			prompt.Text = "Click or tap anywhere to start"
			task.delay(SHOW_SECONDS, splash.close)
		end
	end)

	-- Exposed for tests.
	splash.Overlay = overlay
	splash.Prompt = prompt
	return splash
end

return Splash
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3489">
          <Properties>
            <string name="Name">State</string>
            <ProtectedString name="Source"><![CDATA[--[[
	Read-only view of the state the server publishes as attributes on the local Player
	(see server/PlayerService and server/OrderService for the full list).
]]

local Players = game:GetService("Players")

local State = {}

local player = Players.LocalPlayer

function State.get(name: string, default: any?): any
	local value = player:GetAttribute(name)
	if value == nil then
		return default
	end
	return value
end

-- Calls callback(value) now and again whenever the attribute changes.
function State.watch(name: string, callback: (any) -> ()): RBXScriptConnection
	callback(player:GetAttribute(name))
	return player:GetAttributeChangedSignal(name):Connect(function()
		callback(player:GetAttribute(name))
	end)
end

function State.owns(vehicleId: string): boolean
	local owned = State.get("Owned", "")
	return string.find(owned, "," .. vehicleId .. ",", 1, true) ~= nil
end

return State
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3490">
          <Properties>
            <string name="Name">Theme</string>
            <ProtectedString name="Source"><![CDATA[--[[
	Colours and fonts shared by every piece of UI, so the whole game looks like one product.
]]

local Theme = {
	-- Surfaces
	Navy = Color3.fromRGB(16, 22, 42),
	NavyLight = Color3.fromRGB(30, 40, 70),
	NavyLighter = Color3.fromRGB(46, 60, 100),

	-- Accents
	Orange = Color3.fromRGB(255, 159, 28),
	OrangeDark = Color3.fromRGB(214, 120, 0),
	Green = Color3.fromRGB(84, 224, 128),
	Red = Color3.fromRGB(255, 92, 100),
	Yellow = Color3.fromRGB(255, 214, 84),
	Blue = Color3.fromRGB(96, 176, 255),

	-- Text
	Text = Color3.fromRGB(244, 247, 255),
	TextDim = Color3.fromRGB(160, 172, 204),

	-- Fonts
	FontBold = Enum.Font.GothamBold,
	FontMedium = Enum.Font.GothamMedium,
	FontRegular = Enum.Font.Gotham,

	-- Toast colours by kind
	Kinds = {
		info = Color3.fromRGB(96, 176, 255),
		success = Color3.fromRGB(84, 224, 128),
		warn = Color3.fromRGB(255, 214, 84),
		error = Color3.fromRGB(255, 92, 100),
	},
}

return Theme
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3491">
          <Properties>
            <string name="Name">UIKit</string>
            <ProtectedString name="Source"><![CDATA[--[[
	Tiny UI toolkit: builds Instances from tables and keeps styling consistent.

	All event hookups in the UI go through UIKit.on / UIKit.onFrame so there is one seam to fake in tests.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)

local UIKit = {}

-- Construction ----------------------------------------------------------------------

-- UIKit.create("Frame", { Size = ..., Parent = parent }, { child1, child2 })
function UIKit.create(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	local parent = nil
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			(instance :: any)[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	instance.Parent = parent -- last, so the UI only renders once fully built
	return instance
end

function UIKit.corner(radius: number): UICorner
	return UIKit.create("UICorner", { CornerRadius = UDim.new(0, radius) })
end

function UIKit.stroke(color: Color3, thickness: number, transparency: number?): UIStroke
	return UIKit.create("UIStroke", {
		Color = color,
		Thickness = thickness,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UIKit.padding(left: number, top: number?, right: number?, bottom: number?): UIPadding
	return UIKit.create("UIPadding", {
		PaddingLeft = UDim.new(0, left),
		PaddingTop = UDim.new(0, top or left),
		PaddingRight = UDim.new(0, right or left),
		PaddingBottom = UDim.new(0, bottom or top or left),
	})
end

function UIKit.list(props: { [string]: any }?): UIListLayout
	local layout = UIKit.create("UIListLayout", props)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	return layout
end

-- A rounded dark card with a subtle outline.
function UIKit.panel(props: { [string]: any }, children: { Instance }?): Frame
	local merged = {
		BackgroundColor3 = Theme.Navy,
		BackgroundTransparency = 0.12,
		BorderSizePixel = 0,
	}
	for key, value in props do
		merged[key] = value
	end
	local frame = UIKit.create("Frame", merged, children)
	UIKit.corner(14).Parent = frame
	UIKit.stroke(Theme.NavyLighter, 1.5, 0.2).Parent = frame
	return frame
end

function UIKit.label(props: { [string]: any }): TextLabel
	local merged = {
		BackgroundTransparency = 1,
		Font = Theme.FontMedium,
		TextColor3 = Theme.Text,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		BorderSizePixel = 0,
	}
	for key, value in props do
		merged[key] = value
	end
	return UIKit.create("TextLabel", merged)
end

-- Clickable button with hover/press feedback. props.OnClick is called on activation.
function UIKit.button(props: { [string]: any }): TextButton
	local onClick = props.OnClick
	local base = props.BackgroundColor3 or Theme.Orange
	local merged = {
		AutoButtonColor = false,
		BackgroundColor3 = base,
		BorderSizePixel = 0,
		Font = Theme.FontBold,
		TextColor3 = Theme.Navy,
		TextSize = 18,
	}
	for key, value in props do
		if key ~= "OnClick" then
			merged[key] = value
		end
	end
	local button = UIKit.create("TextButton", merged)
	UIKit.corner(10).Parent = button

	local hover = base:Lerp(Color3.new(1, 1, 1), 0.18)
	local press = base:Lerp(Color3.new(0, 0, 0), 0.18)
	UIKit.on(button, "MouseEnter", function()
		if button:GetAttribute("Disabled") ~= true then
			UIKit.tween(button, 0.1, { BackgroundColor3 = hover })
		end
	end)
	UIKit.on(button, "MouseLeave", function()
		if button:GetAttribute("Disabled") ~= true then
			UIKit.tween(button, 0.15, { BackgroundColor3 = base })
		end
	end)
	UIKit.on(button, "MouseButton1Down", function()
		if button:GetAttribute("Disabled") ~= true then
			UIKit.tween(button, 0.06, { BackgroundColor3 = press })
		end
	end)
	UIKit.on(button, "Activated", function()
		if button:GetAttribute("Disabled") ~= true and onClick then
			onClick()
		end
	end)
	return button
end

-- Greys a button out (and ignores clicks) or restores it.
function UIKit.setButtonEnabled(button: TextButton, enabled: boolean, enabledColor: Color3)
	button:SetAttribute("Disabled", not enabled)
	button.BackgroundColor3 = enabled and enabledColor or Theme.NavyLighter
	button.TextColor3 = enabled and Theme.Navy or Theme.TextDim
end

function UIKit.createGui(name: string): ScreenGui
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local existing = playerGui:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	return UIKit.create("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = false,
		Parent = playerGui,
	})
end

-- Events / animation (the testing seam) ---------------------------------------------------

function UIKit.on(instance: Instance, signalName: string, callback: (...any) -> ()): RBXScriptConnection
	return (instance :: any)[signalName]:Connect(callback)
end

-- Runs callback(dt) every rendered frame.
function UIKit.onFrame(callback: (number) -> ()): RBXScriptConnection
	return RunService.RenderStepped:Connect(callback)
end

function UIKit.tween(instance: Instance, seconds: number, goals: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?)
	local info = TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local tween = TweenService:Create(instance, info, goals)
	tween:Play()
	return tween
end

-- Responsive scaling ---------------------------------------------------------------------

local scales: { UIScale } = {}

local function viewportScale(): number
	local camera = workspace.CurrentCamera
	if not camera then
		return 1
	end
	local size = camera.ViewportSize
	return math.clamp(math.min(size.X / 1280, size.Y / 720), 0.62, 1.3)
end

-- Gives a widget a UIScale that follows the screen size, so layouts designed for 1280x720 work on phones and 4K.
function UIKit.autoScale(widget: GuiObject): UIScale
	local scale = Instance.new("UIScale")
	scale.Scale = viewportScale()
	scale.Parent = widget
	table.insert(scales, scale)
	return scale
end

-- Keeps every autoScale'd widget in step with the viewport. Call once from the client entry point.
function UIKit.watchViewport()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		local value = viewportScale()
		for _, scale in scales do
			scale.Scale = value
		end
	end)
end

return UIKit
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3492">
          <Properties>
            <string name="Name">VehicleController</string>
            <ProtectedString name="Source"><![CDATA[--[[
	Drives the vehicle the local player is sitting in.

	The server hands physics ownership of your own vehicle to you, so this script (running on your
	client) sets its velocity every physics step from the VehicleSeat's throttle/steer input.
	Roblox's PlayerModule already feeds the seat from keyboard, gamepad and mobile thumbstick.
	See DriveModel for what the numbers mean.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local DriveModel = require(script.Parent.DriveModel)

local VehicleController = {}

local player = Players.LocalPlayer

-- The vehicle model we're currently driving, or nil.
function VehicleController.currentVehicle(): (Model?, VehicleSeat?)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local seat = humanoid and humanoid.SeatPart
	if not seat or not seat:IsA("VehicleSeat") then
		return nil, nil
	end
	local model = seat.Parent
	if not model or model:GetAttribute("OwnerUserId") ~= player.UserId then
		return nil, nil
	end
	return model, seat
end

local function step(dt: number)
	local model, seat = VehicleController.currentVehicle()
	if not model or not seat then
		return
	end
	local chassis = model.PrimaryPart
	if not chassis or chassis.Anchored then
		return -- parked, or the server hasn't released it yet
	end

	local cframe = chassis.CFrame
	if DriveModel.needsRecovery(cframe.UpVector) then
		chassis.AssemblyLinearVelocity = Vector3.zero
		chassis.AssemblyAngularVelocity = Vector3.zero
		chassis.CFrame = DriveModel.recoveryCFrame(cframe.Position, cframe.LookVector)
		return
	end

	local stats = {
		MaxSpeed = model:GetAttribute("MaxSpeed"),
		Accel = model:GetAttribute("Accel"),
		Turn = model:GetAttribute("Turn"),
		Grip = model:GetAttribute("Grip"),
	}
	if not (stats.MaxSpeed and stats.Accel and stats.Turn and stats.Grip) then
		return
	end

	local velocity, angular =
		DriveModel.step(chassis.AssemblyLinearVelocity, cframe.LookVector, cframe.UpVector, seat.ThrottleFloat, seat.SteerFloat, stats, dt)
	chassis.AssemblyLinearVelocity = velocity
	chassis.AssemblyAngularVelocity = angular
end

function VehicleController.start()
	-- PreSimulation runs just before each physics step, so our velocity is what the step uses.
	RunService.PreSimulation:Connect(step)
end

-- Exposed for tests.
VehicleController.step = step

return VehicleController
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3493">
          <Properties>
            <string name="Name">VehicleVisuals</string>
            <ProtectedString name="Source"><![CDATA[--[[
	Cosmetic wheel animation for every delivery vehicle in the world (yours and other players').

	Wheels are joined to the chassis with Motor6Ds; setting Motor6D.Transform on this client spins
	and steers them without touching physics or replicating anything. Rolling speed comes from the
	chassis velocity, so it works for vehicles driven by other players too.
]]

local CollectionService = game:GetService("CollectionService")

local UIKit = require(script.Parent.UIKit)

local VehicleVisuals = {}

local MAX_WHEEL_STEER = 0.45 -- radians
local TAU = math.pi * 2
local TAG = "DeliveryVehicle"

local tracked = {} -- [Model] = { Chassis, Seat, Wheels = { { Motor, Front, Radius, Angle } } }

local function track(model: Model)
	if tracked[model] then
		return
	end
	local chassis = model:WaitForChild("Chassis", 10)
	local seat = model:WaitForChild("Seat", 10)
	if not chassis or not seat or not model.Parent then
		return
	end

	local wheels = {}
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("Motor6D") and descendant:GetAttribute("Radius") then
			table.insert(wheels, {
				Motor = descendant,
				Front = descendant:GetAttribute("Front") == true,
				Radius = descendant:GetAttribute("Radius"),
				Angle = 0,
			})
		end
	end
	tracked[model] = { Chassis = chassis, Seat = seat, Wheels = wheels }
end

-- Advances every tracked vehicle's wheels by dt seconds. Exposed for tests.
function VehicleVisuals.update(dt: number)
	for model, info in tracked do
		if not model.Parent then
			tracked[model] = nil
		else
			local chassis = info.Chassis
			local forwardSpeed = chassis.AssemblyLinearVelocity:Dot(chassis.CFrame.LookVector)
			local steerYaw = -info.Seat.SteerFloat * MAX_WHEEL_STEER
			for _, wheel in info.Wheels do
				-- Rolling forward turns the wheel's top toward -Z, which is a negative rotation about X.
				wheel.Angle = (wheel.Angle - forwardSpeed * dt / wheel.Radius) % TAU
				local roll = CFrame.Angles(wheel.Angle, 0, 0)
				if wheel.Front then
					wheel.Motor.Transform = CFrame.Angles(0, steerYaw, 0) * roll
				else
					wheel.Motor.Transform = roll
				end
			end
		end
	end
end

function VehicleVisuals.start()
	CollectionService:GetInstanceAddedSignal(TAG):Connect(function(model)
		task.spawn(track, model)
	end)
	for _, model in CollectionService:GetTagged(TAG) do
		task.spawn(track, model)
	end
	UIKit.onFrame(VehicleVisuals.update)
end

-- Exposed for tests.
VehicleVisuals.track = track

return VehicleVisuals
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3494">
          <Properties>
            <string name="Name">Waypoint</string>
            <ProtectedString name="Source"><![CDATA[--[[
	Shows where to go:
	  * an arrow at the top of the screen that always points at the target, with the distance
	  * for a delivery, a glowing ring + light beam + address label at the destination (client-side
	    only, so each player sees just their own)
	  * a particle burst when a delivery completes
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Theme = require(script.Parent.Theme)
local UIKit = require(script.Parent.UIKit)

local Waypoint = {}

local player = Players.LocalPlayer

local function markerPart(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, transparency: number, shape: Enum.PartType?): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Transparency = transparency
	part.Shape = shape or Enum.PartType.Block
	part.Size = size
	part.CFrame = cframe
	part.Parent = parent
	return part
end

-- The glowing ring/beam at a delivery address. Returns the folder and the ring (for pulsing).
local function buildMarker(position: Vector3, address: string)
	local folder = Instance.new("Folder")
	folder.Name = "OrderMarker"

	local diameter = Config.DeliveryRadius * 2
	-- A cylinder's axis is X, so turn it 90 degrees to lie flat on the road.
	local flat = CFrame.new(position + Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, 0, math.rad(90))
	local ring = markerPart(folder, "Ring", Vector3.new(0.4, diameter, diameter), flat, Theme.Orange, 0.5, Enum.PartType.Cylinder)
	markerPart(folder, "Core", Vector3.new(0.45, diameter * 0.55, diameter * 0.55), flat, Theme.Yellow, 0.6, Enum.PartType.Cylinder)
	markerPart(folder, "Beacon", Vector3.new(3, 140, 3), CFrame.new(position + Vector3.new(0, 70, 0)), Theme.Orange, 0.72)

	local anchor = markerPart(folder, "LabelAnchor", Vector3.new(1, 1, 1), CFrame.new(position + Vector3.new(0, 26, 0)), Theme.Orange, 1)
	local billboard = Instance.new("BillboardGui")
	billboard.Adornee = anchor
	billboard.Size = UDim2.fromOffset(260, 64)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.Parent = anchor
	UIKit.panel({
		Size = UDim2.fromScale(1, 1),
		Parent = billboard,
	}, {
		UIKit.label({
			Size = UDim2.fromScale(1, 1),
			Font = Theme.FontBold,
			TextSize = 24,
			TextXAlignment = Enum.TextXAlignment.Center,
			Text = address,
		}),
	})

	folder.Parent = Workspace
	return folder, ring
end

function Waypoint.build(gui: ScreenGui)
	local widget = UIKit.create("Frame", {
		Name = "Waypoint",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 58),
		Size = UDim2.fromOffset(300, 100),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	UIKit.autoScale(widget)

	-- The arrow: a rotated square for the head plus a bar for the shaft; the frame rotates as a whole.
	local arrow = UIKit.create("Frame", {
		Name = "Arrow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 34),
		Size = UDim2.fromOffset(56, 56),
		BackgroundTransparency = 1,
		Parent = widget,
	})
	UIKit.create("Frame", {
		Name = "Shaft",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(12, 28),
		BackgroundColor3 = Theme.Orange,
		BorderSizePixel = 0,
		Parent = arrow,
	}, { UIKit.corner(4) })
	UIKit.create("Frame", {
		Name = "Head",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(26, 26),
		Rotation = 45,
		BackgroundColor3 = Theme.Orange,
		BorderSizePixel = 0,
		Parent = arrow,
	}, { UIKit.corner(4) })

	local caption = UIKit.label({
		Name = "Caption",
		Position = UDim2.new(0, 0, 0, 70),
		Size = UDim2.new(1, 0, 0, 24),
		Font = Theme.FontBold,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.5,
		Text = "",
		Parent = widget,
	})

	local target = nil -- { Position, Label, HideWithin }
	local markerFolder, markerRing = nil, nil

	local function removeMarker()
		if markerFolder then
			markerFolder:Destroy()
			markerFolder, markerRing = nil, nil
		end
	end

	local waypoint = {}

	-- target: { Position: Vector3, Label: string, HideWithin: number } or nil. withMarker draws the 3D ring.
	function waypoint.setTarget(newTarget, withMarker: boolean?)
		removeMarker()
		target = newTarget
		if target and withMarker then
			markerFolder, markerRing = buildMarker(target.Position, target.Label)
		end
		if not target then
			widget.Visible = false
		end
	end

	-- Points the arrow; split out so it can be tested. Returns the rotation in degrees.
	function waypoint.update()
		if not target then
			return nil
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local camera = Workspace.CurrentCamera
		if not root or not camera then
			return nil
		end

		local delta = target.Position - root.Position
		local flatDelta = Vector3.new(delta.X, 0, delta.Z)
		local distance = flatDelta.Magnitude
		widget.Visible = distance > (target.HideWithin or 0)

		local look = camera.CFrame.LookVector
		local flatLook = Vector3.new(look.X, 0, look.Z)
		flatLook = flatLook.Magnitude > 1e-3 and flatLook.Unit or Vector3.new(0, 0, -1)
		local right = flatLook:Cross(Vector3.yAxis)
		local degrees = math.deg(math.atan2(flatDelta:Dot(right), flatDelta:Dot(flatLook)))
		arrow.Rotation = degrees
		caption.Text = string.format("%s  -  %d studs", target.Label, math.floor(distance + 0.5))

		if markerRing then
			markerRing.Transparency = 0.5 + 0.15 * math.sin(os.clock() * 4)
		end
		return degrees
	end

	UIKit.onFrame(waypoint.update)

	-- Confetti-style burst at a position.
	function waypoint.celebrate(position: Vector3)
		local anchor = Instance.new("Part")
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.CanQuery = false
		anchor.CanTouch = false
		anchor.Transparency = 1
		anchor.Size = Vector3.new(1, 1, 1)
		anchor.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
		anchor.Parent = Workspace

		local emitter = Instance.new("ParticleEmitter")
		emitter.Rate = 0
		emitter.Lifetime = NumberRange.new(0.9, 1.6)
		emitter.Speed = NumberRange.new(24, 48)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Acceleration = Vector3.new(0, -60, 0)
		emitter.Color = ColorSequence.new(Theme.Orange, Theme.Green)
		emitter.Size = NumberSequence.new(1.4, 0)
		emitter.LightEmission = 0.6
		emitter.Parent = anchor
		emitter:Emit(60)
		Debris:AddItem(anchor, 3)
	end

	-- Exposed for tests.
	waypoint.Widget = widget
	waypoint.Arrow = arrow
	waypoint.Caption = caption
	waypoint.hasMarker = function()
		return markerFolder ~= nil
	end
	return waypoint
end

return Waypoint
]]></ProtectedString>
          </Properties>
        </Item>
      </Item>
