		Rarity = "Legendary",
		Reward = 700,
		Description = "Silent, wise and soft as fresh snow.",
		Look = {
			Size = 1.25,
			BodyShape = Vector3.new(1.1, 1.25, 0.85),
			Body = rgb(245, 245, 250),
			Head = rgb(250, 250, 255),
			HeadSize = 1.15,
			HeadOffset = Vector3.new(0, 0.95, -0.35),
			Wing = rgb(230, 230, 238),
			Tail = rgb(230, 230, 238),
			Beak = rgb(60, 60, 60),
			BeakLength = 0.25,
			BeakWidth = 0.22,
			BigEyes = true,
			Eye = rgb(255, 210, 40),
			LegLength = 0.25,
			Legs = rgb(240, 240, 245),
			TailLength = 0.7,
		},
	},
	{
		Id = "Phoenix",
		Name = "Phoenix",
		Rarity = "Mythic",
		Reward = 2500,
		Description = "A legendary bird of fire, reborn from its own ashes.",
		Look = {
			Size = 1.4,
			Body = rgb(255, 110, 30),
			Head = rgb(255, 140, 40),
			Crest = rgb(255, 220, 80),
			Wing = rgb(255, 60, 30),
			WingTip = rgb(255, 210, 60),
			Tail = rgb(255, 200, 60),
			Beak = rgb(255, 215, 90),
			Material = Enum.Material.Neon,
			TailStyle = "Flame",
			TailLength = 3,
			Fire = true,
			Glow = rgb(255, 140, 50),
		},
	},
}

Birds.ById = {}
for index, bird in ipairs(Birds.List) do
	bird.Order = index
	Birds.ById[bird.Id] = bird
end

function Birds.Get(id)
	return Birds.ById[id]
end

return Birds
]]></string>
