			Head = rgb(30, 100, 210),
			Crest = rgb(40, 170, 160),
			Wing = rgb(170, 140, 100),
			Tail = rgb(40, 140, 90),
			TailSpot = rgb(40, 60, 200),
			TailSpotRing = rgb(255, 200, 60),
			Beak = rgb(200, 190, 170),
			TailStyle = "Fan",
			LegLength = 0.9,
			Legs = rgb(160, 150, 140),
		},
	},
	{
		Id = "SnowyOwl",
