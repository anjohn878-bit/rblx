      <Item class="Folder" referent="2540">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="2541">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="2542">
            <Properties>
              <string name="Name">ClientData</string>
              <string name="Source"><![CDATA[--[[
	ClientData
	The local copy of this player's profile, kept in sync by the server.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Signal)

local ClientData = {}
ClientData.Changed = Signal.new() -- (profile, previousProfile)

local profile = nil

local function setProfile(newProfile)
	if type(newProfile) ~= "table" then
		return
	end
	local previous = profile
	profile = newProfile
	ClientData.Changed:Fire(newProfile, previous)
end

function ClientData.get()
	return profile
end

-- Calls `callback(profile)` now if loaded, and every time it changes.
function ClientData.observe(callback)
	if profile then
		task.spawn(callback, profile, nil)
	end
	return ClientData.Changed:Connect(callback)
end

function ClientData.init()
	Remotes.ProfileUpdated.OnClientEvent:Connect(setProfile)
	task.spawn(function()
		local initial = Remotes.GetProfile:InvokeServer()
		if not profile then
			setProfile(initial)
		end
	end)
end

return ClientData
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2543">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--[[
	Effects
	Client-side polish: falling snow, speed-based field of view, snow spray on
	hockey stops, sparkles for landed tricks and pickups, and bobbing golden
	snowflakes.
]]

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local SkateController = require(script.Parent.SkateController)

local Effects = {}

local player = Players.LocalPlayer
local BASE_FOV = 70
local MAX_FOV = 92
local GOLD = Color3.fromRGB(255, 205, 60)

local snowEmitterPart
local sprayEmitter
local sprayAttachment
local flakes = {}

local function emitterPart(name)
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(1, 1, 1)
	return part
end

-- A one-shot burst of particles at a point in the world.
local function burst(position, color, count, speed)
	local part = emitterPart("Burst")
	part.CFrame = CFrame.new(position)
	part.Parent = workspace.CurrentCamera

	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Lifetime = NumberRange.new(0.5, 1)
	emitter.Speed = NumberRange.new(speed * 0.5, speed)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.5),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Drag = 3
	emitter.Enabled = false
	emitter.Parent = part
	emitter:Emit(count)

	Debris:AddItem(part, 1.5)
end

local function createSnowfall()
	snowEmitterPart = emitterPart("Snowfall")
	snowEmitterPart.Size = Vector3.new(160, 1, 160)
	snowEmitterPart.Parent = workspace.CurrentCamera

	local snow = Instance.new("ParticleEmitter")
	snow.Name = "Snow"
	snow.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
	snow.LightEmission = 0.3
	snow.Rate = 140
	snow.Lifetime = NumberRange.new(7, 10)
	snow.Speed = NumberRange.new(5, 9)
	snow.EmissionDirection = Enum.NormalId.Bottom
	snow.SpreadAngle = Vector2.new(15, 15)
	snow.Acceleration = Vector3.new(1.5, 0, 0.6)
	snow.RotSpeed = NumberRange.new(-60, 60)
	snow.Rotation = NumberRange.new(0, 360)
	snow.Size = NumberSequence.new(0.22)
	snow.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.1, 0.1),
		NumberSequenceKeypoint.new(0.85, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	snow.Parent = snowEmitterPart
end

local function attachSpray(character)
	local root = character:WaitForChild("HumanoidRootPart")
	local humanoid = character:WaitForChild("Humanoid")

	sprayAttachment = Instance.new("Attachment")
	sprayAttachment.Name = "SnowSpray"
	sprayAttachment.Position = Vector3.new(0, -(humanoid.HipHeight + root.Size.Y / 2) + 0.4, 0)
	sprayAttachment.Parent = root

	sprayEmitter = Instance.new("ParticleEmitter")
	sprayEmitter.Color = ColorSequence.new(Color3.fromRGB(240, 248, 255))
	sprayEmitter.LightEmission = 0.2
	sprayEmitter.Lifetime = NumberRange.new(0.3, 0.6)
	sprayEmitter.Speed = NumberRange.new(8, 16)
	sprayEmitter.SpreadAngle = Vector2.new(35, 25)
	sprayEmitter.Acceleration = Vector3.new(0, -30, 0)
	sprayEmitter.Drag = 2
	sprayEmitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 0.1),
	})
	sprayEmitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	sprayEmitter.EmissionDirection = Enum.NormalId.Front
	sprayEmitter.Rate = 0
	sprayEmitter.Parent = sprayAttachment
end

local function trackFlake(part)
	local billboard = part:WaitForChild("Icon", 5)
	local flake = billboard and billboard:WaitForChild("Flake", 5)
	if flake and part.Parent then
		flakes[part] = { billboard = billboard, label = flake, phase = math.random() * math.pi * 2 }
	end
end

local function onRenderStep(dt)
	local camera = workspace.CurrentCamera
	local now = os.clock()

	if snowEmitterPart then
		snowEmitterPart.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, 40, 0))
	end

	-- Widen the view as you pick up speed.
	local targetFov = BASE_FOV
	if SkateController.isSkating() then
		local speedAlpha = math.clamp((SkateController.getSpeed() - 20) / 80, 0, 1)
		targetFov = BASE_FOV + (MAX_FOV - BASE_FOV) * speedAlpha
	end
	camera.FieldOfView += (targetFov - camera.FieldOfView) * (1 - math.exp(-4 * dt))

	-- Kick up snow during hockey stops.
	if sprayEmitter and sprayEmitter.Parent then
		local speed = SkateController.getSpeed()
		sprayEmitter.Rate = if SkateController.isBraking() and speed > 4 then math.min(200, speed * 5) else 0
		local root = sprayAttachment.Parent
		local velocity = root.AssemblyLinearVelocity
		if velocity.Magnitude > 1 then
			-- Spray forwards, the way the skater is sliding.
			local localDirection = root.CFrame:VectorToObjectSpace(Vector3.new(velocity.X, 2, velocity.Z).Unit)
			local origin = sprayAttachment.Position
			sprayAttachment.CFrame = CFrame.lookAt(origin, origin + localDirection)
		end
	end

	-- Bob and spin the golden snowflakes.
	for part, flake in flakes do
		if not part.Parent then
			flakes[part] = nil
			continue
		end
		flake.billboard.StudsOffset = Vector3.new(0, math.sin(now * 2.5 + flake.phase) * 0.6, 0)
		flake.label.Rotation = (now * 90 + flake.phase * 57) % 360
	end
end

function Effects.init()
	createSnowfall()

	if player.Character then
		task.spawn(attachSpray, player.Character)
	end
	player.CharacterAdded:Connect(attachSpray)

	for _, part in CollectionService:GetTagged("GoldenSnowflake") do
		task.spawn(trackFlake, part)
	end
	CollectionService:GetInstanceAddedSignal("GoldenSnowflake"):Connect(trackFlake)

	Remotes.CollectiblePicked.OnClientEvent:Connect(function(position)
		burst(position, GOLD, 30, 18)
	end)

	Remotes.TrickResult.OnClientEvent:Connect(function()
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root then
			burst(root.Position - Vector3.new(0, 2.5, 0), Color3.fromRGB(170, 225, 255), 18, 12)
		end
	end)

	Remotes.Rebirthed.OnClientEvent:Connect(function()
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root then
			burst(root.Position, Color3.fromRGB(190, 130, 255), 80, 30)
		end
	end)

	RunService.RenderStepped:Connect(onRenderStep)
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2544">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[--[[
	HUD
	On-screen interface: snowflake counter, menu buttons, speedometer, trick
	and combo popups, rink banners, notifications and control hints.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)
local Remotes = require(Shared.Remotes)

local ClientData = require(script.Parent.ClientData)
local SkateController = require(script.Parent.SkateController)
local UI = require(script.Parent.UI)

local Colors = UI.Colors
local create, label = UI.create, UI.label

local HUD = {}

local player = Players.LocalPlayer
local gui
local amountLabel, multiplierLabel, gainAnchor
local speedFrame, speedLabel, speedFill, rinkTag
local trickName, trickAmount, trickScale
local comboFrame, comboLabel, comboFill
local bannerTitle, bannerSubtitle
local toastList
local hintLabel

local displayedSnowflakes = 0
local targetSnowflakes = 0
local pendingGain = 0
local lastGainShown = 0
local comboExpires = 0
local comboDuration = 1
local trickToken = 0
local bannerToken = 0
local toastCount = 0
local activeToasts = {}

local KIND_COLORS = {
	success = Colors.Success,
	error = Colors.Danger,
	info = Colors.Accent,
	gold = Colors.Gold,
	rebirth = Colors.Purple,
}

-- Notifications ------------------------------------------------------------------

function HUD.notify(message, kind)
	if not toastList or type(message) ~= "string" then
		return
	end
	local color = KIND_COLORS[kind] or Colors.Accent
	toastCount += 1
	local toast = create("Frame", {
		BackgroundColor3 = Colors.Panel,
		BackgroundTransparency = 0.1,
		LayoutOrder = toastCount,
		Size = UDim2.new(1, 0, 0, 38),
		Parent = toastList,
	}, {
		UI.corner(10),
		UI.stroke(color, 2),
		label({
			Font = UI.BodyFont,
			Position = UDim2.fromOffset(12, 6),
			Size = UDim2.new(1, -24, 1, -12),
			Text = message,
			TextColor3 = Colors.Text,
		}, { UI.maxText(18) }),
	})

	table.insert(activeToasts, toast)
	if #activeToasts > 4 then
		table.remove(activeToasts, 1):Destroy()
	end

	task.delay(3.2, function()
		local index = table.find(activeToasts, toast)
		if index then
			table.remove(activeToasts, index)
			UI.tween(toast, 0.3, { BackgroundTransparency = 1 })
			for _, descendant in toast:GetDescendants() do
				if descendant:IsA("TextLabel") then
					UI.tween(descendant, 0.3, { TextTransparency = 1 })
				elseif descendant:IsA("UIStroke") then
					UI.tween(descendant, 0.3, { Transparency = 1 })
				end
			end
			task.wait(0.32)
			toast:Destroy()
		end
	end)
end

-- Snowflake counter -----------------------------------------------------------------

local function showGain(amount)
	local popup = label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(160, 26),
		Text = "+" .. Format.abbreviate(amount) .. " " .. Config.CurrencyIcon,
		TextColor3 = Colors.Accent,
		Parent = gainAnchor,
	}, { UI.textStroke(2) })
	UI.tween(popup, 0.9, { Position = UDim2.new(0.5, 0, 0, 34), TextTransparency = 1 })
	task.delay(0.95, function()
		popup:Destroy()
	end)
end

local function onProfile(profile, previous)
	targetSnowflakes = profile.Snowflakes
	if previous and profile.Snowflakes > previous.Snowflakes then
		pendingGain += profile.Snowflakes - previous.Snowflakes
	elseif not previous then
		displayedSnowflakes = profile.Snowflakes
	end

	local rebirthMultiplier = Formulas.rebirthMultiplier(profile)
	multiplierLabel.Text =
		string.format("🔄 %d rebirths  •  %s boost", profile.Rebirths, Format.multiplier(rebirthMultiplier))
end

-- Tricks & combos ------------------------------------------------------------------

function HUD.showTrick(result)
	trickToken += 1
	local token = trickToken
	trickName.Text = string.upper(result.name) .. "!"
	trickAmount.Text = "+" .. Format.abbreviate(result.amount) .. " " .. Config.CurrencyIcon
	trickName.TextTransparency = 0
	trickAmount.TextTransparency = 0
	trickScale.Scale = 0.4
	UI.tween(trickScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)

	task.delay(1.4, function()
		if token == trickToken then
			UI.tween(trickName, 0.4, { TextTransparency = 1 })
			UI.tween(trickAmount, 0.4, { TextTransparency = 1 })
		end
	end)

	if result.combo >= 2 then
		comboFrame.Visible = true
		comboLabel.Text = string.format("COMBO %d  •  %s", result.combo, Format.multiplier(result.comboMultiplier))
		comboDuration = result.comboWindow
		comboExpires = os.clock() + result.comboWindow
	end
end

function HUD.showBanner(title, subtitle, color)
	bannerToken += 1
	local token = bannerToken
	bannerTitle.Text = title
	bannerTitle.TextColor3 = color or Colors.Text
	bannerSubtitle.Text = subtitle or ""
	bannerTitle.TextTransparency = 1
	bannerSubtitle.TextTransparency = 1
	UI.tween(bannerTitle, 0.4, { TextTransparency = 0 })
	UI.tween(bannerSubtitle, 0.4, { TextTransparency = 0 })
	task.delay(2.4, function()
		if token == bannerToken then
			UI.tween(bannerTitle, 0.6, { TextTransparency = 1 })
			UI.tween(bannerSubtitle, 0.6, { TextTransparency = 1 })
		end
	end)
end

local function onRinkChanged(rinkId)
	local rink = rinkId and Formulas.getRink(rinkId)
	if rink then
		HUD.showBanner(string.upper(rink.Name), Format.multiplier(rink.Multiplier) .. " SNOWFLAKES", Colors.Accent)
		rinkTag.Text = rink.Name .. "  " .. Format.multiplier(rink.Multiplier)
	end
end

-- Per-frame updates ------------------------------------------------------------------

local function onRenderStep(dt)
	-- Count the snowflake total up smoothly.
	if displayedSnowflakes ~= targetSnowflakes then
		local difference = targetSnowflakes - displayedSnowflakes
		displayedSnowflakes += difference * (1 - math.exp(-10 * dt))
		if math.abs(targetSnowflakes - displayedSnowflakes) < 1 then
			displayedSnowflakes = targetSnowflakes
		end
	end
	amountLabel.Text = Format.abbreviate(displayedSnowflakes)

	local now = os.clock()
	if pendingGain >= 1 and now - lastGainShown > 0.35 then
		showGain(pendingGain)
		pendingGain = 0
		lastGainShown = now
	end

	local skating = SkateController.isSkating()
	speedFrame.Visible = skating
	hintLabel.Visible = skating and hintLabel.Text ~= ""
	if skating then
		local speed = SkateController.getSpeed()
		speedLabel.Text = tostring(math.floor(speed + 0.5))
		speedFill.Size = UDim2.fromScale(math.clamp(speed / SkateController.getMaxSpeed(), 0, 1), 1)
	end

	if comboFrame.Visible then
		local remaining = comboExpires - now
		if remaining <= 0 then
			comboFrame.Visible = false
		else
			comboFill.Size = UDim2.fromScale(remaining / comboDuration, 1)
		end
	end
end

local function updateHint()
	if UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
		hintLabel.Text = "A  jump & spin    Y  scratch spin    Pull back  hockey stop"
	elseif UserInputService.KeyboardEnabled then
		hintLabel.Text = "SPACE  jump & spin    F  scratch spin    Hold S  hockey stop"
	else
		hintLabel.Text = ""
	end
end

-- Construction -------------------------------------------------------------------------

local function build(callbacks)
	local screen = create("ScreenGui", {
		Name = "HUD",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- Everything lives in one full-screen frame so it can be scaled down on small screens.
	gui = create("Frame", {
		Name = "Root",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = screen,
	})

	-- Snowflake counter, top centre.
	local counter = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Colors.Panel,
		BackgroundTransparency = 0.15,
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(240, 50),
		Parent = gui,
	}, {
		UI.corner(25),
		UI.stroke(Colors.Accent, 2, 0.2),
		label({
			Position = UDim2.fromOffset(10, 4),
			Size = UDim2.new(0, 42, 1, -8),
			Text = Config.CurrencyIcon,
			TextColor3 = Colors.Accent,
		}),
	})
	amountLabel = label({
		Position = UDim2.fromOffset(56, 6),
		Size = UDim2.new(1, -70, 1, -12),
		Text = "0",
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = counter,
	}, { UI.maxText(34) })
	multiplierLabel = label({
		AnchorPoint = Vector2.new(0.5, 0),
		Font = UI.BodyFont,
		Position = UDim2.new(0.5, 0, 0, 60),
		Size = UDim2.fromOffset(280, 18),
		Text = "",
		TextColor3 = Colors.SubText,
		Parent = gui,
	}, { UI.textStroke(1.5) })
	gainAnchor = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Position = UDim2.new(0.5, 0, 0, 80),
		Size = UDim2.fromOffset(200, 60),
		Parent = gui,
	})

	-- Notifications under the counter.
	toastList = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Position = UDim2.new(0.5, 0, 0, 120),
		Size = UDim2.new(0, 420, 0, 220),
		Parent = gui,
	}, {
		create("UIListLayout", {
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}),
	})

	-- Menu buttons on the left.
	local menu = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(78, 168),
		Parent = gui,
	}, {
		create("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local function menuButton(order, icon, text, color, callback)
		local button = UI.button({
			BackgroundColor3 = color,
			LayoutOrder = order,
			Size = UDim2.fromOffset(78, 78),
			Text = "",
			Parent = menu,
		}, {
			UI.stroke(Colors.Outline, 3),
			label({ Position = UDim2.fromScale(0.1, 0.06), Size = UDim2.fromScale(0.8, 0.56), Text = icon }),
			label(
				{ Position = UDim2.fromScale(0.05, 0.62), Size = UDim2.fromScale(0.9, 0.3), Text = text },
				{ UI.textStroke(1.5) }
			),
		})
		button.Activated:Connect(callback)
		return button
	end
	menuButton(1, "🛒", "SHOP", Color3.fromRGB(60, 150, 235), callbacks.onShop)
	menuButton(2, "🔄", "REBIRTH", Color3.fromRGB(140, 85, 230), callbacks.onRebirth)

	-- Speedometer, bottom centre.
	speedFrame = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = Colors.Panel,
		BackgroundTransparency = 0.2,
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(230, 74),
		Visible = false,
		Parent = gui,
	}, {
		UI.corner(14),
		UI.stroke(Colors.Accent, 2, 0.3),
	})
	speedLabel = label({
		Position = UDim2.fromOffset(14, 6),
		Size = UDim2.fromOffset(110, 42),
		Text = "0",
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = speedFrame,
	})
	label({
		Font = UI.BodyFont,
		Position = UDim2.fromOffset(130, 18),
		Size = UDim2.fromOffset(80, 22),
		Text = "STUDS/S",
		TextColor3 = Colors.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = speedFrame,
	})
	local bar = create("Frame", {
		BackgroundColor3 = Colors.PanelLighter,
		Position = UDim2.new(0, 14, 1, -20),
		Size = UDim2.new(1, -28, 0, 10),
		Parent = speedFrame,
	}, { UI.corner(5) })
	speedFill = create("Frame", {
		BackgroundColor3 = Colors.Accent,
		Size = UDim2.fromScale(0, 1),
		Parent = bar,
	}, {
		UI.corner(5),
		create("UIGradient", { Color = ColorSequence.new(Colors.Accent, Color3.fromRGB(190, 120, 255)) }),
	})
	rinkTag = label({
		AnchorPoint = Vector2.new(0.5, 1),
		Font = UI.BodyFont,
		Position = UDim2.new(0.5, 0, 0, -4),
		Size = UDim2.fromOffset(230, 18),
		Text = "",
		TextColor3 = Colors.SubText,
		Parent = speedFrame,
	}, { UI.textStroke(1.5) })

	hintLabel = label({
		AnchorPoint = Vector2.new(0.5, 1),
		Font = UI.BodyFont,
		Position = UDim2.new(0.5, 0, 1, -112),
		Size = UDim2.fromOffset(520, 18),
		Text = "",
		TextColor3 = Colors.SubText,
		TextTransparency = 0.15,
		Visible = false,
		Parent = gui,
	}, { UI.textStroke(1.5) })

	-- Trick popup and combo meter.
	local trickFrame = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.5, 0.32),
		Size = UDim2.fromOffset(520, 100),
		Parent = gui,
	})
	trickScale = create("UIScale", { Parent = trickFrame })
	trickName = label({
		Size = UDim2.new(1, 0, 0, 56),
		Text = "",
		TextColor3 = Colors.Gold,
		TextTransparency = 1,
		Parent = trickFrame,
	}, { UI.textStroke(3) })
	trickAmount = label({
		Position = UDim2.fromOffset(0, 58),
		Size = UDim2.new(1, 0, 0, 34),
		Text = "",
		TextColor3 = Colors.Accent,
		TextTransparency = 1,
		Parent = trickFrame,
	}, { UI.textStroke(2.5) })

	comboFrame = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Colors.Panel,
		BackgroundTransparency = 0.2,
		Position = UDim2.new(0.5, 0, 0.32, 58),
		Size = UDim2.fromOffset(220, 40),
		Visible = false,
		Parent = gui,
	}, {
		UI.corner(10),
		UI.stroke(Colors.Gold, 2, 0.2),
	})
	comboLabel = label({
		Position = UDim2.fromOffset(10, 4),
		Size = UDim2.new(1, -20, 0, 22),
		Text = "",
		TextColor3 = Colors.Gold,
		Parent = comboFrame,
	})
	local comboBar = create("Frame", {
		BackgroundColor3 = Colors.PanelLighter,
		Position = UDim2.new(0, 10, 1, -11),
		Size = UDim2.new(1, -20, 0, 6),
		Parent = comboFrame,
	}, { UI.corner(3) })
	comboFill = create("Frame", {
		BackgroundColor3 = Colors.Gold,
		Size = UDim2.fromScale(1, 1),
		Parent = comboBar,
	}, { UI.corner(3) })

	-- Big banner for entering rinks and rebirths.
	bannerTitle = label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.17),
		Size = UDim2.fromOffset(600, 64),
		Text = "",
		TextTransparency = 1,
		Parent = gui,
	}, { UI.textStroke(3) })
	bannerSubtitle = label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = UI.BodyFont,
		Position = UDim2.new(0.5, 0, 0.17, 44),
		Size = UDim2.fromOffset(400, 24),
		Text = "",
		TextColor3 = Colors.SubText,
		TextTransparency = 1,
		Parent = gui,
	}, { UI.textStroke(2) })

	-- Shrink fixed-size elements on small phone screens. The root frame is enlarged by the
	-- inverse amount so that, once scaled, it still covers the whole screen.
	local scale = create("UIScale", { Parent = gui })
	local function rescale()
		local viewport = workspace.CurrentCamera.ViewportSize
		local amount = math.clamp(math.min(viewport.X / 900, viewport.Y / 560), 0.6, 1)
		scale.Scale = amount
		gui.Size = UDim2.fromScale(1 / amount, 1 / amount)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()
end

function HUD.init(callbacks)
	build(callbacks)
	updateHint()
	UserInputService.LastInputTypeChanged:Connect(updateHint)

	ClientData.observe(onProfile)
	SkateController.RinkChanged:Connect(onRinkChanged)
	RunService.RenderStepped:Connect(onRenderStep)

	Remotes.Notify.OnClientEvent:Connect(HUD.notify)
	Remotes.TrickResult.OnClientEvent:Connect(HUD.showTrick)
	Remotes.CollectiblePicked.OnClientEvent:Connect(function(_, amount)
		HUD.notify("Golden snowflake! +" .. Format.abbreviate(amount) .. " " .. Config.CurrencyIcon, "gold")
	end)
	Remotes.Rebirthed.OnClientEvent:Connect(function(rebirths)
		HUD.showBanner("REBIRTH " .. rebirths .. "!", "Your snowflake boost is now permanent", Colors.Purple)
	end)

	task.delay(2, function()
		HUD.notify("Welcome to " .. Config.GameName .. "! Head to the Frozen Pond to start skating.", "info")
	end)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2545">
            <Properties>
              <string name="Name">RinkGates</string>
              <string name="Source"><![CDATA[--[[
	RinkGates
	Locked rinks are sealed by invisible walls and a shimmering gate. Once you
	own a rink this opens it up for you only: the walls stop colliding and the
	gate disappears on your screen. The server still checks rink access.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Formulas = require(Shared.Formulas)

local ClientData = require(script.Parent.ClientData)

local RinkGates = {}

local function setLockOpen(lock, open)
	for _, descendant in lock:GetDescendants() do
		if descendant:IsA("BasePart") then
			if descendant.Name == "LockWall" then
				descendant.CanCollide = not open
			elseif descendant.Name == "Gate" then
				descendant.Transparency = if open then 1 else 0
			end
		elseif descendant:IsA("ProximityPrompt") or descendant:IsA("SurfaceGui") then
			descendant.Enabled = not open
		end
	end
end

local function refresh(profile)
	local map = workspace:FindFirstChild("Map")
	local rinks = map and map:FindFirstChild("Rinks")
	if not rinks then
		return
	end
	for _, model in rinks:GetChildren() do
		local lock = model:FindFirstChild("Lock")
		local rinkId = model:GetAttribute("RinkId")
		if lock and rinkId then
			setLockOpen(lock, Formulas.isRinkUnlocked(profile, rinkId))
		end
	end
end

function RinkGates.init()
	workspace:WaitForChild("Map"):WaitForChild("Rinks")
	ClientData.observe(refresh)
end

return RinkGates
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2546">
            <Properties>
              <string name="Name">ShopUI</string>
              <string name="Source"><![CDATA[--[[
	ShopUI
	The Skate Shop (skates, upgrades, rinks) and the Rebirth window.
	Cards are built once and refreshed whenever the profile changes.
]]

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)
local Remotes = require(Shared.Remotes)

local ClientData = require(script.Parent.ClientData)
local HUD = require(script.Parent.HUD)
local UI = require(script.Parent.UI)

local Colors = UI.Colors
local create, label = UI.create, UI.label
local ICON = Config.CurrencyIcon

local ShopUI = {}

local player = Players.LocalPlayer
local shopWindow, rebirthWindow
local tabs = {} -- [name] = { button, page }
local cards = {} -- list of update(profile) functions
local currentTab = "Skates"
local busy = false

local rebirthInfo, rebirthMultiplier, rebirthFill, rebirthProgress, rebirthButton
local rebirthConfirmUntil = 0

local function price(amount)
	return Format.abbreviate(amount) .. " " .. ICON
end

local function purchase(kind, id)
	if busy then
		return
	end
	busy = true
	local ok, success, message = pcall(function()
		return Remotes.Purchase:InvokeServer(kind, id)
	end)
	busy = false
	if not ok then
		HUD.notify("The shop couldn't be reached. Try again!", "error")
		return
	end
	HUD.notify(message, if success then "success" else "error")
end

local function setButton(button, text, enabled, color)
	button.Text = text
	button.Active = enabled
	button.AutoButtonColor = enabled
	button.BackgroundColor3 = if enabled then (color or Colors.Success) else Colors.Disabled
end

-- Window chrome ---------------------------------------------------------------------

local function window(name, title, size, maxSize, parent)
	local frame = create("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Colors.Panel,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = size,
		Visible = false,
		Parent = parent,
	}, {
		UI.corner(18),
		UI.stroke(Colors.Accent, 3, 0.1),
		create("UISizeConstraint", { MaxSize = maxSize }),
	})
	label({
		Position = UDim2.fromOffset(18, 10),
		Size = UDim2.new(1, -90, 0, 40),
		Text = title,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	}, { UI.textStroke(2) })
	local close = UI.button({
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Colors.Danger,
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(40, 40),
		Text = "✕",
		Parent = frame,
	})
	close.Activated:Connect(function()
		frame.Visible = false
	end)
	return frame
end

local function card(page, order, iconText, iconColor)
	local frame = create("Frame", {
		BackgroundColor3 = Colors.PanelLight,
		LayoutOrder = order,
		Size = UDim2.new(1, -10, 0, 78),
		Parent = page,
	}, { UI.corner(12) })
	create("Frame", {
		BackgroundColor3 = iconColor,
		Position = UDim2.fromOffset(12, 12),
		Size = UDim2.fromOffset(54, 54),
		Parent = frame,
	}, {
		UI.corner(12),
		UI.stroke(Colors.Outline, 2, 0.3),
		label({ Size = UDim2.fromScale(1, 1), Text = iconText }, { UI.padding(8) }),
	})
	local title = label({
		Position = UDim2.fromOffset(78, 10),
		Size = UDim2.new(1, -240, 0, 28),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	}, { UI.maxText(24) })
	local description = label({
		Font = UI.BodyFont,
		Position = UDim2.fromOffset(78, 42),
		Size = UDim2.new(1, -240, 0, 24),
		Text = "",
		TextColor3 = Colors.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Parent = frame,
	}, { UI.maxText(15) })
	local button = UI.button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(140, 46),
		Text = "",
		Parent = frame,
	}, { UI.maxText(20), UI.padding(6) })
	return title, description, button
end

-- Pages ------------------------------------------------------------------------------

local function buildSkatesPage(page)
	for tier, skate in Config.Skates do
		local title, description, button = card(page, tier, "⛸", skate.BootColor)
		title.Text = skate.Name
		button.Activated:Connect(function()
			if button.Active then
				purchase("Skate", tier)
			end
		end)
		table.insert(cards, function(profile)
			local speedBonus = Formulas.maxSpeed(profile) / Formulas.getSkate(profile.SkateTier).MaxSpeed
			description.Text = string.format(
				"Top speed %d  •  %s snowflakes",
				math.floor(skate.MaxSpeed * speedBonus),
				Format.multiplier(skate.EarnMultiplier)
			)
			if tier == profile.SkateTier then
				setButton(button, "Equipped", false)
			elseif tier < profile.SkateTier then
				setButton(button, "Owned", false)
			elseif tier == profile.SkateTier + 1 then
				local affordable = profile.Snowflakes >= skate.Price
				setButton(button, price(skate.Price), true, if affordable then Colors.Success else Colors.PanelLighter)
			else
				setButton(button, "🔒 " .. price(skate.Price), false)
			end
		end)
	end
end

local function upgradeEffect(upgrade, profile)
	if upgrade.Id == "Speed" then
		return string.format("Top speed %d", math.floor(Formulas.maxSpeed(profile)))
	elseif upgrade.Id == "Jump" then
		return string.format("Jump height %.1f", Formulas.jumpHeight(profile))
	elseif upgrade.Id == "Style" then
		return "Tricks " .. Format.multiplier(Formulas.styleMultiplier(profile))
	end
	return ""
end

local function buildUpgradesPage(page)
	for order, upgrade in Config.Upgrades do
		local title, description, button = card(page, order, upgrade.Icon, Colors.PanelLighter)
		button.Activated:Connect(function()
			if button.Active then
				purchase("Upgrade", upgrade.Id)
			end
		end)
		table.insert(cards, function(profile)
			local level = Formulas.upgradeLevel(profile, upgrade.Id)
			title.Text = string.format("%s  Lv %d/%d", upgrade.Name, level, upgrade.MaxLevel)
			description.Text = upgrade.Description .. "  •  " .. upgradeEffect(upgrade, profile)
			local cost = Formulas.upgradeCost(upgrade.Id, level)
			if cost then
				setButton(
					button,
					price(cost),
					true,
					if profile.Snowflakes >= cost then Colors.Success else Colors.PanelLighter
				)
			else
				setButton(button, "MAX", false)
			end
		end)
	end
end

local function buildRinksPage(page)
	for order, rink in Config.Rinks do
		local title, description, button = card(page, order, ICON, rink.AccentColor)
		title.Text = rink.Name
		description.Text = string.format(
			"%s snowflakes  •  %d × %d rink",
			Format.multiplier(rink.Multiplier),
			rink.Size.X,
			rink.Size.Y
		)
		button.Activated:Connect(function()
			if button.Active then
				purchase("Rink", rink.Id)
			end
		end)
		table.insert(cards, function(profile)
			if Formulas.isRinkUnlocked(profile, rink.Id) then
				setButton(button, "Unlocked", false)
			else
				setButton(
					button,
					price(rink.Price),
					true,
					if profile.Snowflakes >= rink.Price then Colors.Success else Colors.PanelLighter
				)
			end
		end)
	end
end

local function selectTab(name)
	currentTab = name
	for tabName, tab in tabs do
		local selected = tabName == name
		tab.page.Visible = selected
		tab.button.BackgroundColor3 = if selected then Colors.Accent else Colors.PanelLight
	end
end

local function buildShop(parent)
	shopWindow = window("Shop", "⛸ SKATE SHOP", UDim2.fromScale(0.92, 0.84), Vector2.new(680, 500), parent)

	local tabBar = create("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 60),
		Size = UDim2.new(1, -32, 0, 40),
		Parent = shopWindow,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local pages = {
		{ "Skates", "⛸ Skates", buildSkatesPage },
		{ "Upgrades", "💪 Upgrades", buildUpgradesPage },
		{ "Rinks", "🗺 Rinks", buildRinksPage },
	}
	for order, info in pages do
		local name = info[1]
		local button = UI.button({
			BackgroundColor3 = Colors.PanelLight,
			LayoutOrder = order,
			Size = UDim2.new(1 / #pages, -6, 1, 0),
			Text = info[2],
			Parent = tabBar,
		}, { UI.maxText(20), UI.padding(6) })
		local page = create("ScrollingFrame", {
			Name = name,
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			CanvasSize = UDim2.new(),
			Position = UDim2.fromOffset(16, 110),
			ScrollBarImageColor3 = Colors.Accent,
			ScrollBarThickness = 6,
			Size = UDim2.new(1, -24, 1, -122),
			Visible = false,
			Parent = shopWindow,
		}, {
			create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		})
		info[3](page)
		tabs[name] = { button = button, page = page }
		button.Activated:Connect(function()
			selectTab(name)
		end)
	end
	selectTab(currentTab)
end

-- Rebirth window ------------------------------------------------------------------------

local function buildRebirth(parent)
	rebirthWindow = window("Rebirth", "🔄 REBIRTH", UDim2.new(0.86, 0, 0, 330), Vector2.new(480, 330), parent)

	label({
		Font = UI.BodyFont,
		Position = UDim2.fromOffset(20, 60),
		Size = UDim2.new(1, -40, 0, 54),
		Text = "Reset your snowflakes, skates and upgrades for a permanent snowflake boost. Unlocked rinks are kept!",
		TextColor3 = Colors.SubText,
		TextWrapped = true,
		Parent = rebirthWindow,
	}, { UI.maxText(17) })
	rebirthInfo = label({
		Position = UDim2.fromOffset(20, 124),
		Size = UDim2.new(1, -40, 0, 28),
		Text = "",
		Parent = rebirthWindow,
	}, { UI.maxText(24) })
	rebirthMultiplier = label({
		Position = UDim2.fromOffset(20, 156),
		Size = UDim2.new(1, -40, 0, 32),
		Text = "",
		TextColor3 = Colors.Purple,
		Parent = rebirthWindow,
	}, { UI.maxText(28), UI.textStroke(1.5) })

	local bar = create("Frame", {
		BackgroundColor3 = Colors.PanelLight,
		Position = UDim2.fromOffset(20, 198),
		Size = UDim2.new(1, -40, 0, 26),
		Parent = rebirthWindow,
	}, { UI.corner(13) })
	rebirthFill = create("Frame", {
		BackgroundColor3 = Colors.Purple,
		Size = UDim2.fromScale(0, 1),
		Parent = bar,
	}, { UI.corner(13) })
	rebirthProgress = label({
		Size = UDim2.fromScale(1, 1),
		Text = "",
		ZIndex = 2,
		Parent = bar,
	}, { UI.padding(4), UI.textStroke(1.5) })

	rebirthButton = UI.button({
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = Colors.Purple,
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.new(1, -40, 0, 56),
		Text = "",
		Parent = rebirthWindow,
	}, { UI.maxText(26), UI.padding(8) })
	rebirthButton.Activated:Connect(function()
		if not rebirthButton.Active then
			return
		end
		-- Rebirthing wipes progress, so ask for a second click.
		if os.clock() > rebirthConfirmUntil then
			rebirthConfirmUntil = os.clock() + 3
			rebirthButton.Text = "Click again to confirm"
			return
		end
		rebirthConfirmUntil = 0
		purchase("Rebirth")
	end)
end

local function refreshRebirth(profile)
	local cost = Formulas.rebirthCost(profile.Rebirths)
	local current = Formulas.rebirthMultiplier(profile)
	local nextMultiplier = 1 + (profile.Rebirths + 1) * Config.Rebirth.MultiplierPerRebirth
	rebirthInfo.Text = string.format("Rebirths: %d", profile.Rebirths)
	rebirthMultiplier.Text =
		string.format("%s  →  %s snowflakes", Format.multiplier(current), Format.multiplier(nextMultiplier))
	rebirthFill.Size = UDim2.fromScale(math.clamp(profile.Snowflakes / cost, 0, 1), 1)
	rebirthProgress.Text = string.format("%s / %s", Format.abbreviate(profile.Snowflakes), price(cost))
	if os.clock() > rebirthConfirmUntil then
		local affordable = profile.Snowflakes >= cost
		setButton(rebirthButton, if affordable then "Rebirth!" else "Need " .. price(cost), affordable, Colors.Purple)
	end
end

local function refresh(profile)
	for _, update in cards do
		update(profile)
	end
	refreshRebirth(profile)
end

-- Public -----------------------------------------------------------------------------

function ShopUI.openShop(tab)
	rebirthWindow.Visible = false
	selectTab(tab or currentTab)
	shopWindow.Visible = true
end

function ShopUI.toggleShop()
	if shopWindow.Visible then
		shopWindow.Visible = false
	else
		ShopUI.openShop()
	end
end

function ShopUI.openRebirth()
	shopWindow.Visible = false
	rebirthWindow.Visible = true
end

function ShopUI.toggleRebirth()
	if rebirthWindow.Visible then
		rebirthWindow.Visible = false
	else
		ShopUI.openRebirth()
	end
end

function ShopUI.init()
	local screen = create("ScreenGui", {
		Name = "ShopUI",
		DisplayOrder = 5,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	buildShop(screen)
	buildRebirth(screen)

	ClientData.observe(refresh)

	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local action = prompt:GetAttribute("Action")
		if action == "OpenShop" then
			ShopUI.openShop("Skates")
		elseif action == "OpenRebirth" then
			ShopUI.openRebirth()
		end
	end)
end

return ShopUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2547">
            <Properties>
              <string name="Name">SkateController</string>
              <string name="Source"><![CDATA[--[[
	SkateController
	Turns the local character into a skater whenever they stand on a rink:
	  * momentum-based gliding with carving turns
	  * pushing against your glide does a hockey stop
	  * every jump spins you; land it to score Single/Double/Triple... jumps
	  * F / gamepad Y / the touch "Spin" button does a scratch spin

	Movement uses a LinearVelocity that only drives horizontal motion (so
	gravity and jumping still work normally) and an AlignOrientation that keeps
	the skater facing along their glide.
]]

local CollectionService = game:GetService("CollectionService")
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Formulas = require(Shared.Formulas)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Signal)

local ClientData = require(script.Parent.ClientData)

local SKATING = Config.Skating
local TRICKS = Config.Tricks
local TAU = math.pi * 2
local SPIN_ACTION = "SkateSpin"
local OFF_ICE_GRACE = 0.12

local player = Players.LocalPlayer
local random = Random.new()

local SkateController = {}
SkateController.SkatingChanged = Signal.new() -- (isSkating)
SkateController.RinkChanged = Signal.new() -- (rinkId?) when the rink under your feet changes
SkateController.TrickStarted = Signal.new() -- ("Jump" | "Spin")
SkateController.JumpLanded = Signal.new() -- (rotations, jumpType)

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

local character, humanoid, root
local velocityConstraint, orientationConstraint
local characterConnections = {}

local skating = false
local velocity = Vector3.zero
local yaw = 0
local currentRinkId = nil
local offIceTime = 0
local braking = false
local brakeSide = 1
local airborne = false
local airTime = 0
local air = nil -- active jump: { spinRate, angle, time, jumpType }
local spin = nil -- active scratch spin: { elapsed }
local lastSpinEnd = -math.huge

local function flat(vector)
	return Vector3.new(vector.X, 0, vector.Z)
end

-- Yaw (rotation about Y) whose LookVector points along `direction`.
local function yawOf(direction)
	return math.atan2(-direction.X, -direction.Z)
end

local function angleDifference(from, to)
	return (to - from + math.pi) % TAU - math.pi
end

local function refreshRayFilter()
	rayParams.FilterDescendantsInstances = CollectionService:GetTagged("RinkFloor")
end

local function isUnlocked(rinkId)
	local rink = Formulas.getRink(rinkId)
	if not rink then
		return false
	end
	local profile = ClientData.get()
	if not profile then
		return rink.Price <= 0
	end
	return Formulas.isRinkUnlocked(profile, rinkId)
end

local function currentStats()
	local profile = ClientData.get()
	if profile then
		return Formulas.maxSpeed(profile), Formulas.acceleration(profile)
	end
	return Config.Skates[1].MaxSpeed, Config.Skates[1].Acceleration
end

local function rinkUnderFeet()
	local reach = humanoid.HipHeight + root.Size.Y / 2 + 1.5
	local result = workspace:Raycast(root.Position, Vector3.new(0, -reach, 0), rayParams)
	return result and result.Instance:GetAttribute("RinkId")
end

local function bindSpinAction(enabled)
	if enabled then
		ContextActionService:BindAction(SPIN_ACTION, function(_, inputState)
			if inputState == Enum.UserInputState.Begin then
				SkateController.trySpin()
			end
			return Enum.ContextActionResult.Sink
		end, true, Enum.KeyCode.F, Enum.KeyCode.ButtonY)
		ContextActionService:SetTitle(SPIN_ACTION, "Spin")
	else
		ContextActionService:UnbindAction(SPIN_ACTION)
	end
end

local function setSkating(enabled)
	if skating == enabled then
		return
	end
	skating = enabled
	braking = false
	air = nil
	spin = nil
	offIceTime = 0

	if enabled then
		velocity = flat(root.AssemblyLinearVelocity)
		yaw = yawOf(root.CFrame.LookVector)
		humanoid.AutoRotate = false
		velocityConstraint.MaxForce = root.AssemblyMass * SKATING.ForcePerMass
		velocityConstraint.PlaneVelocity = Vector2.new(velocity.X, velocity.Z)
		velocityConstraint.Enabled = true
		orientationConstraint.CFrame = CFrame.Angles(0, yaw, 0)
		orientationConstraint.Enabled = true
	else
		if velocityConstraint then
			velocityConstraint.Enabled = false
			orientationConstraint.Enabled = false
		end
		if humanoid then
			humanoid.AutoRotate = true
		end
	end

	bindSpinAction(enabled)
	Remotes.SkateState:FireServer(enabled)
	SkateController.SkatingChanged:Fire(enabled)
end

local function beginJump()
	spin = nil -- jumping out of a spin cancels it
	local speed = velocity.Magnitude
	if speed < TRICKS.MinJumpSpeed then
		air = nil
		return
	end
	air = {
		spinRate = Formulas.airSpinRate(speed),
		angle = 0,
		time = 0,
		jumpType = TRICKS.JumpTypes[random:NextInteger(1, #TRICKS.JumpTypes)],
	}
	SkateController.TrickStarted:Fire("Jump")
end

local function finishJump()
	local trick = air
	air = nil
	yaw %= TAU
	local rotations = Formulas.countRotations(trick.angle)
	if rotations >= 1 then
		Remotes.TrickLanded:FireServer({ kind = "Jump", rotations = rotations, jumpType = trick.jumpType })
	end
	SkateController.JumpLanded:Fire(rotations, trick.jumpType)
end

local function finishSpin()
	spin = nil
	yaw %= TAU
	lastSpinEnd = os.clock()
	Remotes.TrickLanded:FireServer({ kind = "Spin" })
end

function SkateController.trySpin()
	if not skating or airborne or air or spin then
		return
	end
	if os.clock() - lastSpinEnd < TRICKS.Spin.Cooldown then
		return
	end
	spin = { elapsed = 0 }
	SkateController.TrickStarted:Fire("Spin")
end

local function updateMovement(dt, grounded)
	local maxSpeed, acceleration = currentStats()

	-- If physics changed our motion (we hit a wall), go with what actually happened.
	local actual = flat(root.AssemblyLinearVelocity)
	if (actual - velocity).Magnitude > 6 then
		velocity = actual
	end

	local speed = velocity.Magnitude
	local direction = if speed > 0.01 then velocity / speed else flat(root.CFrame.LookVector).Unit
	local moveDirection = flat(humanoid.MoveDirection)
	local inputStrength = math.min(moveDirection.Magnitude, 1)
	local wasBraking = braking
	braking = false

	if spin then
		speed *= math.exp(-TRICKS.Spin.SpeedDecay * dt)
	elseif not grounded then
		speed *= math.exp(-SKATING.AirFriction * dt)
	elseif inputStrength > 0.05 then
		local wish = moveDirection.Unit
		if speed > 2 and direction:Dot(wish) < -0.5 then
			-- Pushing against your glide digs the blades in: hockey stop.
			braking = true
			speed = math.max(0, speed - SKATING.BrakeDeceleration * inputStrength * dt)
		else
			if speed < SKATING.InstantTurnSpeed then
				direction = wish
			else
				local currentYaw = yawOf(direction)
				local turn =
					math.clamp(angleDifference(currentYaw, yawOf(wish)), -SKATING.TurnRate * dt, SKATING.TurnRate * dt)
				direction = CFrame.Angles(0, currentYaw + turn, 0).LookVector
			end
			if speed < maxSpeed then
				local alignment = math.max(0, direction:Dot(wish))
				speed = math.min(maxSpeed, speed + acceleration * inputStrength * alignment * dt)
			end
		end
	else
		speed *= math.exp(-SKATING.GlideFriction * dt)
	end

	if speed > maxSpeed then
		speed = math.max(maxSpeed, speed - SKATING.OverspeedDeceleration * dt)
	end
	if speed < 0.05 then
		speed = 0
	end

	velocity = direction * speed
	velocityConstraint.PlaneVelocity = Vector2.new(velocity.X, velocity.Z)

	-- Facing: spin when doing tricks, otherwise face along the glide.
	if spin then
		local config = TRICKS.Spin
		spin.elapsed += dt
		local progress = math.min(1, spin.elapsed / config.Duration)
		yaw += (config.StartRate + (config.EndRate - config.StartRate) * math.sin(progress * math.pi / 2)) * dt
		if spin.elapsed >= config.Duration then
			finishSpin()
		end
	elseif air then
		local step = air.spinRate * dt
		air.angle += step
		yaw += step
	else
		local targetYaw = yaw
		if braking then
			local travelYaw = yawOf(direction)
			if not wasBraking then
				-- Turn sideways to whichever side is closer, like a hockey stop.
				local left = math.abs(angleDifference(yaw, travelYaw + math.pi / 2))
				local right = math.abs(angleDifference(yaw, travelYaw - math.pi / 2))
				brakeSide = if left < right then 1 else -1
			end
			targetYaw = travelYaw + brakeSide * math.pi / 2
		elseif speed > 1.5 then
			targetYaw = yawOf(direction)
		elseif inputStrength > 0.05 then
			targetYaw = yawOf(moveDirection)
		end
		yaw += angleDifference(yaw, targetYaw) * (1 - math.exp(-12 * dt))
	end
	orientationConstraint.CFrame = CFrame.Angles(0, yaw, 0)
end

local function update(dt)
	if not (character and humanoid and root and root.Parent and velocityConstraint) then
		return
	end
	if humanoid.Health <= 0 or humanoid.Sit or root.Anchored then
		setSkating(false)
		return
	end

	local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
	local rinkId = rinkUnderFeet()
	if rinkId and not isUnlocked(rinkId) then
		rinkId = nil
	end

	if grounded and rinkId ~= currentRinkId then
		currentRinkId = rinkId
		SkateController.RinkChanged:Fire(rinkId)
	end

	if air then
		air.time += dt
		if grounded and air.time > 0.12 then
			finishJump()
		end
	end

	if not skating then
		if grounded and rinkId then
			setSkating(true)
		else
			return
		end
	end

	-- Stop skating once we've properly left the ice (or been in the air far too long).
	if grounded and not rinkId then
		offIceTime += dt
		if offIceTime > OFF_ICE_GRACE then
			setSkating(false)
			return
		end
	else
		offIceTime = 0
	end

	airborne = not grounded
	airTime = if airborne then airTime + dt else 0
	if airTime > SKATING.MaxAirTime then
		setSkating(false)
		return
	end

	updateMovement(dt, grounded)
end

local function onCharacterAdded(newCharacter)
	for _, connection in characterConnections do
		connection:Disconnect()
	end
	table.clear(characterConnections)
	if skating then
		setSkating(false)
	end

	character = newCharacter
	humanoid = newCharacter:WaitForChild("Humanoid")
	root = newCharacter:WaitForChild("HumanoidRootPart")
	velocity = Vector3.zero
	currentRinkId = nil
	airTime = 0

	local attachment = root:FindFirstChild("RootAttachment")
	if not attachment then
		attachment = Instance.new("Attachment")
		attachment.Name = "SkateAttachment"
		attachment.Parent = root
	end

	velocityConstraint = Instance.new("LinearVelocity")
	velocityConstraint.Name = "SkateVelocity"
	velocityConstraint.Attachment0 = attachment
	velocityConstraint.RelativeTo = Enum.ActuatorRelativeTo.World
	velocityConstraint.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	velocityConstraint.PrimaryTangentAxis = Vector3.xAxis
	velocityConstraint.SecondaryTangentAxis = Vector3.zAxis
	velocityConstraint.ForceLimitMode = Enum.ForceLimitMode.Magnitude
	velocityConstraint.Enabled = false
	velocityConstraint.Parent = root

	orientationConstraint = Instance.new("AlignOrientation")
	orientationConstraint.Name = "SkateOrientation"
	orientationConstraint.Mode = Enum.OrientationAlignmentMode.OneAttachment
	orientationConstraint.Attachment0 = attachment
	orientationConstraint.Responsiveness = 60
	orientationConstraint.MaxTorque = math.huge
	orientationConstraint.MaxAngularVelocity = math.huge
	orientationConstraint.Enabled = false
	orientationConstraint.Parent = root

	table.insert(
		characterConnections,
		humanoid.StateChanged:Connect(function(_, newState)
			if newState == Enum.HumanoidStateType.Jumping and skating then
				beginJump()
			end
		end)
	)
	table.insert(
		characterConnections,
		humanoid.Died:Connect(function()
			setSkating(false)
		end)
	)
end

function SkateController.isSkating()
	return skating
end

function SkateController.isBraking()
	return skating and braking
end

function SkateController.isSpinning()
	return skating and (spin ~= nil or air ~= nil)
end

function SkateController.getSpeed()
	if root and root.Parent then
		return flat(root.AssemblyLinearVelocity).Magnitude
	end
	return 0
end

function SkateController.getMaxSpeed()
	return (currentStats())
end

function SkateController.getRinkId()
	return currentRinkId
end

function SkateController.init()
	refreshRayFilter()
	CollectionService:GetInstanceAddedSignal("RinkFloor"):Connect(refreshRayFilter)
	CollectionService:GetInstanceRemovedSignal("RinkFloor"):Connect(refreshRayFilter)

	if player.Character then
		task.spawn(onCharacterAdded, player.Character)
	end
	player.CharacterAdded:Connect(onCharacterAdded)
	RunService.PreSimulation:Connect(update)
end

return SkateController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2548">
            <Properties>
              <string name="Name">SkatePoser</string>
              <string name="Source"><![CDATA[--[[
	SkatePoser
	Procedural skating animation for R15 characters. While someone is skating
	this overrides their joints after the default Animate script has run:
	a crouched stance, alternating side pushes, arm swing, leaning into turns,
	a sideways lean during hockey stops, and a tight tuck while spinning.

	Everything is derived from how the character is moving, so it runs on every
	client for every skater and stays in sync without extra networking.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local SkateController = require(script.Parent.SkateController)

local SkatePoser = {}

local localPlayer = Players.LocalPlayer
local TAU = math.pi * 2
local BLEND_SPEED = 8

local JOINTS = {
	Root = "LowerTorso",
	Waist = "UpperTorso",
	Neck = "Head",
	LeftHip = "LeftUpperLeg",
	RightHip = "RightUpperLeg",
	LeftKnee = "LeftLowerLeg",
	RightKnee = "RightLowerLeg",
	LeftAnkle = "LeftFoot",
	RightAnkle = "RightFoot",
	LeftShoulder = "LeftUpperArm",
	RightShoulder = "RightUpperArm",
	LeftElbow = "LeftLowerArm",
	RightElbow = "RightLowerArm",
}

local rigs = {} -- [character] = rig state

local function smooth(current, target, rate, dt)
	return current + (target - current) * (1 - math.exp(-rate * dt))
end

local function findRig(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or humanoid.RigType ~= Enum.HumanoidRigType.R15 then
		return nil
	end
	local motors = {}
	for jointName, partName in JOINTS do
		local limb = character:FindFirstChild(partName)
		local motor = limb and limb:FindFirstChild(jointName)
		if not (motor and motor:IsA("Motor6D")) then
			return nil
		end
		motors[jointName] = motor
	end
	return {
		character = character,
		humanoid = humanoid,
		root = root,
		motors = motors,
		weight = 0,
		phase = 0,
		lastYaw = nil,
		yawRate = 0,
		lastSpeed = 0,
		acceleration = 0,
		bank = 0,
		tuck = 0,
		brake = 0,
		brakeSign = 1,
		spinTime = 0,
		runningSound = nil,
		runningVolume = nil,
	}
end

-- Joints get rebuilt when an avatar's body parts load in, so re-find them if any went stale.
local function getRig(character)
	local rig = rigs[character]
	if rig then
		for _, motor in rig.motors do
			if not motor.Parent then
				rig = nil
				break
			end
		end
	end
	if not rig then
		rig = findRig(character)
		rigs[character] = rig
	end
	return rig
end

local function isSkating(player, character)
	if player == localPlayer then
		return SkateController.isSkating()
	end
	return character:GetAttribute("Skating") == true
end

-- Footstep sounds come from the default character sounds script; silence them on the ice.
local function muteFootsteps(rig, muted)
	if not rig.runningSound or not rig.runningSound.Parent then
		rig.runningSound = rig.root:FindFirstChild("Running")
		rig.runningVolume = rig.runningSound and rig.runningSound.Volume
	end
	if rig.runningSound then
		rig.runningSound.Volume = if muted then 0 else rig.runningVolume
	end
end

local function computePose(rig, dt, isLocal)
	local root = rig.root
	local velocity = root.AssemblyLinearVelocity
	local horizontal = Vector3.new(velocity.X, 0, velocity.Z)
	local speed = horizontal.Magnitude

	-- How fast the character is turning, from frame-to-frame facing changes.
	local look = root.CFrame.LookVector
	local currentYaw = math.atan2(-look.X, -look.Z)
	if rig.lastYaw then
		local delta = (currentYaw - rig.lastYaw + math.pi) % TAU - math.pi
		rig.yawRate = smooth(rig.yawRate, delta / math.max(dt, 1 / 240), 10, dt)
	end
	rig.lastYaw = currentYaw

	rig.acceleration = smooth(rig.acceleration, (speed - rig.lastSpeed) / math.max(dt, 1 / 240), 4, dt)
	rig.lastSpeed = speed

	-- The local skater knows exactly what it's doing; for everyone else, a sustained
	-- fast turn is a spin (a hockey stop also turns quickly, but only briefly).
	local spinning
	if isLocal then
		spinning = SkateController.isSpinning()
	else
		rig.spinTime = if math.abs(rig.yawRate) > 8 then rig.spinTime + dt else 0
		spinning = rig.spinTime > 0.2
	end
	local airborne = math.abs(velocity.Y) > 6
	rig.tuck = smooth(rig.tuck, if spinning or airborne then 1 else 0, 12, dt)

	-- Sliding sideways = hockey stop.
	local lateral = 0
	local mayBrake = if isLocal then SkateController.isBraking() else not spinning
	if speed > 5 and mayBrake then
		local facingDot = look:Dot(horizontal.Unit)
		if facingDot < 0.5 then
			lateral = root.CFrame.RightVector:Dot(horizontal.Unit)
		end
	end
	if math.abs(lateral) > 0.2 then
		rig.brakeSign = if lateral > 0 then 1 else -1
	end
	rig.brake = smooth(rig.brake, math.abs(lateral), 10, dt)

	-- Lean into turns, or away from the slide when stopping.
	local turnLean = if spinning then 0 else math.clamp(rig.yawRate * speed * 0.006, -0.35, 0.35)
	local brakeLean = 0.3 * rig.brakeSign
	local targetBank = turnLean * (1 - rig.brake) + brakeLean * rig.brake
	rig.bank = smooth(rig.bank, targetBank, 8, dt)

	-- Stride: strong pushes when speeding up, a gentle glide when coasting.
	local speedAlpha = math.clamp(speed / 40, 0, 1)
	local gliding = rig.acceleration < -0.5
	local push = math.clamp(speed / 25, 0, 1) * (if gliding then 0.3 else 1) * (1 - rig.brake)
	rig.phase = (rig.phase + dt * TAU * (0.55 + speedAlpha * 0.9)) % TAU
	local stride = math.sin(rig.phase)
	local leftPush = math.max(stride, 0) * push
	local rightPush = math.max(-stride, 0) * push

	local crouch = 1 + rig.brake * 0.5
	local lean = 0.2 + speedAlpha * 0.25 + rig.brake * 0.1
	local twist = 0.15 * stride * push

	local function leg(pushAmount, side)
		local hip = CFrame.Angles(0.35 * crouch - 0.7 * pushAmount, 0, side * 0.45 * pushAmount)
		local knee = CFrame.Angles(-0.6 * crouch + 0.45 * pushAmount, 0, 0)
		local ankle = CFrame.Angles(0.25 * crouch - 0.1 * pushAmount, 0, 0)
		return hip, knee, ankle
	end
	local leftHip, leftKnee, leftAnkle = leg(leftPush, -1)
	local rightHip, rightKnee, rightAnkle = leg(rightPush, 1)

	local skate = {
		Waist = CFrame.Angles(-lean, twist, 0),
		Neck = CFrame.Angles(lean * 0.6, -twist, 0),
		LeftHip = leftHip,
		LeftKnee = leftKnee,
		LeftAnkle = leftAnkle,
		RightHip = rightHip,
		RightKnee = rightKnee,
		RightAnkle = rightAnkle,
		LeftShoulder = CFrame.Angles(0.15 + 0.7 * stride * push, 0, -0.3 - 0.2 * rig.brake),
		RightShoulder = CFrame.Angles(0.15 - 0.7 * stride * push, 0, 0.3 + 0.2 * rig.brake),
		LeftElbow = CFrame.Angles(0.35, 0, 0),
		RightElbow = CFrame.Angles(0.35, 0, 0),
	}

	-- Arms pulled in and legs together for spins and jumps.
	local tuckPose = {
		Waist = CFrame.identity,
		Neck = CFrame.identity,
		LeftHip = CFrame.Angles(0.05, 0, 0.08),
		RightHip = CFrame.Angles(0.05, 0, -0.08),
		LeftKnee = CFrame.Angles(-0.05, 0, 0),
		RightKnee = CFrame.Angles(-0.05, 0, 0),
		LeftAnkle = CFrame.Angles(0.15, 0, 0),
		RightAnkle = CFrame.Angles(0.15, 0, 0),
		LeftShoulder = CFrame.Angles(1.1, 0, 0.55),
		RightShoulder = CFrame.Angles(1.1, 0, -0.55),
		LeftElbow = CFrame.Angles(1.5, 0, 0),
		RightElbow = CFrame.Angles(1.5, 0, 0),
	}

	local pose = {}
	for jointName, skateCFrame in skate do
		pose[jointName] = skateCFrame:Lerp(tuckPose[jointName], rig.tuck)
	end

	-- Root: drop slightly for the crouch, and bank around the feet rather than the hips.
	local rootMotor = rig.motors.Root
	local pivotHeight = rig.humanoid.HipHeight + root.Size.Y / 2 + rootMotor.C0.Position.Y
	local drop = 0.12 * crouch * (1 - rig.tuck)
	pose.Root = CFrame.new(0, -drop, 0)
		* CFrame.new(0, -pivotHeight, 0)
		* CFrame.Angles(0, 0, rig.bank)
		* CFrame.new(0, pivotHeight, 0)

	return pose
end

local function step(dt)
	for _, player in Players:GetPlayers() do
		local character = player.Character
		if not character then
			continue
		end
		local rig = getRig(character)
		if not rig or not rig.root.Parent then
			continue
		end

		local skating = isSkating(player, character) and rig.humanoid.Health > 0
		rig.weight = smooth(rig.weight, if skating then 1 else 0, BLEND_SPEED, dt)
		if not skating and rig.weight < 0.01 then
			if rig.weight > 0 then
				rig.weight = 0
				muteFootsteps(rig, false)
			end
			rig.lastYaw = nil
			continue
		end

		muteFootsteps(rig, rig.weight > 0.5)
		local pose = computePose(rig, dt, player == localPlayer)
		for jointName, motor in rig.motors do
			local target = pose[jointName]
			if target then
				motor.Transform = motor.Transform:Lerp(target, rig.weight)
			end
		end
	end
end

function SkatePoser.init()
	-- PreSimulation runs after the Animator has written this frame's joint transforms.
	RunService.PreSimulation:Connect(step)

	local function forget(character)
		rigs[character] = nil
	end
	local function watch(player)
		player.CharacterRemoving:Connect(forget)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end
end

return SkatePoser
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2549">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[--[[
	UI
	Small helpers for building interfaces in code, plus the shared colour palette.
]]

local TweenService = game:GetService("TweenService")

local UI = {}

UI.Colors = {
	Panel = Color3.fromRGB(18, 28, 52),
	PanelLight = Color3.fromRGB(32, 46, 82),
	PanelLighter = Color3.fromRGB(45, 62, 105),
	Accent = Color3.fromRGB(110, 195, 255),
	Gold = Color3.fromRGB(255, 210, 90),
	Success = Color3.fromRGB(85, 205, 125),
	Danger = Color3.fromRGB(235, 85, 95),
	Purple = Color3.fromRGB(170, 110, 255),
	Disabled = Color3.fromRGB(70, 80, 105),
	Text = Color3.fromRGB(255, 255, 255),
	SubText = Color3.fromRGB(175, 195, 230),
	Outline = Color3.fromRGB(10, 18, 40),
}

UI.TitleFont = Enum.Font.FredokaOne
UI.BodyFont = Enum.Font.GothamBold

function UI.create(className, props, children)
	local instance = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function UI.corner(radius)
	return UI.create("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function UI.stroke(color, thickness, transparency)
	return UI.create("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = color or UI.Colors.Accent,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
	})
end

function UI.textStroke(thickness)
	return UI.create("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		Color = UI.Colors.Outline,
		Thickness = thickness or 2,
	})
end

function UI.padding(pixels)
	local amount = UDim.new(0, pixels)
	return UI.create(
		"UIPadding",
		{ PaddingTop = amount, PaddingBottom = amount, PaddingLeft = amount, PaddingRight = amount }
	)
end

function UI.maxText(size)
	return UI.create("UITextSizeConstraint", { MaxTextSize = size })
end

function UI.label(props, children)
	local defaults = {
		BackgroundTransparency = 1,
		Font = UI.TitleFont,
		TextColor3 = UI.Colors.Text,
		TextScaled = true,
	}
	for key, value in props do
		defaults[key] = value
	end
	return UI.create("TextLabel", defaults, children)
end

function UI.button(props, children)
	local defaults = {
		AutoButtonColor = true,
		BackgroundColor3 = UI.Colors.Accent,
		Font = UI.TitleFont,
		TextColor3 = UI.Colors.Text,
		TextScaled = true,
	}
	for key, value in props do
		defaults[key] = value
	end
	local button = UI.create("TextButton", defaults, children)
	if not button:FindFirstChildOfClass("UICorner") then
		UI.corner(10).Parent = button
	end

	-- A little squish when pressed.
	local scale = UI.create("UIScale", { Parent = button })
	button.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.08), { Scale = 0.93 }):Play()
	end)
	local function release()
		TweenService:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
	button.MouseButton1Up:Connect(release)
	button.MouseLeave:Connect(release)
	return button
end

function UI.tween(instance, duration, goals, style, direction)
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		goals
	)
	tween:Play()
	return tween
end

return UI
]]></string>
            </Properties>
