      <Item class="ModuleScript" referent="2576">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config
	Every tunable number in Ice Skating Simulator lives here: skates, upgrades,
	rinks, trick scoring and the economy. Shared by the server and the client,
	and also read by the build script when it bakes the map into the place file.
]]

local Config = {}

Config.GameName = "Ice Skating Simulator"
Config.CurrencyName = "Snowflakes"
Config.CurrencyIcon = "❄"

Config.DataStoreName = "IceSkatingSimulator_PlayerData_v1"
Config.LeaderboardStoreName = "IceSkatingSimulator_Lifetime_v1"
Config.AutosaveInterval = 120
Config.LeaderboardRefreshInterval = 60

-- Movement on the ice. Speeds are in studs/second.
Config.Skating = {
	BaseJumpHeight = 7.2,
	GlideFriction = 0.22, -- fraction of speed bled off per second while coasting
	AirFriction = 0.02,
	BrakeDeceleration = 85, -- pushing against your direction of travel = hockey stop
	TurnRate = 3.4, -- radians/second you can carve at speed
	InstantTurnSpeed = 4, -- below this speed you turn on the spot
	OverspeedDeceleration = 40, -- how fast you slow down when above your max speed
	ForcePerMass = 10000, -- strength of the skating constraint
	MaxAirTime = 4, -- stop skating if airborne for longer than this
}

Config.Skates = {
	{
		Id = "Rental",
		Name = "Rental Skates",
		Price = 0,
		MaxSpeed = 30,
		Acceleration = 18,
		EarnMultiplier = 1,
		BladeColor = Color3.fromRGB(165, 170, 180),
		BootColor = Color3.fromRGB(90, 95, 110),
		TrailColor = Color3.fromRGB(235, 245, 255),
	},
	{
		Id = "Hockey",
		Name = "Hockey Skates",
		Price = 350,
		MaxSpeed = 38,
		Acceleration = 24,
		EarnMultiplier = 1.5,
		BladeColor = Color3.fromRGB(200, 205, 215),
		BootColor = Color3.fromRGB(30, 30, 35),
		TrailColor = Color3.fromRGB(200, 225, 255),
	},
	{
		Id = "Figure",
		Name = "Figure Skates",
		Price = 2500,
		MaxSpeed = 46,
		Acceleration = 30,
		EarnMultiplier = 2.25,
		BladeColor = Color3.fromRGB(220, 225, 235),
		BootColor = Color3.fromRGB(250, 250, 250),
		TrailColor = Color3.fromRGB(255, 190, 230),
	},
	{
		Id = "Speed",
		Name = "Speed Skates",
		Price = 20000,
		MaxSpeed = 56,
		Acceleration = 38,
		EarnMultiplier = 3.5,
		BladeColor = Color3.fromRGB(230, 235, 245),
		BootColor = Color3.fromRGB(220, 40, 50),
		TrailColor = Color3.fromRGB(255, 120, 90),
	},
	{
		Id = "Golden",
		Name = "Golden Skates",
		Price = 150000,
		MaxSpeed = 66,
		Acceleration = 46,
		EarnMultiplier = 5.5,
		BladeColor = Color3.fromRGB(255, 205, 70),
		BootColor = Color3.fromRGB(255, 225, 120),
		TrailColor = Color3.fromRGB(255, 215, 90),
		Glow = true,
	},
	{
		Id = "Diamond",
		Name = "Diamond Skates",
		Price = 1200000,
		MaxSpeed = 78,
		Acceleration = 56,
		EarnMultiplier = 9,
		BladeColor = Color3.fromRGB(160, 240, 255),
		BootColor = Color3.fromRGB(110, 210, 255),
		TrailColor = Color3.fromRGB(120, 235, 255),
		Glow = true,
	},
	{
		Id = "Aurora",
		Name = "Aurora Skates",
		Price = 10000000,
		MaxSpeed = 92,
		Acceleration = 68,
		EarnMultiplier = 15,
		BladeColor = Color3.fromRGB(140, 255, 200),
		BootColor = Color3.fromRGB(150, 90, 255),
		TrailColor = Color3.fromRGB(120, 255, 190),
		Glow = true,
	},
}

-- Cost of the next level is BaseCost * CostGrowth ^ currentLevel.
Config.Upgrades = {
	{
		Id = "Speed",
		Name = "Leg Power",
		Icon = "💨",
		Description = "+2.5% top speed and acceleration per level",
		MaxLevel = 25,
		BaseCost = 150,
		CostGrowth = 1.5,
		PerLevel = 0.025,
	},
	{
		Id = "Jump",
		Name = "Spring Jumps",
		Icon = "🦘",
		Description = "Jump higher to land more rotations",
		MaxLevel = 20,
		BaseCost = 200,
		CostGrowth = 1.55,
		PerLevel = 1.1, -- studs of jump height per level
	},
	{
		Id = "Style",
		Name = "Showmanship",
		Icon = "⭐",
		Description = "+15% snowflakes from tricks per level",
		MaxLevel = 25,
		BaseCost = 250,
		CostGrowth = 1.5,
		PerLevel = 0.15,
	},
}

Config.Lobby = {
	Center = Vector3.new(0, 0, 0),
	PlazaRadius = 55,
}

-- Each rink is laid out so its entrance faces the lobby. Size is (width, length).
Config.Rinks = {
	{
		Id = "Pond",
		Name = "Frozen Pond",
		Price = 0,
		Multiplier = 1,
		Center = Vector3.new(0, 0, -160),
		Size = Vector2.new(170, 120),
		Collectibles = 3,
		Theme = "Pond",
		IceColor = Color3.fromRGB(205, 232, 255),
		BoardColor = Color3.fromRGB(245, 248, 255),
		BoardMaterial = Enum.Material.Snow,
		BoardHeight = 3.5,
		RailColor = Color3.fromRGB(150, 105, 70),
		AccentColor = Color3.fromRGB(110, 185, 255),
	},
	{
		Id = "PineLake",
		Name = "Pine Lake",
		Price = 3000,
		Multiplier = 2,
		Center = Vector3.new(230, 0, 0),
		Size = Vector2.new(180, 230),
		Collectibles = 4,
		Theme = "Forest",
		IceColor = Color3.fromRGB(190, 225, 245),
		BoardColor = Color3.fromRGB(120, 80, 50),
		BoardMaterial = Enum.Material.WoodPlanks,
		BoardHeight = 4,
		RailColor = Color3.fromRGB(245, 248, 255),
		AccentColor = Color3.fromRGB(90, 200, 120),
	},
	{
		Id = "GlacierBay",
		Name = "Glacier Bay",
		Price = 60000,
		Multiplier = 4,
		Center = Vector3.new(-270, 0, 0),
		Size = Vector2.new(220, 280),
		Collectibles = 5,
		Theme = "Glacier",
		IceColor = Color3.fromRGB(170, 220, 250),
		BoardColor = Color3.fromRGB(150, 215, 245),
		BoardMaterial = Enum.Material.Glacier,
		BoardHeight = 4,
		RailColor = Color3.fromRGB(235, 250, 255),
		AccentColor = Color3.fromRGB(60, 220, 255),
	},
	{
		Id = "AuroraArena",
		Name = "Aurora Arena",
		Price = 1500000,
		Multiplier = 8,
		Center = Vector3.new(0, 0, 320),
		Size = Vector2.new(280, 340),
		Collectibles = 6,
		Theme = "Arena",
		IceColor = Color3.fromRGB(225, 235, 255),
		BoardColor = Color3.fromRGB(245, 245, 250),
		BoardMaterial = Enum.Material.SmoothPlastic,
		BoardHeight = 4,
		RailColor = Color3.fromRGB(170, 90, 255),
		AccentColor = Color3.fromRGB(170, 90, 255),
	},
}

Config.Tricks = {
	-- Purely cosmetic: a random jump name is picked each time you take off.
	JumpTypes = { "Axel", "Lutz", "Flip", "Salchow", "Loop", "Toe Loop" },
	Rotations = {
		{ Prefix = "Single", Points = 10 },
		{ Prefix = "Double", Points = 40 },
		{ Prefix = "Triple", Points = 120 },
		{ Prefix = "Quad", Points = 350 },
		{ Prefix = "Quint", Points = 1000 },
	},
	-- A rotation counts once you are this close to completing it (0.3 = 70% of the way round).
	RotationForgiveness = 0.3,
	BaseAirSpinRate = math.pi * 3.2, -- radians/second while airborne
	AirSpinRatePerSpeed = 0.12, -- extra radians/second for each stud/second of speed at takeoff
	MinJumpSpeed = 10, -- you need some speed to launch a real jump
	MinJumpInterval = 0.5,
	ComboWindow = 4, -- seconds to land the next trick before the combo resets
	ComboStep = 0.2,
	MaxComboMultiplier = 3,
	Spin = {
		Name = "Scratch Spin",
		Points = 15,
		Duration = 1.5,
		StartRate = math.pi * 4,
		EndRate = math.pi * 10,
		Cooldown = 0.4,
		SpeedDecay = 2.5,
	},
}

Config.Economy = {
	SnowflakesPerStud = 0.25,
	GoldenSnowflakeValue = 25,
	GoldenSnowflakeRespawn = 6,
	CollectRadius = 6,
}

Config.Rebirth = {
	BaseCost = 1000000,
	CostGrowth = 3,
	MultiplierPerRebirth = 0.5,
}

Config.Server = {
	SkateTickInterval = 0.2,
	ProfileSyncInterval = 0.25,
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="2577">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--[[
	Format
	Number formatting for the UI: 1234 -> "1,234", 1250000 -> "1.25M".
]]

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

local function trimZeros(text)
	if string.find(text, "%.") then
		text = string.gsub(text, "0+$", "")
		text = string.gsub(text, "%.$", "")
	end
	return text
end

function Format.commas(number)
	local negative = number < 0
	local text = tostring(math.floor(math.abs(number)))
	local formatted = string.reverse((string.gsub(string.reverse(text), "(%d%d%d)", "%1,")))
	formatted = string.gsub(formatted, "^,", "")
	return if negative then "-" .. formatted else formatted
end

function Format.abbreviate(number)
	local negative = number < 0
	local value = math.floor(math.abs(number))
	if value < 10000 then
		return Format.commas(if negative then -value else value)
	end

	local index = 1
	local scaled = value
	while scaled >= 1000 and index < #SUFFIXES do
		scaled /= 1000
		index += 1
	end

	local text
	if scaled < 10 then
		text = trimZeros(string.format("%.2f", math.floor(scaled * 100) / 100))
	elseif scaled < 100 then
		text = trimZeros(string.format("%.1f", math.floor(scaled * 10) / 10))
	else
		text = tostring(math.floor(scaled))
	end

	return (if negative then "-" else "") .. text .. SUFFIXES[index]
end

function Format.multiplier(value)
	return "x" .. trimZeros(string.format("%.2f", value))
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="2578">
        <Properties>
          <string name="Name">Formulas</string>
          <string name="Source"><![CDATA[--[[
	Formulas
	Derived stats and prices. The server uses these to validate everything,
	the client uses the same functions to drive movement and draw the UI, so the
	two can never disagree.
]]

local Config = require(script.Parent.Config)

local Formulas = {}

local rinksById = {}
for _, rink in Config.Rinks do
	rinksById[rink.Id] = rink
end

local upgradesById = {}
for _, upgrade in Config.Upgrades do
	upgradesById[upgrade.Id] = upgrade
end

function Formulas.getRink(rinkId)
	return rinksById[rinkId]
end

function Formulas.getUpgrade(upgradeId)
	return upgradesById[upgradeId]
end

function Formulas.getSkate(tier)
	return Config.Skates[math.clamp(tier or 1, 1, #Config.Skates)]
end

function Formulas.upgradeLevel(profile, upgradeId)
	return profile.Upgrades[upgradeId] or 0
end

function Formulas.isRinkUnlocked(profile, rinkId)
	local rink = rinksById[rinkId]
	return rink ~= nil and (rink.Price <= 0 or profile.UnlockedRinks[rinkId] == true)
end

local function speedBonus(profile)
	return 1 + Formulas.upgradeLevel(profile, "Speed") * upgradesById.Speed.PerLevel
end

function Formulas.maxSpeed(profile)
	return Formulas.getSkate(profile.SkateTier).MaxSpeed * speedBonus(profile)
end

function Formulas.acceleration(profile)
	return Formulas.getSkate(profile.SkateTier).Acceleration * speedBonus(profile)
end

function Formulas.jumpHeight(profile)
	return Config.Skating.BaseJumpHeight + Formulas.upgradeLevel(profile, "Jump") * upgradesById.Jump.PerLevel
end

function Formulas.rebirthMultiplier(profile)
	return 1 + profile.Rebirths * Config.Rebirth.MultiplierPerRebirth
end

function Formulas.styleMultiplier(profile)
	return 1 + Formulas.upgradeLevel(profile, "Style") * upgradesById.Style.PerLevel
end

-- Multiplier applied to snowflakes earned by skating and golden snowflakes.
function Formulas.earnMultiplier(profile, rinkId)
	local rink = rinksById[rinkId]
	local rinkMultiplier = if rink then rink.Multiplier else 1
	return Formulas.getSkate(profile.SkateTier).EarnMultiplier * rinkMultiplier * Formulas.rebirthMultiplier(profile)
end

-- Multiplier applied to snowflakes earned from tricks.
function Formulas.trickMultiplier(profile, rinkId)
	return Formulas.earnMultiplier(profile, rinkId) * Formulas.styleMultiplier(profile)
end

-- Returns nil once the upgrade is maxed.
function Formulas.upgradeCost(upgradeId, level)
	local upgrade = upgradesById[upgradeId]
	if not upgrade or level >= upgrade.MaxLevel then
		return nil
	end
	return math.floor(upgrade.BaseCost * upgrade.CostGrowth ^ level)
end

function Formulas.rebirthCost(rebirths)
	return math.floor(Config.Rebirth.BaseCost * Config.Rebirth.CostGrowth ^ rebirths)
end

function Formulas.airTime(jumpHeight, gravity)
	return 2 * math.sqrt(2 * jumpHeight / gravity)
end

function Formulas.airSpinRate(speed)
	return Config.Tricks.BaseAirSpinRate + speed * Config.Tricks.AirSpinRatePerSpeed
end

function Formulas.countRotations(angle)
	return math.max(0, math.floor(math.abs(angle) / (2 * math.pi) + Config.Tricks.RotationForgiveness))
end

-- The most rotations this player could physically land, used by the server to reject fakes.
function Formulas.maxRotations(profile, gravity)
	local airTime = Formulas.airTime(Formulas.jumpHeight(profile), gravity)
	local fastestSpin = Formulas.airSpinRate(Formulas.maxSpeed(profile) * 1.1)
	local tolerance = 1.15
	return math.min(#Config.Tricks.Rotations, Formulas.countRotations(airTime * fastestSpin * tolerance))
end

function Formulas.jumpTrick(rotations)
	local tiers = Config.Tricks.Rotations
	return tiers[math.clamp(rotations, 1, #tiers)]
end

function Formulas.comboMultiplier(combo)
	local tricks = Config.Tricks
	return math.min(tricks.MaxComboMultiplier, 1 + math.max(0, combo - 1) * tricks.ComboStep)
end

return Formulas
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="2579">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--[[
	Remotes
	Single place that defines every RemoteEvent/RemoteFunction. The server
	creates them; the client waits for them.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"ProfileUpdated", -- server -> client: full profile snapshot
	"Notify", -- server -> client: (message, kind)
	"SkateState", -- client -> server: (isSkating)
	"TrickLanded", -- client -> server: { kind, rotations?, jumpType? }
	"TrickResult", -- server -> client: { name, amount, combo, comboMultiplier }
	"CollectiblePicked", -- server -> client: (position, amount)
	"Rebirthed", -- server -> client: (rebirths)
}

local FUNCTIONS = {
	"GetProfile", -- client -> server: returns the profile once loaded
	"Purchase", -- client -> server: (kind, id) -> (ok, message)
}

local Remotes = {}

local folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
	end
	for _, name in EVENTS do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	for _, name in FUNCTIONS do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
	end
	folder.Parent = ReplicatedStorage
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end

for _, name in EVENTS do
	Remotes[name] = folder:WaitForChild(name)
end
for _, name in FUNCTIONS do
	Remotes[name] = folder:WaitForChild(name)
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="2580">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--[[
	Signal
	A tiny event object for module-to-module communication.
]]

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(handler)
	local handlers = self._handlers
	table.insert(handlers, handler)
	return {
		Disconnect = function()
			local index = table.find(handlers, handler)
			if index then
				table.remove(handlers, index)
			end
		end,
	}
end

function Signal:Fire(...)
	for _, handler in table.clone(self._handlers) do
		task.spawn(handler, ...)
	end
end

return Signal
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="2581">
    <Properties>
      <string name="Name">ServerScriptService</string>
      <BinaryString name="AttributesSerialize"></BinaryString>
      <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
      <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
      <bool name="LoadStringEnabled">false</bool>
      <bool name="DefinesCapabilities">false</bool>
      <int64 name="SourceAssetId">-1</int64>
      <BinaryString name="Tags"></BinaryString>
      <UniqueId name="UniqueId">184acf13447c97560ad43f37000003ce</UniqueId>
    </Properties>
    <Item class="Folder" referent="2582">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="2583">
        <Properties>
          <string name="Name">Main</string>
          <string name="Source"><![CDATA[--[[
	Ice Skating Simulator - server entry point.
	Makes sure the map exists, then starts every service.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
require(Shared.Remotes) -- creates the RemoteEvents before any client asks for them

local Services = script.Parent:WaitForChild("Services")

-- The map is normally baked into the place file; build it if it's missing.
if not workspace:FindFirstChild("Map") then
	require(Services.WorldBuilder).build(Config)
end

local order = {
	"DataService",
	"SkaterService",
	"TrickService",
	"ShopService",
	"CollectibleService",
	"LeaderboardService",
}

for _, name in order do
	require(Services[name]).init()
end
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="2584">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="2585">
          <Properties>
            <string name="Name">CollectibleService</string>
            <string name="Source"><![CDATA[--[[
	CollectibleService
	Scatters golden snowflakes across every rink. Skate through one to grab a
	bonus scaled by that rink's multiplier. Pickups are checked on the server.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Formulas = require(Shared.Formulas)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)

local CollectibleService = {}

local GOLD = Color3.fromRGB(255, 205, 60)
local TAG = "GoldenSnowflake"

local container
local active = {} -- [part] = rinkId
local random = Random.new()

local function countOnRink(rinkId)
	local count = 0
	for _, id in active do
		if id == rinkId then
			count += 1
		end
	end
	return count
end

local function spawnOn(rink)
	local map = workspace:FindFirstChild("Map")
	local model = map and map.Rinks:FindFirstChild(rink.Id)
	local ice = model and model:FindFirstChild("Ice")
	if not ice then
		return
	end

	local margin = 14
	local x = random:NextNumber(-0.5, 0.5) * (ice.Size.X - margin * 2)
	local z = random:NextNumber(-0.5, 0.5) * (ice.Size.Z - margin * 2)

	local part = Instance.new("Part")
	part.Name = TAG
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(2, 2, 2)
	part.CFrame = ice.CFrame * CFrame.new(x, 3.2, z)
	part:SetAttribute("RinkId", rink.Id)
	part:AddTag(TAG)

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Icon"
	billboard.Size = UDim2.fromScale(4.5, 4.5)
	billboard.LightInfluence = 0
	billboard.MaxDistance = 300
	billboard.Parent = part

	local label = Instance.new("TextLabel")
	label.Name = "Flake"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.Text = "❄"
	label.TextScaled = true
	label.TextColor3 = GOLD
	label.Parent = billboard

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(150, 90, 0)
	stroke.Parent = label

	local glow = Instance.new("PointLight")
	glow.Color = GOLD
	glow.Range = 12
	glow.Brightness = 1.5
	glow.Parent = part

	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Color = ColorSequence.new(GOLD)
	sparkles.LightEmission = 1
	sparkles.Rate = 6
	sparkles.Lifetime = NumberRange.new(0.8, 1.4)
	sparkles.Speed = NumberRange.new(1, 2)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Size = NumberSequence.new(0.35)
	sparkles.Parent = part

	part.Parent = container
	active[part] = rink.Id
end

local function collect(player, part, rinkId)
	active[part] = nil
	local profile = DataService.get(player)
	local amount = math.floor(Config.Economy.GoldenSnowflakeValue * Formulas.earnMultiplier(profile, rinkId) + 0.5)
	local position = part.Position
	part:Destroy()

	DataService.addSnowflakes(player, amount)
	profile.Stats.GoldenSnowflakes += 1
	DataService.markChanged(player)
	Remotes.CollectiblePicked:FireClient(player, position, amount)
end

local function checkPickups()
	local radius = Config.Economy.CollectRadius
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local profile = DataService.get(player)
		if not root or not profile then
			continue
		end
		for part, rinkId in active do
			if (part.Position - root.Position).Magnitude <= radius and Formulas.isRinkUnlocked(profile, rinkId) then
				collect(player, part, rinkId)
			end
		end
	end
end

function CollectibleService.init()
	container = Instance.new("Folder")
	container.Name = "Collectibles"
	container.Parent = workspace

	for _, rink in Config.Rinks do
		for _ = 1, rink.Collectibles do
			spawnOn(rink)
		end
	end

	task.spawn(function()
		while true do
			task.wait(0.1)
			checkPickups()
		end
	end)

	-- Top rinks back up one at a time.
	task.spawn(function()
		while true do
			task.wait(Config.Economy.GoldenSnowflakeRespawn)
			for _, rink in Config.Rinks do
				if countOnRink(rink.Id) < rink.Collectibles then
					spawnOn(rink)
				end
			end
		end
	end)
end

return CollectibleService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="2586">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--[[
	DataService
	Loads, saves and replicates player profiles.

	Profiles are plain tables. Anything that changes a profile calls
	DataService.markChanged, which updates leaderstats and queues a sync to the
	owning client. Data is saved on leave, on shutdown and every few minutes.
	If the DataStore can't be reached (for example in Studio with API access
	turned off) the player still gets a fresh profile, it just isn't saved.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Signal)

local DataService = {}
DataService.ProfileLoaded = Signal.new() -- (player, profile)
DataService.ProfileChanged = Signal.new() -- (player, profile)

local profiles = {}
local saveEnabled = {}
local pendingSync = {}

local store
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore unavailable, progress will not save:", result)
	end
end

local function defaultProfile()
	return {
		Snowflakes = 0,
		LifetimeSnowflakes = 0,
		Rebirths = 0,
		SkateTier = 1,
		Upgrades = {
			Speed = 0,
			Jump = 0,
			Style = 0,
		},
		UnlockedRinks = {
			Pond = true,
		},
		Stats = {
			TricksLanded = 0,
			BestCombo = 0,
			BestTrick = "",
			BestTrickPoints = 0,
			GoldenSnowflakes = 0,
		},
	}
end

-- Fills in any keys that were added to the default profile after this one was saved.
local function reconcile(data, template)
	for key, value in template do
		if data[key] == nil then
			data[key] = if type(value) == "table" then table.clone(value) else value
		elseif type(value) == "table" and type(data[key]) == "table" then
			reconcile(data[key], value)
		end
	end
	return data
end

local function storeKey(player)
	return "Player_" .. player.UserId
end

local function loadProfile(player)
	if not store then
		return defaultProfile(), false
	end

	local attempts = if RunService:IsStudio() then 1 else 3
	for attempt = 1, attempts do
		local ok, result = pcall(store.GetAsync, store, storeKey(player))
		if ok then
			local data = if type(result) == "table" then result else defaultProfile()
			return reconcile(data, defaultProfile()), true
		end
		warn(string.format("[DataService] Load attempt %d for %s failed: %s", attempt, player.Name, tostring(result)))
		if attempt < attempts then
			task.wait(attempt * 2)
		end
	end

	return defaultProfile(), false
end

local function saveProfile(player)
	local profile = profiles[player]
	if not profile or not saveEnabled[player] or not store then
		return
	end

	local snapshot = table.clone(profile)
	local ok, err = pcall(store.UpdateAsync, store, storeKey(player), function()
		return snapshot
	end)
	if not ok then
		warn(string.format("[DataService] Save for %s failed: %s", player.Name, tostring(err)))
	end
end

local function createLeaderstats(player, profile)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local snowflakes = Instance.new("IntValue")
	snowflakes.Name = Config.CurrencyName
	snowflakes.Value = math.floor(profile.Snowflakes)
	snowflakes.Parent = leaderstats

	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Value = profile.Rebirths
	rebirths.Parent = leaderstats

	leaderstats.Parent = player
end

local function updateLeaderstats(player, profile)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		return
	end
	leaderstats[Config.CurrencyName].Value = math.floor(profile.Snowflakes)
	leaderstats.Rebirths.Value = profile.Rebirths
end

local function onPlayerAdded(player)
	local profile, canSave = loadProfile(player)

	if not player.Parent then
		return
	end

	profiles[player] = profile
	saveEnabled[player] = canSave
	createLeaderstats(player, profile)
	pendingSync[player] = true

	if store and not canSave then
		Remotes.Notify:FireClient(
			player,
			"Your saved data couldn't be loaded. Progress this session won't be saved.",
			"error"
		)
	end

	DataService.ProfileLoaded:Fire(player, profile)
end

local function onPlayerRemoving(player)
	saveProfile(player)
	profiles[player] = nil
	saveEnabled[player] = nil
	pendingSync[player] = nil
end

function DataService.get(player)
	return profiles[player]
end

-- Yields until the player's profile has loaded (or they leave).
function DataService.waitFor(player, timeout)
	local deadline = os.clock() + (timeout or 30)
	while not profiles[player] and player.Parent and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

function DataService.markChanged(player)
	local profile = profiles[player]
	if not profile then
		return
	end
	pendingSync[player] = true
	updateLeaderstats(player, profile)
	DataService.ProfileChanged:Fire(player, profile)
end

function DataService.addSnowflakes(player, amount)
	local profile = profiles[player]
	if not profile or amount <= 0 then
		return
	end
	profile.Snowflakes += amount
	profile.LifetimeSnowflakes += amount
	pendingSync[player] = true
	updateLeaderstats(player, profile)
end

-- Returns true and deducts the cost if the player can afford it.
function DataService.spend(player, amount)
	local profile = profiles[player]
	if not profile or profile.Snowflakes < amount then
		return false
	end
	profile.Snowflakes -= amount
	return true
end

function DataService.init()
	Remotes.GetProfile.OnServerInvoke = function(player)
		return DataService.waitFor(player, 15)
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	-- Batch profile syncs so a skater earning every tick doesn't flood the network.
	task.spawn(function()
		while true do
			task.wait(Config.Server.ProfileSyncInterval)
			for player in pendingSync do
				pendingSync[player] = nil
				local profile = profiles[player]
				if profile and player.Parent then
					Remotes.ProfileUpdated:FireClient(player, profile)
				end
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for player in profiles do
				task.spawn(saveProfile, player)
			end
		end
	end)

	game:BindToClose(function()
		local remaining = 0
		for player in profiles do
			remaining += 1
			task.spawn(function()
				saveProfile(player)
				remaining -= 1
			end)
		end
		local deadline = os.clock() + 25
		while remaining > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="2587">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--[[
	LeaderboardService
	Fills the "Top Skaters" board in the lobby with the all-time best skaters
	from an OrderedDataStore. When DataStores aren't available (Studio without
	API access) it shows the players in the server instead.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local DataService = require(script.Parent.DataService)

local LeaderboardService = {}

local ROWS = 10
local nameCache = {}

local orderedStore
do
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore(Config.LeaderboardStoreName)
	end)
	if ok then
		orderedStore = result
	end
end

local function getBoardList()
	local map = workspace:FindFirstChild("Map")
	local board = map and map:FindFirstChild("LeaderboardBoard", true)
	local gui = board and board:FindFirstChild("Leaderboard")
	return gui and gui:FindFirstChild("List")
end

local function nameFor(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.DisplayName
		return player.DisplayName
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	if ok and name then
		nameCache[userId] = name
		return name
	end
	return "Skater " .. userId
end

local function render(entries)
	local list = getBoardList()
	if not list then
		return
	end
	for rank = 1, ROWS do
		local row = list:FindFirstChild("Row" .. rank)
		if row then
			local entry = entries[rank]
			row.PlayerName.Text = if entry then entry.name else "—"
			row.Value.Text = if entry then Format.abbreviate(entry.value) .. " ❄" else ""
		end
	end
end

local function submitScores()
	if not orderedStore then
		return
	end
	for _, player in Players:GetPlayers() do
		local profile = DataService.get(player)
		if profile then
			pcall(orderedStore.SetAsync, orderedStore, tostring(player.UserId), math.floor(profile.LifetimeSnowflakes))
		end
	end
end

local function fetchGlobal()
	if not orderedStore then
		return nil
	end
	local ok, pages = pcall(orderedStore.GetSortedAsync, orderedStore, false, ROWS)
	if not ok then
		return nil
	end
	local entries = {}
	for _, item in pages:GetCurrentPage() do
		local userId = tonumber(item.key)
		if userId then
			table.insert(entries, { name = nameFor(userId), value = item.value })
		end
	end
	return entries
end

local function fetchLocal()
	local entries = {}
	for _, player in Players:GetPlayers() do
		local profile = DataService.get(player)
		if profile then
			table.insert(entries, { name = player.DisplayName, value = profile.LifetimeSnowflakes })
		end
	end
	table.sort(entries, function(a, b)
		return a.value > b.value
	end)
	return entries
end

function LeaderboardService.refresh()
	submitScores()
	render(fetchGlobal() or fetchLocal())
end

function LeaderboardService.init()
	task.spawn(function()
		task.wait(5)
		while true do
			LeaderboardService.refresh()
			task.wait(Config.LeaderboardRefreshInterval)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="2588">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--[[
	ShopService
	Handles every purchase: skates, upgrades, rink unlocks and rebirths.
	All prices come from Formulas so the server is the only authority.
]]

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)

local ShopService = {}

local lastPurchase = {}

local function notEnough(profile, cost)
	return false,
		string.format("You need %s more %s.", Format.abbreviate(cost - profile.Snowflakes), Config.CurrencyName)
end

function ShopService.buySkate(player, tier)
	local profile = DataService.get(player)
	if not profile then
		return false, "Still loading your data..."
	end
	if type(tier) ~= "number" or tier ~= profile.SkateTier + 1 then
		return false, "Buy the skates before these first."
	end
	local skate = Config.Skates[tier]
	if not skate then
		return false, "Those skates don't exist."
	end
	if not DataService.spend(player, skate.Price) then
		return notEnough(profile, skate.Price)
	end
	profile.SkateTier = tier
	DataService.markChanged(player)
	return true, "Equipped " .. skate.Name .. "!"
end

function ShopService.buyUpgrade(player, upgradeId)
	local profile = DataService.get(player)
	if not profile then
		return false, "Still loading your data..."
	end
	local upgrade = Formulas.getUpgrade(upgradeId)
	if not upgrade then
		return false, "Unknown upgrade."
	end
	local level = Formulas.upgradeLevel(profile, upgradeId)
	local cost = Formulas.upgradeCost(upgradeId, level)
	if not cost then
		return false, upgrade.Name .. " is already maxed!"
	end
	if not DataService.spend(player, cost) then
		return notEnough(profile, cost)
	end
	profile.Upgrades[upgradeId] = level + 1
	DataService.markChanged(player)
	return true, string.format("%s upgraded to level %d!", upgrade.Name, level + 1)
end

function ShopService.unlockRink(player, rinkId)
	local profile = DataService.get(player)
	if not profile then
		return false, "Still loading your data..."
	end
	local rink = Formulas.getRink(rinkId)
	if not rink then
		return false, "Unknown rink."
	end
	if Formulas.isRinkUnlocked(profile, rinkId) then
		return false, rink.Name .. " is already unlocked."
	end
	if not DataService.spend(player, rink.Price) then
		return notEnough(profile, rink.Price)
	end
	profile.UnlockedRinks[rinkId] = true
	DataService.markChanged(player)
	return true, rink.Name .. " unlocked! " .. Format.multiplier(rink.Multiplier) .. " snowflakes there."
end

function ShopService.rebirth(player)
	local profile = DataService.get(player)
	if not profile then
		return false, "Still loading your data..."
	end
	local cost = Formulas.rebirthCost(profile.Rebirths)
	if not DataService.spend(player, cost) then
		return notEnough(profile, cost)
	end
	profile.Rebirths += 1
	profile.Snowflakes = 0
	profile.SkateTier = 1
	for upgradeId in profile.Upgrades do
		profile.Upgrades[upgradeId] = 0
	end
	DataService.markChanged(player)
	Remotes.Rebirthed:FireClient(player, profile.Rebirths)
	return true,
		string.format(
			"Rebirth %d! You now earn %s snowflakes.",
			profile.Rebirths,
			Format.multiplier(Formulas.rebirthMultiplier(profile))
		)
end

local handlers = {
	Skate = ShopService.buySkate,
	Upgrade = ShopService.buyUpgrade,
	Rink = ShopService.unlockRink,
	Rebirth = ShopService.rebirth,
}

local function onPurchase(player, kind, id)
	local now = os.clock()
	if now - (lastPurchase[player] or 0) < 0.15 then
		return false, "Slow down!"
	end
	lastPurchase[player] = now

	local handler = type(kind) == "string" and handlers[kind]
	if not handler then
		return false, "Unknown purchase."
	end
	return handler(player, id)
end

function ShopService.init()
	Remotes.Purchase.OnServerInvoke = onPurchase

	-- Rink gates are unlocked straight from their proximity prompt.
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		if prompt:GetAttribute("Action") ~= "UnlockRink" then
			return
		end
		local ok, message = ShopService.unlockRink(player, prompt:GetAttribute("RinkId"))
		Remotes.Notify:FireClient(player, message, if ok then "success" else "error")
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastPurchase[player] = nil
	end)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="2589">
          <Properties>
            <string name="Name">SkateGear</string>
            <string name="Source"><![CDATA[--[[
	SkateGear
	Straps a pair of skates (boot sole, blade and an ice-carving trail) onto a
	character's feet in the colours of the player's current skate tier. The
	character is raised by the blade height so the blades sit on the ice.
]]

local SkateGear = {}

local BLADE_HEIGHT = 0.2
local SOLE_THICKNESS = 0.14
-- How far the character is lifted so the blades rest on top of the ice.
local RAISE = 0.32
local FEET = {
	{ "LeftFoot", "Left Leg" },
	{ "RightFoot", "Right Leg" },
}

local function findFoot(character, names)
	for _, name in names do
		local foot = character:FindFirstChild(name)
		if foot and foot:IsA("BasePart") then
			return foot
		end
	end
	return nil
end

local function gearPart(name, size, color, material)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

local function weldTo(foot, part, offset)
	part.CFrame = foot.CFrame * offset
	local weld = Instance.new("Weld")
	weld.Part0 = foot
	weld.Part1 = part
	weld.C0 = offset
	weld.Parent = part
end

local raisedHumanoids = setmetatable({}, { __mode = "k" })

local function raiseCharacter(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or raisedHumanoids[humanoid] then
		return
	end
	raisedHumanoids[humanoid] = true

	local baseHipHeight = humanoid.HipHeight
	humanoid.HipHeight = baseHipHeight + RAISE

	-- Avatar scaling can recompute HipHeight after we've set it; keep the skates on top of the ice.
	humanoid:GetPropertyChangedSignal("HipHeight"):Connect(function()
		if math.abs(humanoid.HipHeight - (baseHipHeight + RAISE)) > 0.001 then
			baseHipHeight = humanoid.HipHeight
			humanoid.HipHeight = baseHipHeight + RAISE
		end
	end)
end

function SkateGear.equip(character, skate)
	local existing = character:FindFirstChild("SkateGear")
	if existing then
		existing:Destroy()
	end

	local gear = Instance.new("Folder")
	gear.Name = "SkateGear"
	local enabled = character:GetAttribute("Skating") == true

	for _, names in FEET do
		local foot = findFoot(character, names)
		if not foot then
			continue
		end

		local bottom = -foot.Size.Y / 2
		local length = math.max(foot.Size.Z, 0.8)

		local soleBottom = bottom - SOLE_THICKNESS + 0.03
		local sole = gearPart(
			"Sole",
			Vector3.new(foot.Size.X * 1.12, SOLE_THICKNESS, length * 1.1),
			skate.BootColor,
			Enum.Material.SmoothPlastic
		)
		weldTo(foot, sole, CFrame.new(0, soleBottom + SOLE_THICKNESS / 2, 0))
		sole.Parent = gear

		local blade = gearPart(
			"Blade",
			Vector3.new(0.12, BLADE_HEIGHT, length * 1.35),
			skate.BladeColor,
			if skate.Glow then Enum.Material.Neon else Enum.Material.Metal
		)
		weldTo(foot, blade, CFrame.new(0, soleBottom - BLADE_HEIGHT / 2, -0.05))
		blade.Parent = gear

		-- The trail is a flat ribbon across the bottom of the blade, so it reads as a groove in the ice.
		local halfBlade = blade.Size.Y / 2
		local left = Instance.new("Attachment")
		left.Name = "TrailLeft"
		left.Position = Vector3.new(-0.16, -halfBlade + 0.05, 0)
		left.Parent = blade
		local right = Instance.new("Attachment")
		right.Name = "TrailRight"
		right.Position = Vector3.new(0.16, -halfBlade + 0.05, 0)
		right.Parent = blade

		local trail = Instance.new("Trail")
		trail.Name = "IceTrail"
		trail.Attachment0 = left
		trail.Attachment1 = right
		trail.FaceCamera = false
		trail.Lifetime = 1.4
		trail.MinLength = 0.15
		trail.LightEmission = 0.35
		trail.Color = ColorSequence.new(skate.TrailColor)
		trail.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.25),
			NumberSequenceKeypoint.new(1, 1),
		})
		trail.Enabled = enabled
		trail.Parent = blade
	end

	gear.Parent = character
	raiseCharacter(character)
end

function SkateGear.setTrails(character, enabled)
	local gear = character:FindFirstChild("SkateGear")
	if not gear then
		return
	end
	for _, descendant in gear:GetDescendants() do
		if descendant:IsA("Trail") then
			descendant.Enabled = enabled
		end
	end
end

return SkateGear
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="2590">
          <Properties>
            <string name="Name">SkaterService</string>
            <string name="Source"><![CDATA[--[[
	SkaterService
	Server side of skating:
	  * sets up each character (jump height, skates, no player-player collisions)
	  * relays each client's "I'm skating" state so everyone sees trails and poses
	  * pays snowflakes for distance skated, measured on the server so it can't be faked
	  * keeps players out of rinks they haven't unlocked
]]

local CollectionService = game:GetService("CollectionService")
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Formulas = require(Shared.Formulas)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local SkateGear = require(script.Parent.SkateGear)

local SkaterService = {}

local COLLISION_GROUP = "Skaters"

local states = {}
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

local function refreshRayFilter()
	rayParams.FilterDescendantsInstances = CollectionService:GetTagged("RinkFloor")
end

local function getState(player)
	local state = states[player]
	if not state then
		state = {
			lastPosition = nil,
			lastTime = 0,
			lastRinkId = nil,
			lastIceTime = -math.huge,
			recentRinkId = nil,
			earnings = 0,
			lastLockWarning = 0,
			skateStateChanges = 0,
			skateStateWindow = 0,
		}
		states[player] = state
	end
	return state
end

local function rinkModel(rinkId)
	local map = workspace:FindFirstChild("Map")
	local rinks = map and map:FindFirstChild("Rinks")
	return rinks and rinks:FindFirstChild(rinkId)
end

-- Just outside the rink's entrance, facing the lobby.
function SkaterService.getRinkExit(rinkId)
	local model = rinkModel(rinkId)
	local ice = model and model:FindFirstChild("Ice")
	if not ice then
		return nil
	end
	return ice.CFrame * CFrame.new(0, 4, ice.Size.Z / 2 + 16)
end

-- The rink this player was skating on within the last `window` seconds, if any.
function SkaterService.getRecentRink(player, window)
	local state = states[player]
	if state and state.recentRinkId and os.clock() - state.lastIceTime <= window then
		return state.recentRinkId
	end
	return nil
end

local function setCollisionGroup(character)
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = COLLISION_GROUP
		end
	end
	character.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = COLLISION_GROUP
		end
	end)
end

local function applyCharacterStats(player, character)
	local profile = DataService.get(player)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not profile or not humanoid then
		return
	end
	humanoid.UseJumpPower = false
	humanoid.JumpHeight = Formulas.jumpHeight(profile)

	local gear = character:FindFirstChild("SkateGear")
	local tier = profile.SkateTier
	if not gear or gear:GetAttribute("Tier") ~= tier then
		SkateGear.equip(character, Formulas.getSkate(tier))
		local newGear = character:FindFirstChild("SkateGear")
		if newGear then
			newGear:SetAttribute("Tier", tier)
		end
	end
end

local function onCharacterAdded(player, character)
	local state = getState(player)
	state.lastPosition = nil
	state.lastRinkId = nil

	character:SetAttribute("Skating", false)
	setCollisionGroup(character)

	character:WaitForChild("Humanoid", 10)
	if DataService.waitFor(player, 30) and character.Parent then
		applyCharacterStats(player, character)
	end
end

local function onPlayerAdded(player)
	getState(player)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	-- Body scaling arrives with the avatar, so refit the skates once it has loaded.
	player.CharacterAppearanceLoaded:Connect(function(character)
		local gear = character:FindFirstChild("SkateGear")
		if gear then
			gear:SetAttribute("Tier", nil)
		end
		applyCharacterStats(player, character)
	end)
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end
end

local function onSkateState(player, isSkating)
	if type(isSkating) ~= "boolean" then
		return
	end
	local state = getState(player)
	-- Ignore clients that flip this absurdly often.
	local now = os.clock()
	if now - state.skateStateWindow > 1 then
		state.skateStateWindow = now
		state.skateStateChanges = 0
	end
	state.skateStateChanges += 1
	if state.skateStateChanges > 12 then
		return
	end

	local character = player.Character
	if character then
		character:SetAttribute("Skating", isSkating)
		SkateGear.setTrails(character, isSkating)
	end
end

local function kickOutOfRink(player, character, rinkId)
	local exit = SkaterService.getRinkExit(rinkId)
	if exit then
		character:PivotTo(exit)
	end
	local state = getState(player)
	if os.clock() - state.lastLockWarning > 2 then
		state.lastLockWarning = os.clock()
		local rink = Formulas.getRink(rinkId)
		Remotes.Notify:FireClient(
			player,
			"Unlock " .. (rink and rink.Name or "this rink") .. " at its gate first!",
			"error"
		)
	end
end

local function step()
	local now = os.clock()
	for player, state in states do
		local character = player.Character
		local profile = DataService.get(player)
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not profile or not humanoid or not root or humanoid.Health <= 0 then
			state.lastPosition = nil
			continue
		end

		local position = root.Position
		local reach = humanoid.HipHeight + root.Size.Y / 2 + 2.5
		local result = workspace:Raycast(position, Vector3.new(0, -reach, 0), rayParams)
		local rinkId = result and result.Instance:GetAttribute("RinkId")

		if rinkId and not Formulas.isRinkUnlocked(profile, rinkId) then
			kickOutOfRink(player, character, rinkId)
			state.lastPosition = nil
			state.lastRinkId = nil
			continue
		end

		if rinkId then
			state.lastIceTime = now
			state.recentRinkId = rinkId
		end

		-- Pay for distance covered on the same rink since the last sample.
		if rinkId and state.lastPosition and state.lastRinkId == rinkId then
			local delta = position - state.lastPosition
			local distance = Vector3.new(delta.X, 0, delta.Z).Magnitude
			local elapsed = now - state.lastTime
			local allowed = Formulas.maxSpeed(profile) * elapsed * 1.4 + 2
			if distance <= allowed then
				state.earnings += distance * Config.Economy.SnowflakesPerStud * Formulas.earnMultiplier(profile, rinkId)
				local whole = math.floor(state.earnings)
				if whole >= 1 then
					state.earnings -= whole
					DataService.addSnowflakes(player, whole)
				end
			end
		end

		state.lastPosition = position
		state.lastTime = now
		state.lastRinkId = rinkId
	end
end

function SkaterService.init()
	pcall(function()
		PhysicsService:RegisterCollisionGroup(COLLISION_GROUP)
	end)
	PhysicsService:CollisionGroupSetCollidable(COLLISION_GROUP, COLLISION_GROUP, false)

	refreshRayFilter()
	CollectionService:GetInstanceAddedSignal("RinkFloor"):Connect(refreshRayFilter)
	CollectionService:GetInstanceRemovedSignal("RinkFloor"):Connect(refreshRayFilter)

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)

	Remotes.SkateState.OnServerEvent:Connect(onSkateState)

	-- Upgrades and new skates take effect immediately.
	DataService.ProfileChanged:Connect(function(player)
		if player.Character then
			applyCharacterStats(player, player.Character)
		end
	end)
	DataService.ProfileLoaded:Connect(function(player)
		if player.Character then
			applyCharacterStats(player, player.Character)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(Config.Server.SkateTickInterval)
			step()
		end
	end)
end

return SkaterService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="2591">
          <Properties>
            <string name="Name">TrickService</string>
            <string name="Source"><![CDATA[--[[
	TrickService
	Scores the tricks clients report. The client decides what it *tried* to do;
	the server checks it was actually on ice, that the trick is physically
	possible with the player's stats, and that it isn't being spammed, then
	pays out with style, rink, rebirth and combo multipliers.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Formulas = require(Shared.Formulas)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local SkaterService = require(script.Parent.SkaterService)

local TrickService = {}

local states = {}

local function getState(player)
	local state = states[player]
	if not state then
		state = { lastJump = -math.huge, lastSpin = -math.huge, lastTrick = -math.huge, combo = 0 }
		states[player] = state
	end
	return state
end

local function scoreJump(profile, state, payload, now)
	local rotations = tonumber(payload.rotations)
	if not rotations or rotations ~= rotations then
		return nil
	end
	rotations = math.clamp(math.floor(rotations), 0, Formulas.maxRotations(profile, workspace.Gravity))
	if rotations < 1 or now - state.lastJump < Config.Tricks.MinJumpInterval then
		return nil
	end
	state.lastJump = now

	local jumpType = "Axel"
	if type(payload.jumpType) == "string" and table.find(Config.Tricks.JumpTypes, payload.jumpType) then
		jumpType = payload.jumpType
	end
	local tier = Formulas.jumpTrick(rotations)
	return tier.Prefix .. " " .. jumpType, tier.Points
end

local function scoreSpin(state, now)
	local spin = Config.Tricks.Spin
	if now - state.lastSpin < spin.Duration * 0.9 then
		return nil
	end
	state.lastSpin = now
	return spin.Name, spin.Points
end

local function onTrickLanded(player, payload)
	if type(payload) ~= "table" then
		return
	end
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local rinkId = SkaterService.getRecentRink(player, 2.5)
	if not rinkId then
		return
	end

	local state = getState(player)
	local now = os.clock()
	local name, basePoints
	if payload.kind == "Jump" then
		name, basePoints = scoreJump(profile, state, payload, now)
	elseif payload.kind == "Spin" then
		name, basePoints = scoreSpin(state, now)
	end
	if not name then
		return
	end

	if now - state.lastTrick <= Config.Tricks.ComboWindow then
		state.combo += 1
	else
		state.combo = 1
	end
	state.lastTrick = now

	local comboMultiplier = Formulas.comboMultiplier(state.combo)
	local amount =
		math.max(1, math.floor(basePoints * Formulas.trickMultiplier(profile, rinkId) * comboMultiplier + 0.5))
	DataService.addSnowflakes(player, amount)

	local stats = profile.Stats
	stats.TricksLanded += 1
	stats.BestCombo = math.max(stats.BestCombo, state.combo)
	if basePoints >= stats.BestTrickPoints then
		stats.BestTrick = name
		stats.BestTrickPoints = basePoints
	end
	DataService.markChanged(player)

	Remotes.TrickResult:FireClient(player, {
		name = name,
		amount = amount,
		combo = state.combo,
		comboMultiplier = comboMultiplier,
		comboWindow = Config.Tricks.ComboWindow,
	})
end

function TrickService.init()
	Remotes.TrickLanded.OnServerEvent:Connect(onTrickLanded)
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)
end

return TrickService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="2592">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[--[[
	WorldBuilder
	Builds the whole map out of plain parts: the lobby plaza, the skate shop,
	the rebirth crystal, the leaderboard, four themed rinks with their gates,
	paths, lamps, trees and the mountain backdrop.

	The build script (.lune/build.luau) runs this under Lune to bake the map
	into Place1.rbxl / Place1.rbxlx, so the map can be edited in Studio. If the
	Map folder is ever missing (for example in a fresh Rojo-synced place) the
	server runs it on startup instead. Only plain instance creation is used
	here so the same code works in both environments.
]]

local WorldBuilder = {}

local CYLINDER_UP = CFrame.Angles(0, 0, math.pi / 2)
local WHITE = Color3.fromRGB(255, 255, 255)
local SNOW = Color3.fromRGB(240, 245, 252)
local DARK_METAL = Color3.fromRGB(45, 50, 62)
local LAMP_GLOW = Color3.fromRGB(255, 222, 160)
local ENTRANCE_WIDTH = 24
local BOARD_THICKNESS = 1.5
local LOCK_OUTSET = 4

-- Deterministic random numbers, so every build produces the same map.
local function newRandom(seed)
	local state = seed
	return function(min, max)
		state = (state * 16807) % 2147483647
		return min + (max - min) * (state / 2147483647)
	end
end

local function commas(number)
	local text = tostring(math.floor(number))
	local formatted = string.reverse((string.gsub(string.reverse(text), "(%d%d%d)", "%1,")))
	return (string.gsub(formatted, "^,", ""))
end

local function multiplierText(value)
	return "x" .. tostring(value)
end

local function folder(name, parent)
	local instance = Instance.new("Folder")
	instance.Name = name
	instance.Parent = parent
	return instance
end

local function part(parent, props, className)
	local instance = Instance.new(className or "Part")
	instance.Anchored = true
	instance.TopSurface = Enum.SurfaceType.Smooth
	instance.BottomSurface = Enum.SurfaceType.Smooth
	-- Shape has to be set before Size or Roblox resizes the part to fit the shape.
	if props.Shape then
		instance.Shape = props.Shape
	end
	for key, value in props do
		if key ~= "Shape" then
			instance[key] = value
		end
	end
	instance.Parent = parent
	return instance
end

-- Purely visual part: no collisions, no raycasts, no touch events.
local function decor(parent, props, className)
	local instance = part(parent, props, className)
	instance.CanCollide = false
	instance.CanQuery = false
	instance.CanTouch = false
	return instance
end

local function cylinder(parent, position, height, diameter, props)
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(height, diameter, diameter)
	props.CFrame = CFrame.new(position) * CYLINDER_UP
	return part(parent, props)
end

local function ball(parent, position, diameter, props)
	props.Shape = Enum.PartType.Ball
	props.Size = Vector3.new(diameter, diameter, diameter)
	props.CFrame = CFrame.new(position)
	return part(parent, props)
end

-- A CFrame at `position` whose front (-Z) faces `target` on the horizontal plane.
local function facing(position, target)
	local delta = target - position
	return CFrame.new(position) * CFrame.Angles(0, math.atan2(-delta.X, -delta.Z), 0)
end

local function light(parent, className, props)
	local instance = Instance.new(className)
	instance.Shadows = false
	for key, value in props do
		instance[key] = value
	end
	instance.Parent = parent
	return instance
end

-- lines = { { Text, Weight, Color? }, ... } stacked top to bottom.
local function addText(target, face, lines, options)
	options = options or {}
	local gui = Instance.new("SurfaceGui")
	gui.Name = options.Name or "Sign"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = options.PixelsPerStud or 25
	gui.LightInfluence = 0
	gui.Parent = target

	local totalWeight = 0
	for _, line in lines do
		totalWeight += line[2]
	end

	local offset = 0
	for index, line in lines do
		local label = Instance.new("TextLabel")
		label.Name = "Line" .. index
		label.BackgroundTransparency = 1
		label.Position = UDim2.fromScale(0.04, offset / totalWeight)
		label.Size = UDim2.fromScale(0.92, line[2] / totalWeight)
		label.FontFace = Font.fromEnum(Enum.Font.FredokaOne)
		label.Text = line[1]
		label.TextScaled = true
		label.TextColor3 = line[3] or WHITE
		label.Parent = gui

		local stroke = Instance.new("UIStroke")
		stroke.Thickness = options.StrokeThickness or 3
		stroke.Color = options.StrokeColor or Color3.fromRGB(20, 30, 55)
		stroke.Parent = label

		offset += line[2]
	end

	return gui
end

local function addPrompt(target, props, attributes)
	local prompt = Instance.new("ProximityPrompt")
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	for key, value in props do
		prompt[key] = value
	end
	for key, value in attributes do
		prompt:SetAttribute(key, value)
	end
	prompt.Parent = target
	return prompt
end

-- Four walls around a width x length rectangle in the local frame `cf`,
-- optionally leaving a gap centred on the +Z side for an entrance.
local function ring(parent, cf, width, length, options)
	local thickness = options.Thickness
	local height = options.Height
	local y = (options.Bottom or 0) + height / 2
	local halfWidth = width / 2 + (options.Outset or 0)
	local halfLength = length / 2 + (options.Outset or 0)
	local gap = options.Gap or 0

	local segments = {
		{
			Vector3.new(0, y, -halfLength - thickness / 2),
			Vector3.new(halfWidth * 2 + thickness * 2, height, thickness),
		},
		{ Vector3.new(-halfWidth - thickness / 2, y, 0), Vector3.new(thickness, height, halfLength * 2) },
		{ Vector3.new(halfWidth + thickness / 2, y, 0), Vector3.new(thickness, height, halfLength * 2) },
	}
	if gap > 0 then
		local segmentLength = (halfWidth * 2 - gap) / 2 + thickness
		local x = gap / 2 + segmentLength / 2
		table.insert(
			segments,
			{ Vector3.new(-x, y, halfLength + thickness / 2), Vector3.new(segmentLength, height, thickness) }
		)
		table.insert(
			segments,
			{ Vector3.new(x, y, halfLength + thickness / 2), Vector3.new(segmentLength, height, thickness) }
		)
	else
		table.insert(segments, {
			Vector3.new(0, y, halfLength + thickness / 2),
			Vector3.new(halfWidth * 2 + thickness * 2, height, thickness),
		})
	end

	for _, segment in segments do
		local wall = part(parent, {
			Name = options.Name or "Wall",
			Size = segment[2],
			CFrame = cf * CFrame.new(segment[1]),
			Material = options.Material or Enum.Material.SmoothPlastic,
			Color = options.Color or WHITE,
			Transparency = options.Transparency or 0,
		})
		if options.Invisible then
			wall.CanQuery = false
			wall.CanTouch = false
			wall.CastShadow = false
		end
	end
end

local function distanceToSegment(point, a, b)
	local ab = b - a
	local t = math.clamp((point - a):Dot(ab) / ab:Dot(ab), 0, 1)
	return (point - (a + ab * t)).Magnitude
end

-- Geometry -----------------------------------------------------------------

function WorldBuilder.rinkCFrame(rink, lobbyCenter)
	local toLobby = lobbyCenter - rink.Center
	local yaw = math.atan2(toLobby.X, toLobby.Z)
	-- Local +Z points at the lobby, which is where the entrance goes.
	return CFrame.new(rink.Center) * CFrame.Angles(0, yaw, 0)
end

-- Props ---------------------------------------------------------------------

local function lamp(parent, position, glow)
	local lampFolder = folder("Lamp", parent)
	cylinder(lampFolder, position + Vector3.new(0, 6, 0), 12, 0.7, {
		Name = "Post",
		Material = Enum.Material.Metal,
		Color = DARK_METAL,
	})
	decor(lampFolder, {
		Name = "Cap",
		Size = Vector3.new(2, 0.4, 2),
		CFrame = CFrame.new(position + Vector3.new(0, 12.2, 0)),
		Material = Enum.Material.Metal,
		Color = DARK_METAL,
	})
	decor(lampFolder, {
		Name = "SnowCap",
		Size = Vector3.new(2.2, 0.35, 2.2),
		CFrame = CFrame.new(position + Vector3.new(0, 12.55, 0)),
		Material = Enum.Material.Snow,
		Color = SNOW,
	})
	local bulb = ball(lampFolder, position + Vector3.new(0, 11.2, 0), 1.6, {
		Name = "Bulb",
		Material = Enum.Material.Neon,
		Color = glow or LAMP_GLOW,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
	})
	light(bulb, "PointLight", { Range = 22, Brightness = 1.3, Color = glow or LAMP_GLOW })
	return lampFolder
end

local function tree(parent, position, scale, random)
	local treeFolder = folder("PineTree", parent)
	local trunkHeight = 4 * scale
	cylinder(treeFolder, position + Vector3.new(0, trunkHeight / 2, 0), trunkHeight, 1.6 * scale, {
		Name = "Trunk",
		Material = Enum.Material.Wood,
		Color = Color3.fromRGB(95, 65, 45),
	})

	local green = Color3.fromRGB(40, 95 + math.floor(random(0, 30)), 60)
	local y = trunkHeight
	for tier = 1, 3 do
		local diameter = (11 - tier * 2.6) * scale
		local height = 3.2 * scale
		cylinder(treeFolder, position + Vector3.new(0, y + height / 2, 0), height, diameter, {
			Name = "Leaves",
			Material = Enum.Material.Grass,
			Color = green,
		})
		local cap = cylinder(
			treeFolder,
			position + Vector3.new(0, y + height + 0.25 * scale, 0),
			0.5 * scale,
			diameter * 0.82,
			{
				Name = "Snow",
				Material = Enum.Material.Snow,
				Color = SNOW,
			}
		)
		cap.CanCollide = false
		cap.CanQuery = false
		y += height * 0.82
	end
	return treeFolder
end

local function snowman(parent, position, lookAt, scale)
	local cf = facing(position, lookAt)
	local model = folder("Snowman", parent)
	local function at(x, y, z)
		return (cf * CFrame.new(x * scale, y * scale, z * scale)).Position
	end

	ball(model, at(0, 2, 0), 5 * scale, { Name = "Base", Material = Enum.Material.Snow, Color = SNOW })
	ball(model, at(0, 5.3, 0), 3.8 * scale, { Name = "Body", Material = Enum.Material.Snow, Color = SNOW })
	ball(model, at(0, 7.9, 0), 2.8 * scale, { Name = "Head", Material = Enum.Material.Snow, Color = SNOW })

	for _, x in { -0.45, 0.45 } do
		decor(model, {
			Shape = Enum.PartType.Ball,
			Name = "Eye",
			Size = Vector3.one * 0.35 * scale,
			CFrame = CFrame.new(at(x, 8.25, -1.22)),
			Color = Color3.fromRGB(20, 20, 25),
		})
	end
	for index = 1, 3 do
		decor(model, {
			Shape = Enum.PartType.Ball,
			Name = "Button",
			Size = Vector3.one * 0.4 * scale,
			CFrame = CFrame.new(at(0, 4.5 + index * 0.55, -1.75 + math.abs(index - 2) * 0.12)),
			Color = Color3.fromRGB(20, 20, 25),
		})
	end
	decor(model, {
		Shape = Enum.PartType.Cylinder,
		Name = "Nose",
		Size = Vector3.new(1.2, 0.35, 0.35) * scale,
		CFrame = CFrame.new(at(0, 7.9, -1.6)) * (cf - cf.Position) * CFrame.Angles(0, math.pi / 2, 0),
		Color = Color3.fromRGB(255, 140, 40),
	})
	decor(model, {
		Shape = Enum.PartType.Cylinder,
		Name = "Scarf",
		Size = Vector3.new(0.6, 3.1, 3.1) * scale,
		CFrame = CFrame.new(at(0, 6.65, 0)) * CYLINDER_UP,
		Material = Enum.Material.Fabric,
		Color = Color3.fromRGB(210, 50, 60),
	})
	decor(model, {
		Shape = Enum.PartType.Cylinder,
		Name = "HatBrim",
		Size = Vector3.new(0.25, 3, 3) * scale,
		CFrame = CFrame.new(at(0, 9.15, 0)) * CYLINDER_UP,
		Color = Color3.fromRGB(25, 25, 30),
	})
	decor(model, {
		Shape = Enum.PartType.Cylinder,
		Name = "Hat",
		Size = Vector3.new(1.8, 2, 2) * scale,
		CFrame = CFrame.new(at(0, 10.1, 0)) * CYLINDER_UP,
		Color = Color3.fromRGB(25, 25, 30),
	})
	return model
end

local function iceCrystals(parent, position, scale, random)
	local cluster = folder("IceCrystals", parent)
	for _ = 1, 3 do
		local width = random(1.5, 3) * scale
		local height = random(6, 16) * scale
		local offset = Vector3.new(random(-3, 3), 0, random(-3, 3)) * scale
		local tilt = CFrame.Angles(math.rad(random(-25, 25)), math.rad(random(0, 90)), math.rad(random(-25, 25)))
		part(cluster, {
			Name = "Crystal",
			Size = Vector3.new(width, height, width),
			CFrame = CFrame.new(position + offset) * tilt * CFrame.new(0, height * 0.35, 0),
			Material = Enum.Material.Glacier,
			Color = Color3.fromRGB(150, 220, 255),
			Transparency = 0.15,
			Reflectance = 0.1,
		})
	end
	return cluster
end

local function mountain(parent, position, size, yaw, color, material)
	-- A cube balanced on its corner reads as a jagged peak from far away.
	local cornerUp = CFrame.Angles(0, yaw, 0)
		* CFrame.Angles(0, 0, math.rad(54.7356))
		* CFrame.Angles(0, math.rad(45), 0)
	decor(parent, {
		Name = "Mountain",
		Size = Vector3.new(size, size, size),
		CFrame = CFrame.new(position + Vector3.new(0, -size * 0.35, 0)) * cornerUp,
		Material = material,
		Color = color,
		CastShadow = false,
	})
end

-- Lighting & baseplate ---------------------------------------------------------

local function configureLighting()
	local lighting = game:GetService("Lighting")
	lighting.ClockTime = 15.2
	lighting.Brightness = 2.4
	lighting.Ambient = Color3.fromRGB(105, 120, 150)
	lighting.OutdoorAmbient = Color3.fromRGB(150, 165, 200)
	lighting.ColorShift_Top = Color3.fromRGB(215, 230, 255)
	lighting.ColorShift_Bottom = Color3.fromRGB(180, 200, 235)
	lighting.EnvironmentDiffuseScale = 0.7
	lighting.EnvironmentSpecularScale = 1
	lighting.GeographicLatitude = 55
	-- Technology can only be changed in Studio, not by a running game.
	pcall(function()
		lighting.Technology = Enum.Technology.Future
	end)

	local atmosphere = lighting:FindFirstChildOfClass("Atmosphere")
	if not atmosphere then
		atmosphere = Instance.new("Atmosphere")
		atmosphere.Parent = lighting
	end
	atmosphere.Density = 0.32
	atmosphere.Offset = 0.1
	atmosphere.Color = Color3.fromRGB(205, 225, 250)
	atmosphere.Decay = Color3.fromRGB(120, 150, 195)
	atmosphere.Glare = 0.15
	atmosphere.Haze = 1.6

	local bloom = lighting:FindFirstChildOfClass("BloomEffect")
	if bloom then
		bloom.Intensity = 0.6
		bloom.Size = 30
		bloom.Threshold = 1.6
	end
end

local function restyleWorkspace()
	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate and baseplate:IsA("BasePart") then
		baseplate.Material = Enum.Material.Snow
		baseplate.Color = Color3.fromRGB(236, 242, 250)
		local texture = baseplate:FindFirstChildOfClass("Texture")
		if texture then
			texture:Destroy()
		end
	end

	-- The template's default spawn is replaced by the one in the lobby.
	local defaultSpawn = workspace:FindFirstChild("SpawnLocation")
	if defaultSpawn then
		defaultSpawn:Destroy()
	end
end

-- Lobby -----------------------------------------------------------------------------

local function buildSkateShop(parent, cf, Config)
	local shop = folder("SkateShop", parent)
	local function at(x, y, z)
		return cf * CFrame.new(x, y, z)
	end
	local wood = Color3.fromRGB(150, 100, 65)

	part(shop, {
		Name = "Floor",
		Size = Vector3.new(20, 0.8, 12),
		CFrame = at(0, 0.4, 0),
		Material = Enum.Material.WoodPlanks,
		Color = wood,
	})
	part(shop, {
		Name = "BackWall",
		Size = Vector3.new(20, 11, 1),
		CFrame = at(0, 6.3, 5.5),
		Material = Enum.Material.WoodPlanks,
		Color = Color3.fromRGB(125, 85, 55),
	})
	for _, x in { -9.5, 9.5 } do
		part(shop, {
			Name = "SideWall",
			Size = Vector3.new(1, 11, 12),
			CFrame = at(x, 6.3, 0),
			Material = Enum.Material.WoodPlanks,
			Color = Color3.fromRGB(125, 85, 55),
		})
	end
	part(shop, {
		Name = "Counter",
		Size = Vector3.new(16, 3.4, 2.4),
		CFrame = at(0, 2.5, -3.5),
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(70, 150, 230),
	})
	part(shop, {
		Name = "CounterTop",
		Size = Vector3.new(16.6, 0.4, 3),
		CFrame = at(0, 4.4, -3.5),
		Material = Enum.Material.Wood,
		Color = wood,
	})

	-- Striped roof with snow on top.
	for index = 0, 4 do
		part(shop, {
			Name = "Roof",
			Size = Vector3.new(4.4, 1, 14),
			CFrame = at(-8.8 + index * 4.4, 12.3, -0.5),
			Color = if index % 2 == 0 then Color3.fromRGB(220, 60, 70) else WHITE,
		})
	end
	decor(shop, {
		Name = "RoofSnow",
		Size = Vector3.new(22.4, 0.7, 14.4),
		CFrame = at(0, 13.1, -0.5),
		Material = Enum.Material.Snow,
		Color = SNOW,
	})

	local sign = part(
		shop,
		{ Name = "Sign", Size = Vector3.new(18, 4, 0.6), CFrame = at(0, 15.5, 1), Color = Color3.fromRGB(30, 45, 80) }
	)
	addText(sign, Enum.NormalId.Front, { { "⛸ SKATE SHOP", 1 } }, { PixelsPerStud = 30 })
	addText(sign, Enum.NormalId.Back, { { "⛸ SKATE SHOP", 1 } }, { PixelsPerStud = 30 })

	-- A shelf of display skates in each tier's colours.
	part(shop, {
		Name = "Shelf",
		Size = Vector3.new(18, 0.4, 1.6),
		CFrame = at(0, 6.5, 4.4),
		Material = Enum.Material.Wood,
		Color = wood,
	})
	for index = 1, math.min(5, #Config.Skates) do
		local skate = Config.Skates[index]
		local x = -7.2 + (index - 1) * 3.6
		decor(shop, {
			Name = "DisplayBoot",
			Size = Vector3.new(1.2, 1.3, 2),
			CFrame = at(x, 7.55, 4.2),
			Color = skate.BootColor,
		})
		decor(shop, {
			Name = "DisplayBlade",
			Size = Vector3.new(0.2, 0.3, 2.4),
			CFrame = at(x, 6.85, 4.2),
			Material = Enum.Material.Metal,
			Color = skate.BladeColor,
		})
	end

	local lantern = decor(shop, {
		Name = "Lantern",
		Size = Vector3.new(1, 1, 1),
		CFrame = at(0, 11.3, 0),
		Material = Enum.Material.Neon,
		Color = LAMP_GLOW,
	})
	light(lantern, "PointLight", { Range = 18, Brightness = 1.2, Color = LAMP_GLOW })

	local promptPart =
		decor(shop, { Name = "PromptAnchor", Size = Vector3.new(4, 4, 1), CFrame = at(0, 3, -5.2), Transparency = 1 })
	addPrompt(promptPart, { ActionText = "Open Shop", ObjectText = "Skate Shop" }, { Action = "OpenShop" })
end

local function buildRebirthCrystal(parent, cf)
	local altar = folder("RebirthCrystal", parent)
	local position = cf.Position
	local purple = Color3.fromRGB(170, 110, 255)

	cylinder(
		altar,
		position + Vector3.new(0, 0.5, 0),
		1,
		18,
		{ Name = "Base", Material = Enum.Material.Marble, Color = Color3.fromRGB(235, 235, 245) }
	)
	cylinder(
		altar,
		position + Vector3.new(0, 1.5, 0),
		1,
		12,
		{ Name = "Step", Material = Enum.Material.Glacier, Color = Color3.fromRGB(200, 180, 255) }
	)

	local crystal = part(altar, {
		Name = "Crystal",
		Size = Vector3.new(4, 10, 4),
		CFrame = CFrame.new(position + Vector3.new(0, 8, 0)) * CFrame.Angles(0, math.pi / 4, 0),
		Material = Enum.Material.Glass,
		Color = purple,
		Transparency = 0.2,
	})
	decor(altar, {
		Name = "Core",
		Size = Vector3.new(1.8, 7, 1.8),
		CFrame = crystal.CFrame,
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(215, 170, 255),
	})
	for side = -1, 1, 2 do
		part(altar, {
			Name = "Shard",
			Size = Vector3.new(1.6, 5, 1.6),
			CFrame = CFrame.new(position + Vector3.new(side * 3.2, 4.5, 0))
				* CFrame.Angles(0, math.pi / 4, math.rad(side * -20)),
			Material = Enum.Material.Glass,
			Color = purple,
			Transparency = 0.25,
		})
	end
	for index = 0, 7 do
		local angle = index / 8 * math.pi * 2
		ball(altar, position + Vector3.new(math.cos(angle) * 5.5, 7, math.sin(angle) * 5.5), 0.8, {
			Name = "Orb",
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(230, 200, 255),
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
		})
	end
	light(crystal, "PointLight", { Range = 22, Brightness = 2, Color = purple })

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Title"
	billboard.Size = UDim2.fromScale(14, 3.5)
	billboard.StudsOffset = Vector3.new(0, 8, 0)
	billboard.LightInfluence = 0
	billboard.MaxDistance = 160
	billboard.Parent = crystal
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.FontFace = Font.fromEnum(Enum.Font.FredokaOne)
	label.Text = "🔄 REBIRTH"
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(235, 215, 255)
	label.Parent = billboard
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(60, 25, 110)
	stroke.Parent = label

	local promptPart = decor(altar, {
		Name = "PromptAnchor",
		Size = Vector3.new(4, 4, 4),
		CFrame = CFrame.new(position + Vector3.new(0, 4, 0)),
		Transparency = 1,
	})
	addPrompt(promptPart, { ActionText = "Rebirth", ObjectText = "Rebirth Crystal" }, { Action = "OpenRebirth" })
end

local function buildLeaderboard(parent, cf)
	local board = folder("Leaderboard", parent)
	local function at(x, y, z)
		return cf * CFrame.new(x, y, z)
	end
	for _, x in { -13, 13 } do
		part(board, {
			Name = "Post",
			Size = Vector3.new(1.2, 22, 1.2),
			CFrame = at(x, 11, 0.6),
			Material = Enum.Material.Metal,
			Color = DARK_METAL,
		})
	end
	decor(board, {
		Name = "Frame",
		Size = Vector3.new(28.8, 18.8, 0.6),
		CFrame = at(0, 13, 0.4),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 200, 80),
	})
	local panel = part(board, {
		Name = "LeaderboardBoard",
		Size = Vector3.new(28, 18, 1),
		CFrame = at(0, 13, 0),
		Color = Color3.fromRGB(22, 32, 58),
	})

	local gui = Instance.new("SurfaceGui")
	gui.Name = "Leaderboard"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.LightInfluence = 0
	gui.Parent = panel

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromScale(0.05, 0.02)
	title.Size = UDim2.fromScale(0.9, 0.15)
	title.FontFace = Font.fromEnum(Enum.Font.FredokaOne)
	title.Text = "🏆 TOP SKATERS"
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(255, 215, 100)
	title.Parent = gui

	local subtitle = Instance.new("TextLabel")
	subtitle.Name = "Subtitle"
	subtitle.BackgroundTransparency = 1
	subtitle.Position = UDim2.fromScale(0.05, 0.17)
	subtitle.Size = UDim2.fromScale(0.9, 0.07)
	subtitle.FontFace = Font.fromEnum(Enum.Font.GothamMedium)
	subtitle.Text = "Lifetime snowflakes earned"
	subtitle.TextScaled = true
	subtitle.TextColor3 = Color3.fromRGB(180, 200, 235)
	subtitle.Parent = gui

	local list = Instance.new("Frame")
	list.Name = "List"
	list.BackgroundTransparency = 1
	list.Position = UDim2.fromScale(0.05, 0.26)
	list.Size = UDim2.fromScale(0.9, 0.72)
	list.Parent = gui

	for rank = 1, 10 do
		local row = Instance.new("Frame")
		row.Name = "Row" .. rank
		row.BackgroundColor3 = WHITE
		row.BackgroundTransparency = if rank % 2 == 0 then 0.94 else 1
		row.BorderSizePixel = 0
		row.Position = UDim2.fromScale(0, (rank - 1) / 10)
		row.Size = UDim2.fromScale(1, 0.1)
		row.Parent = list

		local columns = {
			{ "Rank", "#" .. rank, 0, 0.12, Enum.TextXAlignment.Left },
			{ "PlayerName", "—", 0.12, 0.56, Enum.TextXAlignment.Left },
			{ "Value", "", 0.68, 0.32, Enum.TextXAlignment.Right },
		}
		for _, column in columns do
			local label = Instance.new("TextLabel")
			label.Name = column[1]
			label.BackgroundTransparency = 1
			label.Position = UDim2.fromScale(column[3], 0.1)
			label.Size = UDim2.fromScale(column[4], 0.8)
			label.FontFace = Font.fromEnum(Enum.Font.GothamBold)
			label.Text = column[2]
			label.TextScaled = true
			label.TextXAlignment = column[5]
			label.TextColor3 = if rank <= 3 then Color3.fromRGB(255, 225, 140) else WHITE
			label.Parent = row
		end
	end
end

local function buildTitleArch(parent, center, radius, accent)
	local arch = folder("TitleArch", parent)
	local z = center.Z - radius - 6
	for _, x in { -13, 13 } do
		part(arch, {
			Name = "Pillar",
			Size = Vector3.new(4, 24, 4),
			CFrame = CFrame.new(center.X + x, 12, z),
			Material = Enum.Material.Glacier,
			Color = Color3.fromRGB(175, 220, 250),
		})
		ball(
			arch,
			Vector3.new(center.X + x, 24.5, z),
			3.2,
			{ Name = "Orb", Material = Enum.Material.Neon, Color = accent, CanCollide = false }
		)
	end
	local beam = part(arch, {
		Name = "Beam",
		Size = Vector3.new(34, 7, 3),
		CFrame = CFrame.new(center.X, 27.5, z),
		Color = Color3.fromRGB(30, 50, 95),
	})
	decor(arch, {
		Name = "Trim",
		Size = Vector3.new(34.4, 0.5, 3.2),
		CFrame = CFrame.new(center.X, 24.1, z),
		Material = Enum.Material.Neon,
		Color = accent,
	})
	decor(arch, {
		Name = "Snow",
		Size = Vector3.new(34.6, 0.8, 3.6),
		CFrame = CFrame.new(center.X, 31.4, z),
		Material = Enum.Material.Snow,
		Color = SNOW,
	})
	local lines = {
		{ "ICE SKATING SIMULATOR", 0.66 },
		{ "❄ skate • spin • collect ❄", 0.34, Color3.fromRGB(190, 225, 255) },
	}
	addText(beam, Enum.NormalId.Back, lines, { PixelsPerStud = 30 })
	addText(beam, Enum.NormalId.Front, lines, { PixelsPerStud = 30 })
end

local function buildLobby(map, Config)
	local lobby = folder("Lobby", map)
	local center = Config.Lobby.Center
	local radius = Config.Lobby.PlazaRadius
	local accent = Color3.fromRGB(110, 190, 255)

	cylinder(
		lobby,
		center + Vector3.new(0, -0.05, 0),
		0.6,
		(radius + 3) * 2,
		{ Name = "PlazaRim", Material = Enum.Material.Slate, Color = Color3.fromRGB(150, 160, 182) }
	)
	cylinder(
		lobby,
		center,
		0.6,
		radius * 2,
		{ Name = "Plaza", Material = Enum.Material.Cobblestone, Color = Color3.fromRGB(200, 207, 220) }
	)
	cylinder(
		lobby,
		center + Vector3.new(0, 0.02, 0),
		0.6,
		34,
		{ Name = "Medallion", Material = Enum.Material.Marble, Color = Color3.fromRGB(185, 220, 250) }
	)
	for index = 0, 2 do
		decor(lobby, {
			Name = "SnowflakeArm",
			Size = Vector3.new(30, 0.06, 1.4),
			CFrame = CFrame.new(center + Vector3.new(0, 0.34, 0)) * CFrame.Angles(0, index * math.pi / 3, 0),
			Material = Enum.Material.Neon,
			Color = accent,
		})
	end

	local spawn = part(lobby, {
		Name = "Spawn",
		Size = Vector3.new(10, 0.6, 10),
		CFrame = CFrame.new(center + Vector3.new(0, 0.62, 0)),
		Material = Enum.Material.Glass,
		Color = Color3.fromRGB(160, 215, 255),
		Transparency = 0.15,
	}, "SpawnLocation")
	spawn.Duration = 0
	spawn.Neutral = true

	buildTitleArch(lobby, center, radius, accent)
	buildSkateShop(lobby, facing(center + Vector3.new(-34, 0.0, 22), center), Config)
	buildRebirthCrystal(lobby, facing(center + Vector3.new(34, 0, 22), center))
	buildLeaderboard(lobby, facing(center + Vector3.new(0, 0, radius - 6), center))

	-- Lamps around the plaza, leaving the path openings clear.
	local pathAngles = {}
	for _, rink in Config.Rinks do
		local toRink = rink.Center - center
		table.insert(pathAngles, math.atan2(toRink.Z, toRink.X))
	end
	local lamps = folder("Lamps", lobby)
	for index = 0, 15 do
		local angle = index / 16 * math.pi * 2 + math.pi / 16
		local blocked = false
		for _, pathAngle in pathAngles do
			local difference = math.abs((angle - pathAngle + math.pi) % (math.pi * 2) - math.pi)
			if difference < math.rad(16) then
				blocked = true
			end
		end
		if not blocked then
			lamp(lamps, center + Vector3.new(math.cos(angle) * (radius - 2.5), 0.3, math.sin(angle) * (radius - 2.5)))
		end
	end

	-- A couple of benches facing the spawn.
	for _, x in { -18, 18 } do
		local bench = folder("Bench", lobby)
		local cf = facing(center + Vector3.new(x, 0.3, -20), center)
		part(bench, {
			Name = "Seat",
			Size = Vector3.new(7, 0.5, 2),
			CFrame = cf * CFrame.new(0, 1.6, 0),
			Material = Enum.Material.WoodPlanks,
			Color = Color3.fromRGB(150, 100, 65),
		})
		part(bench, {
			Name = "Back",
			Size = Vector3.new(7, 2, 0.4),
			CFrame = cf * CFrame.new(0, 2.8, 0.9),
			Material = Enum.Material.WoodPlanks,
			Color = Color3.fromRGB(150, 100, 65),
		})
		for _, legX in { -3, 3 } do
			part(bench, {
				Name = "Leg",
				Size = Vector3.new(0.4, 1.4, 1.6),
				CFrame = cf * CFrame.new(legX, 0.7, 0),
				Material = Enum.Material.Metal,
				Color = DARK_METAL,
			})
		end
	end

	return lobby
end

-- Rinks ------------------------------------------------------------------------------

local function buildRinkDecor(model, rink, cf, random)
	local width, length = rink.Size.X, rink.Size.Y
	local decorFolder = folder("Decor", model)

	if rink.Theme == "Pond" then
		for index, x in { -1, 1, -1 } do
			local position = (cf * CFrame.new(x * (width / 2 + 16), 0, length / 2 - 20 - index * 25)).Position
			snowman(decorFolder, position, cf.Position, 1 + index * 0.1)
		end
	elseif rink.Theme == "Forest" then
		for _ = 1, 34 do
			local side = math.floor(random(0, 4))
			local outset = random(14, 40)
			local x, z
			if side == 0 then
				x, z = -width / 2 - outset, random(-length / 2, length / 2)
			elseif side == 1 then
				x, z = width / 2 + outset, random(-length / 2, length / 2)
			else
				x, z = random(-width / 2, width / 2), -length / 2 - outset
			end
			tree(decorFolder, (cf * CFrame.new(x, 0, z)).Position, random(0.9, 1.5), random)
		end
	elseif rink.Theme == "Glacier" then
		for _ = 1, 26 do
			local side = math.floor(random(0, 3))
			local outset = random(10, 36)
			local x, z
			if side == 0 then
				x, z = -width / 2 - outset, random(-length / 2, length / 2)
			elseif side == 1 then
				x, z = width / 2 + outset, random(-length / 2, length / 2)
			else
				x, z = random(-width / 2, width / 2), -length / 2 - outset
			end
			iceCrystals(decorFolder, (cf * CFrame.new(x, 0, z)).Position, random(0.8, 1.8), random)
		end
	elseif rink.Theme == "Arena" then
		-- Bleachers along both long sides.
		local purple = Color3.fromRGB(70, 45, 120)
		for side = -1, 1, 2 do
			for row = 1, 6 do
				part(decorFolder, {
					Name = "Bleacher",
					Size = Vector3.new(3, 1.4 * row, length * 0.85),
					CFrame = cf * CFrame.new(side * (width / 2 + 5 + 3 * (row - 1)), 0.7 * row, 0),
					Color = if row % 2 == 0 then purple else Color3.fromRGB(100, 70, 160),
				})
			end
		end

		-- Floodlight towers in each corner.
		for _, corner in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do
			local base = (cf * CFrame.new(corner[1] * (width / 2 + 26), 0, corner[2] * (length / 2 + 10))).Position
			cylinder(
				decorFolder,
				base + Vector3.new(0, 20, 0),
				40,
				1.6,
				{ Name = "Tower", Material = Enum.Material.Metal, Color = DARK_METAL }
			)
			local lampHead = part(decorFolder, {
				Name = "Floodlight",
				Size = Vector3.new(8, 4, 1),
				CFrame = facing(base + Vector3.new(0, 40, 0), cf.Position) * CFrame.Angles(math.rad(-30), 0, 0),
				Material = Enum.Material.Neon,
				Color = Color3.fromRGB(240, 240, 255),
				CanCollide = false,
			})
			light(lampHead, "SpotLight", {
				Face = Enum.NormalId.Front,
				Range = 60,
				Angle = 70,
				Brightness = 2,
				Color = Color3.fromRGB(230, 225, 255),
			})
		end

		-- Floating jumbotron over centre ice.
		local screen = decor(decorFolder, {
			Name = "Jumbotron",
			Size = Vector3.new(26, 12, 26),
			CFrame = cf * CFrame.new(0, 55, 0),
			Color = Color3.fromRGB(28, 28, 40),
		})
		for _, y in { -6.2, 6.2 } do
			decor(decorFolder, {
				Name = "JumbotronTrim",
				Size = Vector3.new(26.6, 0.6, 26.6),
				CFrame = cf * CFrame.new(0, 55 + y, 0),
				Material = Enum.Material.Neon,
				Color = rink.AccentColor,
			})
		end
		for _, face in { Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right } do
			addText(screen, face, {
				{ string.upper(rink.Name), 0.6 },
				{ multiplierText(rink.Multiplier) .. " ❄", 0.4, Color3.fromRGB(210, 180, 255) },
			}, { PixelsPerStud = 20 })
		end

		-- Aurora ribbons in the sky.
		for band = 0, 1 do
			for index = 0, 39 do
				local t = index / 39
				local x = -220 + t * 440
				local wave = math.sin(t * math.pi * 3 + band * 1.7)
				local colour = Color3.fromRGB(90, 255, 170)
					:Lerp(Color3.fromRGB(170, 100, 255), (math.sin(t * math.pi * 2 + band) + 1) / 2)
				decor(decorFolder, {
					Name = "Aurora",
					Size = Vector3.new(12, 40 + wave * 12, 0.4),
					CFrame = cf
						* CFrame.new(x, 150 + band * 30 + wave * 8, -60 + band * 90 + wave * 30)
						* CFrame.Angles(0, wave * 0.4, 0),
					Material = Enum.Material.Neon,
					Color = colour,
					Transparency = 0.6,
					CastShadow = false,
				})
			end
		end
	end
end

local function buildRink(parent, rink, Config, random)
	local width, length = rink.Size.X, rink.Size.Y
	local cf = WorldBuilder.rinkCFrame(rink, Config.Lobby.Center)
	local model = Instance.new("Model")
	model.Name = rink.Id
	model:SetAttribute("RinkId", rink.Id)
	model:SetAttribute("Multiplier", rink.Multiplier)
	model:SetAttribute("Price", rink.Price)

	local ice = part(model, {
		Name = "Ice",
		Size = Vector3.new(width, 0.4, length),
		CFrame = cf,
		Material = Enum.Material.Ice,
		Color = rink.IceColor,
		Reflectance = 0.15,
	})
	ice:SetAttribute("RinkId", rink.Id)
	ice:AddTag("RinkFloor")
	model.PrimaryPart = ice

	-- Centre circle and lines on the ice.
	local markings = folder("Markings", model)
	decor(markings, {
		Shape = Enum.PartType.Cylinder,
		Name = "CircleOuter",
		Size = Vector3.new(0.04, 32, 32),
		CFrame = cf * CFrame.new(0, 0.22, 0) * CYLINDER_UP,
		Color = rink.AccentColor,
		Transparency = 0.35,
	})
	decor(markings, {
		Shape = Enum.PartType.Cylinder,
		Name = "CircleInner",
		Size = Vector3.new(0.04, 29, 29),
		CFrame = cf * CFrame.new(0, 0.25, 0) * CYLINDER_UP,
		Material = Enum.Material.Ice,
		Color = rink.IceColor,
	})
	if rink.Theme == "Arena" or rink.Theme == "Forest" then
		decor(markings, {
			Name = "CentreLine",
			Size = Vector3.new(width, 0.04, 1.2),
			CFrame = cf * CFrame.new(0, 0.22, 0),
			Color = Color3.fromRGB(220, 60, 70),
			Transparency = 0.3,
		})
		for _, z in { -length / 6, length / 6 } do
			decor(markings, {
				Name = "BlueLine",
				Size = Vector3.new(width, 0.04, 1.2),
				CFrame = cf * CFrame.new(0, 0.22, z),
				Color = Color3.fromRGB(50, 110, 220),
				Transparency = 0.3,
			})
		end
	end

	-- Boards around the edge, with an entrance on the lobby side.
	local boards = folder("Boards", model)
	local boardHeight = rink.BoardHeight
	ring(boards, cf, width, length, {
		Name = "Board",
		Height = boardHeight,
		Thickness = BOARD_THICKNESS,
		Gap = ENTRANCE_WIDTH,
		Material = rink.BoardMaterial,
		Color = rink.BoardColor,
	})
	ring(boards, cf, width, length, {
		Name = "Rail",
		Height = 0.5,
		Bottom = boardHeight,
		Thickness = BOARD_THICKNESS + 0.4,
		Outset = -0.2,
		Gap = ENTRANCE_WIDTH,
		Color = rink.RailColor,
	})
	if rink.Theme == "Arena" then
		ring(boards, cf, width, length, {
			Name = "Glass",
			Height = 6,
			Bottom = boardHeight + 0.5,
			Thickness = 0.4,
			Outset = 0.55,
			Gap = ENTRANCE_WIDTH,
			Material = Enum.Material.Glass,
			Color = Color3.fromRGB(200, 230, 255),
			Transparency = 0.65,
		})
	end

	-- Entrance arch with the rink's name.
	local arch = folder("Arch", model)
	local archZ = length / 2 + BOARD_THICKNESS / 2
	for side = -1, 1, 2 do
		local x = side * (ENTRANCE_WIDTH / 2 + 2.5)
		part(arch, {
			Name = "Pillar",
			Size = Vector3.new(3.5, 18, 3.5),
			CFrame = cf * CFrame.new(x, 9, archZ),
			Material = rink.BoardMaterial,
			Color = rink.BoardColor,
		})
		ball(
			arch,
			(cf * CFrame.new(x, 18.4, archZ)).Position,
			2.6,
			{ Name = "Orb", Material = Enum.Material.Neon, Color = rink.AccentColor, CanCollide = false }
		)
	end
	local beam = part(arch, {
		Name = "Beam",
		Size = Vector3.new(ENTRANCE_WIDTH + 9, 5, 2.5),
		CFrame = cf * CFrame.new(0, 20.5, archZ),
		Color = Color3.fromRGB(30, 45, 80),
	})
	decor(arch, {
		Name = "Trim",
		Size = Vector3.new(ENTRANCE_WIDTH + 9.4, 0.4, 2.7),
		CFrame = cf * CFrame.new(0, 18.2, archZ),
		Material = Enum.Material.Neon,
		Color = rink.AccentColor,
	})
	decor(arch, {
		Name = "Snow",
		Size = Vector3.new(ENTRANCE_WIDTH + 9.4, 0.8, 2.9),
		CFrame = cf * CFrame.new(0, 23.4, archZ),
		Material = Enum.Material.Snow,
		Color = SNOW,
	})
	local archLines = {
		{ string.upper(rink.Name), 0.62 },
		{ multiplierText(rink.Multiplier) .. " Snowflakes", 0.38, Color3.fromRGB(200, 230, 255) },
	}
	addText(beam, Enum.NormalId.Back, archLines, { PixelsPerStud = 30 })
	addText(beam, Enum.NormalId.Front, archLines, { PixelsPerStud = 30 })

	-- Lamps around the outside.
	local lamps = folder("Lamps", model)
	local lampOutset = BOARD_THICKNESS + LOCK_OUTSET + 3
	local sideCount = math.max(2, math.floor(length / 45))
	for index = 0, sideCount do
		local z = -length / 2 + index * (length / sideCount)
		for side = -1, 1, 2 do
			if rink.Theme ~= "Arena" then
				lamp(
					lamps,
					(cf * CFrame.new(side * (width / 2 + lampOutset), 0, z)).Position,
					rink.Theme == "Glacier" and Color3.fromRGB(170, 230, 255) or nil
				)
			end
		end
	end
	local backCount = math.max(2, math.floor(width / 45))
	for index = 1, backCount - 1 do
		local x = -width / 2 + index * (width / backCount)
		lamp(
			lamps,
			(cf * CFrame.new(x, 0, -length / 2 - lampOutset)).Position,
			rink.Theme == "Glacier" and Color3.fromRGB(170, 230, 255) or nil
		)
	end

	-- Locked rinks are sealed by invisible walls and a shimmering gate until bought.
	-- The client opens them for players who own them; the server double-checks.
	if rink.Price > 0 then
		local lock = folder("Lock", model)
		ring(lock, cf, width, length, {
			Name = "LockWall",
			Height = 90,
			Thickness = 1,
			Outset = LOCK_OUTSET,
			Transparency = 1,
			Invisible = true,
		})
		local gateZ = length / 2 + LOCK_OUTSET + 1.5
		local gate = decor(lock, {
			Name = "Gate",
			Size = Vector3.new(ENTRANCE_WIDTH + 14, 24, 0.4),
			CFrame = cf * CFrame.new(0, 12, gateZ),
			Material = Enum.Material.ForceField,
			Color = rink.AccentColor,
			CastShadow = false,
		})
		addText(gate, Enum.NormalId.Back, {
			{ "🔒 LOCKED", 0.4 },
			{ commas(rink.Price) .. " ❄", 0.35, Color3.fromRGB(200, 235, 255) },
			{ "to unlock " .. rink.Name, 0.25, Color3.fromRGB(200, 215, 240) },
		}, { PixelsPerStud = 20 })
		local promptPart = decor(lock, {
			Name = "PromptAnchor",
			Size = Vector3.new(4, 4, 1),
			CFrame = cf * CFrame.new(0, 4, gateZ + 1.5),
			Transparency = 1,
		})
		addPrompt(promptPart, {
			ActionText = "Unlock",
			ObjectText = rink.Name .. " (" .. commas(rink.Price) .. " ❄)",
			HoldDuration = 0.4,
			MaxActivationDistance = 16,
		}, { Action = "UnlockRink", RinkId = rink.Id })
	end

	buildRinkDecor(model, rink, cf, random)
	model.Parent = parent
	return model, cf
end

local function buildPath(parent, Config, rink, cf)
	local center = Config.Lobby.Center
	local radius = Config.Lobby.PlazaRadius
	local entrance = (cf * CFrame.new(0, 0, rink.Size.Y / 2 + BOARD_THICKNESS)).Position
	local direction = Vector3.new(entrance.X - center.X, 0, entrance.Z - center.Z).Unit
	local start = center + direction * (radius - 1)
	local pathLength = (entrance - start).Magnitude
	local pathCFrame = facing((start + entrance) / 2, entrance)

	local path = folder(rink.Id .. "Path", parent)
	part(path, {
		Name = "Path",
		Size = Vector3.new(18, 0.3, pathLength),
		CFrame = pathCFrame,
		Material = Enum.Material.Slate,
		Color = Color3.fromRGB(175, 185, 205),
	})
	for side = -1, 1, 2 do
		decor(path, {
			Name = "SnowBank",
			Size = Vector3.new(2.4, 1.4, pathLength),
			CFrame = pathCFrame * CFrame.new(side * 10.2, 0, 0),
			Material = Enum.Material.Snow,
			Color = SNOW,
		})
	end

	local lampCount = math.max(1, math.floor(pathLength / 40))
	for index = 1, lampCount do
		local z = -pathLength / 2 + (index - 0.5) * (pathLength / lampCount)
		for side = -1, 1, 2 do
			lamp(path, (pathCFrame * CFrame.new(side * 13, 0, z)).Position)
		end
	end

	-- Signpost at the plaza end of the path.
	local signBase = start + direction * 4 + direction:Cross(Vector3.yAxis) * 12
	cylinder(
		path,
		signBase + Vector3.new(0, 4, 0),
		8,
		0.6,
		{ Name = "SignPost", Material = Enum.Material.Wood, Color = Color3.fromRGB(110, 75, 50) }
	)
	local board = part(path, {
		Name = "SignBoard",
		Size = Vector3.new(9, 3.4, 0.4),
		CFrame = facing(signBase + Vector3.new(0, 7.4, 0), center),
		Material = Enum.Material.WoodPlanks,
		Color = Color3.fromRGB(150, 100, 65),
	})
	local signLines = {
		{ rink.Name, 0.6 },
		{ multiplierText(rink.Multiplier) .. " ❄", 0.4, Color3.fromRGB(200, 235, 255) },
	}
	addText(board, Enum.NormalId.Front, signLines, { PixelsPerStud = 30, StrokeThickness = 2 })
	addText(board, Enum.NormalId.Back, signLines, { PixelsPerStud = 30, StrokeThickness = 2 })

	return start, entrance
end

-- Scenery ----------------------------------------------------------------------------

local function buildScenery(map, Config, random, rinkFrames, paths)
	local scenery = folder("Scenery", map)
	local center = Config.Lobby.Center
	local radius = Config.Lobby.PlazaRadius

	local function isClear(point, margin)
		if (point - center).Magnitude < radius + 15 + margin then
			return false
		end
		for _, entry in rinkFrames do
			local localPoint = entry.CFrame:PointToObjectSpace(point)
			if
				math.abs(localPoint.X) < entry.Rink.Size.X / 2 + 32 + margin
				and math.abs(localPoint.Z) < entry.Rink.Size.Y / 2 + 32 + margin
			then
				return false
			end
		end
		for _, segment in paths do
			if distanceToSegment(point, segment[1], segment[2]) < 20 + margin then
				return false
			end
		end
		return true
	end

	local trees = folder("Trees", scenery)
	local placed = 0
	local attempts = 0
	while placed < 140 and attempts < 4000 do
		attempts += 1
		local point = Vector3.new(random(-560, 560), 0, random(-420, 620))
		if isClear(point, 0) then
			tree(trees, point, random(0.9, 1.7), random)
			placed += 1
		end
	end

	local drifts = folder("SnowDrifts", scenery)
	placed = 0
	attempts = 0
	while placed < 40 and attempts < 2000 do
		attempts += 1
		local point = Vector3.new(random(-560, 560), 0, random(-420, 620))
		if isClear(point, 10) then
			local diameter = random(10, 26)
			ball(
				drifts,
				point + Vector3.new(0, -diameter * 0.3, 0),
				diameter,
				{ Name = "Drift", Material = Enum.Material.Snow, Color = SNOW }
			)
			placed += 1
		end
	end

	local mountains = folder("Mountains", scenery)
	local mountainCentre = center + Vector3.new(0, 0, 100)
	for index = 0, 17 do
		local angle = index / 18 * math.pi * 2 + random(-0.1, 0.1)
		local distance = random(850, 980)
		local position = mountainCentre + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
		local glacier = index % 3 == 0
		mountain(
			mountains,
			position,
			random(260, 420),
			random(0, math.pi * 2),
			if glacier then Color3.fromRGB(185, 215, 240) else Color3.fromRGB(235, 240, 248),
			if glacier then Enum.Material.Glacier else Enum.Material.Snow
		)
	end
end

-- Entry point --------------------------------------------------------------------

function WorldBuilder.build(Config)
	local random = newRandom(20261004)

	configureLighting()
	restyleWorkspace()

	local map = Instance.new("Folder")
	map.Name = "Map"

	buildLobby(map, Config)

	local rinksFolder = folder("Rinks", map)
	local pathsFolder = folder("Paths", map)
	local rinkFrames = {}
	local paths = {}
	for _, rink in Config.Rinks do
		local _, cf = buildRink(rinksFolder, rink, Config, random)
		table.insert(rinkFrames, { Rink = rink, CFrame = cf })
		local start, finish = buildPath(pathsFolder, Config, rink, cf)
		table.insert(paths, { start, finish })
	end

	buildScenery(map, Config, random, rinkFrames, paths)

	map.Parent = workspace
	return map
end

return WorldBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
