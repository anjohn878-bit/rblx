	{
		Id = "Goldfinch",
		Name = "Goldfinch",
		Rarity = "Uncommon",
		Reward = 12,
		Description = "A flash of sunshine with tiny black wings.",
		Look = {
			Size = 0.8,
			Body = rgb(255, 215, 40),
			Head = rgb(255, 215, 40),
			Cap = rgb(35, 35, 35),
			Wing = rgb(35, 35, 35),
