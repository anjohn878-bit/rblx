		BackgroundTransparency = 0.5,
		Visible = false,
		Parent = gui,
	})

	panel = UIKit.New("Frame", {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(800, 520),
		BackgroundColor3 = Theme.Colors.Panel,
		Visible = false,
		Parent = gui,
	}, {
		UIKit.Corner(22),
		UIKit.Stroke(4, Theme.Colors.Stroke),
	})
	UIKit.Scaled(panel)

	header = UIKit.New("Frame", {
		Size = UDim2.new(1, 0, 0, 64),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = panel,
	}, {
		UIKit.Corner(22),
	})
	headerGradient = UIKit.Gradient(Theme.Colors.Teal, Theme.Colors.TealDark)
	headerGradient.Parent = header
	UIKit.New("Frame", {
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.new(0, 0, 1, -22),
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BackgroundTransparency = 0.82,
		BorderSizePixel = 0,
		Parent = header,
	})
	titleLabel = UIKit.Label({
		Text = "🩺 DIAGNOSIS",
		TextSize = 34,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.5, 0, 1, 0),
		Position = UDim2.fromOffset(22, 0),
		Parent = header,
	})
	UIKit.TextStroke(3).Parent = titleLabel
	rarityLabel = UIKit.Label({
		Text = "",
		TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -74, 0, 0),
		Size = UDim2.new(0.45, 0, 1, 0),
		Parent = header,
	})
	UIKit.TextStroke(3).Parent = rarityLabel
	UIKit.Button({
		Text = "✖",
		Color = Theme.Colors.Red,
		Size = UDim2.fromOffset(48, 48),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		TextSize = 26,
		Parent = header,
		OnClick = function()
			DiagnosisController.Close(true)
		end,
	})

	-- Left: patient card
	local card = UIKit.New("Frame", {
		Position = UDim2.fromOffset(16, 80),
		Size = UDim2.fromOffset(300, 424),
		BackgroundColor3 = Theme.Colors.White,
		Parent = panel,
	}, {
		UIKit.Corner(18),
		UIKit.Stroke(3, Theme.Colors.PanelAlt:Lerp(Theme.Colors.Stroke, 0.25)),
	})
	faceLabel = UIKit.Label({ Text = "🤒", TextSize = 64, Size = UDim2.new(1, 0, 0, 76), Position = UDim2.fromOffset(0, 6), Parent = card })
	nameLabel = UIKit.Label({ Text = "", TextSize = 28, TextColor3 = Theme.Colors.Text, Size = UDim2.new(1, -20, 0, 32), Position = UDim2.fromOffset(10, 82), Parent = card })
	tagLabel = UIKit.Label({
		Text = "",
		Font = Theme.BodyFont,
		TextSize = 14,
		TextColor3 = Theme.Colors.TextMuted,
		Size = UDim2.new(1, -20, 0, 20),
		Position = UDim2.fromOffset(10, 114),
		Parent = card,
	})
	UIKit.Label({ Text = "SYMPTOMS", TextSize = 22, TextColor3 = Theme.Colors.Red, Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 140), Parent = card })
	symptomList = UIKit.New("Frame", {
		Position = UDim2.fromOffset(14, 172),
		Size = UDim2.new(1, -28, 1, -182),
		BackgroundTransparency = 1,
		Parent = card,
	}, {
		UIKit.List(Enum.FillDirection.Vertical, 8),
	})

	-- Right: options
	local right = UIKit.New("Frame", {
		Position = UDim2.fromOffset(332, 80),
		Size = UDim2.fromOffset(452, 424),
		BackgroundTransparency = 1,
		Parent = panel,
	})
	UIKit.Label({
		Text = "What's the diagnosis?",
		TextSize = 28,
		TextColor3 = Theme.Colors.Text,
		Size = UDim2.new(1, 0, 0, 34),
		Parent = right,
	})
	optionsFrame = UIKit.New("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(1, 0, 0, 270),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = right,
	}, {
		UIKit.Padding(6, 6),
	})
	optionsGrid = UIKit.New("UIGridLayout", {
		CellSize = UDim2.fromOffset(204, 74),
		CellPadding = UDim2.fromOffset(14, 12),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = optionsFrame,
	})

	local tools = UIKit.New("Frame", {
		Position = UDim2.fromOffset(0, 318),
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundTransparency = 1,
		Parent = right,
	}, {
		UIKit.List(Enum.FillDirection.Horizontal, 12),
	})
	handbookButton = UIKit.Button({
		Text = "📖 Show Handbook",
		Color = Theme.Colors.Purple,
		Size = UDim2.fromOffset(210, 48),
		TextSize = 20,
		LayoutOrder = 1,
		Parent = tools,
		OnClick = function()
			task.spawn(revealHandbook)
		end,
	})
	labButton = UIKit.Button({
		Text = "🧪 Lab Test",
		Color = Theme.Colors.Teal,
		Size = UDim2.fromOffset(170, 48),
		TextSize = 20,
		LayoutOrder = 2,
		Parent = tools,
		OnClick = function()
			task.spawn(useLab)
		end,
	})
	rewardLabel = UIKit.Label({
		Text = "",
		TextSize = 19,
		TextColor3 = Theme.Colors.GreenDark,
		Size = UDim2.new(1, 0, 0, 26),
		Position = UDim2.fromOffset(0, 380),
		Parent = right,
	})
	feedbackLabel = UIKit.Label({
		Text = "",
		TextSize = 20,
		TextColor3 = Theme.Colors.Red,
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.fromOffset(0, 404),
		Visible = false,
		Parent = right,
	})
	tipLabel = UIKit.Label({
		Text = "💡 Find the illness whose symptoms match the patient's! (matching symptoms glow yellow)",
		TextSize = 17,
		TextWrapped = true,
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Colors.Yellow,
		TextColor3 = Theme.Colors.Text,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 10),
		Size = UDim2.fromOffset(620, 44),
		Visible = false,
		Parent = panel,
	})
	UIKit.Corner(12).Parent = tipLabel
	UIKit.Stroke(3, Theme.Colors.Stroke).Parent = tipLabel

	-- Success overlay
	resultOverlay = UIKit.New("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.15,
		Visible = false,
		ZIndex = 10,
		Parent = panel,
	}, {
		UIKit.Corner(22),
	})
	local stamp = UIKit.Label({
		Name = "Stamp",
		Text = "✅ CORRECT DIAGNOSIS!",
		TextSize = 52,
		TextColor3 = Theme.Colors.Green,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.fromOffset(760, 80),
		ZIndex = 11,
		Parent = resultOverlay,
	})
	UIKit.TextStroke(4).Parent = stamp
	local money = UIKit.Label({
		Name = "Money",
		Text = "+$0",
		TextSize = 64,
		TextColor3 = Theme.Colors.Money,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.58),
		Size = UDim2.fromOffset(500, 80),
		ZIndex = 11,
		Parent = resultOverlay,
	})
	UIKit.TextStroke(4).Parent = money
	UIKit.Label({
		Name = "Details",
		Text = "",
		TextSize = 24,
		TextColor3 = Theme.Colors.Text,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.74),
		Size = UDim2.fromOffset(700, 40),
		ZIndex = 11,
		Parent = resultOverlay,
	})
end

function DiagnosisController.Start()
	Remotes.Event("OpenDiagnosis").OnClientEvent:Connect(open)
	Remotes.Event("CloseDiagnosis").OnClientEvent:Connect(function(reason: any)
		if current and not resultOverlay.Visible then
			if reason == "far" then
				controllers.NotificationController.Toast("You walked away from your patient.", "Info")
			end
			DiagnosisController.Close(false)
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not current or resultOverlay.Visible then
			return
		end
		local index = table.find(KEYCODES, input.KeyCode)
		if index and optionOrder[index] then
			task.spawn(choose, optionOrder[index])
		elseif input.KeyCode == Enum.KeyCode.H then
			task.spawn(revealHandbook)
		end
	end)
	player.CharacterAdded:Connect(function()
		DiagnosisController.Close(true)
	end)
end

return DiagnosisController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">EffectsController</string>
              <string name="Source"><![CDATA[--[[
	EffectsController
	Juice: floating "+$45" popups, sparkle bursts, confetti and camera shake.
	Triggered by the server's Effect remote and by other controllers.
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Rarities = require(Shared:WaitForChild("Config"):WaitForChild("Rarities"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local UIKit = require(script.Parent.Parent.UI.UIKit)
local Theme = UIKit.Theme

local EffectsController = {}

local controllers: any = nil
local player = Players.LocalPlayer
local confettiGui: ScreenGui

local CONFETTI_COLORS = {
	Color3.fromRGB(255, 90, 90),
	Color3.fromRGB(255, 205, 60),
	Color3.fromRGB(90, 210, 110),
	Color3.fromRGB(80, 160, 255),
	Color3.fromRGB(190, 110, 255),
	Color3.fromRGB(255, 150, 210),
}

function EffectsController.Init(all: any)
	controllers = all
	confettiGui = UIKit.New("ScreenGui", {
		Name = "Confetti",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 30,
		Parent = player:WaitForChild("PlayerGui"),
	})
end

-- Floating text in the world that rises and fades.
function EffectsController.WorldPopup(position: Vector3, text: string, color: Color3?, size: number?)
	local attachment = Instance.new("Attachment")
	attachment.WorldPosition = position
	attachment.Parent = workspace.Terrain

	local billboard = UIKit.New("BillboardGui", {
		Adornee = attachment,
		Size = UDim2.fromOffset(260, 70),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = 250,
		StudsOffsetWorldSpace = Vector3.zero,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local label = UIKit.Label({
		Text = text,
		TextSize = size or 40,
		TextColor3 = color or Theme.Colors.Money,
		Size = UDim2.fromScale(1, 1),
		Parent = billboard,
	})
	UIKit.TextStroke(3).Parent = label
	UIKit.PopIn(label, 0.3)
	UIKit.Tween(billboard, 1.6, { StudsOffsetWorldSpace = Vector3.new(0, 6, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	task.delay(1, function()
		UIKit.Tween(label, 0.6, { TextTransparency = 1 })
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			UIKit.Tween(stroke, 0.6, { Transparency = 1 })
		end
	end)
	Debris:AddItem(billboard, 1.8)
	Debris:AddItem(attachment, 1.8)
end

-- Particle burst at a world position.
function EffectsController.Burst(position: Vector3, color: Color3?, amount: number?)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(1, 1, 1)
	part.CFrame = CFrame.new(position)
	part.Parent = workspace

	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color or Theme.Colors.Yellow)
	emitter.LightEmission = 0.8
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.6, 1.2)
	emitter.Speed = NumberRange.new(12, 24)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Acceleration = Vector3.new(0, -25, 0)
	emitter.Drag = 2
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.8),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Parent = part
	emitter:Emit(amount or 40)
	Debris:AddItem(part, 2)
end

-- Screen confetti rain.
function EffectsController.Confetti(count: number?)
	local camera = workspace.CurrentCamera
	local width = if camera then camera.ViewportSize.X else 1280
	for _ = 1, count or 70 do
		local piece = UIKit.New("Frame", {
			Size = UDim2.fromOffset(math.random(8, 16), math.random(12, 22)),
			Position = UDim2.new(math.random(), 0, 0, -30 - math.random(0, 200)),
			Rotation = math.random(0, 360),
			BackgroundColor3 = CONFETTI_COLORS[math.random(1, #CONFETTI_COLORS)],
			BorderSizePixel = 0,
			Parent = confettiGui,
		})
		local duration = 1.6 + math.random() * 1.4
		local drift = (math.random() - 0.5) * width * 0.2
		UIKit.Tween(piece, duration, {
			Position = UDim2.new(piece.Position.X.Scale, drift, 1, 40),
			Rotation = piece.Rotation + math.random(-400, 400),
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(piece, duration + 0.1)
	end
end

function EffectsController.Shake(intensity: number?, duration: number?)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local strength = intensity or 0.4
	local endsAt = os.clock() + (duration or 0.4)
	local connection
	connection = RunService.RenderStepped:Connect(function()
		if os.clock() > endsAt or not humanoid.Parent then
			humanoid.CameraOffset = Vector3.zero
			connection:Disconnect()
			return
		end
		humanoid.CameraOffset = Vector3.new((math.random() - 0.5) * strength, (math.random() - 0.5) * strength, 0)
	end)
end

local function onEffect(effect: any)
	if type(effect) ~= "table" then
		return
	end
	local kind = effect.Type
	local position = effect.Position
	if kind == "Treated" then
		local rarity = Rarities.ById[effect.Rarity or "Common"]
		local big = effect.Manual or (rarity and rarity.Stars >= 2)
		local color = if rarity and rarity.Stars >= 2 then rarity.Color else Theme.Colors.Money
		if typeof(position) == "Vector3" then
			EffectsController.WorldPopup(position, "+" .. Format.Money(effect.Amount), color, if big then 46 else 34)
			if effect.Pharmacy and effect.Pharmacy > 0 then
				task.delay(0.35, function()
					EffectsController.WorldPopup(position + Vector3.new(1.5, -1, 0), "+" .. Format.Money(effect.Pharmacy) .. " 💊", Theme.Colors.Teal, 28)
				end)
			end
			if big then
				EffectsController.Burst(position, color, 25)
			end
		end
		controllers.SoundController.Play("Cash", 0.9 + math.random() * 0.25)
		controllers.HUDController.FlashMoney((effect.Amount or 0) + (effect.Pharmacy or 0))
	elseif kind == "HospitalUpgraded" then
		EffectsController.Confetti(110)
		EffectsController.Shake(0.6, 0.5)
		if typeof(position) == "Vector3" then
			EffectsController.Burst(position + Vector3.new(0, 12, 0), Theme.Colors.Yellow, 120)
		end
		controllers.SoundController.Play("Upgrade")
	elseif kind == "RoomUnlocked" then
		if typeof(position) == "Vector3" then
			EffectsController.Burst(position, Theme.Colors.Teal, 80)
			EffectsController.WorldPopup(position + Vector3.new(0, 4, 0), "✨ UNLOCKED! ✨", Theme.Colors.Yellow, 40)
		end
		EffectsController.Confetti(50)
		controllers.SoundController.Play("Upgrade")
	elseif kind == "DoctorHired" then
		if typeof(position) == "Vector3" then
			EffectsController.Burst(position, Theme.Colors.Blue, 60)
			EffectsController.WorldPopup(position + Vector3.new(0, 4, 0), "🤖 NEW DOCTOR!", Theme.Colors.Blue, 36)
		end
		controllers.SoundController.Play("Purchase")
	elseif kind == "DoctorLevelUp" then
		EffectsController.Confetti(80)
		controllers.SoundController.Play("LevelUp")
	elseif kind == "Improvement" then
		controllers.SoundController.Play("Purchase", 1.2)
	end
end

function EffectsController.Start()
	Remotes.Event("Effect").OnClientEvent:Connect(onEffect)
end

return EffectsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">GuideController</string>
              <string name="Source"><![CDATA[--[[
	GuideController
	A glowing trail from your character to a target plus a bouncing arrow
	above it. Used by the tutorial and the "GO!" button.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local UIKit = require(script.Parent.Parent.UI.UIKit)
local Theme = UIKit.Theme

local GuideController = {}

local player = Players.LocalPlayer
local current: { Target: Instance, Cleanup: () -> () }? = nil

local function targetPart(target: Instance): BasePart?
	if target:IsA("BasePart") then
		return target
	elseif target:IsA("Model") then
		return target.PrimaryPart or target:FindFirstChild("HumanoidRootPart") :: BasePart? or target:FindFirstChildWhichIsA("BasePart")
	end
	return nil
end

function GuideController.Clear()
	if current then
		current.Cleanup()
		current = nil
	end
end

function GuideController.GetTarget(): Instance?
	return current and current.Target
end

-- Points at `target` until cleared, the target disappears, or `duration` ends.
function GuideController.PointTo(target: Instance, duration: number?)
	if current and current.Target == target then
		return
	end
	GuideController.Clear()
	local part = targetPart(target)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not part or not root then
		return
	end

	local a0 = Instance.new("Attachment")
	a0.Name = "GuideStart"
	a0.Position = Vector3.new(0, -1.5, 0)
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Name = "GuideEnd"
	a1.Parent = part

	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Color = ColorSequence.new(Theme.Colors.Yellow)
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.Transparency = NumberSequence.new(0.15)
	beam.Width0 = 0.9
	beam.Width1 = 0.9
	beam.FaceCamera = true
	beam.Segments = 24
	beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	beam.TextureMode = Enum.TextureMode.Wrap
	beam.TextureLength = 2
	beam.TextureSpeed = 2
	beam.Parent = root

	local billboard = UIKit.New("BillboardGui", {
		Name = "GuideArrow",
		Adornee = part,
		Size = UDim2.fromOffset(80, 80),
		StudsOffset = Vector3.new(0, 5, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local arrow = UIKit.Label({
		Text = "⬇️",
		TextSize = 60,
		Size = UDim2.fromScale(1, 1),
		Parent = billboard,
	})

	local bounce = RunService.RenderStepped:Connect(function()
		arrow.Position = UDim2.fromOffset(0, math.sin(os.clock() * 6) * 8)
	end)

	local connections: { RBXScriptConnection } = { bounce }
	local function cleanup()
		for _, connection in connections do
			connection:Disconnect()
		end
		beam:Destroy()
		a0:Destroy()
		a1:Destroy()
		billboard:Destroy()
	end
	local handle = { Target = target, Cleanup = cleanup }
	current = handle

	table.insert(
		connections,
		target.AncestryChanged:Connect(function(_, parent)
			if parent == nil and current == handle then
				GuideController.Clear()
			end
		end)
	)
	table.insert(
		connections,
		root.AncestryChanged:Connect(function(_, parent)
			if parent == nil and current == handle then
				GuideController.Clear()
			end
		end)
	)
	if duration then
		task.delay(duration, function()
			if current == handle then
				GuideController.Clear()
			end
		end)
	end
end

function GuideController.Init() end

return GuideController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[--[[
	HUDController
	Always-visible UI:
	  top     - money, hospital level, patients treated, "next upgrade" goal bar
	  left    - SHOP / STATS / HOME buttons
	  bottom  - doctor level XP bar and combo streak
	  right   - "patients need you!" alert with a GO button
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local HospitalLevels = require(Shared:WaitForChild("Config"):WaitForChild("HospitalLevels"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local UIKit = require(script.Parent.Parent.UI.UIKit)
local Theme = UIKit.Theme

local HUDController = {}

local controllers: any = nil
local player = Players.LocalPlayer

local moneyLabel: TextLabel
local moneyFrame: Frame
local levelLabel: TextLabel
local treatedLabel: TextLabel
local goalFill: Frame
local goalLabel: TextLabel
local doctorLabel: TextLabel
local xpFill: Frame
local xpLabel: TextLabel
local comboLabel: TextLabel
local shopButton: TextButton
local shopBadge: TextLabel
local needsFrame: Frame
local needsLabel: TextLabel
local topContainer: Frame

local displayedMoney = 0
local targetMoney = 0
local needsTarget: Model? = nil

local function pill(parent: Instance, width: number, order: number): TextLabel
	local frame = UIKit.New("Frame", {
		Size = UDim2.fromOffset(width, 36),
		BackgroundColor3 = Theme.Colors.PanelDark,
		BackgroundTransparency = 0.1,
		LayoutOrder = order,
		Parent = parent,
	}, {
		UIKit.Corner(18),
		UIKit.Stroke(2, Theme.Colors.Stroke),
	})
	return UIKit.Label({
		Size = UDim2.new(1, -16, 1, 0),
		Position = UDim2.fromOffset(8, 0),
		TextSize = 19,
		Parent = frame,
	})
end

local function menuButton(parent: Instance, emoji: string, text: string, color: Color3, order: number, onClick: () -> ()): TextButton
	local holder = UIKit.New("Frame", {
		Size = UDim2.fromOffset(84, 98),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	})
	local button = UIKit.Button({
		Text = emoji,
		Color = color,
		Size = UDim2.fromOffset(76, 72),
		Position = UDim2.fromOffset(4, 0),
		TextSize = 38,
		Parent = holder,
		OnClick = onClick,
	})
	local label = UIKit.Label({
		Text = text,
		TextSize = 20,
		Size = UDim2.new(1, 0, 0, 24),
		Position = UDim2.fromOffset(0, 74),
		Parent = holder,
	})
	UIKit.TextStroke(2).Parent = label
	return button
end

function HUDController.Init(all: any)
	controllers = all
	local gui = UIKit.New("ScreenGui", {
		Name = "HUD",
		ResetOnSpawn = false,
		DisplayOrder = 1,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})

	-- Top: money + stats + goal ------------------------------------------------
	topContainer = UIKit.New("Frame", {
		Name = "Top",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 4),
		Size = UDim2.fromOffset(560, 160),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	UIKit.Scaled(topContainer)

	moneyFrame = UIKit.New("Frame", {
		Name = "Money",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(310, 62),
		BackgroundColor3 = Theme.Colors.PanelDark,
		Parent = topContainer,
	}, {
		UIKit.Corner(31),
		UIKit.Stroke(4, Theme.Colors.Stroke),
	})
	UIKit.Label({
		Text = "💵",
		TextSize = 40,
		Size = UDim2.fromOffset(60, 62),
		Position = UDim2.fromOffset(6, 0),
		Parent = moneyFrame,
	})
	moneyLabel = UIKit.Label({
		Text = "$0",
		TextSize = 42,
		TextColor3 = Theme.Colors.Money,
		Size = UDim2.new(1, -76, 1, 0),
		Position = UDim2.fromOffset(62, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = moneyFrame,
	})
	UIKit.TextStroke(3).Parent = moneyLabel

	local row = UIKit.New("Frame", {
		Name = "Row",
		Position = UDim2.fromOffset(0, 68),
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundTransparency = 1,
		Parent = topContainer,
	}, {
		UIKit.List(Enum.FillDirection.Horizontal, 8),
	})
	levelLabel = pill(row, 300, 1)
	treatedLabel = pill(row, 190, 2)

	local goalButton = UIKit.New("TextButton", {
		Name = "Goal",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 110),
		Size = UDim2.fromOffset(420, 34),
		BackgroundColor3 = Theme.Colors.PanelDark,
		AutoButtonColor = false,
		Text = "",
		Parent = topContainer,
	}, {
		UIKit.Corner(17),
		UIKit.Stroke(3, Theme.Colors.Stroke),
	})
	goalFill = UIKit.New("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = goalButton,
	}, {
		UIKit.Corner(17),
		UIKit.Gradient(Theme.Colors.Green, Theme.Colors.GreenDark),
	})
	goalLabel = UIKit.Label({
		Text = "",
		TextSize = 18,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
		Parent = goalButton,
	})
	UIKit.TextStroke(2).Parent = goalLabel
	goalButton.Activated:Connect(function()
		controllers.ShopController.Open("Hospital")
	end)

	-- Left menu --------------------------------------------------------------------
	local menu = UIKit.New("Frame", {
		Name = "Menu",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(90, 320),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UIKit.List(Enum.FillDirection.Vertical, 4),
	})
	UIKit.Scaled(menu)
	shopButton = menuButton(menu, "🛒", "SHOP", Theme.Colors.Yellow, 1, function()
		controllers.ShopController.Toggle()
	end)
	shopBadge = UIKit.Label({
		Name = "Badge",
		Text = "!",
		TextSize = 22,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -4, 0, 4),
		Size = UDim2.fromOffset(30, 30),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Colors.Red,
		ZIndex = 5,
		Visible = false,
		Parent = shopButton,
	})
	UIKit.Corner(15).Parent = shopBadge
	UIKit.Stroke(2, Theme.Colors.Stroke).Parent = shopBadge
	menuButton(menu, "📊", "STATS", Theme.Colors.Blue, 2, function()
		controllers.StatsController.Toggle()
	end)
	menuButton(menu, "🏠", "HOME", Theme.Colors.Green, 3, function()
		Remotes.Event("TeleportHome"):FireServer()
	end)

	-- Bottom: doctor level ------------------------------------------------------------
	local bottom = UIKit.New("Frame", {
		Name = "Doctor",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.fromOffset(460, 60),
		BackgroundColor3 = Theme.Colors.PanelDark,
		BackgroundTransparency = 0.1,
		Parent = gui,
	}, {
		UIKit.Corner(16),
		UIKit.Stroke(3, Theme.Colors.Stroke),
	})
	UIKit.Scaled(bottom)
	doctorLabel = UIKit.Label({
		Text = "🥼 Dr. Lv 1",
		TextSize = 22,
		Size = UDim2.fromOffset(150, 60),
		Position = UDim2.fromOffset(10, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = bottom,
	})
	local xpBar = UIKit.New("Frame", {
		Position = UDim2.fromOffset(160, 16),
		Size = UDim2.fromOffset(200, 28),
		BackgroundColor3 = Color3.fromRGB(20, 24, 40),
		Parent = bottom,
	}, {
		UIKit.Corner(14),
	})
	xpFill = UIKit.New("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = xpBar,
	}, {
		UIKit.Corner(14),
		UIKit.Gradient(Theme.Colors.Purple, Theme.Colors.Blue, 0),
	})
	xpLabel = UIKit.Label({
		Text = "0 / 50 XP",
		TextSize = 16,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
		Parent = xpBar,
	})
	UIKit.TextStroke(2).Parent = xpLabel
	comboLabel = UIKit.Label({
		Text = "",
		TextSize = 24,
		TextColor3 = Theme.Colors.Orange,
		Size = UDim2.fromOffset(90, 60),
		Position = UDim2.fromOffset(366, 0),
		Parent = bottom,
	})
	UIKit.TextStroke(2).Parent = comboLabel

	-- Right: patients need you -----------------------------------------------------------
	needsFrame = UIKit.New("Frame", {
		Name = "NeedsYou",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.42, 0),
		Size = UDim2.fromOffset(230, 110),
		BackgroundColor3 = Theme.Colors.PanelDark,
		Visible = false,
		Parent = gui,
	}, {
		UIKit.Corner(16),
		UIKit.Stroke(4, Theme.Colors.Yellow),
	})
	UIKit.Scaled(needsFrame)
	needsLabel = UIKit.Label({
		Text = "",
		TextSize = 20,
		TextWrapped = true,
		Size = UDim2.new(1, -16, 0, 50),
		Position = UDim2.fromOffset(8, 4),
		Parent = needsFrame,
	})
	UIKit.Button({
		Text = "GO! ➜",
		Color = Theme.Colors.Yellow,
		Size = UDim2.fromOffset(150, 44),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 56),
		Parent = needsFrame,
		OnClick = function()
			if needsTarget then
				controllers.GuideController.PointTo(needsTarget, 12)
			end
		end,
	})
end

function HUDController.FlashMoney(amount: number)
	if amount <= 0 then
		return
	end
	UIKit.Bounce(moneyFrame, 1.08)
	local gain = UIKit.Label({
		Text = "+" .. Format.Money(amount),
		TextSize = 30,
		TextColor3 = Theme.Colors.Money,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(1, 8, 0.5, 0),
		Size = UDim2.fromOffset(160, 40),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = moneyFrame,
	})
	UIKit.TextStroke(2).Parent = gain
	UIKit.Tween(gain, 1, { Position = UDim2.new(1, 8, 0.5, -40), TextTransparency = 1 })
	task.delay(1.05, function()
		gain:Destroy()
	end)
end

local function updateGoal(state: any)
	local nextLevel = HospitalLevels.GetNext(state.HospitalLevel)
	if not nextLevel then
		goalFill.Size = UDim2.fromScale(1, 1)
		goalLabel.Text = "🏆 MAX HOSPITAL LEVEL!"
		return
	end
	local progress = math.clamp(state.Money / nextLevel.Cost, 0, 1)
	UIKit.Tween(goalFill, 0.3, { Size = UDim2.fromScale(math.max(progress, 0.04), 1) })
	if progress >= 1 then
		goalLabel.Text = string.format("✨ %s READY! Tap to upgrade ✨", nextLevel.Name)
	else
		goalLabel.Text = string.format("Next: %s  %s / %s", nextLevel.Name, Format.Money(state.Money), Format.Money(nextLevel.Cost))
	end
end

function HUDController.Update(state: any)
	targetMoney = state.Money
	local level = HospitalLevels.Get(state.HospitalLevel)
	levelLabel.Text = string.format("🏥 Lv.%d · %s", level.Level, level.Name)
	treatedLabel.Text = string.format("🩺 %s treated", Format.Short(state.PatientsTreated))
	doctorLabel.Text = string.format("🥼 Dr. Lv %d", state.DoctorLevel)
	local xpProgress = if state.DoctorXPNeeded > 0 then state.DoctorXP / state.DoctorXPNeeded else 1
	UIKit.Tween(xpFill, 0.3, { Size = UDim2.fromScale(math.clamp(xpProgress, 0.03, 1), 1) })
	xpLabel.Text = if state.DoctorXPNeeded > 0 then string.format("%d / %d XP", state.DoctorXP, state.DoctorXPNeeded) else "MAX LEVEL"
	if state.Combo and state.Combo >= 2 then
		comboLabel.Text = "🔥 x" .. state.Combo
	else
		comboLabel.Text = ""
	end
	updateGoal(state)

	local affordable = controllers.ShopController.CountAffordable(state)
	shopBadge.Visible = affordable > 0
	shopBadge.Text = tostring(affordable)
end

function HUDController.SetNeedsYou(count: number, target: Model?)
	needsTarget = target
	if count > 0 then
		if not needsFrame.Visible then
			needsFrame.Visible = true
			UIKit.PopIn(needsFrame)
		end
		needsLabel.Text = if count == 1 then "🔔 1 patient needs you!" else string.format("🔔 %d patients need you!", count)
	else
		needsFrame.Visible = false
	end
end

function HUDController.GetShopButton(): TextButton
	return shopButton
end

function HUDController.Start()
	controllers.ClientState.Changed:Connect(function(state)
		HUDController.Update(state)
	end)
	if controllers.ClientState.Get() then
		HUDController.Update(controllers.ClientState.Get())
	end

	-- Smooth money counter
	task.spawn(function()
		while true do
			local dt = task.wait(1 / 30)
			if displayedMoney ~= targetMoney then
				local diff = targetMoney - displayedMoney
				local step = diff * math.min(1, dt * 8)
				if math.abs(diff) < 1 or math.abs(step) < 0.5 then
					displayedMoney = targetMoney
				else
					displayedMoney += step
				end
				moneyLabel.Text = Format.Money(math.floor(displayedMoney + 0.5))
			end
		end
	end)
end

return HUDController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">NotificationController</string>
              <string name="Source"><![CDATA[--[[
	NotificationController
	Small toasts (stacked under the HUD) and big centre banners for exciting
	moments (rare patients, upgrades, level ups).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local UIKit = require(script.Parent.Parent.UI.UIKit)
local Theme = UIKit.Theme

local NotificationController = {}

local controllers: any = nil
local toastHolder: Frame
local bannerHolder: Frame
local bannerQueue = {}
local bannerBusy = false

local STYLE_COLORS = {
	Info = Theme.Colors.Blue,
	Success = Theme.Colors.Green,
	Error = Theme.Colors.Red,
	Rare = Theme.Colors.Purple,
	Big = Theme.Colors.Yellow,
}

function NotificationController.Init(all: any)
	controllers = all
	local gui = UIKit.New("ScreenGui", {
		Name = "Notifications",
		ResetOnSpawn = false,
		DisplayOrder = 20,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})

	toastHolder = UIKit.New("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 168),
		Size = UDim2.fromOffset(520, 300),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UIKit.List(Enum.FillDirection.Vertical, 6),
	})
	UIKit.Scaled(toastHolder)

	bannerHolder = UIKit.New("Frame", {
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(640, 150),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	UIKit.Scaled(bannerHolder)
end

function NotificationController.Toast(text: string, style: string?)
	local color = STYLE_COLORS[style or "Info"] or Theme.Colors.Blue
	local toast = UIKit.New("Frame", {
		Size = UDim2.fromOffset(500, 44),
		BackgroundColor3 = Theme.Colors.PanelDark,
		BackgroundTransparency = 0.05,
		LayoutOrder = math.floor(os.clock() * 100),
		Parent = toastHolder,
	}, {
		UIKit.Corner(12),
		UIKit.Stroke(3, color),
	})
	local label = UIKit.Label({
		Text = text,
		TextSize = 19,
		TextWrapped = true,
		Size = UDim2.new(1, -20, 1, 0),
		Position = UDim2.fromOffset(10, 0),
		Parent = toast,
	})
	-- Grow for long text
	if #text > 52 then
		toast.Size = UDim2.fromOffset(500, 66)
	end
	UIKit.PopIn(toast, 0.25)

	local children = {}
	for _, child in toastHolder:GetChildren() do
		if child:IsA("Frame") then
			table.insert(children, child)
		end
	end
	if #children > 4 then
		table.sort(children, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		children[1]:Destroy()
	end

	task.delay(4, function()
		if toast.Parent then
			UIKit.Tween(toast, 0.3, { BackgroundTransparency = 1 })
			UIKit.Tween(label, 0.3, { TextTransparency = 1 })
			local stroke = toast:FindFirstChildOfClass("UIStroke")
			if stroke then
				UIKit.Tween(stroke, 0.3, { Transparency = 1 })
			end
			task.wait(0.35)
			toast:Destroy()
		end
	end)
end

local function showNextBanner()
	if bannerBusy or #bannerQueue == 0 then
		return
	end
	bannerBusy = true
	local notice = table.remove(bannerQueue, 1)
	local color = notice.Color or STYLE_COLORS[notice.Style or "Big"] or Theme.Colors.Yellow

	local frame = UIKit.New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(620, 130),
		BackgroundColor3 = Theme.Colors.PanelDark,
		Parent = bannerHolder,
	}, {
		UIKit.Corner(22),
		UIKit.Stroke(5, color),
	})
	local title = UIKit.Label({
		Text = notice.Title or "",
		TextSize = 44,
		TextColor3 = color,
		Size = UDim2.new(1, -20, 0, 60),
		Position = UDim2.fromOffset(10, 8),
		Parent = frame,
	})
	UIKit.TextStroke(3).Parent = title
	UIKit.Label({
		Text = notice.Text or "",
		TextSize = 21,
		TextWrapped = true,
		Size = UDim2.new(1, -40, 0, 54),
		Position = UDim2.fromOffset(20, 66),
		Parent = frame,
	})
	UIKit.PopIn(frame, 0.45)
	if notice.Style == "Rare" then
		controllers.SoundController.Play("Rare")
	end

	task.delay(3.2, function()
		UIKit.Tween(frame, 0.35, { Position = UDim2.fromScale(0.5, -0.6) }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.wait(0.4)
		frame:Destroy()
		bannerBusy = false
		showNextBanner()
	end)
end

function NotificationController.Banner(notice: { [string]: any })
	table.insert(bannerQueue, notice)
	if #bannerQueue > 3 then
		table.remove(bannerQueue, 1)
	end
	showNextBanner()
end

function NotificationController.Start()
	Remotes.Event("Notify").OnClientEvent:Connect(function(notice: any)
		if type(notice) ~= "table" then
			return
		end
		if notice.Style == "Rare" or notice.Style == "Big" then
			NotificationController.Banner(notice)
		else
			NotificationController.Toast(notice.Text or notice.Title or "", notice.Style)
		end
	end)
end

return NotificationController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">PatientVisualsController</string>
              <string name="Source"><![CDATA[--[[
	PatientVisualsController
	Builds name/status billboards for patients, Auto Doctors and staff on
	every hospital (purely client-side, driven by model attributes), animates
	the "examining" progress bars, and tells the HUD how many of *your*
	patients are waiting for you.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local AutoDoctors = require(Config:WaitForChild("AutoDoctors"))
local Rarities = require(Config:WaitForChild("Rarities"))
local UIKit = require(script.Parent.Parent.UI.UIKit)
local Theme = UIKit.Theme

local PatientVisualsController = {}

local controllers: any = nil
local player = Players.LocalPlayer

type Entry = {
	Model: Model,
	Billboard: BillboardGui,
	Status: TextLabel,
	Bar: Frame?,
	Fill: Frame?,
	Own: boolean,
	IsPatient: boolean,
}

local entries: { [Model]: Entry } = {}

local STATUS_TEXT = {
	Arriving = "🚶 Arriving",
	ToSeat = "🚶 Arriving",
	CheckingIn = "📋 Checking in",
	Waiting = "🪑 Waiting",
	ToExam = "🚶 Going to exam room",
	NeedsDoctor = "❓ Needs a doctor!",
	Examining = "🩺 Being examined",
	BeingDiagnosed = "🩺 With the doctor",
	Treated = "✅ Treated!",
	Leaving = "😊 Feeling better!",
}

local KIND_PREFIX = {
	Emergency = "🚨 ",
	VIP = "👑 ",
	Child = "🧸 ",
}

local function makeBillboard(model: Model, height: number, width: number, offsetY: number): (BillboardGui?, BasePart?)
	local head = model:WaitForChild("Head", 5)
	if not head or not head:IsA("BasePart") then
		return nil, nil
	end
	local billboard = UIKit.New("BillboardGui", {
		Name = "Info",
		Size = UDim2.fromOffset(width, height),
		StudsOffset = Vector3.new(0, offsetY, 0),
		AlwaysOnTop = false,
		LightInfluence = 0,
		MaxDistance = 85,
		ResetOnSpawn = false,
		Parent = head,
	})
	return billboard, head
end

local function updatePatient(entry: Entry)
	local model = entry.Model
	local status = model:GetAttribute("Status") or "Arriving"
	local text = STATUS_TEXT[status] or status
	if status == "NeedsDoctor" then
		text = if entry.Own then "❓ Needs YOU! Press E" else "❓ Waiting for doctor"
		entry.Status.TextColor3 = Theme.Colors.Yellow
	elseif status == "Treated" or status == "Leaving" then
		entry.Status.TextColor3 = Theme.Colors.Money
	else
		entry.Status.TextColor3 = Theme.Colors.White
	end
	entry.Status.Text = text
	if entry.Bar then
		local hasProgress = model:GetAttribute("ProgressDuration") ~= nil and (status == "Examining" or status == "BeingDiagnosed")
		entry.Bar.Visible = hasProgress
	end
end

local function trackPatient(model: Model)
	if entries[model] then
		return
	end
	local billboard = makeBillboard(model, 78, 230, 2.8)
	if not billboard or not model.Parent then
		if billboard then
			billboard:Destroy()
		end
		return
	end
	local rarity = Rarities.ById[model:GetAttribute("Rarity") or "Common"] or Rarities.List[1]
	local kind = model:GetAttribute("Kind") or "Normal"
	local name = UIKit.Label({
		Text = (KIND_PREFIX[kind] or "") .. string.rep("⭐", rarity.Stars) .. (if rarity.Stars > 0 then " " else "") .. tostring(model:GetAttribute("PatientName") or "Patient"),
		TextSize = 20,
		TextColor3 = rarity.Color,
		Size = UDim2.new(1, 0, 0, 24),
		Parent = billboard,
	})
	UIKit.TextStroke(2).Parent = name
	local status = UIKit.Label({
		Text = "",
		TextSize = 17,
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.fromOffset(0, 24),
		Parent = billboard,
	})
	UIKit.TextStroke(2).Parent = status
	local bar = UIKit.New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 52),
		Size = UDim2.fromOffset(140, 14),
		BackgroundColor3 = Color3.fromRGB(25, 30, 45),
		Visible = false,
		Parent = billboard,
	}, {
		UIKit.Corner(7),
		UIKit.Stroke(2, Theme.Colors.Stroke),
	})
	local fill = UIKit.New("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Colors.Green,
		Parent = bar,
	}, {
		UIKit.Corner(7),
	})

	local entry: Entry = {
		Model = model,
		Billboard = billboard,
		Status = status,
		Bar = bar,
		Fill = fill,
		Own = model:GetAttribute("OwnerUserId") == player.UserId,
		IsPatient = true,
	}
	entries[model] = entry
	updatePatient(entry)
	model.AttributeChanged:Connect(function()
		updatePatient(entry)
	end)
end

local function updateDoctor(entry: Entry)
	local model = entry.Model
	local tierInfo = AutoDoctors.Tiers[model:GetAttribute("Tier") or 1] or AutoDoctors.Tiers[1]
	local status = model:GetAttribute("Status")
	entry.Status.Text = if status == "Examining" then "🩺 Examining..." else "💤 Ready for patients"
	entry.Status.TextColor3 = if status == "Examining" then Theme.Colors.Money else Theme.Colors.White
	local nameLabel = entry.Billboard:FindFirstChild("DoctorName") :: TextLabel?
	if nameLabel then
		nameLabel.Text = (if tierInfo.Robot then "🤖 " else "🥼 ") .. tierInfo.Name
		nameLabel.TextColor3 = tierInfo.Accent
	end
end

local function trackDoctor(model: Model)
	if entries[model] then
		return
	end
	local billboard = makeBillboard(model, 50, 230, 2.6)
	if not billboard then
		return
	end
	local name = UIKit.Label({
		Name = "DoctorName",
		Text = "",
		TextSize = 19,
		Size = UDim2.new(1, 0, 0, 24),
		Parent = billboard,
	})
	UIKit.TextStroke(2).Parent = name
	local status = UIKit.Label({
		Text = "",
		TextSize = 15,
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.fromOffset(0, 24),
		Parent = billboard,
	})
	UIKit.TextStroke(2).Parent = status
	local entry: Entry = {
		Model = model,
		Billboard = billboard,
		Status = status,
		Bar = nil,
		Fill = nil,
		Own = model:GetAttribute("OwnerUserId") == player.UserId,
		IsPatient = false,
	}
	entries[model] = entry
	updateDoctor(entry)
	model.AttributeChanged:Connect(function()
		updateDoctor(entry)
	end)
end

local function trackStaff(model: Model)
	local billboard = makeBillboard(model, 26, 200, 2.4)
	if not billboard then
		return
	end
	billboard.MaxDistance = 50
	local label = UIKit.Label({
		Text = tostring(model:GetAttribute("StaffName") or "Staff"),
		TextSize = 17,
		TextColor3 = Color3.fromRGB(255, 200, 230),
		Size = UDim2.fromScale(1, 1),
		Parent = billboard,
	})
	UIKit.TextStroke(2).Parent = label
end

local function untrack(model: Instance)
	local entry = entries[model :: Model]
	if entry then
		entries[model :: Model] = nil
		entry.Billboard:Destroy()
	end
end

local function listen(tag: string, callback: (Model) -> ())
	CollectionService:GetInstanceAddedSignal(tag):Connect(function(instance)
		if instance:IsA("Model") then
			task.spawn(callback, instance)
		end
	end)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(untrack)
	for _, instance in CollectionService:GetTagged(tag) do
		if instance:IsA("Model") then
			task.spawn(callback, instance)
		end
	end
end

function PatientVisualsController.Init(all: any)
	controllers = all
end

-- Returns your patients that are lying in an exam room waiting for you.
function PatientVisualsController.GetWaitingForMe(): { Model }
	local result = {}
	for model, entry in entries do
		if entry.IsPatient and entry.Own and model:GetAttribute("Status") == "NeedsDoctor" then
			table.insert(result, model)
		end
	end
	return result
end

function PatientVisualsController.GetMyPatients(): { Model }
	local result = {}
	for model, entry in entries do
		if entry.IsPatient and entry.Own then
			table.insert(result, model)
		end
	end
	return result
end

function PatientVisualsController.Start()
	listen("Patient", trackPatient)
	listen("AutoDoctor", trackDoctor)
	listen("Staff", trackStaff)

	-- Progress bars
	RunService.Heartbeat:Connect(function()
		local now = workspace:GetServerTimeNow()
		for model, entry in entries do
			if entry.Bar and entry.Bar.Visible and entry.Fill then
				local duration = model:GetAttribute("ProgressDuration")
				local start = model:GetAttribute("ProgressStart")
				if typeof(duration) == "number" and typeof(start) == "number" and duration > 0 then
					local fraction
					if model:GetAttribute("ProgressPaused") then
						fraction = model:GetAttribute("ProgressFrozen") or 0
					else
						fraction = (now - start) / duration
					end
					entry.Fill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
				end
			end
		end
	end)

	-- "Patients need you" alert
	task.spawn(function()
		while true do
			task.wait(0.5)
			local waiting = PatientVisualsController.GetWaitingForMe()
			local nearest: Model? = nil
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local best = math.huge
				for _, model in waiting do
					local distance = (model:GetPivot().Position - root.Position).Magnitude
					if distance < best then
						best = distance
						nearest = model
					end
				end
			end
			controllers.HUDController.SetNeedsYou(#waiting, nearest)
		end
	end)
end

return PatientVisualsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">ShopController</string>
              <string name="Source"><![CDATA[--[[
	ShopController
	The upgrade shop: Hospital levels, special Rooms, Auto Doctors and Boosts.
	Prices are computed with the shared Economy module for display; the
	server re-validates every purchase.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local AutoDoctors = require(Config:WaitForChild("AutoDoctors"))
local HospitalLevels = require(Config:WaitForChild("HospitalLevels"))
local Improvements = require(Config:WaitForChild("Improvements"))
local Rooms = require(Config:WaitForChild("Rooms"))
local Economy = require(Shared:WaitForChild("Economy"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local Signal = require(Shared:WaitForChild("Util"):WaitForChild("Signal"))
local UIKit = require(script.Parent.Parent.UI.UIKit)
local Theme = UIKit.Theme

local ShopController = {}
ShopController.Opened = Signal.new()

local controllers: any = nil
local panel: Frame
local list: ScrollingFrame
local tabButtons: { [string]: TextButton } = {}
local currentTab = "Hospital"
local isOpen = false
local busy = false

local TABS = {
	{ Id = "Hospital", Text = "🏥 Hospital", Color = Theme.Colors.Blue },
	{ Id = "Rooms", Text = "🚪 Rooms", Color = Theme.Colors.Teal },
	{ Id = "Doctors", Text = "🤖 Doctors", Color = Theme.Colors.Purple },
	{ Id = "Boosts", Text = "📈 Boosts", Color = Theme.Colors.Orange },
}

-- What can be bought right now (used for the HUD badge) ---------------------------
type Offer = { Cost: number, Available: boolean }

local function collectOffers(state: any): { Offer }
	local offers = {}
	local nextLevel = HospitalLevels.GetNext(state.HospitalLevel)
	if nextLevel then
		table.insert(offers, { Cost = nextLevel.Cost, Available = true })
	end
	for _, room in Rooms.List do
		if not state.Rooms[room.Id] then
			table.insert(offers, { Cost = room.Cost, Available = state.HospitalLevel >= room.RequiredLevel })
		end
	end
	local level = HospitalLevels.Get(state.HospitalLevel)
	if #state.Doctors < level.ExamRooms then
		table.insert(offers, { Cost = Economy.HireCost(#state.Doctors), Available = true })
	end
	for _, tier in state.Doctors do
		local nextTier = AutoDoctors.Tiers[tier + 1]
		if nextTier then
			table.insert(offers, { Cost = nextTier.UpgradeCost, Available = state.HospitalLevel >= nextTier.RequiredLevel })
		end
	end
	for _, item in Improvements.List do
		local cost = Economy.ImprovementCost(item.Id, Economy.ImprovementLevel(state, item.Id))
		if cost then
			table.insert(offers, { Cost = cost, Available = true })
		end
	end
	return offers
end

function ShopController.CountAffordable(state: any): number
	local count = 0
	for _, offer in collectOffers(state) do
		if offer.Available and offer.Cost <= state.Money then
			count += 1
		end
	end
	return count
end

-- Purchasing ---------------------------------------------------------------------------

local function purchase(kind: string, arg: any, card: Frame?)
	if busy then
		return
	end
	busy = true
	task.spawn(function()
		local ok, result = pcall(function()
			return Remotes.Function("Purchase"):InvokeServer(kind, arg)
		end)
		busy = false
		if not ok or type(result) ~= "table" then
			controllers.NotificationController.Toast("Purchase failed, try again!", "Error")
			return
		end
		if result.Ok then
			if card then
				UIKit.Bounce(card, 1.05)
			end
		else
			controllers.SoundController.Play("Wrong")
			controllers.NotificationController.Toast(result.Message or "Can't buy that yet", "Error")
			if card then
				UIKit.Shake(card)
			end
		end
	end)
end

-- Card building --------------------------------------------------------------------------

type CardSpec = {
	Emoji: string,
	Title: string,
	Description: string,
	ButtonText: string?,
	ButtonColor: Color3?,
	Cost: number?,
	Money: number,
	Disabled: boolean?,
	Highlight: Color3?,
	Height: number?,
	OnBuy: ((card: Frame) -> ())?,
}

local function clearList()
	for _, child in list:GetChildren() do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

local cardOrder = 0

local function addCard(spec: CardSpec): Frame
	cardOrder += 1
	local height = spec.Height or 104
	local card = UIKit.New("Frame", {
		Size = UDim2.new(1, -16, 0, height),
		BackgroundColor3 = Theme.Colors.White,
		LayoutOrder = cardOrder,
		Parent = list,
	}, {
		UIKit.Corner(16),
		UIKit.Stroke(3, spec.Highlight or Theme.Colors.PanelAlt:Lerp(Theme.Colors.Stroke, 0.25)),
	})
	local iconBack = UIKit.New("Frame", {
		Size = UDim2.fromOffset(78, 78),
		Position = UDim2.new(0, 12, 0.5, -39),
		BackgroundColor3 = Theme.Colors.PanelAlt,
		Parent = card,
	}, {
		UIKit.Corner(39),
	})
	UIKit.Label({ Text = spec.Emoji, TextSize = 44, Size = UDim2.fromScale(1, 1), Parent = iconBack })

	local hasButton = spec.ButtonText ~= nil
	local textWidth = if hasButton then -310 else -120
	UIKit.Label({
		Text = spec.Title,
		TextSize = 25,
		TextColor3 = Theme.Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, textWidth, 0, 30),
		Position = UDim2.fromOffset(104, 10),
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = card,
	})
	UIKit.Label({
		Text = spec.Description,
		Font = Theme.BodyFont,
		TextSize = 15,
		TextColor3 = Theme.Colors.TextMuted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		Size = UDim2.new(1, textWidth, 1, -46),
		Position = UDim2.fromOffset(104, 42),
		Parent = card,
	})

	if hasButton then
		local affordable = spec.Cost == nil or spec.Money >= spec.Cost
		local color = spec.ButtonColor or Theme.Colors.Green
		if spec.Disabled then
			color = Theme.Colors.Gray
		elseif not affordable then
			color = Theme.Colors.GrayDark
		end
		local button = UIKit.Button({
			Text = spec.ButtonText :: string,
			Color = color,
			Size = UDim2.fromOffset(190, 68),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			TextSize = 22,
			Parent = card,
			OnClick = function()
				if not spec.Disabled and spec.OnBuy then
					spec.OnBuy(card)
				end
			end,
		})
		if spec.Cost and not spec.Disabled and not affordable then
			UIKit.Label({
				Text = "Need " .. Format.Money(spec.Cost - spec.Money) .. " more",
				Font = Theme.BodyFont,
				TextSize = 13,
				TextColor3 = Theme.Colors.Red,
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 1, 2),
				Size = UDim2.new(1, 0, 0, 14),
				Parent = button,
			})
		end
	end
	return card
end

local function header(text: string)
	cardOrder += 1
	UIKit.Label({
		Text = text,
		TextSize = 20,
		TextColor3 = Theme.Colors.Text,
		TextWrapped = true,
		Size = UDim2.new(1, -16, 0, 44),
		LayoutOrder = cardOrder,
		Parent = list,
	})
end

-- Tabs ----------------------------------------------------------------------------------------

local function renderHospital(state: any)
	local current = HospitalLevels.Get(state.HospitalLevel)
	local nextLevel = HospitalLevels.GetNext(state.HospitalLevel)
	addCard({
		Emoji = "🏥",
		Title = string.format("Current: Lv.%d %s", current.Level, current.Name),
		Description = table.concat(current.Perks, " • "),
		Money = state.Money,
		Highlight = Theme.Colors.Blue,
	})
	if nextLevel then
		addCard({
			Emoji = "⬆️",
			Title = string.format("Lv.%d %s", nextLevel.Level, nextLevel.Name),
			Description = table.concat(nextLevel.Perks, " • "),
			ButtonText = "UPGRADE\n" .. Format.Money(nextLevel.Cost),
			ButtonColor = Theme.Colors.Green,
			Cost = nextLevel.Cost,
			Money = state.Money,
			Highlight = Theme.Colors.Yellow,
			Height = 120,
			OnBuy = function(card)
				purchase("HospitalLevel", nil, card)
			end,
		})
		local after = HospitalLevels.GetNext(nextLevel.Level)
		if after then
			addCard({
				Emoji = "🔭",
				Title = string.format("Then: Lv.%d %s", after.Level, after.Name),
				Description = "Costs " .. Format.Money(after.Cost) .. ". Keep growing your hospital!",
				Money = state.Money,
			})
		end
	else
		addCard({
			Emoji = "🏆",
			Title = "Max level reached!",
			Description = "Your hospital is legendary. Fill it with the best doctors and rooms!",
			Money = state.Money,
		})
	end
end

local function renderRooms(state: any)
	header("Special rooms give your hospital permanent bonuses ✨")
	for _, room in Rooms.List do
		local owned = state.Rooms[room.Id] == true
		local locked = state.HospitalLevel < room.RequiredLevel
		local buttonText
		if owned then
			buttonText = "OWNED ✔"
		elseif locked then
			buttonText = "🔒 Hospital\nLv." .. room.RequiredLevel
		else
			buttonText = "UNLOCK\n" .. Format.Money(room.Cost)
		end
		addCard({
			Emoji = room.Emoji,
			Title = room.Name,
			Description = room.Benefit,
			ButtonText = buttonText,
			ButtonColor = if owned then Theme.Colors.Green else Theme.Colors.Teal,
			Cost = if owned or locked then nil else room.Cost,
			Money = state.Money,
			Disabled = owned or locked,
			Highlight = if owned then room.Color else nil,
			OnBuy = function(card)
				purchase("Room", room.Id, card)
			end,
		})
	end
end

local function renderDoctors(state: any)
	local level = HospitalLevels.Get(state.HospitalLevel)
	local owned = #state.Doctors
	header(string.format("🤖 Auto Doctors treat patients for you! (%d / %d exam rooms staffed)", owned, level.ExamRooms))
	local firstTier = AutoDoctors.Tiers[1]
	if owned < level.ExamRooms then
		local cost = Economy.HireCost(owned)
		addCard({
			Emoji = "🥼",
			Title = "Hire " .. firstTier.Name,
			Description = string.format("Works in Exam Room %d. Treats 1 patient every %ss, forever.", owned + 1, tostring(firstTier.TreatTime)),
			ButtonText = "HIRE\n" .. Format.Money(cost),
			ButtonColor = Theme.Colors.Purple,
			Cost = cost,
			Money = state.Money,
			Highlight = Theme.Colors.Purple,
			OnBuy = function(card)
				purchase("HireDoctor", nil, card)
			end,
		})
	else
		addCard({
			Emoji = "🏗️",
			Title = "All exam rooms are staffed",
			Description = "Upgrade your hospital to build more exam rooms and hire more doctors.",
			Money = state.Money,
		})
	end
	for slot, tier in state.Doctors do
		local info = AutoDoctors.Tiers[tier]
		local nextTier = AutoDoctors.Tiers[tier + 1]
		local buttonText, cost, disabled
		if not nextTier then
			buttonText = "MAX ⭐"
			disabled = true
		elseif state.HospitalLevel < nextTier.RequiredLevel then
			buttonText = "🔒 Hospital\nLv." .. nextTier.RequiredLevel
			disabled = true
		else
			buttonText = "UPGRADE\n" .. Format.Money(nextTier.UpgradeCost)
			cost = nextTier.UpgradeCost
		end
		local description = string.format("Treats 1 patient every %ss.", tostring(info.TreatTime))
		if nextTier then
			description ..= string.format(" Next: %s (%ss)", nextTier.Name, tostring(nextTier.TreatTime))
		end
		addCard({
			Emoji = if info.Robot then "🤖" else "🩺",
			Title = string.format("Room %d · %s", slot, info.Name),
			Description = description,
			ButtonText = buttonText,
			ButtonColor = Theme.Colors.Blue,
			Cost = cost,
			Money = state.Money,
			Disabled = disabled,
			OnBuy = function(card)
				purchase("UpgradeDoctor", slot, card)
			end,
		})
	end
end

local function renderBoosts(state: any)
	header("Boosts stack up: buy them again and again! 📈")
	for _, item in Improvements.List do
		local current = Economy.ImprovementLevel(state, item.Id)
		local cost = Economy.ImprovementCost(item.Id, current)
		addCard({
			Emoji = item.Emoji,
			Title = string.format("%s  (Lv %d/%d)", item.Name, current, item.MaxLevel),
			Description = item.Description,
			ButtonText = if cost then "BUY\n" .. Format.Money(cost) else "MAX ⭐",
			ButtonColor = Theme.Colors.Orange,
			Cost = cost,
			Money = state.Money,
			Disabled = cost == nil,
			OnBuy = function(card)
				purchase("Improvement", item.Id, card)
			end,
		})
	end
end

local function render()
	local state = controllers.ClientState.Get()
	if not state or not isOpen then
		return
	end
	local scroll = list.CanvasPosition
	clearList()
	cardOrder = 0
	if currentTab == "Hospital" then
		renderHospital(state)
	elseif currentTab == "Rooms" then
		renderRooms(state)
	elseif currentTab == "Doctors" then
		renderDoctors(state)
	else
		renderBoosts(state)
	end
	list.CanvasPosition = scroll
	for id, button in tabButtons do
		local tab
		for _, t in TABS do
			if t.Id == id then
				tab = t
			end
		end
		UIKit.SetButtonColor(button, if id == currentTab then tab.Color else Theme.Colors.Gray)
	end
end

function ShopController.SetTab(tabId: string)
	if currentTab ~= tabId then
		currentTab = tabId
		list.CanvasPosition = Vector2.zero
	end
	render()
end

function ShopController.Open(tabId: string?)
	if tabId then
		currentTab = tabId
	end
	controllers.StatsController.Close()
	isOpen = true
	panel.Visible = true
	UIKit.PopIn(panel)
	controllers.SoundController.Play("Open")
	render()
	ShopController.Opened:Fire()
end

function ShopController.Close()
	isOpen = false
	panel.Visible = false
end

function ShopController.Toggle()
	if isOpen then
		ShopController.Close()
	else
		ShopController.Open()
	end
end

function ShopController.IsOpen(): boolean
	return isOpen
end

function ShopController.Init(all: any)
	controllers = all
	local gui = UIKit.New("ScreenGui", {
		Name = "Shop",
		ResetOnSpawn = false,
		DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	local content
	panel, content = UIKit.Panel({
		Name = "ShopPanel",
		Title = "🛒 HOSPITAL SHOP",
		Size = Vector2.new(780, 540),
		Color = Theme.Colors.Yellow,
		Parent = gui,
		OnClose = ShopController.Close,
	})

	local tabs = UIKit.New("Frame", {
		Name = "Tabs",
		Size = UDim2.new(1, -24, 0, 54),
		Position = UDim2.fromOffset(12, 10),
		BackgroundTransparency = 1,
		Parent = content,
	}, {
		UIKit.List(Enum.FillDirection.Horizontal, 10),
	})
	for index, tab in TABS do
		tabButtons[tab.Id] = UIKit.Button({
			Text = tab.Text,
			Color = Theme.Colors.Gray,
			Size = UDim2.fromOffset(175, 48),
			TextSize = 22,
			LayoutOrder = index,
			Parent = tabs,
			OnClick = function()
				ShopController.SetTab(tab.Id)
			end,
		})
	end

	list = UIKit.New("ScrollingFrame", {
		Name = "List",
		Position = UDim2.fromOffset(12, 74),
		Size = UDim2.new(1, -24, 1, -86),
		BackgroundColor3 = Theme.Colors.PanelAlt,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Theme.Colors.GrayDark,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = content,
	}, {
		UIKit.Corner(14),
		UIKit.List(Enum.FillDirection.Vertical, 10),
		UIKit.Padding(10, 8),
	})
end

function ShopController.Start()
	local pending = false
	controllers.ClientState.Changed:Connect(function()
		if isOpen and not pending then
			pending = true
			task.delay(0.4, function()
				pending = false
				render()
			end)
		end
	end)
end

return ShopController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">SoundController</string>
              <string name="Source"><![CDATA[--[[
	SoundController
	Plays UI / feedback sounds locally.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local SoundDefs = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("Sounds"))

local SoundController = {}

local sounds: { [string]: Sound } = {}
local lastPlayed: { [string]: number } = {}

function SoundController.Init()
	local folder = Instance.new("Folder")
	folder.Name = "DoctorSounds"
	folder.Parent = SoundService
	for name, def in SoundDefs do
		local sound = Instance.new("Sound")
		sound.Name = name
		sound.SoundId = def.Id
		sound.Volume = def.Volume
		sound.PlaybackSpeed = def.Speed
		sound.Parent = folder
		sounds[name] = sound
	end
end

function SoundController.Play(name: string, pitch: number?)
	local sound = sounds[name]
	if not sound then
		return
	end
	-- Avoid stacking the exact same sound many times in one frame.
	local now = os.clock()
	if lastPlayed[name] and now - lastPlayed[name] < 0.05 then
		return
	end
	lastPlayed[name] = now
	if pitch then
		local clone = sound:Clone()
		clone.PlaybackSpeed = sound.PlaybackSpeed * pitch
		clone.Parent = sound.Parent
		clone:Play()
		clone.Ended:Once(function()
			clone:Destroy()
		end)
		task.delay(5, function()
			if clone.Parent then
				clone:Destroy()
			end
		end)
	else
		SoundService:PlayLocalSound(sound)
	end
end

return SoundController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">StatsController</string>
              <string name="Source"><![CDATA[--[[
	StatsController
	"Your career" panel: doctor level, hospital, patients, money, doctors...
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local HospitalLevels = require(Shared:WaitForChild("Config"):WaitForChild("HospitalLevels"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local UIKit = require(script.Parent.Parent.UI.UIKit)
local Theme = UIKit.Theme

local StatsController = {}

local controllers: any = nil
local panel: Frame
local grid: Frame
local isOpen = false

local function tile(order: number, emoji: string, title: string, value: string)
	local frame = UIKit.New("Frame", {
		BackgroundColor3 = Theme.Colors.White,
		LayoutOrder = order,
		Parent = grid,
	}, {
		UIKit.Corner(14),
		UIKit.Stroke(3, Theme.Colors.PanelAlt:Lerp(Theme.Colors.Stroke, 0.25)),
	})
	UIKit.Label({ Text = emoji, TextSize = 34, Size = UDim2.fromOffset(56, 76), Position = UDim2.fromOffset(6, 0), Parent = frame })
	UIKit.Label({
		Text = title,
		Font = Theme.BodyFont,
		TextSize = 14,
		TextColor3 = Theme.Colors.TextMuted,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -70, 0, 22),
		Position = UDim2.fromOffset(64, 10),
		Parent = frame,
	})
	UIKit.Label({
		Text = value,
		TextSize = 24,
		TextColor3 = Theme.Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextScaled = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(1, -70, 0, 32),
		Position = UDim2.fromOffset(64, 32),
		Parent = frame,
	})
end

local function render()
	local state = controllers.ClientState.Get()
	if not state or not isOpen then
		return
	end
	for _, child in grid:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local level = HospitalLevels.Get(state.HospitalLevel)
	local rare = state.RareTreated or {}
	local rareText = string.format("%d / %d / %d", rare.Rare or 0, rare.Epic or 0, rare.Legendary or 0)
	tile(1, "🥼", "Doctor Level", string.format("Lv %d (%d/%d XP)", state.DoctorLevel, state.DoctorXP, state.DoctorXPNeeded))
	tile(2, "🏥", "Hospital", string.format("Lv %d %s", level.Level, level.Name))
	tile(3, "🩺", "Patients Treated", Format.Commas(state.PatientsTreated))
	tile(4, "🙋", "Treated by You / Auto", string.format("%s / %s", Format.Short(state.ManualTreated), Format.Short(state.AutoTreated)))
	tile(5, "💰", "Money Earned (all time)", Format.Money(state.LifetimeEarned))
	tile(6, "🏦", "Hospital Value", Format.Money(state.HospitalValue))
	tile(7, "🤖", "Auto Doctors", string.format("%d / %d rooms", #state.Doctors, level.ExamRooms))
	tile(8, "🔥", "Best Combo", "x" .. tostring(state.BestCombo))
	tile(9, "⭐", "Rare / Epic / Legendary", rareText)
	tile(10, "⏱️", "Time Played", Format.Time(state.PlayTime or 0))
	tile(11, "💾", "Saving", if state.SavingEnabled then "On ✔" else "Off (Studio/offline)")
end

function StatsController.Open()
	controllers.ShopController.Close()
	isOpen = true
	panel.Visible = true
	UIKit.PopIn(panel)
	controllers.SoundController.Play("Open")
	render()
end

function StatsController.Close()
	isOpen = false
	if panel then
		panel.Visible = false
	end
end

function StatsController.Toggle()
	if isOpen then
		StatsController.Close()
	else
		StatsController.Open()
	end
end

function StatsController.Init(all: any)
	controllers = all
	local gui = UIKit.New("ScreenGui", {
		Name = "Stats",
		ResetOnSpawn = false,
		DisplayOrder = 6,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	local content
	panel, content = UIKit.Panel({
		Name = "StatsPanel",
		Title = "📊 YOUR CAREER",
		Size = Vector2.new(720, 520),
		Color = Theme.Colors.Blue,
		Parent = gui,
		OnClose = StatsController.Close,
	})
	grid = UIKit.New("Frame", {
		Position = UDim2.fromOffset(16, 14),
		Size = UDim2.new(1, -32, 1, -28),
		BackgroundTransparency = 1,
		Parent = content,
	}, {
		UIKit.New("UIGridLayout", {
			CellSize = UDim2.fromOffset(334, 76),
			CellPadding = UDim2.fromOffset(12, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
end

function StatsController.Start()
	controllers.ClientState.Changed:Connect(function()
		if isOpen then
			render()
		end
	end)
end

return StatsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">TutorialController</string>
              <string name="Source"><![CDATA[--[[
	TutorialController
	First-time guide: "Patients are arriving! Diagnose them to earn money."
	Walks the player through their first patient, then points at the shop.
	Can be skipped at any time.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local UIKit = require(script.Parent.Parent.UI.UIKit)
local Theme = UIKit.Theme

local TutorialController = {}

local controllers: any = nil
local coach: Frame
local coachText: TextLabel
local nextButton: TextButton
local shopArrow: TextLabel
local finished = false
local nextPressed = false

local function say(text: string, showNext: boolean?)
	coachText.Text = text
	nextButton.Visible = showNext == true
	nextPressed = false
	if not coach.Visible then
		coach.Visible = true
	end
	UIKit.PopIn(coach, 0.3)
end

local function finish(action: string)
	if finished then
		return
	end
	finished = true
	coach.Visible = false
	shopArrow.Visible = false
	controllers.GuideController.Clear()
	Remotes.Event("TutorialAction"):FireServer(action)
end

-- Polls `predicate` until it is true, the tutorial ends, or `timeout` passes.
local function waitUntil(predicate: () -> boolean, timeout: number?): boolean
	local started = os.clock()
	while not finished do
		if predicate() then
			return true
		end
		if timeout and os.clock() - started > timeout then
			return false
		end
		task.wait(0.2)
	end
	return false
end

local function myPatient(): Model?
	local patients = controllers.PatientVisualsController.GetMyPatients()
	return patients[1]
end

local function run()
	local interact = if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then "tap the Diagnose button" else "press [E]"

	controllers.NotificationController.Banner({
		Style = "Big",
		Title = "👋 Welcome, Doctor!",
		Text = "Patients are arriving! Diagnose them to earn money.",
		Color = Theme.Colors.Teal,
	})
	say("🏥 This is YOUR hospital! Patients are arriving. Diagnose them to earn 💵 money.")
	task.wait(4)

	-- Step: follow the first patient
	waitUntil(function()
		return myPatient() ~= nil
	end, 20)
	local first = myPatient()
	if first then
		controllers.GuideController.PointTo(first)
	end
	say("🚶 Here comes your first patient! Normally patients check in at reception, but this one is heading straight to your Exam Room.")

	while not finished do
		-- Step: patient is ready in the exam room
		waitUntil(function()
			return #controllers.PatientVisualsController.GetWaitingForMe() > 0 or controllers.DiagnosisController.IsOpen()
		end, 90)
		if finished then
			return
		end
		local waiting = controllers.PatientVisualsController.GetWaitingForMe()[1]
		if waiting then
			controllers.GuideController.PointTo(waiting)
		end
		say(string.format("🩺 Your patient is lying in Exam Room 1. Follow the glowing trail and %s next to them!", interact))

		-- Step: diagnosis panel
		waitUntil(function()
			return controllers.DiagnosisController.IsOpen()
		end)
		if finished then
			return
		end
		controllers.GuideController.Clear()
		say("🔍 Read the SYMPTOMS, then pick the illness that matches. The handbook shows each illness's symptoms!")

		local diagnosed = false
		local connection = controllers.DiagnosisController.Diagnosed:Connect(function()
			diagnosed = true
		end)
		waitUntil(function()
			return diagnosed or not controllers.DiagnosisController.IsOpen()
		end)
		connection:Disconnect()
		if diagnosed then
			break
		end
	end
	if finished then
		return
	end

	task.wait(1.8)
	say("🎉 Amazing! You earned money! Every patient you treat pays you. Rare ⭐ patients pay much more!")
	task.wait(4.5)

	-- Step: the shop
	shopArrow.Visible = true
	say("🛒 Open the SHOP to spend your money on upgrades!")
	local opened = false
	local shopConnection = controllers.ShopController.Opened:Connect(function()
		opened = true
	end)
	waitUntil(function()
		return opened
	end, 40)
	shopConnection:Disconnect()
	shopArrow.Visible = false
	if finished then
		return
	end

	say("⬆️ Upgrade your hospital for more exam rooms and patients. 🤖 Hire Auto Doctors to treat patients for you. Keep growing your hospital!", true)
	waitUntil(function()
		return nextPressed
	end, 30)
	finish("Complete")
end

function TutorialController.Init(all: any)
	controllers = all
	local gui = UIKit.New("ScreenGui", {
		Name = "Tutorial",
		ResetOnSpawn = false,
		DisplayOrder = 15,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	coach = UIKit.New("Frame", {
		Name = "Coach",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -84),
		Size = UDim2.fromOffset(660, 104),
		BackgroundColor3 = Theme.Colors.Panel,
		Visible = false,
		Parent = gui,
	}, {
		UIKit.Corner(18),
		UIKit.Stroke(4, Theme.Colors.Teal),
	})
	UIKit.Scaled(coach)
	UIKit.Label({
		Text = "👩",
		TextSize = 54,
		Size = UDim2.fromOffset(80, 104),
		Parent = coach,
	})
	UIKit.Label({
		Text = "Nurse Nina",
		TextSize = 16,
		TextColor3 = Theme.Colors.TealDark,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.fromOffset(200, 20),
		Position = UDim2.fromOffset(84, 6),
		Parent = coach,
	})
	coachText = UIKit.Label({
		Text = "",
		TextSize = 19,
		TextColor3 = Theme.Colors.Text,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Size = UDim2.new(1, -230, 1, -32),
		Position = UDim2.fromOffset(84, 26),
		Parent = coach,
	})
	nextButton = UIKit.Button({
		Text = "Let's go! ➜",
		Color = Theme.Colors.Green,
		Size = UDim2.fromOffset(130, 44),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, -10),
		TextSize = 19,
		Parent = coach,
		OnClick = function()
			nextPressed = true
		end,
	})
	nextButton.Visible = false
	local skip = UIKit.New("TextButton", {
		Text = "Skip tutorial",
		Font = Theme.BodyFont,
		TextSize = 13,
		TextColor3 = Theme.Colors.TextMuted,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -4),
		Size = UDim2.fromOffset(110, 20),
		Parent = coach,
	})
	skip.Activated:Connect(function()
		finish("Skip")
	end)

	shopArrow = UIKit.Label({
		Text = "⬅ OPEN SHOP!",
		TextSize = 30,
		TextColor3 = Theme.Colors.Yellow,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 104, 0.5, -112),
		Size = UDim2.fromOffset(220, 50),
		TextXAlignment = Enum.TextXAlignment.Left,
		Visible = false,
		Parent = gui,
	})
	UIKit.TextStroke(3).Parent = shopArrow
	UIKit.Scaled(shopArrow)
end

function TutorialController.Start()
	task.spawn(function()
		local state = controllers.ClientState.Wait()
		if state.TutorialDone or state.PatientsTreated > 0 then
			finished = true
			return
		end
		-- Gentle bob on the shop arrow
		task.spawn(function()
			while not finished do
				if shopArrow.Visible then
					UIKit.Tween(shopArrow, 0.4, { Position = UDim2.new(0, 116, 0.5, -112) })
					task.wait(0.4)
					UIKit.Tween(shopArrow, 0.4, { Position = UDim2.new(0, 104, 0.5, -112) })
				end
				task.wait(0.4)
			end
		end)
		run()
	end)
end

return TutorialController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">WorldController</string>
              <string name="Source"><![CDATA[--[[
	WorldController
	Small client-side world features:
	  * hides other players' "Diagnose" prompts (you can only treat your own)
	  * hides a hospital's roof while you are inside it so you can see in
	  * ambulances driving around the ring road with flashing lights
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local WorldController = {}

local player = Players.LocalPlayer

-- Prompts ---------------------------------------------------------------------------

local function filterPrompt(prompt: Instance)
	if prompt:IsA("ProximityPrompt") then
		local owner = prompt:GetAttribute("OwnerUserId")
		if owner ~= nil and owner ~= player.UserId then
			prompt.Enabled = false
		end
	end
end

local function setupPrompts()
	workspace.DescendantAdded:Connect(filterPrompt)
	for _, descendant in workspace:GetDescendants() do
		filterPrompt(descendant)
	end
end

-- Roofs -----------------------------------------------------------------------------

local hidden: { [Instance]: boolean } = {}

local function setRoofHidden(hospital: Instance, hide: boolean)
	local roofGroup = hospital:FindFirstChild("RoofGroup")
	if not roofGroup then
		return
	end
	for _, part in roofGroup:GetDescendants() do
		if part:IsA("BasePart") then
			part.LocalTransparencyModifier = if hide then 1 else 0
		end
	end
	for _, gui in roofGroup:GetDescendants() do
		if gui:IsA("SurfaceGui") then
			gui.Enabled = not hide
		end
	end
end

local function insideBounds(bounds: BasePart, point: Vector3): boolean
	local localPoint = bounds.CFrame:PointToObjectSpace(point)
	local size = bounds.Size
	return math.abs(localPoint.X) <= size.X / 2 and math.abs(localPoint.Z) <= size.Z / 2 and localPoint.Y <= size.Y / 2 + 2 and localPoint.Y >= -size.Y / 2 - 2
end

local function updateRoofs()
	local plots = workspace:FindFirstChild("Plots")
	if not plots then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local seen = {}
	for _, plot in plots:GetChildren() do
		local hospital = plot:FindFirstChild("Hospital")
		local bounds = hospital and hospital:FindFirstChild("Bounds")
		if hospital and bounds and bounds:IsA("BasePart") then
			seen[hospital] = true
			local inside = root ~= nil and insideBounds(bounds, root.Position)
			if (hidden[hospital] or false) ~= inside then
				hidden[hospital] = inside
				setRoofHidden(hospital, inside)
			end
		end
	end
	for hospital in hidden do
		if not seen[hospital] then
			hidden[hospital] = nil
		end
	end
end

-- Ambulances ----------------------------------------------------------------------------

type Vehicle = { Model: Model, Radius: number, Speed: number, Angle: number, Lights: { BasePart } }

local vehicles: { Vehicle } = {}

local function part(model: Model, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = offset
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	p.Parent = model
	return p
end

local function buildAmbulance(): (Model, { BasePart })
	local model = Instance.new("Model")
	model.Name = "AmbientAmbulance"
	local body = part(model, Vector3.new(7, 6, 11), CFrame.new(0, 4, 1.5), Color3.fromRGB(250, 250, 250))
	model.PrimaryPart = body
	part(model, Vector3.new(7, 4, 5), CFrame.new(0, 3, -6.5), Color3.fromRGB(250, 250, 250))
	part(model, Vector3.new(6.6, 2, 0.2), CFrame.new(0, 4, -9.05), Color3.fromRGB(150, 210, 255), Enum.Material.Glass)
	part(model, Vector3.new(7.1, 0.8, 16.2), CFrame.new(0, 3, -1), Color3.fromRGB(220, 50, 50))
	part(model, Vector3.new(3, 1, 0.2), CFrame.new(0, 4.6, 7.06), Color3.fromRGB(220, 50, 50))
	part(model, Vector3.new(1, 3, 0.2), CFrame.new(0, 4.6, 7.07), Color3.fromRGB(220, 50, 50))
	local red = part(model, Vector3.new(1.5, 0.6, 1), CFrame.new(-1.6, 7.3, -2), Color3.fromRGB(255, 40, 40), Enum.Material.Neon)
	local blue = part(model, Vector3.new(1.5, 0.6, 1), CFrame.new(1.6, 7.3, -2), Color3.fromRGB(40, 120, 255), Enum.Material.Neon)
	for _, wheel in { { -3.5, -5 }, { 3.5, -5 }, { -3.5, 5 }, { 3.5, 5 } } do
		part(model, Vector3.new(1, 3, 3), CFrame.new(wheel[1], 1.5, wheel[2]), Color3.fromRGB(30, 30, 30), nil, Enum.PartType.Cylinder)
	end
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 80, 80)
	light.Range = 14
	light.Brightness = 2
	light.Parent = red
	return model, { red, blue }
end

local function setupAmbulances()
	local folder = Instance.new("Folder")
	folder.Name = "Ambient"
	folder.Parent = workspace
	for i, def in { { Radius = 138, Speed = 30 }, { Radius = 126, Speed = -24 } } do
		local model, lights = buildAmbulance()
		model.Parent = folder
		table.insert(vehicles, {
			Model = model,
			Radius = def.Radius,
			Speed = def.Speed,
			Angle = i * math.pi,
			Lights = lights,
		})
	end
	RunService.Heartbeat:Connect(function(dt)
		local blink = math.floor(os.clock() * 3) % 2 == 0
		for _, vehicle in vehicles do
			vehicle.Angle += vehicle.Speed / vehicle.Radius * dt
			local a = vehicle.Angle
			local position = Vector3.new(math.sin(a) * vehicle.Radius, 0.3, math.cos(a) * vehicle.Radius)
			local tangent = Vector3.new(math.cos(a), 0, -math.sin(a)) * math.sign(vehicle.Speed)
			vehicle.Model:PivotTo(CFrame.lookAt(position, position + tangent))
			vehicle.Lights[1].Transparency = if blink then 0 else 0.7
			vehicle.Lights[2].Transparency = if blink then 0.7 else 0
		end
	end)
end

function WorldController.Init()
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	end)
end

function WorldController.Start()
	setupPrompts()
	setupAmbulances()
	task.spawn(function()
		while true do
			updateRoofs()
			task.wait(0.2)
		end
	end)
	CollectionService:GetInstanceAddedSignal("HospitalRoof"):Connect(function()
		-- A hospital was rebuilt; force the next check to re-apply visibility.
		table.clear(hidden)
	end)
end

return WorldController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="61">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Work as a Doctor - client entry point.
	Initialises every controller (UI is built from code), then starts them.
]]

local Controllers = script.Parent.Controllers

local UIKit = require(script.Parent.UI.UIKit)
local ClientState = require(script.Parent.ClientState)

local controllers = {
	ClientState = ClientState,
	SoundController = require(Controllers.SoundController),
	NotificationController = require(Controllers.NotificationController),
	EffectsController = require(Controllers.EffectsController),
	GuideController = require(Controllers.GuideController),
	HUDController = require(Controllers.HUDController),
	ShopController = require(Controllers.ShopController),
	StatsController = require(Controllers.StatsController),
	DiagnosisController = require(Controllers.DiagnosisController),
	PatientVisualsController = require(Controllers.PatientVisualsController),
	WorldController = require(Controllers.WorldController),
	TutorialController = require(Controllers.TutorialController),
}

local ORDER = {
	"SoundController",
	"NotificationController",
	"EffectsController",
	"GuideController",
	"HUDController",
	"ShopController",
	"StatsController",
	"DiagnosisController",
	"PatientVisualsController",
	"WorldController",
	"TutorialController",
}

UIKit.Init()
UIKit.SetClickSound(function()
	controllers.SoundController.Play("Click")
end)

for _, name in ORDER do
	local controller = (controllers :: any)[name]
	if controller.Init then
		controller.Init(controllers)
	end
end

ClientState.Start()

for _, name in ORDER do
	local controller = (controllers :: any)[name]
	if controller.Start then
		task.spawn(controller.Start)
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="62">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--[[
	Theme
	Colours and fonts for the whole UI. Bright, chunky and readable for
	younger players.
]]

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

return {
	Font = Enum.Font.FredokaOne,
	BodyFont = Enum.Font.GothamBold,

	Colors = {
		Panel = rgb(248, 250, 255),
		PanelAlt = rgb(232, 240, 252),
		PanelDark = rgb(32, 40, 62),
		Text = rgb(40, 50, 75),
		TextMuted = rgb(110, 120, 145),
		White = rgb(255, 255, 255),
		Stroke = rgb(24, 30, 48),

		Green = rgb(80, 205, 95),
		GreenDark = rgb(40, 150, 60),
		Blue = rgb(70, 150, 245),
		BlueDark = rgb(40, 100, 200),
		Teal = rgb(40, 195, 185),
		TealDark = rgb(20, 140, 140),
		Yellow = rgb(255, 205, 60),
		YellowDark = rgb(220, 150, 20),
		Orange = rgb(255, 150, 60),
		Red = rgb(240, 80, 80),
		RedDark = rgb(180, 40, 50),
		Purple = rgb(160, 100, 240),
		Gray = rgb(170, 175, 190),
		GrayDark = rgb(110, 115, 130),
		Money = rgb(110, 235, 110),
	},
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">UIKit</string>
              <string name="Source"><![CDATA[--[[
	UIKit
	Tiny declarative helpers for building the UI from code, plus shared
	animations (pop-in, button bounce) and resolution scaling.
]]

local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Theme = require(script.Parent.Theme)

local UIKit = {}
UIKit.Theme = Theme

local scales: { UIScale } = {}
local currentScale = 1
local clickSound: (() -> ())? = nil

-- Creates an instance, assigns properties and parents children.
-- Properties are a plain table; `Children` is an optional array.
function UIKit.New(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className :: any)
	local parent = nil
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			(instance :: any)[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function UIKit.Corner(radius: number?): UICorner
	return UIKit.New("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function UIKit.Stroke(thickness: number?, color: Color3?, mode: Enum.ApplyStrokeMode?): UIStroke
	return UIKit.New("UIStroke", {
		Thickness = thickness or 3,
		Color = color or Theme.Colors.Stroke,
		ApplyStrokeMode = mode or Enum.ApplyStrokeMode.Border,
	})
end

function UIKit.TextStroke(thickness: number?, color: Color3?): UIStroke
	return UIKit.New("UIStroke", {
		Thickness = thickness or 2,
		Color = color or Theme.Colors.Stroke,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	})
end

function UIKit.Padding(all: number, horizontal: number?): UIPadding
	local h = horizontal or all
	return UIKit.New("UIPadding", {
		PaddingTop = UDim.new(0, all),
		PaddingBottom = UDim.new(0, all),
		PaddingLeft = UDim.new(0, h),
		PaddingRight = UDim.new(0, h),
	})
end

function UIKit.Gradient(top: Color3, bottom: Color3, rotation: number?): UIGradient
	return UIKit.New("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = rotation or 90,
	})
end

function UIKit.List(direction: Enum.FillDirection?, padding: number?, hAlign: Enum.HorizontalAlignment?, vAlign: Enum.VerticalAlignment?): UIListLayout
	return UIKit.New("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 8),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Center,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function UIKit.Label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextColor3 = Theme.Colors.White,
		TextSize = 22,
		Text = "",
	}
	for key, value in props do
		defaults[key] = value
	end
	return UIKit.New("TextLabel", defaults)
end

function UIKit.Tween(instance: Instance, duration: number, goal: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): Tween
	local tween = TweenService:Create(instance, TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), goal)
	tween:Play()
	return tween
end

-- Pops a GuiObject in with a bouncy scale animation.
function UIKit.PopIn(object: GuiObject, duration: number?)
	local scale = object:FindFirstChild("PopScale") :: UIScale?
	if not scale then
		scale = UIKit.New("UIScale", { Name = "PopScale", Parent = object })
	end
	local popScale = scale :: UIScale
	popScale.Scale = 0.6
	UIKit.Tween(popScale, duration or 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
end

function UIKit.Bounce(object: GuiObject, amount: number?)
	local scale = object:FindFirstChild("PopScale") :: UIScale?
	if not scale then
		scale = UIKit.New("UIScale", { Name = "PopScale", Parent = object })
	end
	local popScale = scale :: UIScale
	popScale.Scale = amount or 1.15
	UIKit.Tween(popScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
end

function UIKit.Shake(object: GuiObject)
	local origin = object.Position
	task.spawn(function()
		for i = 1, 6 do
			local offset = if i % 2 == 0 then -8 else 8
			object.Position = origin + UDim2.fromOffset(offset * (1 - i / 7), 0)
			task.wait(0.04)
		end
		object.Position = origin
	end)
end

function UIKit.SetClickSound(callback: () -> ())
	clickSound = callback
end

export type ButtonProps = {
	Text: string,
	Color: Color3?,
	DarkColor: Color3?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	TextSize: number?,
	LayoutOrder: number?,
	Parent: Instance?,
	Name: string?,
	RichText: boolean?,
	OnClick: (() -> ())?,
}

-- Chunky cartoon button with hover + press feedback.
-- The gradient lives on a child "Fill" frame so it never tints the text.
function UIKit.Button(props: ButtonProps): TextButton
	local color = props.Color or Theme.Colors.Green
	local dark = props.DarkColor or color:Lerp(Color3.new(0, 0, 0), 0.3)
	local button = UIKit.New("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(160, 50),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = props.LayoutOrder or 0,
	})
	UIKit.New("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 1,
		Parent = button,
	}, {
		UIKit.Corner(12),
		UIKit.Stroke(3, Theme.Colors.Stroke),
		UIKit.New("UIGradient", { Name = "Gradient", Color = ColorSequence.new(color, dark), Rotation = 90 }),
	})
	UIKit.New("TextLabel", {
		Name = "Label",
		Size = UDim2.new(1, -8, 1, 0),
		Position = UDim2.fromOffset(4, 0),
		BackgroundTransparency = 1,
		Text = props.Text,
		RichText = props.RichText or false,
		Font = Theme.Font,
		TextSize = props.TextSize or 22,
		TextColor3 = Theme.Colors.White,
		TextWrapped = true,
		ZIndex = 2,
		Parent = button,
	}, {
		UIKit.New("UIStroke", {
			Name = "TextOutline",
			Thickness = 2,
			Color = dark:Lerp(Color3.new(0, 0, 0), 0.4),
			ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		}),
	})
	local scale = UIKit.New("UIScale", { Name = "PopScale", Parent = button })
	button.MouseEnter:Connect(function()
		UIKit.Tween(scale, 0.12, { Scale = 1.06 })
	end)
	button.MouseLeave:Connect(function()
		UIKit.Tween(scale, 0.12, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		UIKit.Tween(scale, 0.08, { Scale = 0.93 })
	end)
	button.MouseButton1Up:Connect(function()
		UIKit.Tween(scale, 0.15, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	if props.OnClick then
		local callback = props.OnClick
		button.Activated:Connect(function()
			if clickSound then
				clickSound()
			end
			callback()
		end)
	end
	if props.Parent then
		button.Parent = props.Parent
	end
	return button
end

function UIKit.SetButtonColor(button: GuiObject, color: Color3, dark: Color3?)
	local darkColor = dark or color:Lerp(Color3.new(0, 0, 0), 0.3)
	local fill = button:FindFirstChild("Fill")
	local gradient = fill and fill:FindFirstChild("Gradient") :: UIGradient?
	if gradient then
		gradient.Color = ColorSequence.new(color, darkColor)
	end
	local label = button:FindFirstChild("Label")
	local outline = label and label:FindFirstChild("TextOutline") :: UIStroke?
	if outline then
		outline.Color = darkColor:Lerp(Color3.new(0, 0, 0), 0.4)
	end
end

function UIKit.SetButtonText(button: GuiObject, text: string)
	local label = button:FindFirstChild("Label") :: TextLabel?
	if label then
		label.Text = text
	end
end

-- Registers a container so it scales with the screen size (designed at 1280x760).
function UIKit.Scaled(object: GuiObject): UIScale
	local scale = UIKit.New("UIScale", { Name = "ScreenScale", Scale = currentScale, Parent = object })
	table.insert(scales, scale)
	return scale
end

function UIKit.GetScale(): number
	return currentScale
end

local function updateScale()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	currentScale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 760), 0.5, 1.2)
	for i = #scales, 1, -1 do
		local scale = scales[i]
		if scale.Parent then
			scale.Scale = currentScale
		else
			table.remove(scales, i)
		end
	end
end

function UIKit.Init()
	local function hook()
		local camera = Workspace.CurrentCamera
		if camera then
			camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
		end
		updateScale()
	end
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hook)
	hook()
end

-- Modal panel with a coloured header and a close button.
export type PanelProps = {
	Name: string,
	Title: string,
	Size: Vector2,
	Color: Color3?,
	Parent: Instance,
	OnClose: (() -> ())?,
}

function UIKit.Panel(props: PanelProps): (Frame, Frame, TextLabel)
	local color = props.Color or Theme.Colors.Blue
	local panel = UIKit.New("Frame", {
		Name = props.Name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(props.Size.X, props.Size.Y),
		BackgroundColor3 = Theme.Colors.Panel,
		Visible = false,
		Parent = props.Parent,
	}, {
		UIKit.Corner(20),
		UIKit.Stroke(4, Theme.Colors.Stroke),
	})
	UIKit.Scaled(panel)

	local header = UIKit.New("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 64),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = panel,
	}, {
		UIKit.Corner(20),
		UIKit.Gradient(color, color:Lerp(Color3.new(0, 0, 0), 0.25)),
	})
	-- Square off the header's bottom corners
	UIKit.New("Frame", {
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.new(0, 0, 1, -20),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = header,
	}, {
		UIKit.Gradient(color:Lerp(Color3.new(0, 0, 0), 0.18), color:Lerp(Color3.new(0, 0, 0), 0.25)),
	})
	local title = UIKit.Label({
		Name = "Title",
		Text = props.Title,
		TextSize = 34,
		Size = UDim2.new(1, -140, 1, 0),
		Position = UDim2.fromOffset(24, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 2,
		Parent = header,
	})
	UIKit.TextStroke(3).Parent = title

	UIKit.Button({
		Name = "Close",
		Text = "✖",
		Color = Theme.Colors.Red,
		Size = UDim2.fromOffset(48, 48),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		TextSize = 26,
		Parent = header,
		OnClick = function()
			if props.OnClose then
				props.OnClose()
			end
		end,
	})

	local content = UIKit.New("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 64),
		Size = UDim2.new(1, 0, 1, -64),
		Parent = panel,
	})
	return panel, content, title
end

return UIKit
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="65">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>