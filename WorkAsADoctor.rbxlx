        <Item class="ModuleScript" referent="3">
          <Properties>
            <string name="Name">AutoDoctors</string>
            <string name="Source"><![CDATA[--[[
	AutoDoctors
	Hired doctors staff one exam room each (doctor N works in exam room N),
	so the number of doctors is capped by the hospital's exam rooms.

	Tier 1 is bought with the "Hire" button (price grows with every doctor
	you already own). Higher tiers are upgrades for a single doctor.
]]

export type Tier = {
	Tier: number,
	Name: string,
	Short: string,
	TreatTime: number,
	UpgradeCost: number, -- cost to upgrade *into* this tier (unused for tier 1)
	RequiredLevel: number,
	Coat: Color3,
	Scrubs: Color3,
	Accent: Color3,
	Robot: boolean,
}

local Tiers: { Tier } = {
	{
		Tier = 1,
		Name = "Auto Doctor I",
		Short = "I",
		TreatTime = 15,
		UpgradeCost = 0,
		RequiredLevel = 1,
		Coat = Color3.fromRGB(245, 245, 245),
		Scrubs = Color3.fromRGB(110, 200, 130),
		Accent = Color3.fromRGB(110, 200, 130),
		Robot = false,
	},
	{
		Tier = 2,
		Name = "Auto Doctor II",
		Short = "II",
		TreatTime = 10,
		UpgradeCost = 5000,
		RequiredLevel = 2,
		Coat = Color3.fromRGB(245, 245, 245),
		Scrubs = Color3.fromRGB(80, 150, 240),
		Accent = Color3.fromRGB(80, 150, 240),
		Robot = false,
	},
	{
		Tier = 3,
		Name = "Auto Doctor III",
		Short = "III",
		TreatTime = 6,
		UpgradeCost = 20000,
		RequiredLevel = 3,
		Coat = Color3.fromRGB(245, 245, 245),
		Scrubs = Color3.fromRGB(150, 90, 230),
		Accent = Color3.fromRGB(150, 90, 230),
		Robot = false,
	},
	{
		Tier = 4,
		Name = "Specialist Doctor",
		Short = "IV",
		TreatTime = 4,
		UpgradeCost = 75000,
		RequiredLevel = 4,
		Coat = Color3.fromRGB(60, 190, 190),
		Scrubs = Color3.fromRGB(30, 60, 90),
		Accent = Color3.fromRGB(255, 200, 60),
		Robot = false,
	},
	{
		Tier = 5,
		Name = "Robo-Doc 3000",
		Short = "V",
		TreatTime = 2.5,
		UpgradeCost = 300000,
		RequiredLevel = 6,
		Coat = Color3.fromRGB(170, 180, 195),
		Scrubs = Color3.fromRGB(70, 80, 100),
		Accent = Color3.fromRGB(0, 230, 255),
		Robot = true,
	},
}

return {
	Tiers = Tiers,
	MaxTier = #Tiers,
	HireBaseCost = 1000,
	HireCostGrowth = 1.6,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">DoctorLevels</string>
            <string name="Source"><![CDATA[--[[
	DoctorLevels
	The player's personal doctor level. XP comes from diagnosing patients
	yourself. Higher levels give harder (more choices) but better-paying cases.
]]

export type Difficulty = {
	MinLevel: number,
	Symptoms: number,
	Choices: number,
	Bonus: number,
	Label: string,
}

local Difficulties: { Difficulty } = {
	{ MinLevel = 1, Symptoms = 2, Choices = 3, Bonus = 1, Label = "Trainee" },
	{ MinLevel = 3, Symptoms = 3, Choices = 4, Bonus = 1.15, Label = "Junior Doctor" },
	{ MinLevel = 6, Symptoms = 3, Choices = 5, Bonus = 1.3, Label = "Doctor" },
	{ MinLevel = 10, Symptoms = 4, Choices = 6, Bonus = 1.5, Label = "Senior Doctor" },
	{ MinLevel = 20, Symptoms = 4, Choices = 6, Bonus = 1.8, Label = "Chief of Medicine" },
}

local DoctorLevels = {
	MaxLevel = 50,
	BaseXP = 10, -- XP for one correct Common diagnosis (before multipliers)
	RewardBonusPerLevel = 0.05, -- +5% manual income per doctor level
}

function DoctorLevels.XPToNext(level: number): number
	return math.floor(50 * level ^ 1.4)
end

-- Returns level, xpIntoLevel, xpNeededForNext
function DoctorLevels.FromTotalXP(totalXP: number): (number, number, number)
	local level = 1
	local remaining = totalXP
	while level < DoctorLevels.MaxLevel do
		local need = DoctorLevels.XPToNext(level)
		if remaining < need then
			return level, remaining, need
		end
		remaining -= need
		level += 1
	end
	return level, 0, 0
end

function DoctorLevels.GetDifficulty(level: number): Difficulty
	local result = Difficulties[1]
	for _, difficulty in Difficulties do
		if level >= difficulty.MinLevel then
			result = difficulty
		end
	end
	return result
end

DoctorLevels.Difficulties = Difficulties

return DoctorLevels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[--[[
	GameConfig
	Global tuning values shared by server and client.
	Anything economy-related is *read* by the client for display only;
	the server is always the authority.
]]

local GameConfig = {
	GameName = "Work as a Doctor",

	-- Data
	DataStoreName = "WorkAsADoctor_PlayerData_v1",
	AutosaveInterval = 60,
	SessionLockTimeout = 150, -- seconds before another server may take over a stale session

	-- Plots
	PlotCount = 6,
	PlotFrontRadius = 150, -- distance from map centre to the front edge of each plot
	PlotWidth = 140,
	PlotDepth = 170,

	-- Money
	StartingMoney = 0,
	ManualCareBonus = 1.5, -- personally diagnosing pays more than Auto Doctors
	ExpertBonus = 1.25, -- diagnosing without opening the handbook
	ComboStep = 0.1, -- +10% per correct diagnosis in a row
	ComboMax = 10, -- capped at +100%
	WrongAnswerMultipliers = { 1, 0.75, 0.5 }, -- reward after 0 / 1 / 2+ mistakes
	PharmacyBonus = 0.25, -- extra income per patient when the Pharmacy is unlocked
	EmergencyMultiplier = 2,
	ChildMultiplier = 1.2,
	VIPMultiplier = 5,

	-- Patient kinds (chances only apply once the matching room is unlocked)
	EmergencyChance = 0.12,
	ChildChance = 0.2,
	VIPChance = 0.05,

	-- NPCs
	PatientWalkSpeed = 12,
	EmergencyWalkSpeed = 18,
	DoctorWalkSpeed = 14,
	UsePathfinding = true, -- falls back to direct walking when line of sight is clear
	CheckInTime = 1.2,

	-- Diagnosis
	DiagnoseDistance = 22, -- max studs between player and patient (server check)
	DiagnosisSessionTimeout = 120,

	-- Leaderboards
	LeaderboardUpdateInterval = 120,
	LeaderboardSize = 10,
}

return GameConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">HospitalLevels</string>
            <string name="Source"><![CDATA[--[[
	HospitalLevels
	Each entry describes one hospital tier. The HospitalBuilder reads Width /
	ExamRooms / Capacity / Style to rebuild the physical hospital, and the
	simulation reads SpawnInterval / RewardMultiplier.

	Constraint: ExamRooms * 12 + 16 <= Width (leaves 8 stud side passages).
]]

export type Style = {
	Wall: Color3,
	Trim: Color3,
	Floor: Color3,
	FloorMaterial: Enum.Material,
	WallMaterial: Enum.Material,
	Roof: Color3,
	Accent: Color3,
	WallHeight: number,
	Windows: boolean,
	Towers: number,
	Helipad: boolean,
	Parking: boolean,
	Gold: boolean,
	Beacon: boolean,
}

export type Level = {
	Level: number,
	Name: string,
	Cost: number,
	ExamRooms: number,
	Capacity: number,
	SpawnInterval: number,
	RewardMultiplier: number,
	Width: number,
	Perks: { string },
	Style: Style,
}

local function rgb(r: number, g: number, b: number): Color3
