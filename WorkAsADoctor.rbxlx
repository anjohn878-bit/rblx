        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Improvements</string>
            <string name="Source"><![CDATA[--[[
	Improvements
	Cheap repeatable upgrades so there is always a "next thing" to save for.
]]

export type Improvement = {
	Id: string,
	Name: string,
	Emoji: string,
	Description: string,
	MaxLevel: number,
	BaseCost: number,
	Growth: number,
	PerLevel: number,
}

local List: { Improvement } = {
	{
		Id = "Marketing",
		Name = "Marketing Campaign",
		Emoji = "📣",
		Description = "Patients arrive 7% faster per level.",
		MaxLevel = 10,
		BaseCost = 250,
		Growth = 1.9,
		PerLevel = 0.07,
	},
	{
		Id = "Equipment",
		Name = "Better Equipment",
		Emoji = "🔬",
		Description = "+10% money from every patient per level.",
		MaxLevel = 15,
		BaseCost = 400,
		Growth = 1.7,
		PerLevel = 0.1,
	},
	{
		Id = "Training",
		Name = "Doctor Training",
		Emoji = "🎓",
		Description = "Auto Doctors work 6% faster per level.",
		MaxLevel = 10,
		BaseCost = 1500,
		Growth = 2,
		PerLevel = 0.06,
	},
}

local byId: { [string]: Improvement } = {}
for _, item in List do
	byId[item.Id] = item
end

return {
	List = List,
	ById = byId,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Rarities</string>
            <string name="Source"><![CDATA[--[[
	Rarities
	Rolled for every patient. Rare+ patients glow, are announced, may carry a
	quirky "rare illness" and pay a lot more.
]]

export type Rarity = {
	Id: string,
	Name: string,
	Weight: number,
	Multiplier: number,
	XP: number,
	Color: Color3,
	Stars: number,
	RareIllnessChance: number,
	Announce: boolean,
}

local List: { Rarity } = {
	{
		Id = "Common",
		Name = "Common",
		Weight = 62,
		Multiplier = 1,
		XP = 1,
		Color = Color3.fromRGB(235, 235, 235),
		Stars = 0,
		RareIllnessChance = 0,
		Announce = false,
	},
	{
		Id = "Uncommon",
		Name = "Uncommon",
		Weight = 25,
		Multiplier = 1.5,
		XP = 1.5,
		Color = Color3.fromRGB(100, 220, 110),
		Stars = 1,
		RareIllnessChance = 0,
		Announce = false,
	},
	{
		Id = "Rare",
		Name = "Rare",
		Weight = 9,
		Multiplier = 2.5,
		XP = 3,
		Color = Color3.fromRGB(70, 160, 255),
		Stars = 2,
		RareIllnessChance = 0.4,
		Announce = true,
	},
	{
		Id = "Epic",
		Name = "Epic",
		Weight = 3.2,
		Multiplier = 5,
		XP = 6,
		Color = Color3.fromRGB(190, 90, 255),
		Stars = 3,
		RareIllnessChance = 0.7,
		Announce = true,
	},
	{
		Id = "Legendary",
		Name = "Legendary",
		Weight = 0.8,
		Multiplier = 12,
		XP = 15,
		Color = Color3.fromRGB(255, 196, 40),
		Stars = 4,
		RareIllnessChance = 1,
		Announce = true,
	},
}

local byId: { [string]: Rarity } = {}
for _, rarity in List do
	byId[rarity.Id] = rarity
end

return {
	List = List,
	ById = byId,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Rooms</string>
            <string name="Source"><![CDATA[--[[
	Rooms
	Special hospital areas that are bought once and give a permanent benefit.
	Location "Lobby" rooms are built into the lobby; "Back" rooms are built
	into the back wing (in this order) once the hospital is big enough.
]]

export type Room = {
	Id: string,
	Name: string,
	Emoji: string,
	Cost: number,
	RequiredLevel: number,
	Location: string,
	Benefit: string,
	Color: Color3,
}

