local H = require("./harness")
local Damage = require("../src/shared/Rules/Damage")
local Combat = require("../src/shared/Config/Combat")

H.describe("Damage", function()
	H.it("deals base damage with no armor", function()
		H.expect(Damage.compute(Combat, false, 0)).toBe(Combat.BaseDamage)
	end)
	H.it("multiplies crits", function()
		H.expect(Damage.compute(Combat, true, 0)).toBe(Combat.BaseDamage * Combat.CritMultiplier)
	end)
	H.it("caps armor reduction", function()
		local floor = Combat.BaseDamage * (1 - Combat.MaxArmorReduction)
		H.expect(Damage.compute(Combat, false, 1000)).toBeNear(floor)
	end)
	H.it("never heals or overflows health", function()
		H.expect(Damage.applyTo(Combat, 10, 50)).toBe(0)
		H.expect(Damage.applyTo(Combat, Combat.MaxHealth, -50)).toBe(Combat.MaxHealth)
	end)
end)
