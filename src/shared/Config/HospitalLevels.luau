local HospitalLevels = {
	Levels = Levels,
	MaxLevel = #Levels,
}

function HospitalLevels.Get(level: number): Level
	return Levels[math.clamp(level, 1, #Levels)]
end

function HospitalLevels.GetNext(level: number): Level?
	return Levels[level + 1]
end

return HospitalLevels
