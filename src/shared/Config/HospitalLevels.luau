--[[
	HospitalLevels
	Each entry describes one hospital tier. The HospitalBuilder reads Width /
	ExamRooms / Capacity / Style to rebuild the physical hospital, and the
	simulation reads SpawnInterval / RewardMultiplier.

	Constraint: ExamRooms * 12 + 16 <= Width (leaves 8 stud side passages).
]]

export type Style = {
	Wall: Color3,
	Trim: Color3,
	Floor: Color3,
	FloorMaterial: Enum.Material,
	WallMaterial: Enum.Material,
	Roof: Color3,
	Accent: Color3,
	WallHeight: number,
	Windows: boolean,
	Towers: number,
	Helipad: boolean,
	Parking: boolean,
	Gold: boolean,
	Beacon: boolean,
}

export type Level = {
	Level: number,
	Name: string,
	Cost: number,
	ExamRooms: number,
	Capacity: number,
	SpawnInterval: number,
	RewardMultiplier: number,
	Width: number,
	Perks: { string },
	Style: Style,
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

