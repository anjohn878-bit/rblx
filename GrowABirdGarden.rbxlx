      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--!strict
-- Minimal signal so UI modules can react to state changes.

local Signal = {}
Signal.__index = Signal

export type Connection = { Disconnect: () -> () }
export type Signal = typeof(setmetatable({} :: { handlers: { [{}]: (...any) -> () } }, Signal))

function Signal.new(): Signal
	return setmetatable({ handlers = {} }, Signal)
end

function Signal.Connect(self: Signal, fn: (...any) -> ()): Connection
	local token = {}
	self.handlers[token] = fn
	return {
		Disconnect = function()
			self.handlers[token] = nil
		end,
	}
end

function Signal.Fire(self: Signal, ...: any)
	for _, fn in table.clone(self.handlers) do
		task.spawn(fn, ...)
	end
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- Shared type definitions. Nothing in here exists at runtime.

export type Rarity = "Common" | "Uncommon" | "Rare" | "Epic" | "Legendary" | "Mythic"

export type BirdDef = {
	id: string,
	name: string,
	rarity: Rarity,
	value: number, -- feathers paid for every visit
	blurb: string,
	scale: number, -- 1.0 is roughly a robin
	body: Color3,
	belly: Color3,
	wing: Color3,
	beak: Color3,
	accent: Color3,
	traits: { string }, -- Crest, Cap, LongTail, BigBeak, LongBeak, OwlFace, FanTail, Glow, Fire, Hover
}

export type WeightedBird = { id: string, weight: number }

export type SeedDef = {
	id: string,
	name: string,
	rarity: Rarity,
	tier: number,
	price: number, -- feathers
	growTime: number, -- seconds
	blurb: string,
	color: Color3,
	labelHeight: number, -- studs above the soil (at full size) for the timer label
	perches: { { number } }, -- {x, y, z} offsets from the plant root at full size
	birds: { WeightedBird },
	stock: { chance: number, min: number, max: number },
}

export type Snapshot = {
	feathers: number,
	seeds: { [string]: number },
	birds: { [string]: number }, -- species id -> number of visits
	plots: number, -- unlocked plots
	nextPlotPrice: number?, -- nil once every plot is unlocked
	totalVisits: number,
}

export type VisitInfo = {
	id: number,
	birdId: string,
	ownerUserId: number,
	perch: Vector3,
	from: Vector3,
	to: Vector3,
	facing: Vector3,
	startTime: number, -- server time
	arrive: number,
	stay: number,
	leave: number,
	seed: number, -- cosmetic variation
}

export type StockInfo = {
	stock: { [string]: number },
	nextRestock: number, -- server time
}

export type Notice = {
	kind: string, -- "toast" | "reward" | "discovery"
	text: string?,
	color: Color3?,
	amount: number?,
	birdId: string?,
	position: Vector3?,
	bonus: number?,
}

export type Result = { ok: boolean, message: string }

return {}
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="15">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="16">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Grow a Bird Garden - server entry point.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes")).get() -- creates every remote first

local BirdService = require(script.BirdService)
local DataService = require(script.DataService)
local DevService = require(script.DevService)
local GardenService = require(script.GardenService)
local PlantService = require(script.PlantService)
local ShopService = require(script.ShopService)
local Throttle = require(script.Throttle)
local WorldBuilder = require(script.WorldBuilder)

local ready: { [Player]: boolean } = {}
local joining: { [Player]: boolean } = {}

-- Remote handlers are assigned before the world is built, so a client that
-- connects while the map is still being generated never calls an empty handler.
-- (Everything they touch only becomes reachable once `ready[player]` is set.)

-- The client asks for everything it needs once it has loaded.
Remotes.Init.OnServerInvoke = function(player: Player)
	local deadline = os.clock() + 30
	while not ready[player] and player.Parent == Players and os.clock() < deadline do
		task.wait(0.1)
	end
	local profile = DataService.get(player)
	if not ready[player] or not profile then
		return nil
	end
	return {
		state = DataService.snapshot(profile),
		stock = ShopService.getStock(),
		visits = BirdService.activeVisits(),
	}
end

Remotes.PlantSeed.OnServerEvent:Connect(function(player: Player, plotIndex: any, seedId: any)
	if ready[player] and Throttle.ok(player, "plant", 0.1) then
		PlantService.plant(player, plotIndex, seedId)
	end
end)

Remotes.DigPlant.OnServerEvent:Connect(function(player: Player, plotIndex: any)
	if ready[player] and Throttle.ok(player, "dig", 0.2) then
		PlantService.dig(player, plotIndex)
	end
end)

Remotes.BuySeed.OnServerInvoke = function(player: Player, seedId: any, amount: any)
	if not ready[player] or not Throttle.ok(player, "buy", 0.1) then
		return { ok = false, message = "Slow down a little!" }
	end
	return ShopService.buySeed(player, seedId, amount)
end

Remotes.UnlockPlot.OnServerInvoke = function(player: Player)
	if not ready[player] or not Throttle.ok(player, "unlock", 0.3) then
		return { ok = false, message = "Slow down a little!" }
	end
	return ShopService.unlockPlot(player)
end

local world = WorldBuilder.build()
GardenService.init(world)
PlantService.init(world)
ShopService.init()
DevService.init()
DataService.startAutosave()

local function onJoin(player: Player)
	if joining[player] then
		return
	end
	joining[player] = true

	player.CharacterAdded:Connect(function()
		if ready[player] then
			GardenService.placeCharacter(player)
		end
	end)

	local profile = DataService.load(player)
	if not profile or player.Parent ~= Players then
		return
	end

	local garden = GardenService.assign(player)
	if not garden then
		player:Kick("Every garden on this server is taken. Please join another server!")
		return
	end

	DataService.attach(player)
	GardenService.refreshPlots(player, profile.plots)
	PlantService.loadPlayer(player, profile)
	DataService.rescue(player)
	ready[player] = true
	GardenService.placeCharacter(player)
end

local function onLeave(player: Player)
	ready[player] = nil
	joining[player] = nil
	PlantService.clearPlayer(player)
	GardenService.release(player)
	DataService.save(player)
	DataService.release(player)
end

Players.PlayerAdded:Connect(onJoin)
Players.PlayerRemoving:Connect(onLeave)
for _, player in Players:GetPlayers() do
	task.spawn(onJoin, player)
end

game:BindToClose(function()
	DataService.saveAll()
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">BirdService</string>
          <string name="Source"><![CDATA[--!strict
-- Runs bird visits. Each perch on a mature plant is an independent slot driven
-- by the pure Scheduler; this module turns its events into real effects
-- (spawn a visit for every client, pay feathers, record discoveries).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BirdFlight = require(Shared:WaitForChild("BirdFlight"))
local Birds = require(Shared:WaitForChild("Birds"))
local Config = require(Shared:WaitForChild("Config"))
local Growth = require(Shared:WaitForChild("Growth"))
local Remotes = require(Shared:WaitForChild("Remotes")).get()
local Scheduler = require(Shared:WaitForChild("Scheduler"))
local Types = require(Shared:WaitForChild("Types"))

local DataService = require(script.Parent.DataService)

local BirdService = {}

-- What BirdService needs to know about a plant (PlantService's state has all of it).
export type Habitat = {
	player: Player,
	plotIndex: number,
	seed: Types.SeedDef,
	root: BasePart,
	slots: { Scheduler.Slot },
}

type Active = { info: Types.VisitInfo, habitat: Habitat }

local active: { [number]: Active } = {}
local nextId = 1
local rng = Random.new()

local function startVisit(h: Habitat, slotIndex: number, slot: Scheduler.Slot, now: number)
	local timing = Scheduler.start(slot, now, rng)
	local birdId = Growth.pickBird(h.seed, rng)
	local offset = h.seed.perches[slotIndex]
	local perch = h.root.CFrame:PointToWorldSpace(Vector3.new(offset[1], offset[2], offset[3]))
	local plan = BirdFlight.plan(perch, rng)

	local id = nextId
	nextId += 1
	local info: Types.VisitInfo = {
		id = id,
		birdId = birdId,
		ownerUserId = h.player.UserId,
		perch = perch,
		from = plan.from,
		to = plan.to,
		facing = plan.facing,
		startTime = now,
		arrive = timing.arrive,
		stay = timing.stay,
		leave = timing.leave,
		seed = plan.seed,
	}
	active[id] = { info = info, habitat = h }
	slot.visitId = id
	Remotes.BirdVisit:FireAllClients(info)
end

-- The bird has landed: pay the owner and record the species.
local function payVisit(h: Habitat, slot: Scheduler.Slot)
	Scheduler.markPaid(slot)
	local entry = if slot.visitId then active[slot.visitId] else nil
	local profile = DataService.get(h.player)
	if not entry or not profile then
		return
	end
	local def = Birds.get(entry.info.birdId)
	if not def then
		return
	end

	local seenBefore = profile.birds[def.id] or 0
	profile.birds[def.id] = seenBefore + 1
	profile.totalVisits += 1
	local bonus = if seenBefore == 0 then def.value * Config.DISCOVERY_MULTIPLIER else 0
	profile.feathers += def.value + bonus
	DataService.push(h.player)

	local reward: Types.Notice = {
		kind = "reward",
		amount = def.value,
		birdId = def.id,
		position = entry.info.perch + Vector3.new(0, 1.5 + def.scale, 0),
		bonus = if bonus > 0 then bonus else nil,
	}
	Remotes.Notify:FireClient(h.player, reward)
	if bonus > 0 then
		local discovery: Types.Notice = { kind = "discovery", birdId = def.id, bonus = bonus }
		Remotes.Notify:FireClient(h.player, discovery)
	end
end

local function finishVisit(slot: Scheduler.Slot, now: number)
	if slot.visitId then
		active[slot.visitId] = nil
	end
	Scheduler.finish(slot, now, rng)
end

function BirdService.update(h: Habitat, now: number)
	for index, slot in h.slots do
		local action = Scheduler.due(slot, now)
		if action == "start" then
			startVisit(h, index, slot, now)
		elseif action == "reward" then
			payVisit(h, slot)
		elseif action == "finish" then
			finishVisit(slot, now)
		end
	end
end

-- The plant is going away: tell clients to drop any birds that were headed for it.
function BirdService.cancelHabitat(h: Habitat)
	for _, slot in h.slots do
		local id = slot.visitId
		if id and active[id] then
			active[id] = nil
			Remotes.BirdCancel:FireAllClients(id)
		end
		slot.visitId = nil
		slot.visiting = false
	end
end

-- For players who join mid-visit.
function BirdService.activeVisits(): { Types.VisitInfo }
	local list = {}
	for _, entry in active do
		table.insert(list, entry.info)
	end
	return list
end

return BirdService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--!strict
-- Player profiles: loading, sanitising, saving, and syncing to the client.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Birds = require(Shared:WaitForChild("Birds"))
local Clock = require(Shared:WaitForChild("Clock"))
local Config = require(Shared:WaitForChild("Config"))
local Growth = require(Shared:WaitForChild("Growth"))
local Remotes = require(Shared:WaitForChild("Remotes")).get()
local Seeds = require(Shared:WaitForChild("Seeds"))
local Types = require(Shared:WaitForChild("Types"))

local DataService = {}

export type PlantRecord = { seedId: string, plantedAt: number }

export type Profile = {
	version: number,
	feathers: number,
	seeds: { [string]: number },
	birds: { [string]: number },
	plots: number,
	plants: { [string]: PlantRecord }, -- keyed by plot index as a string
	totalVisits: number,
}

local PROFILE_VERSION = 1

local store: DataStore? = nil
local storeWarned = false
local profiles: { [Player]: Profile } = {}
local ephemeral: { [Player]: boolean } = {} -- Studio without API access: play, but never save
local dirty: { [Player]: boolean } = {}
local pushPending: { [Player]: boolean } = {}

local function getStore(): DataStore?
	if store then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DATASTORE_NAME)
	end)
	if ok then
		store = result
	end
	return store
end

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

local function defaultProfile(): Profile
	local seeds: { [string]: number } = {}
	for id, count in Config.START_SEEDS do
		seeds[id] = count
	end
	return {
		version = PROFILE_VERSION,
		feathers = Config.START_FEATHERS,
		seeds = seeds,
		birds = {},
		plots = Config.START_PLOTS,
		plants = {},
		totalVisits = 0,
	}
end

local function isCount(v: any): boolean
	return type(v) == "number" and v == v and v >= 0 and v < 1e15
end

-- Never trust stored data: rebuild a valid profile from whatever was loaded.
local function sanitize(raw: any): Profile
	local profile = defaultProfile()
	if type(raw) ~= "table" then
		return profile
	end

	if isCount(raw.feathers) then
		profile.feathers = math.floor(raw.feathers)
	end
	if isCount(raw.totalVisits) then
		profile.totalVisits = math.floor(raw.totalVisits)
	end
	if isCount(raw.plots) then
		profile.plots = math.clamp(math.floor(raw.plots), Config.START_PLOTS, Config.MAX_PLOTS)
	end

	if type(raw.seeds) == "table" then
		profile.seeds = {}
		for id, count in raw.seeds do
			if Seeds.isValid(id) and isCount(count) and count >= 1 then
				profile.seeds[id] = math.floor(count)
			end
		end
	end
	if type(raw.birds) == "table" then
		for id, count in raw.birds do
			if type(id) == "string" and Birds.get(id) and isCount(count) and count >= 1 then
				profile.birds[id] = math.floor(count)
			end
		end
	end
	if type(raw.plants) == "table" then
		local now = Clock.now()
		for key, record in raw.plants do
			local index = tonumber(key)
			if
				index
				and index == math.floor(index)
				and index >= 1
				and index <= profile.plots
				and type(record) == "table"
				and Seeds.isValid(record.seedId)
				and type(record.plantedAt) == "number"
			then
				profile.plants[tostring(index)] = {
					seedId = record.seedId,
					plantedAt = math.min(record.plantedAt, now), -- no planting in the future
				}
			end
		end
	end
	return profile
end

function DataService.snapshot(profile: Profile): Types.Snapshot
	local seeds, birds = {}, {}
	for id, count in profile.seeds do
		seeds[id] = count
	end
	for id, count in profile.birds do
		birds[id] = count
	end
	return {
		feathers = profile.feathers,
		seeds = seeds,
		birds = birds,
		plots = profile.plots,
		nextPlotPrice = Growth.plotPrice(profile.plots),
		totalVisits = profile.totalVisits,
	}
end

local function updateLeaderstats(player: Player, profile: Profile)
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		return
	end
	local feathers = stats:FindFirstChild("Feathers") :: IntValue?
	if feathers then
		feathers.Value = profile.feathers
	end
	local species = stats:FindFirstChild("Birds") :: IntValue?
	if species then
		local count = 0
		for _ in profile.birds do
			count += 1
		end
		species.Value = count
	end
end

-- Call after changing a profile: marks it for saving and syncs the client
-- (batched, so many changes in one frame send one update).
function DataService.push(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	dirty[player] = true
	updateLeaderstats(player, profile)
	if pushPending[player] then
		return
	end
	pushPending[player] = true
	task.defer(function()
		pushPending[player] = nil
		local current = profiles[player]
		if current and player.Parent == Players then
			Remotes.StateUpdate:FireClient(player, DataService.snapshot(current))
		end
	end)
end

-- Soft-lock protection: a player with no plants, no seeds and too few feathers
-- to buy the cheapest seed would be stuck forever, so give them one free seed.
function DataService.rescue(player: Player): boolean
	local profile = profiles[player]
	if not profile or next(profile.plants) ~= nil then
		return false
	end
	for _, count in profile.seeds do
		if count > 0 then
			return false
		end
	end
	local cheapest = Seeds.list[1]
	if profile.feathers >= cheapest.price then
		return false
	end
	profile.seeds[cheapest.id] = 1
	DataService.push(player)
	return true
end

function DataService.get(player: Player): Profile?
	return profiles[player]
end

-- Loads (yields). Returns nil if the player was kicked because loading failed.
function DataService.load(player: Player): Profile?
	local raw: any = nil
	local ok = true
	local ds = getStore()

	if ds then
		for attempt = 1, 3 do
			local success, result = pcall(function()
				return ds:GetAsync(keyFor(player))
			end)
			if success then
				raw, ok = result, true
				break
			end
			ok = false
			if attempt < 3 then
				task.wait(1.5 * attempt)
			else
				warn(`[DataService] Could not load {player.Name}: {result}`)
			end
		end
	else
		ok = false
	end

	if not ok then
		if RunService:IsStudio() then
			-- Studio without "Enable Studio Access to API Services": play with fresh data.
			ephemeral[player] = true
			if not storeWarned then
				storeWarned = true
				warn(
					"[DataService] DataStore unavailable - progress will NOT be saved in this session. "
						.. "Enable Game Settings > Security > 'Enable Studio Access to API Services' to test saving."
				)
			end
		else
			-- Never let a player continue on default data: saving would overwrite their real save.
			player:Kick("We couldn't load your garden. Please rejoin in a moment.")
			return nil
		end
	end

	local profile = sanitize(raw)
	profiles[player] = profile
	return profile
end

-- Creates the leaderboard entries (call once the profile is loaded).
function DataService.attach(player: Player)
	local profile = profiles[player]
	if not profile or player:FindFirstChild("leaderstats") then
		return
	end
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local feathers = Instance.new("IntValue")
	feathers.Name = "Feathers"
	feathers.Parent = stats
	local species = Instance.new("IntValue")
	species.Name = "Birds"
	species.Parent = stats
	stats.Parent = player
	updateLeaderstats(player, profile)
end

function DataService.save(player: Player): boolean
	local profile = profiles[player]
	local ds = getStore()
	if not profile or not ds or ephemeral[player] then
		return false
	end
	for attempt = 1, 3 do
		local success, err = pcall(function()
			ds:UpdateAsync(keyFor(player), function()
				return profile
			end)
		end)
		if success then
			dirty[player] = nil
			return true
		end
		if attempt < 3 then
			task.wait(1.5 * attempt)
		else
			warn(`[DataService] Could not save {player.Name}: {err}`)
		end
	end
	return false
end

function DataService.release(player: Player)
	profiles[player] = nil
	ephemeral[player] = nil
	dirty[player] = nil
	pushPending[player] = nil
end

-- Saves everyone in parallel (used when the server shuts down).
function DataService.saveAll()
	local pending = 0
	for player in profiles do
		pending += 1
		task.spawn(function()
			DataService.save(player)
			pending -= 1
		end)
	end
	local deadline = os.clock() + 25
	while pending > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
end

function DataService.startAutosave()
	task.spawn(function()
		while true do
			task.wait(Config.AUTOSAVE_INTERVAL)
			for player in profiles do
				if dirty[player] then
					task.spawn(DataService.save, player)
				end
			end
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">DevService</string>
          <string name="Source"><![CDATA[--!strict
-- Studio-only cheats so the whole progression can be tested in minutes.
-- Ignored completely on live servers.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes")).get()
local Seeds = require(Shared:WaitForChild("Seeds"))

local DataService = require(script.Parent.DataService)
local GardenService = require(script.Parent.GardenService)
local PlantService = require(script.Parent.PlantService)
local ShopService = require(script.Parent.ShopService)

local DevService = {}

function DevService.init()
	if not RunService:IsStudio() then
		return
	end
	Remotes.Dev.OnServerEvent:Connect(function(player: Player, action: any)
		local profile = DataService.get(player)
		if not profile or type(action) ~= "string" then
			return
		end
		if action == "feathers" then
			profile.feathers += 100000
		elseif action == "seeds" then
			for _, seed in Seeds.list do
				profile.seeds[seed.id] = (profile.seeds[seed.id] or 0) + 5
			end
		elseif action == "grow" then
			PlantService.growAll(player)
		elseif action == "plots" then
			profile.plots = Config.MAX_PLOTS
			GardenService.refreshPlots(player, profile.plots)
		elseif action == "stock" then
			ShopService.devFillStock()
		end
		DataService.push(player)
	end)
end

return DevService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">GardenService</string>
          <string name="Source"><![CDATA[--!strict
-- Hands out garden slots to players and keeps the plots' look in sync with
-- how many the owner has unlocked.

local Players = game:GetService("Players")

local WorldBuilder = require(script.Parent.WorldBuilder)
type Garden = WorldBuilder.Garden

local GardenService = {}

local SOIL_COLOR = Color3.fromRGB(96, 68, 46)
local LOCKED_COLOR = Color3.fromRGB(116, 118, 124)

local world: WorldBuilder.World? = nil
local byPlayer: { [Player]: Garden } = {}

function GardenService.init(builtWorld: WorldBuilder.World)
	world = builtWorld
end

local function setLocked(garden: Garden, index: number, locked: boolean)
	local soil = garden.plots[index]
	soil:SetAttribute("Locked", locked)
	soil.Color = if locked then LOCKED_COLOR else SOIL_COLOR
	soil.Material = if locked then Enum.Material.Slate else Enum.Material.Ground
	garden.lockGuis[index].Enabled = locked
end

local function setSign(garden: Garden, text: string)
	for _, label in garden.signLabels do
		label.Text = text
	end
end

function GardenService.get(player: Player): Garden?
	return byPlayer[player]
end

function GardenService.assign(player: Player): Garden?
	if not world then
		return nil
	end
	for _, garden in world.gardens do
		if garden.owner == nil then
			garden.owner = player
			garden.model:SetAttribute("OwnerUserId", player.UserId)
			setSign(garden, player.DisplayName .. "'s Garden")
			byPlayer[player] = garden
			return garden
		end
	end
	return nil
end

function GardenService.release(player: Player)
	local garden = byPlayer[player]
	if not garden then
		return
	end
	byPlayer[player] = nil
	garden.owner = nil
	garden.model:SetAttribute("OwnerUserId", 0)
	setSign(garden, "Free Garden")
	for index, soil in garden.plots do
		soil:SetAttribute("HasPlant", false)
		setLocked(garden, index, true)
	end
end

function GardenService.refreshPlots(player: Player, unlocked: number)
	local garden = byPlayer[player]
	if not garden then
		return
	end
	for index in garden.plots do
		setLocked(garden, index, index > unlocked)
	end
end

function GardenService.setHasPlant(player: Player, index: number, has: boolean)
	local garden = byPlayer[player]
	if garden then
		garden.plots[index]:SetAttribute("HasPlant", has)
	end
end

-- Where a plant's root sits: the middle of the soil's top surface.
function GardenService.plantCFrame(player: Player, index: number): CFrame?
	local garden = byPlayer[player]
	if not garden then
		return nil
	end
	local soil = garden.plots[index]
	return soil.CFrame * CFrame.new(0, soil.Size.Y / 2, 0)
end

function GardenService.placeCharacter(player: Player)
	local garden = byPlayer[player]
	local character = player.Character
	if not garden or not character or player.Parent ~= Players then
		return
	end
	local root = character:WaitForChild("HumanoidRootPart", 5)
	if root and character.Parent then
		character:PivotTo(garden.spawnCF)
	end
end

return GardenService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">PlantService</string>
          <string name="Source"><![CDATA[--!strict
-- Planting, growing and digging up plants. Growth is derived from the planting
-- timestamp, so plants keep growing while the owner is offline.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Clock = require(Shared:WaitForChild("Clock"))
local Config = require(Shared:WaitForChild("Config"))
local Growth = require(Shared:WaitForChild("Growth"))
local PlantModels = require(Shared:WaitForChild("PlantModels"))
local Remotes = require(Shared:WaitForChild("Remotes")).get()
local Scheduler = require(Shared:WaitForChild("Scheduler"))
local Seeds = require(Shared:WaitForChild("Seeds"))
local Types = require(Shared:WaitForChild("Types"))

local BirdService = require(script.Parent.BirdService)
local DataService = require(script.Parent.DataService)
local GardenService = require(script.Parent.GardenService)
local WorldBuilder = require(script.Parent.WorldBuilder)

local PlantService = {}

type PlantState = {
	player: Player,
	plotIndex: number,
	seed: Types.SeedDef,
	plantedAt: number,
	model: Model,
	root: BasePart,
	mature: boolean,
	lastScale: number,
	slots: { Scheduler.Slot },
}

local states: { [Player]: { [number]: PlantState } } = {}
local plantsFolder: Folder? = nil
local rng = Random.new()

local function notify(player: Player, text: string, color: Color3?)
	local notice: Types.Notice = { kind = "toast", text = text, color = color }
	Remotes.Notify:FireClient(player, notice)
end

local function bloom(state: PlantState, now: number, announce: boolean)
	state.mature = true
	PlantModels.setMature(state.model, true)
	state.slots = {}
	for _ in state.seed.perches do
		table.insert(state.slots, Scheduler.newSlot(now, rng, true))
	end
	if announce then
		notify(
			state.player,
			`Your {state.seed.name} is fully grown! Birds will start visiting soon.`,
			Config.RARITY_COLORS[state.seed.rarity]
		)
	end
end

local function spawnPlant(
	player: Player,
	plotIndex: number,
	seedId: string,
	plantedAt: number,
	announce: boolean
): PlantState?
	local seed = Seeds.get(seedId)
	local cf = GardenService.plantCFrame(player, plotIndex)
	local folder = plantsFolder
	if not seed or not cf or not folder then
		return nil
	end

	local now = Clock.now()
	local progress = Growth.progress(plantedAt, seed.growTime, now)
	local model = PlantModels.build(seedId, cf, false)
	if not model then
		return nil
	end
	model.Name = string.format("Plant_%d_%d", player.UserId, plotIndex)
	model:SetAttribute("SeedId", seedId)
	model:SetAttribute("PlantedAt", plantedAt)
	model:SetAttribute("GrowTime", seed.growTime)
	model:SetAttribute("OwnerUserId", player.UserId)
	model:SetAttribute("PlotIndex", plotIndex)
	CollectionService:AddTag(model, "Plant")
	model.Parent = folder

	local scale = Growth.scale(progress)
	if scale < 1 then
		model:ScaleTo(scale)
	end

	local state: PlantState = {
		player = player,
		plotIndex = plotIndex,
		seed = seed,
		plantedAt = plantedAt,
		model = model,
		root = model.PrimaryPart :: BasePart,
		mature = false,
		lastScale = scale,
		slots = {},
	}
	if progress >= 1 then
		bloom(state, now, announce)
	end

	local plants = states[player]
	if not plants then
		plants = {}
		states[player] = plants
	end
	plants[plotIndex] = state
	GardenService.setHasPlant(player, plotIndex, true)
	return state
end

local function updatePlant(state: PlantState, now: number)
	if state.mature then
		BirdService.update(state, now)
		return
	end
	local progress = Growth.progress(state.plantedAt, state.seed.growTime, now)
	local scale = Growth.scale(progress)
	if progress >= 1 then
		state.model:ScaleTo(1)
		state.lastScale = 1
		bloom(state, now, true)
	elseif scale - state.lastScale >= 0.012 then
		state.model:ScaleTo(scale)
		state.lastScale = scale
	end
end

function PlantService.init(world: WorldBuilder.World)
	plantsFolder = world.plantsFolder
	task.spawn(function()
		while true do
			task.wait(Config.TICK)
			local now = Clock.now()
			for _, plants in states do
				for _, state in plants do
					xpcall(updatePlant, function(err)
						warn("[PlantService] update failed: " .. tostring(err))
					end, state, now)
				end
			end
		end
	end)
end

-- Recreates a player's saved plants when they join.
function PlantService.loadPlayer(player: Player, profile: DataService.Profile)
	for key, record in profile.plants do
		local index = tonumber(key)
		if index then
			spawnPlant(player, index, record.seedId, record.plantedAt, false)
		end
	end
end

function PlantService.plant(player: Player, plotIndex: any, seedId: any)
	local profile = DataService.get(player)
	if not profile or not GardenService.get(player) then
		return
	end
	if
		type(plotIndex) ~= "number"
		or plotIndex ~= math.floor(plotIndex)
		or plotIndex < 1
		or plotIndex > Config.MAX_PLOTS
	then
		return
	end
	if plotIndex > profile.plots then
		notify(player, "That plot is still locked.")
		return
	end
	if not Seeds.isValid(seedId) then
		return
	end
	local id = seedId :: string
	local key = tostring(plotIndex)
	if profile.plants[key] then
		notify(player, "Something is already growing there.")
		return
	end
	local count = profile.seeds[id] or 0
	if count < 1 then
		notify(player, "You don't have any of that seed. Visit the Seed Shop!")
		return
	end

	local plantedAt = Clock.now()
	if not spawnPlant(player, plotIndex, id, plantedAt, true) then
		return
	end
	if count > 1 then
		profile.seeds[id] = count - 1
	else
		profile.seeds[id] = nil
	end
	profile.plants[key] = { seedId = id, plantedAt = plantedAt }
	DataService.push(player)
end

-- Digging up a growing plant returns the seed; a grown plant is lost for good.
function PlantService.dig(player: Player, plotIndex: any)
	local profile = DataService.get(player)
	if not profile or type(plotIndex) ~= "number" then
		return
	end
	local plants = states[player]
	local state = if plants then plants[plotIndex] else nil
	if not plants or not state then
		return
	end

	BirdService.cancelHabitat(state)
	state.model:Destroy()
	plants[plotIndex] = nil
	profile.plants[tostring(plotIndex)] = nil
	if not state.mature then
		profile.seeds[state.seed.id] = (profile.seeds[state.seed.id] or 0) + 1
	end
	GardenService.setHasPlant(player, plotIndex, false)
	DataService.push(player)
	if DataService.rescue(player) then
		notify(player, "Here's a free Sunflower seed to get you going again!", Config.RARITY_COLORS.Common)
	end
end

function PlantService.clearPlayer(player: Player)
	local plants = states[player]
	if not plants then
		return
	end
	states[player] = nil
	for _, state in plants do
		BirdService.cancelHabitat(state)
		state.model:Destroy()
	end
end

-- Dev helper: finish every growing plant right now.
function PlantService.growAll(player: Player)
	local profile = DataService.get(player)
	local plants = states[player]
	if not profile or not plants then
		return
	end
	local now = Clock.now()
	for index, state in plants do
		if not state.mature then
			local plantedAt = now - state.seed.growTime
			state.plantedAt = plantedAt
			state.model:SetAttribute("PlantedAt", plantedAt)
			local record = profile.plants[tostring(index)]
			if record then
				record.plantedAt = plantedAt
			end
		end
	end
	DataService.push(player)
end

return PlantService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[--!strict
-- The seed shop. Stock restocks on a fixed global clock (the roll is seeded by
-- the restock number, so every server shows the same shelves) and is shared by
-- everyone on the server, so rare seeds can sell out.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Clock = require(Shared:WaitForChild("Clock"))
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Growth = require(Shared:WaitForChild("Growth"))
local Remotes = require(Shared:WaitForChild("Remotes")).get()
local Seeds = require(Shared:WaitForChild("Seeds"))
local Types = require(Shared:WaitForChild("Types"))

local DataService = require(script.Parent.DataService)
local GardenService = require(script.Parent.GardenService)

local ShopService = {}

local currentIndex = -1
local stock: { [string]: number } = {}

-- Returns true if a new restock just happened.
local function refresh(): boolean
	local index = Growth.restockIndex(Clock.now())
	if index == currentIndex then
		return false
	end
	currentIndex = index
	stock = Growth.rollStock(index)
	return true
end

function ShopService.getStock(): Types.StockInfo
	refresh()
	local copy = {}
	for id, count in stock do
		copy[id] = count
	end
	return { stock = copy, nextRestock = Growth.nextRestock(Clock.now()) }
end

local function broadcast()
	Remotes.StockUpdate:FireAllClients(ShopService.getStock())
end

function ShopService.init()
	refresh()
	task.spawn(function()
		while true do
			task.wait(1)
			if refresh() then
				broadcast()
			end
		end
	end)
end

function ShopService.buySeed(player: Player, seedId: any, amount: any): Types.Result
	local profile = DataService.get(player)
	if not profile then
		return { ok = false, message = "Still loading your garden..." }
	end
	if not Seeds.isValid(seedId) then
		return { ok = false, message = "Unknown seed." }
	end
	if type(amount) ~= "number" or amount ~= math.floor(amount) or amount < 1 or amount > Config.MAX_BUY_AMOUNT then
		return { ok = false, message = "Invalid amount." }
	end

	refresh()
	local id = seedId :: string
	local seed = Seeds.get(id) :: Types.SeedDef
	local available = stock[id] or 0
	if available < 1 then
		return { ok = false, message = `{seed.name} is out of stock. Check back after the restock!` }
	end
	if amount > available then
		return { ok = false, message = `Only {available} left in stock.` }
	end
	local cost = seed.price * amount
	if profile.feathers < cost then
		return { ok = false, message = `Not enough feathers (need {Format.feathers(cost)}).` }
	end

	profile.feathers -= cost
	profile.seeds[id] = (profile.seeds[id] or 0) + amount
	stock[id] = available - amount
	DataService.push(player)
	broadcast()
	return { ok = true, message = `Bought {amount}x {seed.name}!` }
end

function ShopService.unlockPlot(player: Player): Types.Result
	local profile = DataService.get(player)
	if not profile then
		return { ok = false, message = "Still loading your garden..." }
	end
	local price = Growth.plotPrice(profile.plots)
	if not price then
		return { ok = false, message = "Every plot is already unlocked!" }
	end
	if profile.feathers < price then
		return { ok = false, message = `Not enough feathers (need {Format.feathers(price)}).` }
	end
	profile.feathers -= price
	profile.plots += 1
	GardenService.refreshPlots(player, profile.plots)
	DataService.push(player)
	return { ok = true, message = `Plot {profile.plots} unlocked!` }
end

-- Dev helper: fill every shelf.
function ShopService.devFillStock()
	refresh()
	for _, seed in Seeds.list do
		stock[seed.id] = 10
	end
	broadcast()
end

return ShopService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Throttle</string>
          <string name="Source"><![CDATA[--!strict
-- Tiny per-player rate limiter for remote handlers.

local Throttle = {}

local last: { [string]: { [Player]: number } } = {}

function Throttle.ok(player: Player, key: string, interval: number): boolean
	local bucket = last[key]
	if not bucket then
		bucket = setmetatable({}, { __mode = "k" }) :: any
		last[key] = bucket
	end
	local now = os.clock()
	local previous = (bucket :: { [Player]: number })[player]
	if previous and now - previous < interval then
		return false
	end
	(bucket :: { [Player]: number })[player] = now
	return true
end

return Throttle
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Builds the whole map from parts at startup: ground, hub plaza (seed shop +
-- Birdpedia), scenery, and one fenced garden per player slot.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Seeds = require(Shared:WaitForChild("Seeds"))

local WorldBuilder = {}

export type Garden = {
	slot: number,
	model: Model,
	origin: CFrame,
	spawnCF: CFrame,
	plots: { Part },
	lockGuis: { SurfaceGui },
	signLabels: { TextLabel },
	owner: Player?,
}

export type World = {
	gardens: { Garden },
	plantsFolder: Folder,
}

local TOP = 0.6 -- height of the walkable surface (plaza, paths, garden pads)
local GARDEN_RADIUS = 125
local PLOT_SIZE = 10
local PLOT_PITCH = 13

local GRASS = Color3.fromRGB(98, 172, 86)
local WOOD = Color3.fromRGB(150, 106, 68)
local CREAM = Color3.fromRGB(250, 240, 214)

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local function part(
	parent: Instance,
	name: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?,
	collide: boolean?
): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = if collide == nil then true else collide
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- Upright cylinder centred at `cf`
local function cylinder(
	parent: Instance,
	name: string,
	height: number,
	diameter: number,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?,
	collide: boolean?
): Part
	local p = part(
		parent,
		name,
		Vector3.new(height, diameter, diameter),
		cf * CFrame.Angles(0, 0, math.rad(90)),
		color,
		material,
		collide
	)
	p.Shape = Enum.PartType.Cylinder
	return p
end

local function ball(
	parent: Instance,
	name: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local p = part(parent, name, size, cf, color, material, false)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local function surfaceText(
	target: Part,
	face: Enum.NormalId,
	text: string,
	color: Color3?,
	pixelsPerStud: number?
): (SurfaceGui, TextLabel)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud or 40
	gui.LightInfluence = 0
	gui.Parent = target

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = color or CREAM
	label.TextStrokeColor3 = Color3.fromRGB(60, 40, 24)
	label.TextStrokeTransparency = 0.45
	label.Parent = gui
	return gui, label
end

local function billboardText(parent: BasePart, text: string, offset: Vector3, width: number, height: number): TextLabel
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(width, height)
	gui.StudsOffsetWorldSpace = offset
	gui.MaxDistance = 140
	gui.LightInfluence = 0
	gui.Parent = parent

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = CREAM
	label.TextStrokeColor3 = Color3.fromRGB(50, 34, 20)
	label.TextStrokeTransparency = 0.3
	label.Parent = gui
	return label
end

local function prompt(parent: BasePart, name: string, action: string, object: string)
	local p = Instance.new("ProximityPrompt")
	p.Name = name
	p.ActionText = action
	p.ObjectText = object
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.HoldDuration = 0
	p.MaxActivationDistance = 18
	p.RequiresLineOfSight = false
	p.Parent = parent
end

------------------------------------------------------------------------------
-- Lighting
------------------------------------------------------------------------------

function WorldBuilder.setupLighting()
	Lighting.ClockTime = 14.2
	Lighting.Brightness = 2.6
	Lighting.Ambient = rgb(104, 108, 120)
	Lighting.OutdoorAmbient = rgb(128, 134, 150)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.4

	for _, class in { "Atmosphere", "Sky", "ColorCorrectionEffect", "BloomEffect", "SunRaysEffect" } do
		for _, child in Lighting:GetChildren() do
			if child.ClassName == class then
				child:Destroy()
			end
		end
	end

	local sky = Instance.new("Sky")
	sky.Parent = Lighting

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.26
	atmosphere.Offset = 0.2
	atmosphere.Color = rgb(190, 208, 230)
	atmosphere.Decay = rgb(240, 220, 190)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 0.8
	atmosphere.Parent = Lighting

	local correction = Instance.new("ColorCorrectionEffect")
	correction.Saturation = 0.14
	correction.Contrast = 0.05
	correction.TintColor = rgb(255, 250, 242)
	correction.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.3
	bloom.Size = 20
	bloom.Threshold = 1.1
	bloom.Parent = Lighting

	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.05
	rays.Spread = 0.6
	rays.Parent = Lighting
end

------------------------------------------------------------------------------
-- Scenery
------------------------------------------------------------------------------

local function buildTree(parent: Instance, position: Vector3, scale: number, rng: Random)
	local trunkHeight = 8 * scale
	cylinder(
		parent,
		"Trunk",
		trunkHeight,
		1.6 * scale,
		CFrame.new(position + Vector3.new(0, trunkHeight / 2, 0)),
		rgb(110, 78, 54),
		Enum.Material.Wood
	)
	local greens = { rgb(70, 150, 66), rgb(84, 166, 74), rgb(62, 138, 60) }
	for i = 1, 3 do
		local offset = Vector3.new(rng:NextNumber(-2, 2), trunkHeight + rng:NextNumber(0, 3.5), rng:NextNumber(-2, 2))
			* scale
		local size = Vector3.new(8, 6.5, 8) * scale * rng:NextNumber(0.8, 1.1)
		local canopy = ball(parent, "Canopy", size, CFrame.new(position + offset), greens[i], Enum.Material.Grass)
		canopy.CanCollide = false
	end
end

local function buildScenery(world: Folder, rng: Random)
	local ground = part(world, "Ground", Vector3.new(900, 2, 900), CFrame.new(0, -1, 0), GRASS, Enum.Material.Grass)
	ground.Name = "Ground"

	-- A ring of trees around the whole map, plus a few between the gardens.
	local scenery = Instance.new("Folder")
	scenery.Name = "Trees"
	scenery.Parent = world
	for i = 1, 56 do
		local angle = i / 56 * math.pi * 2 + rng:NextNumber(-0.04, 0.04)
		local radius = rng:NextNumber(205, 245)
		buildTree(
			scenery,
			Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius),
			rng:NextNumber(1.2, 2.0),
			rng
		)
	end
	for i = 1, Config.MAX_GARDENS do
		-- between two neighbouring gardens
		local angle = (i - 0.5) / Config.MAX_GARDENS * math.pi * 2
		buildTree(scenery, Vector3.new(math.cos(angle) * 128, 0, math.sin(angle) * 128), rng:NextNumber(1.1, 1.5), rng)
	end
end

local function buildHub(world: Folder)
	local hub = Instance.new("Model")
	hub.Name = "Hub"
	hub.Parent = world

	cylinder(hub, "Plaza", TOP, 88, CFrame.new(0, TOP / 2, 0), rgb(206, 198, 182), Enum.Material.Cobblestone)
	cylinder(
		hub,
		"PlazaInner",
		TOP + 0.04,
		58,
		CFrame.new(0, (TOP + 0.04) / 2, 0),
		rgb(224, 214, 190),
		Enum.Material.Slate
	)

	-- Paths from the plaza to each garden entrance
	for slot = 1, Config.MAX_GARDENS do
		local angle = (slot - 1) / Config.MAX_GARDENS * math.pi * 2
		local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local from, to = 40, GARDEN_RADIUS - 29
		local center = dir * ((from + to) / 2)
		part(
			hub,
			"Path",
			Vector3.new(9, TOP, to - from),
			CFrame.lookAt(center + Vector3.new(0, TOP / 2, 0), Vector3.new(0, TOP / 2, 0)),
			rgb(214, 190, 150),
			Enum.Material.Sand
		)
	end

	-- Seed shop kiosk
	local shop = Instance.new("Model")
	shop.Name = "SeedShop"
	shop.Parent = hub
	local counter = cylinder(shop, "Counter", 4, 12, CFrame.new(0, TOP + 2, 0), WOOD, Enum.Material.Wood)
	cylinder(shop, "CounterTop", 0.5, 13.5, CFrame.new(0, TOP + 4.25, 0), rgb(240, 220, 176), Enum.Material.WoodPlanks)
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2 + math.pi / 4
		part(
			shop,
			"Post",
			Vector3.new(0.8, 8, 0.8),
			CFrame.new(math.cos(a) * 5.4, TOP + 8.5, math.sin(a) * 5.4),
			rgb(220, 196, 150),
			Enum.Material.Wood
		)
	end
	cylinder(shop, "Roof", 0.8, 17, CFrame.new(0, TOP + 12.9, 0), rgb(206, 72, 62), Enum.Material.SmoothPlastic)
	cylinder(shop, "RoofTrim", 0.9, 14, CFrame.new(0, TOP + 12.9, 0), rgb(246, 240, 230), Enum.Material.SmoothPlastic)
	cylinder(shop, "RoofTop", 1.4, 6, CFrame.new(0, TOP + 14, 0), rgb(206, 72, 62), Enum.Material.SmoothPlastic)
	-- jars of every seed on the counter
	for i, seed in Seeds.list do
		local a = i / #Seeds.list * math.pi * 2
		ball(
			shop,
			"SeedJar",
			Vector3.new(1.5, 1.5, 1.5),
			CFrame.new(math.cos(a) * 4.2, TOP + 5.3, math.sin(a) * 4.2),
			seed.color,
			Enum.Material.Neon
		)
	end
	prompt(counter, "ShopPrompt", "Browse Seeds", "Seed Shop")
	billboardText(counter, "SEED SHOP", Vector3.new(0, 17, 0), 300, 70)

	-- Birdpedia board
	local boardPos = Vector3.new(24, 0, 24)
	local boardCF = CFrame.lookAt(Vector3.new(boardPos.X, TOP + 6.5, boardPos.Z), Vector3.new(0, TOP + 6.5, 0))
	local board = part(hub, "BirdpediaBoard", Vector3.new(13, 5.5, 0.6), boardCF, rgb(86, 120, 98), Enum.Material.Wood)
	for _, x in { -5.5, 5.5 } do
		part(hub, "BoardPost", Vector3.new(0.9, 7, 0.9), boardCF * CFrame.new(x, -2.2, 0.2), WOOD, Enum.Material.Wood)
	end
	surfaceText(board, Enum.NormalId.Front, "BIRDPEDIA\nSee every bird you've attracted", CREAM, 30)
	prompt(board, "BirdpediaPrompt", "Open Birdpedia", "Field Guide")

	-- Hub spawn (players are moved to their own garden once their data loads)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "HubSpawn"
	spawn.Size = Vector3.new(10, 0.2, 10)
	spawn.CFrame = CFrame.new(0, TOP + 0.1, 32)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.CanCollide = false
	spawn.Transparency = 1
	spawn.Duration = 0
	spawn.Parent = hub
end

------------------------------------------------------------------------------
-- Gardens
------------------------------------------------------------------------------

local function buildGarden(slot: number, parent: Folder): Garden
	local angle = (slot - 1) / Config.MAX_GARDENS * math.pi * 2
	local center = Vector3.new(math.cos(angle) * GARDEN_RADIUS, 0, math.sin(angle) * GARDEN_RADIUS)
	-- local -Z points at the hub, so the entrance is on the hub side
	local origin = CFrame.lookAt(center, Vector3.zero)
	local function at(x: number, y: number, z: number): CFrame
		return origin * CFrame.new(x, y, z)
	end

	local model = Instance.new("Model")
	model.Name = "Garden_" .. slot
	model:SetAttribute("Slot", slot)
	model:SetAttribute("OwnerUserId", 0)
	model.Parent = parent

	part(model, "Pad", Vector3.new(60, TOP, 58), at(0, TOP / 2, 0), rgb(112, 184, 92), Enum.Material.Grass)

	-- soil plots, row by row from the entrance outwards
	local plots: { Part } = {}
	local lockGuis: { SurfaceGui } = {}
	for row = 1, Config.PLOT_ROWS do
		for col = 1, Config.PLOT_COLUMNS do
			local index = (row - 1) * Config.PLOT_COLUMNS + col
			local x = (col - (Config.PLOT_COLUMNS + 1) / 2) * PLOT_PITCH
			local z = -9 + (row - 1) * PLOT_PITCH
			local soil = part(
				model,
				"Plot_" .. index,
				Vector3.new(PLOT_SIZE, 0.5, PLOT_SIZE),
				at(x, TOP + 0.25, z),
				rgb(116, 118, 124),
				Enum.Material.Slate
			)
			soil:SetAttribute("Index", index)
			soil:SetAttribute("Locked", true)
			soil:SetAttribute("HasPlant", false)
			local gui, label = surfaceText(soil, Enum.NormalId.Top, "LOCKED", rgb(210, 214, 222), 24)
			label.TextTransparency = 0.25
			plots[index] = soil
			lockGuis[index] = gui
		end
	end

	-- fence with a gap at the entrance
	local rail = Vector3.new(0.6, 1.4, 58)
	part(model, "FenceL", rail, at(-30, TOP + 0.7, 0), WOOD, Enum.Material.Wood)
	part(model, "FenceR", rail, at(30, TOP + 0.7, 0), WOOD, Enum.Material.Wood)
	part(model, "FenceBack", Vector3.new(60.6, 1.4, 0.6), at(0, TOP + 0.7, 29), WOOD, Enum.Material.Wood)
	part(model, "FenceFrontL", Vector3.new(22, 1.4, 0.6), at(-19, TOP + 0.7, -29), WOOD, Enum.Material.Wood)
	part(model, "FenceFrontR", Vector3.new(22, 1.4, 0.6), at(19, TOP + 0.7, -29), WOOD, Enum.Material.Wood)

	-- entrance arch with the owner's name
	part(model, "ArchPostL", Vector3.new(0.9, 7.5, 0.9), at(-8.5, TOP + 3.75, -29), WOOD, Enum.Material.Wood)
	part(model, "ArchPostR", Vector3.new(0.9, 7.5, 0.9), at(8.5, TOP + 3.75, -29), WOOD, Enum.Material.Wood)
	part(model, "ArchBeam", Vector3.new(18.8, 1, 1), at(0, TOP + 8, -29), WOOD, Enum.Material.Wood)
	local sign =
		part(model, "Sign", Vector3.new(13, 3.4, 0.5), at(0, TOP + 10.2, -29), rgb(94, 128, 100), Enum.Material.Wood)
	part(model, "SignStrut", Vector3.new(0.5, 1.8, 0.5), at(-4, TOP + 8.9, -29), WOOD, Enum.Material.Wood)
	part(model, "SignStrut", Vector3.new(0.5, 1.8, 0.5), at(4, TOP + 8.9, -29), WOOD, Enum.Material.Wood)
	local signLabels: { TextLabel } = {}
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local _, label = surfaceText(sign, face, "Free Garden", CREAM, 40)
		table.insert(signLabels, label)
	end

	-- decorative bird bath at the back
	cylinder(model, "BathBase", 2.2, 1.8, at(0, TOP + 1.1, 25), rgb(200, 196, 188), Enum.Material.Marble)
	cylinder(model, "BathBowl", 0.9, 5, at(0, TOP + 2.6, 25), rgb(214, 210, 202), Enum.Material.Marble)
	local water =
		cylinder(model, "BathWater", 0.12, 4.2, at(0, TOP + 3.1, 25), rgb(120, 190, 255), Enum.Material.Glass, false)
	water.Transparency = 0.25

	local spawnCF = at(0, TOP + 3.5, -21) * CFrame.Angles(0, math.pi, 0)

	return {
		slot = slot,
		model = model,
		origin = origin,
		spawnCF = spawnCF,
		plots = plots,
		lockGuis = lockGuis,
		signLabels = signLabels,
		owner = nil,
	}
end

function WorldBuilder.build(): World
	WorldBuilder.setupLighting()

	local worldFolder = Instance.new("Folder")
	worldFolder.Name = "World"
	worldFolder.Parent = workspace
	local rng = Random.new(2024)
	buildScenery(worldFolder, rng)
	buildHub(worldFolder)

	local gardensFolder = Instance.new("Folder")
	gardensFolder.Name = "Gardens"
	gardensFolder.Parent = workspace
	local gardens: { Garden } = {}
	for slot = 1, Config.MAX_GARDENS do
		gardens[slot] = buildGarden(slot, gardensFolder)
	end

	local plants = Instance.new("Folder")
	plants.Name = "Plants"
	plants.Parent = workspace

	return { gardens = gardens, plantsFolder = plants }
end

return WorldBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="25">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="26">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="27">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
-- Grow a Bird Garden - client entry point.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes")).get()

local BirdRenderer = require(script.BirdRenderer)
local BirdpediaUI = require(script.BirdpediaUI)
local DevPanel = require(script.DevPanel)
local Hotbar = require(script.Hotbar)
local Hud = require(script.Hud)
local Objective = require(script.Objective)
local PlantLabels = require(script.PlantLabels)
local Prompts = require(script.Prompts)
local ShopUI = require(script.ShopUI)
local State = require(script.State)
local Toasts = require(script.Toasts)
local Ui = require(script.Ui)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Ask the server for everything we need (it replies once our garden is ready).
local init: any = nil
for _ = 1, 5 do
	local ok, result = pcall(function()
		return Remotes.Init:InvokeServer()
	end)
	if ok and result then
		init = result
		break
	end
	task.wait(2)
end
if not init then
	warn("[BirdGarden] Could not load game data from the server.")
	return
end

State.apply(init.state)
State.setStock(init.stock)

local gui = Ui.new("ScreenGui", {
	Name = "BirdGardenUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 5,
	Parent = playerGui,
})

Toasts.init(gui)
Hud.init(gui, ShopUI.toggle, BirdpediaUI.toggle)
Objective.init(gui)
Hotbar.init(gui)
ShopUI.init(gui)
BirdpediaUI.init(gui)
DevPanel.init(gui)
PlantLabels.init()
Prompts.init()
BirdRenderer.init(init.visits)

Remotes.StateUpdate.OnClientEvent:Connect(State.apply)
Remotes.StockUpdate.OnClientEvent:Connect(State.setStock)
Remotes.Notify.OnClientEvent:Connect(Toasts.handle)
Remotes.BirdVisit.OnClientEvent:Connect(BirdRenderer.add)
Remotes.BirdCancel.OnClientEvent:Connect(BirdRenderer.remove)

-- The kiosk and the field-guide board in the plaza open the matching window.
ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt)
	if prompt.Name == "ShopPrompt" then
		ShopUI.open()
	elseif prompt.Name == "BirdpediaPrompt" then
		BirdpediaUI.open()
	end
end)

UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if not processed and input.KeyCode == Enum.KeyCode.B then
		BirdpediaUI.toggle()
	end
end)
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">BirdRenderer</string>
            <string name="Source"><![CDATA[--!strict
-- Draws every bird visit. The server only sends a tiny description of each
-- visit; this module animates the bird locally from BirdFlight, so birds are
-- perfectly smooth and cost nothing in network traffic.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BirdFlight = require(Shared:WaitForChild("BirdFlight"))
local BirdModel = require(Shared:WaitForChild("BirdModel"))
local Birds = require(Shared:WaitForChild("Birds"))
local Clock = require(Shared:WaitForChild("Clock"))
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))

local Ui = require(script.Parent.Ui)

local BirdRenderer = {}

type Active = {
	info: Types.VisitInfo,
	rig: BirdModel.Rig,
	duration: number,
	attached: boolean,
	flap: number,
	wingPhase: number,
	nameGui: BillboardGui,
}

local CULL_DISTANCE = 260 -- birds further than this aren't drawn at all

local active: { [number]: Active } = {}
local folder: Folder

local function destroy(id: number)
	local bird = active[id]
	if bird then
		active[id] = nil
		bird.rig.model:Destroy()
	end
end

function BirdRenderer.add(info: Types.VisitInfo)
	if active[info.id] then
		return
	end
	local def = Birds.get(info.birdId)
	if not def then
		return
	end
	local duration = BirdFlight.duration(info)
	if Clock.now() - info.startTime >= duration then
		return -- this visit is already over
	end

	local rig = BirdModel.build(def)
	local color = Config.RARITY_COLORS[def.rarity]
	local gui = Ui.new("BillboardGui", {
		Name = "NameTag",
		Size = UDim2.fromOffset(150, 26),
		StudsOffsetWorldSpace = Vector3.new(0, rig.height + 1.1, 0),
		MaxDistance = 55,
		LightInfluence = 0,
		Adornee = rig.model.PrimaryPart,
		Parent = rig.model.PrimaryPart,
	})
	Ui.label({
		Size = UDim2.fromScale(1, 1),
		Text = def.name,
		Font = Ui.FONT,
		TextSize = 17,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.25,
		Parent = gui,
	})

	active[info.id] = {
		info = info,
		rig = rig,
		duration = duration,
		attached = false,
		flap = 1,
		wingPhase = info.seed,
		nameGui = gui,
	}
end

function BirdRenderer.remove(id: number)
	destroy(id)
end

local function step(dt: number)
	local camera = workspace.CurrentCamera
	local cameraPosition = if camera then camera.CFrame.Position else Vector3.zero
	local now = Clock.now()

	for id, bird in active do
		local t = now - bird.info.startTime
		if t >= bird.duration then
			destroy(id)
		else
			local sample = BirdFlight.sample(bird.info, t)
			if (sample.position - cameraPosition).Magnitude > CULL_DISTANCE then
				if bird.attached then
					bird.attached = false
					bird.rig.model.Parent = nil
				end
			else
				-- ease the wings between folded (perched) and beating (flying)
				bird.flap += (sample.flap - bird.flap) * math.min(1, dt * 10)
				bird.wingPhase += dt * bird.rig.flapRate
				local angle = bird.flap * (1.25 + 0.95 * math.sin(bird.wingPhase))

				local look = sample.look
				if math.abs(look.Y) > 0.98 then
					look = Vector3.new(look.X + 0.05, look.Y, look.Z)
				end
				BirdModel.pose(bird.rig, CFrame.lookAt(sample.position, sample.position + look), angle)

				bird.nameGui.Enabled = sample.phase ~= "leave"
				if not bird.attached then
					bird.attached = true
					bird.rig.model.Parent = folder
				end
			end
		end
	end
end

function BirdRenderer.init(initialVisits: { Types.VisitInfo })
	folder = Ui.new("Folder", { Name = "ClientBirds", Parent = workspace })
	for _, info in initialVisits do
		BirdRenderer.add(info)
	end
	RunService.RenderStepped:Connect(step)
end

return BirdRenderer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">BirdpediaUI</string>
            <string name="Source"><![CDATA[--!strict
-- The field guide: every species in the game. Birds you haven't seen yet are
-- silhouettes with a hint about which seed attracts them.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BirdModel = require(Shared:WaitForChild("BirdModel"))
local Birds = require(Shared:WaitForChild("Birds"))
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Seeds = require(Shared:WaitForChild("Seeds"))
local Types = require(Shared:WaitForChild("Types"))

local State = require(script.Parent.State)
local Ui = require(script.Parent.Ui)
local Viewport = require(script.Parent.Viewport)

local BirdpediaUI = {}

type Card = {
	def: Types.BirdDef,
	viewport: ViewportFrame,
	name: TextLabel,
	detail: TextLabel,
	discovered: boolean?, -- what the viewport currently shows
}

local overlay: TextButton
local header: TextLabel
local listFrame: ScrollingFrame
local cards: { Card } = {}
local built = false

-- The seed that most likely brings this bird (highest weight wins).
local function hintSeed(birdId: string): Types.SeedDef?
	local best: Types.SeedDef? = nil
	local bestWeight = 0
	for _, seed in Seeds.list do
		for _, entry in seed.birds do
			if entry.id == birdId and entry.weight > bestWeight then
				best, bestWeight = seed, entry.weight
			end
		end
	end
	return best
end

local function refresh()
	if not built then
		return
	end
	header.Text = `Birdpedia   {State.speciesDiscovered()} / {#Birds.list} discovered   -   {Format.commas(
		State.totalVisits
	)} visits`
	for _, card in cards do
		local seen = State.birds[card.def.id]
		local discovered = seen ~= nil
		local color = Config.RARITY_COLORS[card.def.rarity]

		if card.discovered ~= discovered then
			card.discovered = discovered
			Viewport.mount(card.viewport, BirdModel.build(card.def, not discovered).model)
		end
		if discovered then
			card.name.Text = card.def.name
			card.name.TextColor3 = color
			card.detail.Text = `Seen x{seen}\n{Format.feathers(card.def.value)} per visit`
			card.detail.TextColor3 = Ui.COLORS.text
		else
			card.name.Text = "???"
			card.name.TextColor3 = Ui.COLORS.muted
			local seed = hintSeed(card.def.id)
			card.detail.Text = `{card.def.rarity}\nTry: {if seed then seed.name else "?"}`
			card.detail.TextColor3 = Ui.COLORS.muted
		end
	end
end

local function buildCards(list: Instance)
	for _, def in Birds.list do
		local color = Config.RARITY_COLORS[def.rarity]
		local frame = Ui.new(
			"Frame",
			{ Name = def.id, BackgroundColor3 = Ui.COLORS.row, Parent = list },
			{ Ui.corner(14), Ui.stroke(color, 2, 0.4) }
		)
		Ui.new(
			"Frame",
			{ Size = UDim2.new(1, 0, 0, 5), BackgroundColor3 = color, BorderSizePixel = 0, Parent = frame },
			{ Ui.corner(3) }
		)
		local viewport = Ui.new("ViewportFrame", {
			Position = UDim2.fromOffset(10, 12),
			Size = UDim2.new(1, -20, 0, 96),
			BackgroundColor3 = Ui.COLORS.bg,
			BackgroundTransparency = 0,
			Parent = frame,
		}, { Ui.corner(10) })
		local name = Ui.label({
			Position = UDim2.fromOffset(6, 112),
			Size = UDim2.new(1, -12, 0, 22),
			Font = Ui.FONT,
			TextSize = 17,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = frame,
		})
		local detail = Ui.label({
			Position = UDim2.fromOffset(6, 136),
			Size = UDim2.new(1, -12, 0, 32),
			Font = Ui.FONT_BOLD,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true,
			Parent = frame,
		})
		table.insert(cards, { def = def, viewport = viewport, name = name, detail = detail, discovered = nil })
	end
end

function BirdpediaUI.close()
	overlay.Visible = false
end

function BirdpediaUI.open()
	if overlay.Visible then
		return
	end
	overlay.Visible = true
	if not built then
		built = true
		buildCards(listFrame)
	end
	refresh()
end

function BirdpediaUI.toggle()
	if overlay.Visible then
		BirdpediaUI.close()
	else
		BirdpediaUI.open()
	end
end

function BirdpediaUI.init(gui: ScreenGui)
	overlay = Ui.new("TextButton", {
		Name = "BirdpediaOverlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.5,
		AutoButtonColor = false,
		Text = "",
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	})
	overlay.Activated:Connect(BirdpediaUI.close)

	local panel = Ui.new("Frame", {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.86, 0.84),
		BackgroundColor3 = Ui.COLORS.panel,
		Active = true,
		Parent = overlay,
	}, {
		Ui.corner(20),
		Ui.stroke(Color3.fromRGB(70, 130, 196), 4),
		Ui.new("UISizeConstraint", { MaxSize = Vector2.new(860, 600), MinSize = Vector2.new(300, 280) }),
	})

	header = Ui.label({
		Position = UDim2.fromOffset(20, 12),
		Size = UDim2.new(1, -80, 0, 34),
		Text = "Birdpedia",
		Font = Ui.FONT,
		TextSize = 24,
		TextColor3 = Ui.COLORS.gold,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = panel,
	})
	Ui.label({
		Position = UDim2.fromOffset(22, 44),
		Size = UDim2.new(1, -80, 0, 18),
		Text = "Plant better seeds to attract rarer birds. Discovering a new species pays a big bonus!",
		TextSize = 13,
		TextColor3 = Ui.COLORS.muted,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = panel,
	})

	local close = Ui.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 14),
		Size = UDim2.fromOffset(40, 40),
		Text = "X",
		BackgroundColor3 = Ui.COLORS.bad,
		Parent = panel,
	})
	close.Activated:Connect(BirdpediaUI.close)

	listFrame = Ui.new("ScrollingFrame", {
		Name = "List",
		Position = UDim2.fromOffset(12, 72),
		Size = UDim2.new(1, -24, 1, -84),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = panel,
	}, {
		Ui.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(138, 176),
			CellPadding = UDim2.fromOffset(10, 10),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		Ui.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 8) }),
	})

	State.changed:Connect(refresh)
end

return BirdpediaUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">DevPanel</string>
            <string name="Source"><![CDATA[--!strict
-- Studio-only cheat buttons for testing. Never appears in a published game.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes")).get()

local Ui = require(script.Parent.Ui)

local DevPanel = {}

function DevPanel.init(gui: ScreenGui)
	if not RunService:IsStudio() then
		return
	end

	local panel = Ui.new("Frame", {
		Name = "DevPanel",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(150, 220),
		BackgroundColor3 = Ui.COLORS.bg,
		BackgroundTransparency = 0.15,
		Parent = gui,
	}, {
		Ui.corner(12),
		Ui.stroke(Ui.COLORS.bad, 2),
		Ui.padding(8),
		Ui.new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	Ui.label({
		LayoutOrder = 0,
		Size = UDim2.new(1, 0, 0, 18),
		Text = "DEV (Studio only)",
		Font = Ui.FONT_BOLD,
		TextSize = 12,
		TextColor3 = Ui.COLORS.bad,
		Parent = panel,
	})

	local actions = {
		{ "feathers", "+100K Feathers" },
		{ "seeds", "+5 of every seed" },
		{ "grow", "Grow all plants" },
		{ "plots", "Unlock all plots" },
		{ "stock", "Fill shop stock" },
	}
	for i, entry in actions do
		local button = Ui.button({
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 32),
			Text = entry[2],
			TextSize = 13,
			Parent = panel,
		})
		button.Activated:Connect(function()
			Remotes.Dev:FireServer(entry[1])
		end)
	end
end

return DevPanel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Hotbar</string>
            <string name="Source"><![CDATA[--!strict
-- The seed bar along the bottom. Click a slot or press 1-6 to pick the seed
-- you'll plant next.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local PlantModels = require(Shared:WaitForChild("PlantModels"))
local Seeds = require(Shared:WaitForChild("Seeds"))

local State = require(script.Parent.State)
local Ui = require(script.Parent.Ui)
local Viewport = require(script.Parent.Viewport)

local Hotbar = {}

type Slot = {
	frame: Frame,
	stroke: UIStroke,
	scale: UIScale,
	count: TextLabel,
	key: TextLabel,
}

local KEYS = {
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4,
	[Enum.KeyCode.Five] = 5,
	[Enum.KeyCode.Six] = 6,
}

function Hotbar.init(gui: ScreenGui)
	-- A full-width transparent strip; the slots are centred inside it by a list layout.
	local root = Ui.new("Frame", {
		Name = "Hotbar",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.new(1, 0, 0, 104),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local hint = Ui.label({
		Name = "Hint",
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(1, 0, 0, 22),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Ui.FONT_BOLD,
		TextSize = 14,
		TextStrokeTransparency = 0.5,
		Parent = root,
	})
	local row = Ui.new("Frame", {
		Name = "Slots",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 80),
		BackgroundTransparency = 1,
		Parent = root,
	}, {
		Ui.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local slots: { [string]: Slot } = {}
	for _, seed in Seeds.list do
		local color = Config.RARITY_COLORS[seed.rarity]
		local frame = Ui.new("Frame", {
			Name = seed.id,
			LayoutOrder = seed.tier,
			Size = UDim2.fromOffset(68, 68),
			BackgroundColor3 = Ui.COLORS.bg,
			Visible = false,
			Parent = row,
		}, { Ui.corner(14) })
		local stroke = Ui.stroke(color, 2)
		stroke.Parent = frame
		local scale = Ui.new("UIScale", { Parent = frame })

		local preview = Ui.new("ViewportFrame", { Size = UDim2.fromScale(1, 1), Parent = frame })
		local model = PlantModels.build(seed.id, CFrame.new(), true)
		if model then
			Viewport.mount(preview, model, Vector3.new(0.4, 0.3, -1))
		end

		local count = Ui.label({
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -5, 1, -3),
			Size = UDim2.fromOffset(40, 18),
			TextXAlignment = Enum.TextXAlignment.Right,
			Font = Ui.FONT,
			TextSize = 17,
			TextStrokeTransparency = 0.3,
			ZIndex = 3,
			Parent = frame,
		})
		local key = Ui.label({
			Position = UDim2.fromOffset(6, 3),
			Size = UDim2.fromOffset(20, 16),
			Font = Ui.FONT_BOLD,
			TextSize = 13,
			TextColor3 = Ui.COLORS.muted,
			TextStrokeTransparency = 0.5,
			ZIndex = 3,
			Parent = frame,
		})

		local click = Ui.new(
			"TextButton",
			{ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 4, Parent = frame }
		)
		click.Activated:Connect(function()
			State.select(seed.id)
		end)

		slots[seed.id] = { frame = frame, stroke = stroke, scale = scale, count = count, key = key }
	end

	local visibleOrder: { string } = {}
	local function refresh()
		visibleOrder = {}
		for _, seed in Seeds.list do
			local slot = slots[seed.id]
			local owned = State.seedCount(seed.id)
			slot.frame.Visible = owned > 0
			if owned > 0 then
				table.insert(visibleOrder, seed.id)
				slot.count.Text = "x" .. Format.commas(owned)
				slot.key.Text = tostring(#visibleOrder)
				local selected = State.selected == seed.id
				slot.stroke.Color = if selected then Ui.COLORS.gold else Config.RARITY_COLORS[seed.rarity]
				slot.stroke.Thickness = if selected then 4 else 2
				slot.scale.Scale = if selected then 1.12 else 1
			end
		end
		local selected = State.selected and Seeds.get(State.selected)
		if selected then
			hint.Text = `{selected.name}  -  grows in {Format.growTime(selected.growTime)}`
			hint.TextColor3 = Config.RARITY_COLORS[selected.rarity]
		else
			hint.Text = ""
		end
	end

	State.changed:Connect(refresh)
	State.selectedChanged:Connect(refresh)
	refresh()

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local position = KEYS[input.KeyCode]
		local id = if position then visibleOrder[position] else nil
		if id then
			State.select(id)
		end
	end)
end

return Hotbar
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!strict
-- Always-on screen elements: the feathers counter and the Shop / Birdpedia buttons.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Birds = require(Shared:WaitForChild("Birds"))
local Format = require(Shared:WaitForChild("Format"))

local State = require(script.Parent.State)
local Ui = require(script.Parent.Ui)

local Hud = {}

function Hud.init(gui: ScreenGui, onShop: () -> (), onBirdpedia: () -> ())
	-- feathers counter
	local pill = Ui.new("Frame", {
		Name = "Feathers",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(250, 44),
		BackgroundColor3 = Ui.COLORS.bg,
		Parent = gui,
	}, { Ui.corner(22), Ui.stroke(Ui.COLORS.gold, 2.5) })
	local scale = Ui.new("UIScale", { Parent = pill })
	Ui.label({
		Position = UDim2.fromOffset(16, 0),
		Size = UDim2.new(0, 90, 1, 0),
		Text = "FEATHERS",
		Font = Ui.FONT_BOLD,
		TextSize = 13,
		TextColor3 = Ui.COLORS.muted,
		Parent = pill,
	})
	local amount = Ui.label({
		Position = UDim2.fromOffset(100, 0),
		Size = UDim2.new(1, -116, 1, 0),
		Text = "0",
		Font = Ui.FONT,
		TextSize = 26,
		TextColor3 = Ui.COLORS.gold,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = pill,
	})

	-- side buttons
	local side = Ui.new("Frame", {
		Name = "SideButtons",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(150, 120),
		BackgroundTransparency = 1,
		Parent = gui,
	}, { Ui.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })

	local shopButton = Ui.button({
		Name = "Shop",
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 54),
		Text = "Seed Shop",
		BackgroundColor3 = Color3.fromRGB(214, 112, 60),
		Parent = side,
	})
	local pediaButton = Ui.button({
		Name = "Birdpedia",
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0, 54),
		Text = "Birdpedia",
		BackgroundColor3 = Color3.fromRGB(70, 130, 196),
		Parent = side,
	})
	Ui.stroke(Color3.fromRGB(0, 0, 0), 2, 0.6).Parent = shopButton
	Ui.stroke(Color3.fromRGB(0, 0, 0), 2, 0.6).Parent = pediaButton
	shopButton.Activated:Connect(onShop)
	pediaButton.Activated:Connect(onBirdpedia)

	local lastFeathers = State.feathers
	local function refresh()
		amount.Text = Format.feathers(State.feathers)
		pediaButton.Text = `Birdpedia {State.speciesDiscovered()}/{#Birds.list}`
		if State.feathers > lastFeathers then
			scale.Scale = 1.12
			TweenService
				:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
				:Play()
		end
		lastFeathers = State.feathers
	end
	State.changed:Connect(refresh)
	refresh()
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Objective</string>
            <string name="Source"><![CDATA[--!strict
-- A single line that tells the player what to do next. This is the "player
-- waits" loop made visible: plant, wait, watch the birds, upgrade.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Birds = require(Shared:WaitForChild("Birds"))
local Clock = require(Shared:WaitForChild("Clock"))
local Format = require(Shared:WaitForChild("Format"))
local Seeds = require(Shared:WaitForChild("Seeds"))

local State = require(script.Parent.State)
local Ui = require(script.Parent.Ui)

local Objective = {}

local label: TextLabel
local localPlayer = Players.LocalPlayer

-- Looks at the local player's plants: how many are growing / blooming, and how long until the next bloom.
local function scanPlants(): (number, number, string?, number?)
	local growing, blooming = 0, 0
	local soonestName: string? = nil
	local soonest: number? = nil
	local now = Clock.now()
	for _, plant in CollectionService:GetTagged("Plant") do
		if plant:GetAttribute("OwnerUserId") == localPlayer.UserId then
			local plantedAt = plant:GetAttribute("PlantedAt")
			local growTime = plant:GetAttribute("GrowTime")
			local seed = Seeds.get(tostring(plant:GetAttribute("SeedId")))
			if type(plantedAt) == "number" and type(growTime) == "number" and seed then
				local remaining = growTime - (now - plantedAt)
				if remaining > 0 then
					growing += 1
					if not soonest or remaining < soonest then
						soonest, soonestName = remaining, seed.name
					end
				else
					blooming += 1
				end
			end
		end
	end
	return growing, blooming, soonestName, soonest
end

local function compute(): string
	local growing, blooming, soonestName, soonest = scanPlants()
	local seedsLeft = State.totalSeeds()
	local selected = State.selected and Seeds.get(State.selected)

	if growing + blooming == 0 then
		if seedsLeft == 0 then
			return "You're out of seeds! Open the Seed Shop on the left to buy more."
		end
		local name = if selected then selected.name else "seed"
		return `Walk up to a soil plot in your garden and press [E] to plant your {name}.`
	end
	if blooming > 0 and growing > 0 and soonest then
		return `Birds are visiting! Next bloom: {soonestName} in {Format.duration(soonest)}.`
	end
	if blooming > 0 then
		local found, total = State.speciesDiscovered(), #Birds.list
		if seedsLeft > 0 then
			return `Birds are visiting! Plant your spare seeds too. ({found}/{total} species found)`
		end
		return `Birds are visiting! ({found}/{total} species found) Buy better seeds to attract rarer birds.`
	end
	if soonest then
		return `Your {soonestName} is growing - ready in {Format.duration(soonest)}. Better seeds take longer, but attract rarer birds!`
	end
	return ""
end

function Objective.init(gui: ScreenGui)
	label = Ui.label({
		Name = "Objective",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 58),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundTransparency = 0.25,
		BackgroundColor3 = Ui.COLORS.bg,
		Font = Ui.FONT_BOLD,
		TextSize = 15,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = gui,
	})
	Ui.corner(12).Parent = label
	Ui.padding(8).Parent = label
	Ui.new("UISizeConstraint", { MaxSize = Vector2.new(560, 90), Parent = label })

	task.spawn(function()
		while true do
			local text = compute()
			label.Text = text
			label.Visible = text ~= ""
			task.wait(0.5)
		end
	end)
end

return Objective
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">PlantLabels</string>
            <string name="Source"><![CDATA[--!strict
-- Floating name + countdown above every plant (yours and other players').
-- Purely visual and computed locally from the plant's attributes, so it costs
-- no network traffic while you wait.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Clock = require(Shared:WaitForChild("Clock"))
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Growth = require(Shared:WaitForChild("Growth"))
local Seeds = require(Shared:WaitForChild("Seeds"))
local Types = require(Shared:WaitForChild("Types"))

local Ui = require(script.Parent.Ui)

local PlantLabels = {}

type Label = {
	gui: BillboardGui,
	status: TextLabel,
	bar: Frame,
	fill: Frame,
	seed: Types.SeedDef,
	model: Model,
}

local labels: { [Instance]: Label } = {}

local function add(instance: Instance)
	if not instance:IsA("Model") or labels[instance] then
		return
	end
	local model: Model = instance
	local seed = Seeds.get(tostring(model:GetAttribute("SeedId")))
	if not seed then
		return
	end
	task.spawn(function()
		local root = model:WaitForChild("Root", 10)
		if not root or not root:IsA("BasePart") or not model.Parent or labels[model] then
			return
		end
		local color = Config.RARITY_COLORS[seed.rarity]

		local gui = Ui.new("BillboardGui", {
			Name = "PlantLabel",
			Size = UDim2.fromOffset(190, 56),
			MaxDistance = 90,
			LightInfluence = 0,
			Adornee = root,
			StudsOffsetWorldSpace = Vector3.new(0, seed.labelHeight * Config.SCALE_MIN + 1.8, 0),
			Parent = root,
		})
		local frame = Ui.new("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Ui.COLORS.bg,
			BackgroundTransparency = 0.15,
			Parent = gui,
		}, { Ui.corner(10), Ui.stroke(color, 2, 0.2) })
		Ui.label({
			Position = UDim2.fromOffset(8, 2),
			Size = UDim2.new(1, -16, 0, 24),
			Text = seed.name,
			Font = Ui.FONT,
			TextSize = 19,
			TextColor3 = color,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = frame,
		})
		local status = Ui.label({
			Position = UDim2.fromOffset(8, 24),
			Size = UDim2.new(1, -16, 0, 16),
			Text = "",
			Font = Ui.FONT_BOLD,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = frame,
		})
		local bar = Ui.new("Frame", {
			Position = UDim2.new(0, 10, 1, -13),
			Size = UDim2.new(1, -20, 0, 7),
			BackgroundColor3 = Color3.fromRGB(20, 32, 27),
			BorderSizePixel = 0,
			Parent = frame,
		}, { Ui.corner(4) })
		local fill = Ui.new(
			"Frame",
			{ Size = UDim2.fromScale(0, 1), BackgroundColor3 = color, BorderSizePixel = 0, Parent = bar },
			{ Ui.corner(4) }
		)

		labels[model] = { gui = gui, status = status, bar = bar, fill = fill, seed = seed, model = model }
	end)
end

local function remove(instance: Instance)
	local label = labels[instance]
	if label then
		labels[instance] = nil
		label.gui:Destroy()
	end
end

function PlantLabels.init()
	CollectionService:GetInstanceAddedSignal("Plant"):Connect(add)
	CollectionService:GetInstanceRemovedSignal("Plant"):Connect(remove)
	for _, plant in CollectionService:GetTagged("Plant") do
		add(plant)
	end

	task.spawn(function()
		while true do
			local now = Clock.now()
			for model, label in labels do
				if not model.Parent then
					remove(model)
				else
					local plantedAt = model:GetAttribute("PlantedAt")
					if type(plantedAt) == "number" then
						local progress = Growth.progress(plantedAt, label.seed.growTime, now)
						if progress >= 1 then
							label.status.Text = "Blooming - birds visit!"
							label.status.TextColor3 = Ui.COLORS.good
							label.bar.Visible = false
						else
							label.status.Text = "Growing  " .. Format.duration(label.seed.growTime - (now - plantedAt))
							label.status.TextColor3 = Ui.COLORS.text
							label.bar.Visible = true
							label.fill.Size = UDim2.fromScale(progress, 1)
						end
						label.gui.StudsOffsetWorldSpace =
							Vector3.new(0, label.seed.labelHeight * Growth.scale(progress) + 1.8, 0)
					end
				end
			end
			task.wait(0.2)
		end
	end)
end

return PlantLabels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Prompts</string>
            <string name="Source"><![CDATA[--!strict
-- Proximity prompts for the local player's own garden. They are created on the
-- client, so other players never see (or can trigger) your prompts, and the
-- text can follow your selected seed instantly.
--   [E]        plant the selected seed / unlock the next plot
--   [X] (hold) dig up a plant

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = require(Shared:WaitForChild("Remotes")).get()
local Seeds = require(Shared:WaitForChild("Seeds"))

local State = require(script.Parent.State)
local Toasts = require(script.Parent.Toasts)
local Ui = require(script.Parent.Ui)

local Prompts = {}

local localPlayer = Players.LocalPlayer
local plotPrompts: { [BasePart]: ProximityPrompt } = {}
local digPrompts: { [Instance]: ProximityPrompt } = {}

local function myGarden(): Instance?
	local gardens = workspace:FindFirstChild("Gardens")
	if not gardens then
		return nil
	end
	for _, garden in gardens:GetChildren() do
		if garden:GetAttribute("OwnerUserId") == localPlayer.UserId then
			return garden
		end
	end
	return nil
end

local function newPrompt(
	parent: BasePart,
	name: string,
	key: Enum.KeyCode,
	hold: number,
	distance: number
): ProximityPrompt
	local prompt = Ui.new("ProximityPrompt", {
		Name = name,
		KeyboardKeyCode = key,
		HoldDuration = hold,
		MaxActivationDistance = distance,
		RequiresLineOfSight = false,
		Parent = parent,
	})
	return prompt
end

local function unlockPlot()
	task.spawn(function()
		local ok, result = pcall(function()
			return Remotes.UnlockPlot:InvokeServer()
		end)
		if ok then
			Toasts.result(result)
		end
	end)
end

local function createPlotPrompt(soil: BasePart, index: number): ProximityPrompt
	local prompt = newPrompt(soil, "PlotPrompt", Enum.KeyCode.E, 0, 13)
	prompt.Triggered:Connect(function()
		if index > State.plots then
			if index == State.plots + 1 and State.nextPlotPrice then
				unlockPlot()
			end
		elseif soil:GetAttribute("HasPlant") == false and State.selected then
			Remotes.PlantSeed:FireServer(index, State.selected)
		end
	end)
	return prompt
end

local function updatePlotPrompt(prompt: ProximityPrompt, soil: BasePart, index: number)
	if index > State.plots then
		local isNext = index == State.plots + 1 and State.nextPlotPrice ~= nil
		prompt.Enabled = isNext
		prompt.ObjectText = "Locked plot"
		prompt.HoldDuration = 0.5
		prompt.ActionText = if State.nextPlotPrice
			then `Unlock for {Format.feathers(State.nextPlotPrice)} feathers`
			else "Locked"
		return
	end
	prompt.HoldDuration = 0
	prompt.ObjectText = "Garden plot"
	local seed = if State.selected then Seeds.get(State.selected) else nil
	prompt.Enabled = soil:GetAttribute("HasPlant") == false and seed ~= nil
	prompt.ActionText = if seed then `Plant {seed.name}` else "Pick a seed"
end

local function createDigPrompt(plant: Model, root: BasePart): ProximityPrompt
	local prompt = newPrompt(root, "DigPrompt", Enum.KeyCode.X, 1.5, 11)
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	prompt.Triggered:Connect(function()
		local index = plant:GetAttribute("PlotIndex")
		if type(index) == "number" then
			Remotes.DigPlant:FireServer(index)
		end
	end)
	return prompt
end

local function reconcile()
	local garden = myGarden()

	if garden then
		for index = 1, Config.MAX_PLOTS do
			local soil = garden:FindFirstChild("Plot_" .. index)
			if soil and soil:IsA("BasePart") then
				local prompt = plotPrompts[soil]
				if not prompt then
					prompt = createPlotPrompt(soil, index)
					plotPrompts[soil] = prompt
				end
				updatePlotPrompt(prompt, soil, index)
			end
		end
	end
	-- forget prompts for soil that is no longer ours (e.g. we respawned into a new server)
	for soil, prompt in plotPrompts do
		if not garden or not soil:IsDescendantOf(garden) then
			prompt:Destroy()
			plotPrompts[soil] = nil
		end
	end

	for _, plant in CollectionService:GetTagged("Plant") do
		if plant:IsA("Model") and plant:GetAttribute("OwnerUserId") == localPlayer.UserId then
			local root = plant:FindFirstChild("Root")
			if root and root:IsA("BasePart") then
				local prompt = digPrompts[plant]
				if not prompt then
					prompt = createDigPrompt(plant, root)
					digPrompts[plant] = prompt
				end
				local seed = Seeds.get(tostring(plant:GetAttribute("SeedId")))
				prompt.ObjectText = if seed then seed.name else "Plant"
				prompt.ActionText = if plant:GetAttribute("Mature") == true
					then "Dig up (seed is lost!)"
					else "Dig up (seed returned)"
			end
		end
	end
	for plant, prompt in digPrompts do
		if not plant.Parent then
			prompt:Destroy()
			digPrompts[plant] = nil
		end
	end
end

function Prompts.init()
	State.changed:Connect(reconcile)
	State.selectedChanged:Connect(reconcile)
	CollectionService:GetInstanceAddedSignal("Plant"):Connect(function()
		task.defer(reconcile)
	end)
	task.spawn(function()
		while true do
			reconcile()
			task.wait(0.5)
		end
	end)
end

return Prompts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">ShopUI</string>
            <string name="Source"><![CDATA[--!strict
-- The seed shop window: live stock, restock countdown, buy buttons.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Birds = require(Shared:WaitForChild("Birds"))
local Clock = require(Shared:WaitForChild("Clock"))
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Growth = require(Shared:WaitForChild("Growth"))
local PlantModels = require(Shared:WaitForChild("PlantModels"))
local Remotes = require(Shared:WaitForChild("Remotes")).get()
local Seeds = require(Shared:WaitForChild("Seeds"))
local Types = require(Shared:WaitForChild("Types"))

local State = require(script.Parent.State)
local Toasts = require(script.Parent.Toasts)
local Ui = require(script.Parent.Ui)
local Viewport = require(script.Parent.Viewport)

local ShopUI = {}

type Row = {
	seed: Types.SeedDef,
	frame: Frame,
	price: TextLabel,
	stock: TextLabel,
	buyOne: TextButton,
	buyMax: TextButton,
}

local overlay: TextButton
local timerLabel: TextLabel
local rows: { Row } = {}
local busy = false

local function birdsFor(seed: Types.SeedDef): string
	local names = {}
	for _, entry in seed.birds do
		local bird = Birds.get(entry.id)
		if bird and bird.rarity == seed.rarity then
			table.insert(names, bird.name)
		end
	end
	return table.concat(names, ", ")
end

local function buy(seedId: string, amount: number)
	if busy then
		return
	end
	busy = true
	task.spawn(function()
		local ok, result = pcall(function()
			return Remotes.BuySeed:InvokeServer(seedId, amount)
		end)
		busy = false
		if ok then
			Toasts.result(result)
		end
	end)
end

local function refresh()
	for _, row in rows do
		local seed = row.seed
		local inStock = State.stock[seed.id] or 0
		local afford = math.floor(State.feathers / seed.price)
		local maxN = math.min(inStock, afford, Config.MAX_BUY_AMOUNT)

		row.price.Text = Format.feathers(seed.price)
		if inStock > 0 then
			row.stock.Text = `In stock: {inStock}`
			row.stock.TextColor3 = Ui.COLORS.good
		else
			row.stock.Text = "Sold out"
			row.stock.TextColor3 = Ui.COLORS.bad
		end
		Ui.setEnabled(row.buyOne, inStock > 0 and afford >= 1, Ui.COLORS.good)
		row.buyOne.Text = "Buy"
		Ui.setEnabled(row.buyMax, maxN >= 2, Color3.fromRGB(82, 160, 216))
		row.buyMax.Text = if maxN >= 2 then `Buy x{maxN}` else "Buy max"
		row.frame.LayoutOrder = seed.tier
	end
end

local function buildRow(seed: Types.SeedDef, parent: Instance): Row
	local color = Config.RARITY_COLORS[seed.rarity]
	local frame = Ui.new("Frame", {
		Name = seed.id,
		Size = UDim2.new(1, -8, 0, 124),
		BackgroundColor3 = Ui.COLORS.row,
		Parent = parent,
	}, { Ui.corner(14), Ui.stroke(color, 2, 0.35) })

	local preview = Ui.new("ViewportFrame", {
		Position = UDim2.fromOffset(10, 12),
		Size = UDim2.fromOffset(100, 100),
		BackgroundColor3 = Ui.COLORS.bg,
		BackgroundTransparency = 0,
		Parent = frame,
	}, { Ui.corner(12) })
	local model = PlantModels.build(seed.id, CFrame.new(), true)
	if model then
		Viewport.mount(preview, model, Vector3.new(0.4, 0.3, -1))
		preview.BackgroundTransparency = 0
	end

	local info = Ui.new("Frame", {
		Position = UDim2.fromOffset(122, 8),
		Size = UDim2.new(1, -122 - 138, 1, -16),
		BackgroundTransparency = 1,
		Parent = frame,
	})
	Ui.label({
		Size = UDim2.new(1, 0, 0, 28),
		Text = seed.name .. " Seed",
		Font = Ui.FONT,
		TextSize = 22,
		TextColor3 = color,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = info,
	})
	Ui.label({
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 0, 16),
		Text = seed.rarity,
		Font = Ui.FONT_BOLD,
		TextSize = 12,
		TextColor3 = color,
		Parent = info,
	})
	Ui.label({
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 0, 30),
		Text = seed.blurb,
		TextSize = 13,
		TextColor3 = Ui.COLORS.muted,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = info,
	})

	local perVisit = Growth.expectedVisitValue(seed, function(id: string): number
		local bird = Birds.get(id)
		return if bird then bird.value else 0
	end)
	local perches = if #seed.perches == 1 then "1 perch" else `{#seed.perches} perches`
	Ui.label({
		Position = UDim2.fromOffset(0, 78),
		Size = UDim2.new(1, 0, 0, 16),
		Text = `Grows in {Format.growTime(seed.growTime)}  |  {perches}  |  ~{Format.feathers(perVisit)} per visit`,
		Font = Ui.FONT_BOLD,
		TextSize = 12,
		TextColor3 = Ui.COLORS.text,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = info,
	})
	Ui.label({
		Position = UDim2.fromOffset(0, 94),
		Size = UDim2.new(1, 0, 0, 16),
		Text = "Attracts: " .. birdsFor(seed),
		TextSize = 12,
		TextColor3 = Ui.COLORS.muted,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = info,
	})

	local right = Ui.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 8),
		Size = UDim2.fromOffset(120, 108),
		BackgroundTransparency = 1,
		Parent = frame,
	})
	local price = Ui.label({
		Size = UDim2.new(1, 0, 0, 26),
		Font = Ui.FONT,
		TextSize = 22,
		TextColor3 = Ui.COLORS.gold,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = right,
	})
	local stock = Ui.label({
		Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(1, 0, 0, 16),
		Font = Ui.FONT_BOLD,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = right,
	})
	local buyOne =
		Ui.button({ Position = UDim2.fromOffset(0, 46), Size = UDim2.new(1, 0, 0, 28), TextSize = 16, Parent = right })
	local buyMax =
		Ui.button({ Position = UDim2.fromOffset(0, 78), Size = UDim2.new(1, 0, 0, 28), TextSize = 15, Parent = right })

	buyOne.Activated:Connect(function()
		buy(seed.id, 1)
	end)
	buyMax.Activated:Connect(function()
		local inStock = State.stock[seed.id] or 0
		local afford = math.floor(State.feathers / seed.price)
		local n = math.min(inStock, afford, Config.MAX_BUY_AMOUNT)
		if n >= 2 then
			buy(seed.id, n)
		end
	end)

	return { seed = seed, frame = frame, price = price, stock = stock, buyOne = buyOne, buyMax = buyMax }
end

function ShopUI.isOpen(): boolean
	return overlay.Visible
end

function ShopUI.close()
	overlay.Visible = false
end

function ShopUI.open()
	if overlay.Visible then
		return
	end
	overlay.Visible = true
	refresh()
	task.spawn(function()
		while overlay.Visible do
			timerLabel.Text = "New stock in " .. Format.duration(State.nextRestock - Clock.now())
			task.wait(0.25)
		end
	end)
end

function ShopUI.toggle()
	if overlay.Visible then
		ShopUI.close()
	else
		ShopUI.open()
	end
end

function ShopUI.init(gui: ScreenGui)
	overlay = Ui.new("TextButton", {
		Name = "ShopOverlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.5,
		AutoButtonColor = false,
		Text = "",
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	})
	overlay.Activated:Connect(ShopUI.close)

	local panel = Ui.new("Frame", {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.82, 0.82),
		BackgroundColor3 = Ui.COLORS.panel,
		Active = true, -- swallow clicks so the overlay behind doesn't close
		Parent = overlay,
	}, {
		Ui.corner(20),
		Ui.stroke(Color3.fromRGB(214, 112, 60), 4),
		Ui.new("UISizeConstraint", { MaxSize = Vector2.new(760, 580), MinSize = Vector2.new(300, 280) }),
	})

	Ui.label({
		Position = UDim2.fromOffset(20, 10),
		Size = UDim2.new(0.5, 0, 0, 40),
		Text = "Seed Shop",
		Font = Ui.FONT,
		TextSize = 34,
		TextColor3 = Ui.COLORS.gold,
		Parent = panel,
	})
	timerLabel = Ui.label({
		Position = UDim2.fromOffset(22, 48),
		Size = UDim2.new(0.6, 0, 0, 20),
		Text = "",
		Font = Ui.FONT_BOLD,
		TextSize = 14,
		TextColor3 = Ui.COLORS.muted,
		Parent = panel,
	})

	local close = Ui.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 14),
		Size = UDim2.fromOffset(40, 40),
		Text = "X",
		BackgroundColor3 = Ui.COLORS.bad,
		Parent = panel,
	})
	close.Activated:Connect(ShopUI.close)

	local list = Ui.new("ScrollingFrame", {
		Position = UDim2.fromOffset(12, 76),
		Size = UDim2.new(1, -24, 1, -88),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = panel,
	}, { Ui.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }) })

	for _, seed in Seeds.list do
		table.insert(rows, buildRow(seed, list))
	end

	State.changed:Connect(refresh)
	State.stockChanged:Connect(refresh)
	refresh()
end

return ShopUI
]]></string>
