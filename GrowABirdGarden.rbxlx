      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">BirdFlight</string>
          <string name="Source"><![CDATA[--!strict
-- Deterministic bird motion. A visit is fully described by a few numbers and a
-- start time, so every client can compute exactly where a bird is at any moment
-- (including clients that join mid-visit) with no per-frame network traffic.

local Types = require(script.Parent.Types)
type VisitInfo = Types.VisitInfo

local BirdFlight = {}

export type Sample = {
	position: Vector3,
	look: Vector3, -- unit vector the bird faces
	phase: "arrive" | "perch" | "leave" | "done",
	flap: number, -- 0 = wings folded, 1 = flapping hard
}

local UP = Vector3.new(0, 1, 0)

local function rotateY(v: Vector3, angle: number): Vector3
	local c, s = math.cos(angle), math.sin(angle)
	return Vector3.new(v.X * c + v.Z * s, v.Y, -v.X * s + v.Z * c)
end

local function bezier(p0: Vector3, c: Vector3, p1: Vector3, s: number): Vector3
	local a = 1 - s
	return p0 * (a * a) + c * (2 * a * s) + p1 * (s * s)
end

local function bezierDirection(p0: Vector3, c: Vector3, p1: Vector3, s: number, fallback: Vector3): Vector3
	local d = (c - p0) * (2 * (1 - s)) + (p1 - c) * (2 * s)
	if d.Magnitude < 1e-4 then
		return fallback
	end
	return d.Unit
end

-- Blend two unit directions. A plain Lerp shrinks the vector (and hits zero for
-- opposite directions), which would hand CFrame.lookAt a degenerate input.
local function blend(a: Vector3, b: Vector3, t: number): Vector3
	local v = a:Lerp(b, t)
	if v.Magnitude < 1e-3 then
		return b
	end
	return v.Unit
end

function BirdFlight.duration(visit: VisitInfo): number
	return visit.arrive + visit.stay + visit.leave
end

function BirdFlight.sample(visit: VisitInfo, t: number): Sample
	local perch = visit.perch
	local facing = visit.facing

	if t < visit.arrive then
		-- Swoop in and brake onto the perch.
		local u = math.clamp(t / visit.arrive, 0, 1)
		local s = 1 - (1 - u) * (1 - u)
		local control = perch + (visit.from - perch) * 0.4 + UP * 3.5
		local dir = bezierDirection(visit.from, control, perch, s, facing)
		local turn = math.clamp((u - 0.7) / 0.3, 0, 1)
		return {
			position = bezier(visit.from, control, perch, s),
			look = blend(dir, facing, turn),
			phase = "arrive",
			flap = 1,
		}
	end

	local sinceLanding = t - visit.arrive
	if sinceLanding < visit.stay then
		-- Perched: hop a little and glance around.
		local hop = math.max(0, math.sin(sinceLanding * 3.1 + visit.seed)) ^ 6 * 0.12
		local glance = math.sin(sinceLanding * 0.7 + visit.seed * 1.7) * 0.55
		return {
			position = perch + UP * hop,
			look = rotateY(facing, glance),
			phase = "perch",
			flap = 0,
		}
	end

	local u = math.clamp((sinceLanding - visit.stay) / visit.leave, 0, 1)
	if u >= 1 then
		return { position = visit.to, look = (visit.to - perch).Unit, phase = "done", flap = 1 }
	end
	-- Take off, accelerating away.
	local s = u * u
	local control = perch + UP * 6 + (visit.to - perch) * 0.2
	local dir = bezierDirection(perch, control, visit.to, s, facing)
	local turn = math.clamp(u / 0.2, 0, 1)
	return {
		position = bezier(perch, control, visit.to, s),
		look = blend(facing, dir, turn),
		phase = "leave",
		flap = 1,
	}
end

-- Builds the geometry for a visit: where the bird comes from, which way it
-- faces on the perch, and where it exits to.
function BirdFlight.plan(perch: Vector3, rng: Random)
	local inAngle = rng:NextNumber(0, math.pi * 2)
	local inDir = Vector3.new(math.cos(inAngle), 0, math.sin(inAngle))
	local outAngle = inAngle + math.pi + rng:NextNumber(-1.1, 1.1)
	local outDir = Vector3.new(math.cos(outAngle), 0, math.sin(outAngle))
	local faceAngle = rng:NextNumber(0, math.pi * 2)
	return {
		from = perch + inDir * rng:NextNumber(55, 80) + UP * rng:NextNumber(18, 30),
		to = perch + outDir * rng:NextNumber(60, 90) + UP * rng:NextNumber(22, 38),
		facing = Vector3.new(math.cos(faceAngle), 0, math.sin(faceAngle)),
		seed = rng:NextNumber(0, 100),
	}
end

return BirdFlight
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">BirdModel</string>
          <string name="Source"><![CDATA[--!strict
-- Builds a bird from primitive parts and exposes a small "rig" so a renderer can
-- pose it every frame (flapping wings) without welds or physics.
-- Local space: the bird faces -Z, up is +Y, and its feet are at the origin.

local Birds = require(script.Parent.Birds)
local Types = require(script.Parent.Types)
type BirdDef = Types.BirdDef

local BirdModel = {}

export type Wing = { index: number, shoulder: CFrame, offset: CFrame, side: number }

export type Rig = {
	model: Model,
	parts: { BasePart },
	rest: { CFrame }, -- local CFrame of each part when wings are folded
	static: { number }, -- indices of parts that never move relative to the body
	wings: { Wing },
	flapRate: number, -- radians/second of the wing beat
	height: number, -- studs from feet to the top of the head
	def: BirdDef,
}

local PLASTIC = Enum.Material.SmoothPlastic
local SILHOUETTE = Color3.fromRGB(16, 16, 22)
local EYE = Color3.fromRGB(20, 20, 26)
local WHITE = Color3.fromRGB(245, 246, 252)

function BirdModel.build(def: BirdDef, silhouette: boolean?): Rig
	local s = def.scale
	local model = Instance.new("Model")
	model.Name = def.id

	local parts: { BasePart } = {}
	local rest: { CFrame } = {}
	local static: { number } = {}
	local wings: { Wing } = {}
	local glow = Birds.hasTrait(def, "Glow")

	local function add(
		name: string,
		size: Vector3,
		cf: CFrame,
		color: Color3,
		material: Enum.Material?,
		round: boolean
	): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size * s
		p.Color = if silhouette then SILHOUETTE else color
		p.Material = if silhouette then PLASTIC else (material or PLASTIC)
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.CastShadow = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		-- positions are authored at scale 1 and scaled here
		local scaled = cf.Rotation + cf.Position * s
		p.CFrame = scaled
		if round then
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = p
		end
		p.Parent = model
		table.insert(parts, p)
		table.insert(rest, scaled)
		return p
	end
	local function addStatic(
		name: string,
		size: Vector3,
		cf: CFrame,
		color: Color3,
		material: Enum.Material?,
		round: boolean
	): Part
		local p = add(name, size, cf, color, material, round)
		table.insert(static, #parts)
		return p
	end

	-- invisible root so the model has a pivot at the feet
	local root = addStatic("Root", Vector3.new(0.2, 0.2, 0.2) / s, CFrame.new(), WHITE, PLASTIC, false)
	root.Transparency = 1
	model.PrimaryPart = root

	local wingMaterial = if glow then Enum.Material.Neon else PLASTIC
	local bellyMaterial = if glow then Enum.Material.Neon else PLASTIC

	-- legs
	for _, x in { -0.17, 0.17 } do
		addStatic("Leg", Vector3.new(0.09, 0.42, 0.09), CFrame.new(x, 0.21, 0), def.beak, PLASTIC, false)
	end

	-- body, belly, head
	local body = addStatic("Body", Vector3.new(0.95, 0.85, 1.4), CFrame.new(0, 0.8, 0.05), def.body, PLASTIC, true)
	addStatic("Belly", Vector3.new(0.8, 0.55, 1.05), CFrame.new(0, 0.64, -0.12), def.belly, bellyMaterial, true)
	addStatic("Head", Vector3.new(0.66, 0.66, 0.66), CFrame.new(0, 1.4, -0.5), def.body, PLASTIC, true)

	local owl = Birds.hasTrait(def, "OwlFace")

	-- beak
	if Birds.hasTrait(def, "BigBeak") then
		addStatic("Beak", Vector3.new(0.26, 0.24, 0.8), CFrame.new(0, 1.34, -1.0), def.beak, PLASTIC, false)
		addStatic(
			"BeakTip",
			Vector3.new(0.24, 0.22, 0.18),
			CFrame.new(0, 1.34, -1.36),
			Color3.fromRGB(30, 30, 34),
			PLASTIC,
			false
		)
	elseif Birds.hasTrait(def, "LongBeak") then
		addStatic("Beak", Vector3.new(0.07, 0.07, 0.95), CFrame.new(0, 1.37, -1.15), def.beak, PLASTIC, false)
	elseif owl then
		addStatic("Beak", Vector3.new(0.1, 0.16, 0.18), CFrame.new(0, 1.3, -0.84), def.beak, PLASTIC, false)
	else
		addStatic("Beak", Vector3.new(0.16, 0.14, 0.36), CFrame.new(0, 1.35, -0.88), def.beak, PLASTIC, false)
	end

	-- eyes
	if owl then
		for _, x in { -0.17, 0.17 } do
			addStatic("EyeDisc", Vector3.new(0.34, 0.34, 0.1), CFrame.new(x, 1.44, -0.79), WHITE, PLASTIC, true)
			addStatic(
				"Eye",
				Vector3.new(0.18, 0.18, 0.1),
				CFrame.new(x, 1.44, -0.84),
				def.accent,
				Enum.Material.Neon,
				true
			)
		end
		for _, side in { -1, 1 } do
			addStatic(
				"Tuft",
				Vector3.new(0.1, 0.3, 0.1),
				CFrame.new(side * 0.22, 1.78, -0.5) * CFrame.Angles(0, 0, side * -0.35),
				def.wing,
				PLASTIC,
				false
			)
		end
	else
		for _, x in { -0.2, 0.2 } do
			addStatic("Eye", Vector3.new(0.12, 0.12, 0.12), CFrame.new(x, 1.47, -0.78), EYE, PLASTIC, true)
		end
	end

	-- head decorations
	if Birds.hasTrait(def, "Crest") then
		addStatic(
			"Crest",
			Vector3.new(0.14, 0.5, 0.36),
			CFrame.new(0, 1.78, -0.42) * CFrame.Angles(math.rad(-28), 0, 0),
			def.accent,
			PLASTIC,
			true
		)
	end
	if Birds.hasTrait(def, "Cap") then
		addStatic("Cap", Vector3.new(0.52, 0.3, 0.52), CFrame.new(0, 1.58, -0.5), def.accent, PLASTIC, true)
	end

	-- tail
	local tailTilt = CFrame.Angles(math.rad(20), 0, 0)
	if Birds.hasTrait(def, "LongTail") then
		addStatic("Tail", Vector3.new(0.3, 0.07, 1.8), CFrame.new(0, 0.82, 1.5) * tailTilt, def.wing, PLASTIC, false)
		addStatic(
			"TailTip",
			Vector3.new(0.34, 0.075, 0.5),
			CFrame.new(0, 0.5, 2.28) * tailTilt,
			def.accent,
			PLASTIC,
			false
		)
	else
		addStatic("Tail", Vector3.new(0.34, 0.08, 0.7), CFrame.new(0, 0.9, 0.98) * tailTilt, def.wing, PLASTIC, false)
	end
	if Birds.hasTrait(def, "FanTail") then
		local base = CFrame.new(0, 0.9, 0.95) * CFrame.Angles(math.rad(22), 0, 0)
		for i = 0, 8 do
			local phi = math.rad(-72 + i * 18)
			local feather = base * CFrame.Angles(0, 0, phi) * CFrame.new(0, 1.35, 0)
			local color = if i % 2 == 0 then def.wing else def.belly
			addStatic("Feather", Vector3.new(0.36, 2.6, 0.06), feather, color, PLASTIC, true)
			addStatic(
				"FeatherEye",
				Vector3.new(0.3, 0.34, 0.07),
				feather * CFrame.new(0, 0.95, 0.02),
				Color3.fromRGB(40, 90, 200),
				PLASTIC,
				true
			)
		end
	end

	-- wings: each hangs from a shoulder and rotates about the body's forward axis
	for _, side in { -1, 1 } do
		local shoulder = CFrame.new(side * 0.46, 1.15, 0)
		local offset = CFrame.new(side * 0.03, -0.4, 0.05)
		local wing = add("Wing", Vector3.new(0.1, 0.85, 0.95), shoulder * offset, def.wing, wingMaterial, true)
		table.insert(wings, {
			index = #parts,
			shoulder = CFrame.new(shoulder.Position * s),
			offset = CFrame.new(offset.Position * s),
			side = side,
		})
		wing.Name = if side < 0 then "WingL" else "WingR"
	end

	-- effects
	if not silhouette then
		if glow then
			local light = Instance.new("PointLight")
			light.Color = def.accent
			light.Range = 10 + 4 * s
			light.Brightness = 0.9
			light.Parent = body
		end
		if Birds.hasTrait(def, "Fire") then
			local fire = Instance.new("ParticleEmitter")
			fire.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 240, 150)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 130, 30)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 30, 10)),
			})
			fire.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9 * s), NumberSequenceKeypoint.new(1, 0) })
			fire.Transparency =
				NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
			fire.Lifetime = NumberRange.new(0.5, 0.9)
			fire.Rate = 40
			fire.Speed = NumberRange.new(1, 3)
			fire.SpreadAngle = Vector2.new(35, 35)
			fire.EmissionDirection = Enum.NormalId.Top
			fire.LightEmission = 1
			fire.Parent = body
		end
	end

	local flapRate = (if Birds.hasTrait(def, "Hover") then 58 else 26) / math.sqrt(s)

	return {
		model = model,
		parts = parts,
		rest = rest,
		static = static,
		wings = wings,
		flapRate = flapRate,
		height = 1.8 * s,
		def = def,
	}
end

-- Moves the whole bird: `rootCF` is where its feet go, `wingAngle` is the wing
-- spread in radians (0 = folded against the body, ~2 = raised high).
function BirdModel.pose(rig: Rig, rootCF: CFrame, wingAngle: number)
	local parts, rest = rig.parts, rig.rest
	for _, i in rig.static do
		parts[i].CFrame = rootCF * rest[i]
	end
	for _, wing in rig.wings do
		parts[wing.index].CFrame = rootCF * wing.shoulder * CFrame.Angles(0, 0, wing.side * wingAngle) * wing.offset
	end
end

return BirdModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Birds</string>
          <string name="Source"><![CDATA[--!strict
local Types = require(script.Parent.Types)
type BirdDef = Types.BirdDef

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- Ordered by rarity so the Birdpedia reads like a field guide.
local list: { BirdDef } = {
	-- Common (Sunflower)
	{
		id = "sparrow",
		name = "House Sparrow",
		rarity = "Common",
		value = 3,
		scale = 0.9,
		blurb = "A cheerful little brown bird that can't resist sunflower seeds.",
		body = rgb(150, 111, 78),
		belly = rgb(214, 196, 170),
		wing = rgb(112, 80, 55),
		beak = rgb(120, 100, 80),
		accent = rgb(60, 45, 35),
		traits = { "Cap" },
	},
	{
		id = "goldfinch",
		name = "Goldfinch",
		rarity = "Common",
		value = 5,
		scale = 0.85,
		blurb = "Bright as a buttercup, and just as sweet.",
		body = rgb(255, 214, 52),
		belly = rgb(255, 236, 120),
		wing = rgb(40, 36, 34),
		beak = rgb(255, 150, 60),
		accent = rgb(30, 28, 28),
		traits = { "Cap" },
	},
	{
		id = "dove",
		name = "Mourning Dove",
		rarity = "Common",
		value = 8,
		scale = 1.1,
		blurb = "Soft, gentle and always a little sleepy.",
		body = rgb(176, 168, 170),
		belly = rgb(222, 206, 200),
		wing = rgb(140, 132, 136),
		beak = rgb(70, 70, 70),
		accent = rgb(60, 60, 70),
		traits = { "LongTail" },
	},

	-- Uncommon (Berry Bush)
	{
		id = "robin",
		name = "Robin",
		rarity = "Uncommon",
		value = 18,
		scale = 1.0,
		blurb = "The first bird of spring, with a warm orange chest.",
		body = rgb(110, 102, 98),
		belly = rgb(232, 120, 60),
		wing = rgb(84, 78, 76),
		beak = rgb(255, 200, 60),
		accent = rgb(40, 40, 40),
		traits = {},
	},
	{
		id = "chickadee",
		name = "Chickadee",
		rarity = "Uncommon",
		value = 26,
		scale = 0.8,
		blurb = "Tiny, fearless, and wearing a little black cap.",
		body = rgb(150, 160, 170),
		belly = rgb(240, 235, 225),
		wing = rgb(110, 120, 130),
		beak = rgb(30, 30, 30),
		accent = rgb(20, 20, 20),
		traits = { "Cap" },
	},
	{
		id = "bluebird",
		name = "Eastern Bluebird",
		rarity = "Uncommon",
		value = 36,
		scale = 1.0,
		blurb = "A flash of sky-blue that loves ripe berries.",
		body = rgb(70, 120, 220),
		belly = rgb(235, 150, 90),
		wing = rgb(50, 90, 200),
		beak = rgb(30, 30, 30),
		accent = rgb(255, 255, 255),
		traits = {},
	},

	-- Rare (Cherry Blossom)
	{
		id = "bluejay",
		name = "Blue Jay",
		rarity = "Rare",
		value = 110,
		scale = 1.25,
		blurb = "Loud, proud and crested. Rules the blossom tree.",
		body = rgb(70, 130, 230),
		belly = rgb(235, 240, 250),
		wing = rgb(40, 90, 200),
		beak = rgb(30, 30, 35),
		accent = rgb(30, 40, 90),
		traits = { "Crest" },
	},
	{
		id = "cardinal",
		name = "Cardinal",
		rarity = "Rare",
		value = 150,
		scale = 1.2,
		blurb = "A crimson jewel against the pink petals.",
		body = rgb(215, 40, 50),
		belly = rgb(225, 70, 70),
		wing = rgb(170, 25, 35),
		beak = rgb(255, 150, 60),
		accent = rgb(30, 20, 20),
		traits = { "Crest" },
	},
	{
		id = "oriole",
		name = "Baltimore Oriole",
		rarity = "Rare",
		value = 210,
		scale = 1.1,
		blurb = "Blazing orange, with a song like a flute.",
		body = rgb(255, 140, 20),
		belly = rgb(255, 170, 50),
		wing = rgb(30, 30, 30),
		beak = rgb(120, 120, 130),
		accent = rgb(20, 20, 20),
		traits = { "Cap" },
	},

	-- Epic (Hibiscus)
	{
		id = "hummingbird",
		name = "Ruby Hummingbird",
		rarity = "Epic",
		value = 520,
		scale = 0.7,
		blurb = "Wings too fast to see. Drawn to the biggest blooms.",
		body = rgb(40, 170, 110),
		belly = rgb(230, 230, 225),
		wing = rgb(200, 220, 230),
		beak = rgb(30, 30, 30),
		accent = rgb(240, 40, 80),
		traits = { "LongBeak", "Hover" },
	},
	{
		id = "parakeet",
		name = "Sunny Parakeet",
		rarity = "Epic",
		value = 720,
		scale = 1.0,
		blurb = "Chatters constantly about how nice the garden is.",
		body = rgb(110, 220, 70),
		belly = rgb(255, 235, 70),
		wing = rgb(60, 170, 60),
		beak = rgb(255, 170, 120),
		accent = rgb(60, 130, 240),
		traits = { "LongTail" },
	},
	{
		id = "kingfisher",
		name = "Kingfisher",
		rarity = "Epic",
		value = 1050,
		scale = 1.2,
		blurb = "A sharp-eyed jewel that arrives like a blue lightning bolt.",
		body = rgb(30, 140, 200),
		belly = rgb(255, 160, 60),
		wing = rgb(20, 100, 170),
		beak = rgb(30, 30, 40),
		accent = rgb(255, 255, 255),
		traits = { "Crest", "BigBeak" },
	},

	-- Legendary (Golden Apple Tree)
	{
		id = "toucan",
		name = "Toucan",
		rarity = "Legendary",
		value = 3000,
		scale = 1.7,
		blurb = "That beak is a lot, but it's also the point.",
		body = rgb(30, 30, 35),
		belly = rgb(255, 255, 255),
		wing = rgb(20, 20, 25),
		beak = rgb(255, 150, 20),
		accent = rgb(60, 180, 230),
		traits = { "BigBeak" },
	},
	{
		id = "macaw",
		name = "Scarlet Macaw",
		rarity = "Legendary",
		value = 4200,
		scale = 1.8,
		blurb = "A living rainbow with a tail like a comet.",
		body = rgb(230, 30, 30),
		belly = rgb(240, 60, 50),
		wing = rgb(50, 100, 230),
		beak = rgb(240, 235, 225),
		accent = rgb(255, 210, 40),
		traits = { "LongTail" },
	},
	{
		id = "peacock",
		name = "Peacock",
		rarity = "Legendary",
		value = 6400,
		scale = 1.9,
		blurb = "Only the golden tree is grand enough to deserve this display.",
		body = rgb(20, 110, 190),
		belly = rgb(30, 150, 170),
		wing = rgb(30, 140, 120),
		beak = rgb(200, 190, 150),
		accent = rgb(30, 170, 100),
		traits = { "FanTail", "Crest" },
	},

	-- Mythic (Starbloom)
	{
		id = "owl",
		name = "Aurora Owl",
		rarity = "Mythic",
		value = 22000,
		scale = 2.2,
		blurb = "Wakes only for starlight. Its feathers shimmer like the northern sky.",
		body = rgb(210, 225, 255),
		belly = rgb(245, 250, 255),
		wing = rgb(170, 190, 240),
		beak = rgb(255, 220, 120),
		accent = rgb(120, 255, 230),
		traits = { "OwlFace", "Glow" },
	},
	{
		id = "quetzal",
		name = "Celestial Quetzal",
		rarity = "Mythic",
		value = 31000,
		scale = 2.1,
		blurb = "The legendary spirit bird, trailing a tail of living emerald.",
		body = rgb(60, 230, 150),
		belly = rgb(255, 60, 90),
		wing = rgb(30, 180, 130),
		beak = rgb(255, 220, 60),
		accent = rgb(255, 255, 255),
		traits = { "Crest", "LongTail", "Glow" },
	},
	{
		id = "phoenix",
		name = "Phoenix",
		rarity = "Mythic",
		value = 48000,
		scale = 2.4,
		blurb = "Reborn in fire. Only the rarest bloom in the world calls it home.",
		body = rgb(255, 110, 20),
		belly = rgb(255, 200, 40),
		wing = rgb(255, 60, 20),
		beak = rgb(255, 230, 120),
		accent = rgb(255, 255, 180),
		traits = { "Crest", "LongTail", "Glow", "Fire" },
	},
}

local byId: { [string]: BirdDef } = {}
for _, bird in list do
	byId[bird.id] = bird
end

local Birds = {
	list = list,
}

function Birds.get(id: string): BirdDef?
	return byId[id]
end

function Birds.hasTrait(bird: BirdDef, trait: string): boolean
	return table.find(bird.traits, trait) ~= nil
end

return Birds
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Clock</string>
          <string name="Source"><![CDATA[--!strict
-- One clock for the whole game. GetServerTimeNow is synchronised between the
-- server and every client, so timers agree everywhere (and survive restarts).

local Clock = {}

function Clock.now(): number
	return workspace:GetServerTimeNow()
end

return Clock
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Every tunable number in the game lives here.

local Config = {
	GAME_NAME = "Grow a Bird Garden",

	-- Progression
	START_FEATHERS = 30,
	START_SEEDS = { sunflower = 3 } :: { [string]: number },
	START_PLOTS = 4,
	MAX_PLOTS = 12,
	-- Price of plot #5, #6, #7 ... (plots unlock in order)
	PLOT_PRICES = { 150, 450, 1200, 3500, 10000, 30000, 90000, 250000 } :: { number },

	-- Garden layout
	MAX_GARDENS = 8,
	PLOT_COLUMNS = 4,
	PLOT_ROWS = 3,

	-- Seed shop restocks on a fixed global clock so every server agrees
	RESTOCK_INTERVAL = 180,
	MAX_BUY_AMOUNT = 25,

	-- Plants
	SCALE_MIN = 0.22, -- size of a freshly planted seed relative to full size

	-- Bird visits (one independent "perch slot" per perch on a plant)
	TICK = 0.25,
	VISIT = {
		FIRST_WAIT_MIN = 3, -- delay before the first bird once a plant blooms
		FIRST_WAIT_MAX = 7,
		WAIT_MIN = 8, -- delay between birds on the same perch
		WAIT_MAX = 18,
		STAY_MIN = 10,
		STAY_MAX = 16,
		ARRIVE = 4.5, -- fly-in time; feathers are paid when the bird lands
		LEAVE = 3.5,
	},
	DISCOVERY_MULTIPLIER = 5, -- first time you see a species: value x this, once

	AUTOSAVE_INTERVAL = 60,
	DATASTORE_NAME = "GrowABirdGarden_v1",
}

Config.RARITY_ORDER = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic" }

Config.RARITY_COLORS = {
	Common = Color3.fromRGB(196, 200, 204),
	Uncommon = Color3.fromRGB(98, 214, 104),
	Rare = Color3.fromRGB(84, 160, 255),
	Epic = Color3.fromRGB(180, 104, 255),
	Legendary = Color3.fromRGB(255, 184, 48),
	Mythic = Color3.fromRGB(255, 92, 158),
} :: { [string]: Color3 }

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--!strict

local Format = {}

function Format.commas(n: number): string
	local s = string.format("%.0f", n)
	local k
	repeat
		s, k = string.gsub(s, "^(-?%d+)(%d%d%d)", "%1,%2")
	until k == 0
	return s
end

local SUFFIXES = { "K", "M", "B", "T" }

-- 950 -> "950", 123456 -> "123,456", 1234567 -> "1.23M"
function Format.feathers(n: number): string
	n = math.floor(n + 0.5)
	if n < 1_000_000 then
		return Format.commas(n)
	end
	local value = n
	local suffix = ""
	for _, s in SUFFIXES do
		value /= 1000
		suffix = s
		if value < 1000 then
			break
		end
	end
	local text = string.format("%.2f", value)
	text = string.gsub(text, "%.?0+$", "")
	return text .. suffix
end

-- 34 -> "0:34", 754 -> "12:34", 7300 -> "2h 02m"
function Format.duration(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	if seconds >= 3600 then
		local h = seconds // 3600
		local m = (seconds % 3600) // 60
		return string.format("%dh %02dm", h, m)
	end
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

-- 20 -> "20 sec", 90 -> "1.5 min", 7200 -> "2 hr"
function Format.growTime(seconds: number): string
	if seconds < 60 then
		return string.format("%d sec", seconds)
	elseif seconds < 3600 then
		local minutes = seconds / 60
		if minutes == math.floor(minutes) then
			return string.format("%d min", minutes)
		end
		return string.format("%.1f min", minutes)
	end
	local hours = seconds / 3600
	if hours == math.floor(hours) then
		return string.format("%d hr", hours)
	end
	return string.format("%.1f hr", hours)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Growth</string>
          <string name="Source"><![CDATA[--!strict
-- Pure game rules (no Instances), so they can be unit-tested outside Roblox.

local Config = require(script.Parent.Config)
local Seeds = require(script.Parent.Seeds)
local Types = require(script.Parent.Types)
type SeedDef = Types.SeedDef

local Growth = {}

-- 0 = just planted, 1 = fully grown
function Growth.progress(plantedAt: number, growTime: number, now: number): number
	if growTime <= 0 then
		return 1
	end
	return math.clamp((now - plantedAt) / growTime, 0, 1)
end

-- Visual size of a plant at a given progress
function Growth.scale(progress: number): number
	return Config.SCALE_MIN + (1 - Config.SCALE_MIN) * progress
end

function Growth.pickBird(seed: SeedDef, rng: Random): string
	local total = 0
	for _, entry in seed.birds do
		total += entry.weight
	end
	local roll = rng:NextNumber() * total
	for _, entry in seed.birds do
		roll -= entry.weight
		if roll <= 0 then
			return entry.id
		end
	end
	return seed.birds[#seed.birds].id
end

-- The shop restocks on a fixed global clock. The roll is seeded by the interval
-- number, so every server sees the same stock (like the real Grow a Garden).
function Growth.restockIndex(now: number): number
	return math.floor(now / Config.RESTOCK_INTERVAL)
end

function Growth.nextRestock(now: number): number
	return (Growth.restockIndex(now) + 1) * Config.RESTOCK_INTERVAL
end

function Growth.rollStock(index: number): { [string]: number }
	local rng = Random.new(index * 7919 + 17)
	local stock: { [string]: number } = {}
	for _, seed in Seeds.list do
		-- Always consume the same rolls so one seed's luck never shifts another's.
		local roll = rng:NextNumber()
		local amount = rng:NextInteger(seed.stock.min, seed.stock.max)
		if roll < seed.stock.chance then
			stock[seed.id] = amount
		end
	end
	return stock
end

-- Price of the next plot to unlock, or nil when every plot is already unlocked.
function Growth.plotPrice(unlocked: number): number?
	return Config.PLOT_PRICES[unlocked - Config.START_PLOTS + 1]
end

-- Expected feathers per visit for a seed (used for balancing and the shop UI).
function Growth.expectedVisitValue(seed: SeedDef, birdValue: (string) -> number): number
	local total, weighted = 0, 0
	for _, entry in seed.birds do
		total += entry.weight
		weighted += entry.weight * birdValue(entry.id)
	end
	return weighted / total
end

return Growth
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">PlantModels</string>
          <string name="Source"><![CDATA[--!strict
-- Procedural plant models built from primitive parts (no uploaded assets needed).
-- Every plant is authored at full size with its root at the soil surface.
--   * parts tagged "Bud"   are visible while the plant is growing
--   * parts tagged "Bloom" are visible once it is fully grown
--   * effects tagged "BloomFX" (particles, lights) switch on at full growth

local PlantModels = {}

local Builder = {}
Builder.__index = Builder

type BuilderData = { model: Model, origin: CFrame }
type Builder = typeof(setmetatable({} :: BuilderData, Builder))

local PLASTIC = Enum.Material.SmoothPlastic

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local function newPart(
	self: Builder,
	name: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?,
	kind: string?
): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or PLASTIC
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = self.origin * cf
	if kind then
		p:SetAttribute(kind, true)
	end
	p.Parent = self.model
	return p
end

-- Squashed sphere (ellipsoid)
function Builder.blob(
	self: Builder,
	name: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?,
	kind: string?
): Part
	local p = newPart(self, name, size, cf, color, material, kind)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

function Builder.block(
	self: Builder,
	name: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?,
	kind: string?
): Part
	return newPart(self, name, size, cf, color, material, kind)
end

-- Upright cylinder; `cf` is the centre (rotate it to lean the stem).
function Builder.stem(
	self: Builder,
	name: string,
	height: number,
	diameter: number,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?,
	kind: string?
): Part
	local p = newPart(
		self,
		name,
		Vector3.new(height, diameter, diameter),
		cf * CFrame.Angles(0, 0, math.rad(90)),
		color,
		material,
		kind
	)
	p.Shape = Enum.PartType.Cylinder
	return p
end

-- Flat disc whose face looks along `cf`'s look vector (-Z).
function Builder.disc(
	self: Builder,
	name: string,
	thickness: number,
	diameter: number,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?,
	kind: string?
): Part
	local p = newPart(
		self,
		name,
		Vector3.new(thickness, diameter, diameter),
		cf * CFrame.Angles(0, math.rad(90), 0),
		color,
		material,
		kind
	)
	p.Shape = Enum.PartType.Cylinder
	return p
end

function Builder.fx(self: Builder, parent: BasePart, emitter: ParticleEmitter)
	emitter.Name = "BloomFX"
	emitter:SetAttribute("BloomFX", true)
	emitter.Enabled = false
	emitter.Parent = parent
end

function Builder.light(self: Builder, parent: BasePart, color: Color3, range: number, brightness: number)
	local light = Instance.new("PointLight")
	light.Name = "BloomFX"
	light:SetAttribute("BloomFX", true)
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Enabled = false
	light.Parent = parent
end

-- A small invisible anchor part that particle emitters can be parented to.
function Builder.anchor(self: Builder, name: string, size: Vector3, cf: CFrame): Part
	local p = newPart(self, name, size, cf, rgb(255, 255, 255), PLASTIC, nil)
	p.Transparency = 1
	return p
end

local function sparkle(color: Color3, rate: number, lifetime: number, size: number, speed: number): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color)
	e.Rate = rate
	e.Lifetime = NumberRange.new(lifetime * 0.7, lifetime)
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.3, size),
		NumberSequenceKeypoint.new(1, 0),
	})
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.LightEmission = 0.8
	e.Drag = 1
	e.Acceleration = Vector3.new(0, 0.5, 0)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-40, 40)
	return e
end

local function petalFall(color: Color3): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color)
	e.Rate = 6
	e.Lifetime = NumberRange.new(3, 4.5)
	e.Speed = NumberRange.new(0.5, 1.5)
	e.EmissionDirection = Enum.NormalId.Bottom
	e.SpreadAngle = Vector2.new(60, 60)
	e.Size = NumberSequence.new(0.35)
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	e.Acceleration = Vector3.new(0, -1.5, 0)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-120, 120)
	return e
end

local BARK = rgb(112, 78, 54)

------------------------------------------------------------------------------
-- Individual plants
------------------------------------------------------------------------------

local builders: { [string]: (b: Builder) -> () } = {}

function builders.sunflower(b)
	local stemColor = rgb(70, 140, 60)
	b:stem("Stem", 4.2, 0.36, CFrame.new(0, 2.1, 0), stemColor, nil, nil)
	b:blob(
		"Leaf",
		Vector3.new(1.6, 0.12, 0.8),
		CFrame.new(0.9, 1.4, 0) * CFrame.Angles(0, 0, math.rad(22)),
		rgb(84, 168, 70),
		nil,
		nil
	)
	b:blob(
		"Leaf",
		Vector3.new(1.6, 0.12, 0.8),
		CFrame.new(-0.9, 2.0, 0) * CFrame.Angles(0, 0, math.rad(-22)),
		rgb(84, 168, 70),
		nil,
		nil
	)

	-- The flower head looks up and out so birds can perch right on the seeds.
	local head = CFrame.new(0, 4.65, 0) * CFrame.Angles(math.rad(45), 0, 0)
	b:blob("Bud", Vector3.new(1.4, 1.4, 1.4), CFrame.new(0, 4.5, 0), rgb(92, 172, 72), nil, "Bud")
	b:disc("HeadDisc", 0.3, 3.0, head, rgb(255, 205, 40), nil, "Bloom")
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2
		local color = if i % 2 == 0 then rgb(255, 196, 24) else rgb(255, 170, 20)
		b:blob(
			"Petal",
			Vector3.new(1.1, 0.55, 0.14),
			head * CFrame.Angles(0, 0, a) * CFrame.new(1.75, 0, 0.02),
			color,
			nil,
			"Bloom"
		)
	end
	b:disc("Seeds", 0.5, 1.8, head * CFrame.new(0, 0, -0.1), rgb(88, 58, 36), nil, "Bloom")
	local glow = b:anchor("FXAnchor", Vector3.new(2, 0.2, 2), CFrame.new(0, 5.2, 0))
	b:fx(glow, sparkle(rgb(255, 228, 120), 3, 2, 0.35, 2))
end

function builders.berrybush(b)
	local greens = { rgb(66, 140, 62), rgb(76, 154, 68), rgb(58, 126, 56), rgb(72, 148, 64), rgb(62, 134, 60) }
	local blobs = {
		{ Vector3.new(3.4, 2.4, 3.2), Vector3.new(0, 1.2, 0) },
		{ Vector3.new(2.4, 2.0, 2.2), Vector3.new(1.3, 1.0, 0.6) },
		{ Vector3.new(2.4, 2.1, 2.3), Vector3.new(-1.2, 1.1, -0.5) },
		{ Vector3.new(2.6, 2.1, 2.4), Vector3.new(0.3, 2.1, -0.4) },
		{ Vector3.new(2.0, 1.7, 2.0), Vector3.new(-0.6, 1.8, 0.8) },
	}
	for i, spec in blobs do
		b:blob("Foliage", spec[1], CFrame.new(spec[2]), greens[i], Enum.Material.Grass, nil)
	end
	-- Berries sit on the surface of the main mass of leaves.
	for i = 1, 18 do
		local a = i * 2.39996
		local e = 0.15 + (i % 5) * 0.22
		local pos =
			Vector3.new(1.75 * math.cos(e) * math.cos(a), 1.2 + 1.5 * math.sin(e), 1.65 * math.cos(e) * math.sin(a))
		local color = if i % 3 == 0 then rgb(86, 64, 176) else rgb(196, 30, 76)
		b:blob("Berry", Vector3.new(0.5, 0.5, 0.5), CFrame.new(pos), color, nil, "Bloom")
	end
	local flowerGlow = b:anchor("FXAnchor", Vector3.new(3, 0.2, 3), CFrame.new(0, 3, 0))
	b:fx(flowerGlow, sparkle(rgb(255, 150, 190), 3, 2, 0.3, 1.5))
end

function builders.cherry(b)
	b:stem("Trunk", 5.6, 1.1, CFrame.new(0, 2.8, 0), BARK, Enum.Material.Wood, nil)
	b:stem(
		"Branch",
		3.4,
		0.6,
		CFrame.new(1.3, 6.1, 0) * CFrame.Angles(0, 0, math.rad(-35)),
		BARK,
		Enum.Material.Wood,
		nil
	)
	b:stem(
		"Branch",
		3.4,
		0.6,
		CFrame.new(-1.4, 5.9, 0) * CFrame.Angles(0, 0, math.rad(38)),
		BARK,
		Enum.Material.Wood,
		nil
	)

	local canopy = {
		{ Vector3.new(5.6, 4.2, 5.3), Vector3.new(0, 8.3, 0) },
		{ Vector3.new(4.2, 3.4, 4.0), Vector3.new(2.8, 7.9, 0.4) },
		{ Vector3.new(4.2, 3.2, 4.0), Vector3.new(-2.9, 7.5, 0.4) },
		{ Vector3.new(3.8, 2.8, 3.6), Vector3.new(0.2, 9.2, -0.5) },
		{ Vector3.new(3.6, 2.8, 3.6), Vector3.new(0.2, 7.4, 2.3) },
	}
	for _, spec in canopy do
		b:blob("Leaves", spec[1], CFrame.new(spec[2]), rgb(92, 170, 80), Enum.Material.Grass, "Bud")
		b:blob(
			"Blossoms",
			spec[1] * 1.03,
			CFrame.new(spec[2]),
			rgb(255, 172, 202),
			Enum.Material.SmoothPlastic,
			"Bloom"
		)
	end
	for i = 1, 8 do
		local a = i * 2.4
		local pos = Vector3.new(2.6 * math.cos(a), 8.6 + (i % 3) * 0.8, 2.5 * math.sin(a))
		b:blob("Blossom", Vector3.new(0.8, 0.8, 0.8), CFrame.new(pos), rgb(255, 214, 230), nil, "Bloom")
	end
	local petals = b:anchor("FXAnchor", Vector3.new(7, 0.2, 7), CFrame.new(0, 9, 0))
	b:fx(petals, petalFall(rgb(255, 190, 215)))
end

local function hibiscusFlower(b: Builder, pos: Vector3, outward: Vector3)
	local base = CFrame.lookAt(pos, pos + outward)
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2
		local color = if i % 2 == 0 then rgb(255, 64, 90) else rgb(255, 92, 110)
		b:blob(
			"Petal",
			Vector3.new(1.4, 1.1, 0.2),
			base * CFrame.Angles(0, 0, a) * CFrame.new(0.7, 0, 0),
			color,
			nil,
			"Bloom"
		)
	end
	b:disc("Heart", 0.25, 0.8, base * CFrame.new(0, 0, -0.1), rgb(255, 150, 40), nil, "Bloom")
	b:blob("Stamen", Vector3.new(0.22, 0.22, 0.9), base * CFrame.new(0, 0, -0.5), rgb(255, 224, 80), nil, "Bloom")
	b:blob("FlowerBud", Vector3.new(0.7, 1.1, 0.7), CFrame.new(pos), rgb(214, 70, 80), nil, "Bud")
end

function builders.hibiscus(b)
	local dark = rgb(44, 128, 62)
	b:stem("Stem", 3.4, 0.6, CFrame.new(0, 1.7, 0), rgb(96, 84, 52), Enum.Material.Wood, nil)
	b:stem(
		"Stem",
		3.0,
		0.45,
		CFrame.new(1.1, 1.6, 0) * CFrame.Angles(0, 0, math.rad(-24)),
		rgb(96, 84, 52),
		Enum.Material.Wood,
		nil
	)
	b:stem(
		"Stem",
		3.0,
		0.45,
		CFrame.new(-1.1, 1.6, 0) * CFrame.Angles(0, 0, math.rad(24)),
		rgb(96, 84, 52),
		Enum.Material.Wood,
		nil
	)
	b:blob("Foliage", Vector3.new(4.8, 3.4, 4.6), CFrame.new(0, 3.6, 0), dark, Enum.Material.Grass, nil)
	b:blob("Foliage", Vector3.new(3.4, 2.6, 3.2), CFrame.new(2.3, 3.1, 0.2), rgb(52, 140, 66), Enum.Material.Grass, nil)
	b:blob(
		"Foliage",
		Vector3.new(3.4, 2.6, 3.2),
		CFrame.new(-2.3, 3.3, -0.3),
		rgb(40, 120, 58),
		Enum.Material.Grass,
		nil
	)
	b:blob("Foliage", Vector3.new(3.4, 2.7, 3.2), CFrame.new(0.4, 5.0, 0.1), rgb(50, 136, 64), Enum.Material.Grass, nil)

	hibiscusFlower(b, Vector3.new(1.0, 3.6, 2.35), Vector3.new(0.2, 0.2, 1))
	hibiscusFlower(b, Vector3.new(-1.5, 3.9, -2.2), Vector3.new(-0.2, 0.3, -1))
	hibiscusFlower(b, Vector3.new(3.6, 3.6, 0.3), Vector3.new(1, 0.3, 0.1))
	hibiscusFlower(b, Vector3.new(-3.9, 3.2, 0.3), Vector3.new(-1, 0.2, 0.1))
	hibiscusFlower(b, Vector3.new(2.0, 5.5, 1.5), Vector3.new(0.5, 0.6, 0.8))
	local glow = b:anchor("FXAnchor", Vector3.new(4, 0.2, 4), CFrame.new(0, 5.5, 0))
	b:fx(glow, sparkle(rgb(255, 120, 150), 4, 2, 0.35, 2))
end

function builders.goldenapple(b)
	b:blob("RootFlare", Vector3.new(3.4, 1.4, 3.4), CFrame.new(0, 0.5, 0), BARK, Enum.Material.Wood, nil)
	b:stem("Trunk", 8, 2.0, CFrame.new(0, 4, 0), BARK, Enum.Material.Wood, nil)
	b:stem(
		"Branch",
		4.4,
		0.9,
		CFrame.new(2, 8.2, 0.3) * CFrame.Angles(0, 0, math.rad(-45)),
		BARK,
		Enum.Material.Wood,
		nil
	)
	b:stem(
		"Branch",
		4.4,
		0.9,
		CFrame.new(-2, 8, -0.3) * CFrame.Angles(0, 0, math.rad(45)),
		BARK,
		Enum.Material.Wood,
		nil
	)

	local mainCenter, mainRadii = Vector3.new(0, 11.5, 0), Vector3.new(4.5, 3.25, 4.25)
	b:blob("Canopy", mainRadii * 2, CFrame.new(mainCenter), rgb(66, 148, 58), Enum.Material.Grass, nil)
	b:blob("Canopy", Vector3.new(5, 4.6, 5), CFrame.new(3.6, 10.4, 0.8), rgb(74, 158, 64), Enum.Material.Grass, nil)
	b:blob("Canopy", Vector3.new(5, 4.6, 5), CFrame.new(-3.7, 10, -0.6), rgb(60, 140, 54), Enum.Material.Grass, nil)

	-- Fruit hangs on the surface of the main canopy: unripe green, then gold.
	for i = 1, 16 do
		local a = i * 2.39996
		local e = -0.55 + (i % 5) * 0.27
		local pos = mainCenter
			+ Vector3.new(
				mainRadii.X * math.cos(e) * math.cos(a),
				mainRadii.Y * math.sin(e),
				mainRadii.Z * math.cos(e) * math.sin(a)
			)
		b:blob("UnripeApple", Vector3.new(0.6, 0.6, 0.6), CFrame.new(pos), rgb(150, 190, 70), nil, "Bud")
		local apple = b:blob(
			"GoldenApple",
			Vector3.new(1, 1, 1),
			CFrame.new(pos),
			rgb(255, 196, 40),
			Enum.Material.Metal,
			"Bloom"
		)
		apple.Reflectance = 0.15
	end
	local glow = b:anchor("FXAnchor", Vector3.new(9, 0.2, 9), CFrame.new(0, 11, 0))
	b:fx(glow, sparkle(rgb(255, 214, 90), 8, 3, 0.5, 2.5))
	b:light(glow, rgb(255, 200, 90), 22, 0.8)
end

function builders.starbloom(b)
	local deep = rgb(58, 40, 112)
	b:stem("Trunk", 9, 1.6, CFrame.new(0, 4.5, 0), deep, Enum.Material.SmoothPlastic, nil)
	b:stem("Vein", 8.6, 0.26, CFrame.new(0.55, 4.4, 0.3), rgb(120, 255, 240), Enum.Material.Neon, "Bloom")
	b:stem("Vein", 8.6, 0.26, CFrame.new(-0.5, 4.4, -0.35), rgb(255, 150, 240), Enum.Material.Neon, "Bloom")
	b:stem(
		"Branch",
		4.6,
		0.8,
		CFrame.new(2.4, 8.6, 0) * CFrame.Angles(0, 0, math.rad(-48)),
		deep,
		Enum.Material.SmoothPlastic,
		nil
	)
	b:stem(
		"Branch",
		4.6,
		0.8,
		CFrame.new(-2.4, 8.6, 0) * CFrame.Angles(0, 0, math.rad(48)),
		deep,
		Enum.Material.SmoothPlastic,
		nil
	)

	local canopy = {
		{ size = Vector3.new(7, 5, 7), pos = Vector3.new(0, 13, 0), color = rgb(150, 110, 255) },
		{ size = Vector3.new(4.6, 4, 4.6), pos = Vector3.new(3.8, 10.6, 0), color = rgb(100, 200, 255) },
		{ size = Vector3.new(4.6, 4, 4.6), pos = Vector3.new(-3.8, 10.6, 0), color = rgb(255, 130, 224) },
		{ size = Vector3.new(4.2, 3.6, 4.2), pos = Vector3.new(0, 10.4, 3.6), color = rgb(130, 255, 205) },
		{ size = Vector3.new(4.2, 3.6, 4.2), pos = Vector3.new(0, 10.4, -3.6), color = rgb(255, 214, 120) },
	}
	for _, spec in canopy do
		b:blob("NightLeaves", spec.size, CFrame.new(spec.pos), rgb(52, 46, 128), Enum.Material.SmoothPlastic, "Bud")
		b:blob("StarLeaves", spec.size * 1.03, CFrame.new(spec.pos), spec.color, Enum.Material.Neon, "Bloom")
	end
	-- Floating star shards orbiting the crown.
	for i = 1, 10 do
		local a = i * 2.39996
		local pos = Vector3.new(math.cos(a) * (7.5 + (i % 3)), 8.5 + (i % 5) * 1.7, math.sin(a) * (7.5 + (i % 3)))
		local color = if i % 2 == 0 then rgb(255, 250, 190) else rgb(190, 235, 255)
		b:block(
			"Shard",
			Vector3.new(0.6, 0.6, 0.6),
			CFrame.new(pos) * CFrame.Angles(math.rad(45), math.rad(45), 0),
			color,
			Enum.Material.Neon,
			"Bloom"
		)
	end
	local glow = b:anchor("FXAnchor", Vector3.new(10, 0.2, 10), CFrame.new(0, 12, 0))
	local e = sparkle(rgb(255, 255, 255), 14, 3.5, 0.55, 3)
	e.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, rgb(120, 255, 240)),
		ColorSequenceKeypoint.new(0.5, rgb(190, 130, 255)),
		ColorSequenceKeypoint.new(1, rgb(255, 130, 224)),
	})
	b:fx(glow, e)
	b:light(glow, rgb(170, 130, 255), 30, 1.4)
end

------------------------------------------------------------------------------
-- Public API
------------------------------------------------------------------------------

-- Shows the right half of a plant: growing look vs blooming look.
function PlantModels.setMature(model: Model, mature: boolean)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			if d:GetAttribute("Bloom") then
				d.Transparency = if mature then 0 else 1
			elseif d:GetAttribute("Bud") then
				d.Transparency = if mature then 1 else 0
			end
		elseif d:GetAttribute("BloomFX") then
			(d :: any).Enabled = mature
		end
	end
	model:SetAttribute("Mature", mature)
end

function PlantModels.build(seedId: string, origin: CFrame, mature: boolean): Model?
	local builder = builders[seedId]
	if not builder then
		return nil
	end
	local model = Instance.new("Model")
	model.Name = "Plant"

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 0.2, 1)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.CFrame = origin
	root.Parent = model
	model.PrimaryPart = root

	builder(setmetatable({ model = model, origin = origin }, Builder))
	PlantModels.setMature(model, mature)
	return model
end

return PlantModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
-- All remote events/functions are created by the server at startup and looked
-- up by name here, so the place file needs no pre-built RemoteEvent instances.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENT_NAMES = {
	"StateUpdate", -- server -> client: Snapshot
	"StockUpdate", -- server -> client: StockInfo
	"BirdVisit", -- server -> client: VisitInfo
	"BirdCancel", -- server -> client: visit id
	"Notify", -- server -> client: Notice
	"PlantSeed", -- client -> server: plotIndex, seedId
	"DigPlant", -- client -> server: plotIndex
	"Dev", -- client -> server: action (Studio only)
}

local FUNCTION_NAMES = {
	"Init", -- client -> server: returns { state, stock, visits }
	"BuySeed", -- client -> server: seedId, amount -> Result
	"UnlockPlot", -- client -> server -> Result
}

export type Remotes = {
	StateUpdate: RemoteEvent,
	StockUpdate: RemoteEvent,
	BirdVisit: RemoteEvent,
	BirdCancel: RemoteEvent,
	Notify: RemoteEvent,
	PlantSeed: RemoteEvent,
	DigPlant: RemoteEvent,
	Dev: RemoteEvent,
	Init: RemoteFunction,
	BuySeed: RemoteFunction,
	UnlockPlot: RemoteFunction,
}

local cached: Remotes? = nil

local function get(): Remotes
	if cached then
		return cached
	end

	local isServer = RunService:IsServer()
	local folder: Instance
	if isServer then
		local existing = ReplicatedStorage:FindFirstChild("Remotes")
		if existing then
			folder = existing
		else
			folder = Instance.new("Folder")
			folder.Name = "Remotes"
			folder.Parent = ReplicatedStorage
		end
	else
		folder = ReplicatedStorage:WaitForChild("Remotes")
	end

	local map: { [string]: Instance } = {}
	local function resolve(name: string, create: () -> Instance)
		if isServer then
			local found = folder:FindFirstChild(name)
			local inst: Instance = found or create()
			if not found then
				inst.Name = name
				inst.Parent = folder
			end
			map[name] = inst
		else
			map[name] = folder:WaitForChild(name)
		end
	end
	for _, name in EVENT_NAMES do
		resolve(name, function()
			return Instance.new("RemoteEvent")
		end)
	end
	for _, name in FUNCTION_NAMES do
		resolve(name, function()
			return Instance.new("RemoteFunction")
		end)
	end

	local remotes = (map :: any) :: Remotes
	cached = remotes
	return remotes
end

return { get = get }
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Scheduler</string>
          <string name="Source"><![CDATA[--!strict
-- Pure state machine for one perch on a plant:
--   idle --(wait elapsed)--> visiting --(lands: pay feathers)--> visiting --(leaves)--> idle
-- The server ticks it; the Roblox-specific work (spawning, paying) lives in BirdService.

local Config = require(script.Parent.Config)

local Scheduler = {}

export type Slot = {
	visiting: boolean,
	nextVisitAt: number,
	rewardAt: number,
	endAt: number,
	paid: boolean,
	visitId: number?,
}

export type Timing = { arrive: number, stay: number, leave: number }

function Scheduler.newSlot(now: number, rng: Random, first: boolean): Slot
	local v = Config.VISIT
	local wait = if first
		then rng:NextNumber(v.FIRST_WAIT_MIN, v.FIRST_WAIT_MAX)
		else rng:NextNumber(v.WAIT_MIN, v.WAIT_MAX)
	return { visiting = false, nextVisitAt = now + wait, rewardAt = 0, endAt = 0, paid = false, visitId = nil }
end

-- What should happen to this slot right now?
function Scheduler.due(slot: Slot, now: number): "start" | "reward" | "finish" | nil
	if not slot.visiting then
		if now >= slot.nextVisitAt then
			return "start"
		end
		return nil
	end
	if not slot.paid and now >= slot.rewardAt then
		return "reward"
	end
	if now >= slot.endAt then
		return "finish"
	end
	return nil
end

function Scheduler.start(slot: Slot, now: number, rng: Random): Timing
	local v = Config.VISIT
	local timing = { arrive = v.ARRIVE, stay = rng:NextNumber(v.STAY_MIN, v.STAY_MAX), leave = v.LEAVE }
	slot.visiting = true
	slot.paid = false
	slot.rewardAt = now + timing.arrive
	slot.endAt = now + timing.arrive + timing.stay + timing.leave
	return timing
end

function Scheduler.markPaid(slot: Slot)
	slot.paid = true
end

function Scheduler.finish(slot: Slot, now: number, rng: Random)
	local v = Config.VISIT
	slot.visiting = false
	slot.visitId = nil
	slot.nextVisitAt = now + rng:NextNumber(v.WAIT_MIN, v.WAIT_MAX)
end

return Scheduler
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Seeds</string>
          <string name="Source"><![CDATA[--!strict
local Types = require(script.Parent.Types)
type SeedDef = Types.SeedDef

-- Better seeds take longer to grow, cost more, and attract rarer birds.
-- Each seed mostly draws birds of its own tier, with a ~3% chance of a bird
-- from the tier above (a "lucky visit").
local list: { SeedDef } = {
	{
		id = "sunflower",
		name = "Sunflower",
		rarity = "Common",
		tier = 1,
		price = 15,
		growTime = 20,
		blurb = "Quick to grow. Perfect for finches and sparrows.",
		color = Color3.fromRGB(255, 205, 40),
		labelHeight = 6.6,
		perches = { { 0, 5.1, -0.15 } },
		birds = {
			{ id = "sparrow", weight = 60 },
			{ id = "goldfinch", weight = 29 },
			{ id = "dove", weight = 10 },
			{ id = "robin", weight = 1 },
		},
		stock = { chance = 1, min = 6, max = 12 },
	},
	{
		id = "berrybush",
		name = "Berry Bush",
		rarity = "Uncommon",
		tier = 2,
		price = 140,
		growTime = 90,
		blurb = "Juicy berries bring the songbirds.",
		color = Color3.fromRGB(190, 40, 80),
		labelHeight = 3.4,
		perches = { { 0.3, 3.2, -0.4 } },
		birds = {
			{ id = "robin", weight = 55 },
			{ id = "chickadee", weight = 30 },
			{ id = "bluebird", weight = 12 },
			{ id = "bluejay", weight = 3 },
		},
		stock = { chance = 0.8, min = 2, max = 5 },
	},
	{
		id = "cherry",
		name = "Cherry Blossom",
		rarity = "Rare",
		tier = 3,
		price = 2100,
		growTime = 300,
		blurb = "A tree in full bloom. Two perches for two proud visitors.",
		color = Color3.fromRGB(255, 160, 190),
		labelHeight = 10.6,
		perches = { { 2.6, 9.55, 0.4 }, { -2.8, 9.05, 0.4 } },
		birds = {
			{ id = "bluejay", weight = 55 },
			{ id = "cardinal", weight = 30 },
			{ id = "oriole", weight = 12 },
			{ id = "hummingbird", weight = 3 },
		},
		stock = { chance = 0.5, min = 1, max = 3 },
	},
	{
		id = "hibiscus",
		name = "Hibiscus",
		rarity = "Epic",
		tier = 4,
		price = 13000,
		growTime = 900,
		blurb = "Enormous tropical flowers that hummingbirds dream about.",
		color = Color3.fromRGB(255, 70, 90),
		labelHeight = 7,
		perches = { { 0.4, 6.35, 0.1 }, { -2.3, 4.65, -0.3 } },
		birds = {
			{ id = "hummingbird", weight = 50 },
			{ id = "parakeet", weight = 30 },
			{ id = "kingfisher", weight = 17 },
			{ id = "toucan", weight = 3 },
		},
		stock = { chance = 0.25, min = 1, max = 2 },
	},
	{
		id = "goldenapple",
		name = "Golden Apple Tree",
		rarity = "Legendary",
		tier = 5,
		price = 140000,
		growTime = 2400,
		blurb = "A magnificent tree of golden fruit. Three perches for the grandest birds.",
		color = Color3.fromRGB(255, 200, 50),
		labelHeight = 15,
		perches = { { 0, 14.8, 0 }, { 3.4, 12.7, 0.8 }, { -3.5, 12.3, -0.6 } },
		birds = {
			{ id = "toucan", weight = 50 },
			{ id = "macaw", weight = 32 },
			{ id = "peacock", weight = 15 },
			{ id = "owl", weight = 3 },
		},
		stock = { chance = 0.1, min = 1, max = 1 },
	},
	{
		id = "starbloom",
		name = "Starbloom",
		rarity = "Mythic",
		tier = 6,
		price = 1050000,
		growTime = 7200,
		blurb = "A celestial tree that blooms with starlight. Mythic birds only.",
		color = Color3.fromRGB(180, 120, 255),
		labelHeight = 16.6,
		perches = { { 0, 15.55, 0 }, { 3.8, 12.65, 0 }, { -3.8, 12.65, 0 } },
		birds = {
			{ id = "owl", weight = 52 },
			{ id = "quetzal", weight = 32 },
			{ id = "phoenix", weight = 16 },
		},
		stock = { chance = 0.05, min = 1, max = 1 },
	},
}

local byId: { [string]: SeedDef } = {}
for _, seed in list do
	byId[seed.id] = seed
end

local Seeds = {
	list = list,
}

function Seeds.get(id: string): SeedDef?
	return byId[id]
end

function Seeds.isValid(id: any): boolean
	return typeof(id) == "string" and byId[id] ~= nil
end

return Seeds
]]></string>
