        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!strict
-- The client's copy of the player's data, plus which seed is selected.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Seeds = require(Shared:WaitForChild("Seeds"))
local Signal = require(Shared:WaitForChild("Signal"))
local Types = require(Shared:WaitForChild("Types"))

local State = {
	feathers = 0,
	seeds = {} :: { [string]: number },
	birds = {} :: { [string]: number },
	plots = 0,
	nextPlotPrice = nil :: number?,
	totalVisits = 0,
	stock = {} :: { [string]: number },
	nextRestock = 0,
	selected = nil :: string?,
	changed = Signal.new(), -- any data change
	stockChanged = Signal.new(),
	selectedChanged = Signal.new(),
}

local function ensureSelection()
	local current = State.selected
	if current and (State.seeds[current] or 0) > 0 then
		return
	end
	local pick: string? = nil
	for _, seed in Seeds.list do
		if (State.seeds[seed.id] or 0) > 0 then
			pick = seed.id
			break
		end
	end
	if pick ~= current then
		State.selected = pick
		State.selectedChanged:Fire(pick)
	end
end

function State.apply(snapshot: Types.Snapshot)
	State.feathers = snapshot.feathers
	State.seeds = snapshot.seeds
	State.birds = snapshot.birds
	State.plots = snapshot.plots
	State.nextPlotPrice = snapshot.nextPlotPrice
	State.totalVisits = snapshot.totalVisits
	ensureSelection()
	State.changed:Fire()
end

function State.setStock(info: Types.StockInfo)
	State.stock = info.stock
	State.nextRestock = info.nextRestock
	State.stockChanged:Fire()
end

function State.select(id: string?)
	if id ~= nil and (State.seeds[id] or 0) < 1 then
		return
	end
	if State.selected ~= id then
		State.selected = id
		State.selectedChanged:Fire(id)
	end
end

function State.seedCount(id: string): number
	return State.seeds[id] or 0
end

function State.totalSeeds(): number
	local total = 0
	for _, count in State.seeds do
		total += count
	end
	return total
end

function State.speciesDiscovered(): number
	local n = 0
	for _ in State.birds do
		n += 1
	end
	return n
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Toasts</string>
            <string name="Source"><![CDATA[--!strict
-- Transient feedback: toast messages, the "new bird discovered" banner, and the
-- floating "+feathers" popup that appears over a bird when it lands.

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BirdModel = require(Shared:WaitForChild("BirdModel"))
local Birds = require(Shared:WaitForChild("Birds"))
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Types = require(Shared:WaitForChild("Types"))

local Ui = require(script.Parent.Ui)
local Viewport = require(script.Parent.Viewport)

local Toasts = {}

local container: Frame
local banner: Frame
local bannerStroke: UIStroke
local fxFolder: Folder

local MAX_TOASTS = 4

function Toasts.init(gui: ScreenGui)
	container = Ui.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 108),
		Size = UDim2.new(0.9, 0, 0, 220),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Ui.new("UIListLayout", {
			Padding = UDim.new(0, 6),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	banner = Ui.new("Frame", {
		Name = "DiscoveryBanner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -220),
		Size = UDim2.fromOffset(400, 130),
		BackgroundColor3 = Ui.COLORS.bg,
		Visible = false,
		ZIndex = 20,
		Parent = gui,
	}, { Ui.corner(18) })
	bannerStroke = Ui.stroke(Ui.COLORS.gold, 3)
	bannerStroke.Parent = banner

	fxFolder = Ui.new("Folder", { Name = "ClientFX", Parent = workspace })
end

local order = 0

function Toasts.show(text: string, color: Color3?)
	order += 1
	local toast = Ui.new("TextLabel", {
		Name = "Toast",
		LayoutOrder = order,
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = Ui.COLORS.bg,
		BackgroundTransparency = 0.1,
		Font = Ui.FONT_BOLD,
		Text = text,
		TextColor3 = color or Ui.COLORS.text,
		TextSize = 16,
		TextWrapped = true,
		Parent = container,
	}, {
		Ui.corner(12),
		Ui.padding(10),
		Ui.stroke(color or Ui.COLORS.panelLight, 2, 0.3),
		Ui.new("UISizeConstraint", { MaxSize = Vector2.new(460, 120) }),
	})

	-- keep the stack short
	local toasts = {}
	for _, child in container:GetChildren() do
		if child.Name == "Toast" then
			table.insert(toasts, child)
		end
	end
	if #toasts > MAX_TOASTS then
		toasts[1]:Destroy()
	end

	task.delay(3.6, function()
		if not toast.Parent then
			return
		end
		local info = TweenInfo.new(0.4)
		TweenService:Create(toast, info, { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
		local stroke = toast:FindFirstChildOfClass("UIStroke")
		if stroke then
			TweenService:Create(stroke, info, { Transparency = 1 }):Play()
		end
		task.wait(0.45)
		toast:Destroy()
	end)
end

function Toasts.result(result: any)
	if type(result) ~= "table" then
		return
	end
	Toasts.show(tostring(result.message), if result.ok then Ui.COLORS.good else Ui.COLORS.bad)
end

------------------------------------------------------------------------------
-- Discovery banner
------------------------------------------------------------------------------

local queue: { { birdId: string, bonus: number } } = {}
local pumping = false

local function playBanner(birdId: string, bonus: number)
	local def = Birds.get(birdId)
	if not def then
		return
	end
	local rarityColor = Config.RARITY_COLORS[def.rarity]

	for _, child in banner:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	bannerStroke.Color = rarityColor

	local preview = Ui.new("ViewportFrame", {
		Position = UDim2.fromOffset(12, 10),
		Size = UDim2.fromOffset(110, 110),
		Parent = banner,
	})
	Viewport.mount(preview, BirdModel.build(def).model)

	Ui.label({
		Position = UDim2.fromOffset(134, 12),
		Size = UDim2.new(1, -146, 0, 18),
		Text = "NEW BIRD DISCOVERED!",
		Font = Ui.FONT_BOLD,
		TextSize = 14,
		TextColor3 = Ui.COLORS.gold,
		Parent = banner,
	})
	Ui.label({
		Position = UDim2.fromOffset(134, 34),
		Size = UDim2.new(1, -146, 0, 34),
		Text = def.name,
		Font = Ui.FONT,
		TextSize = 28,
		TextColor3 = rarityColor,
		TextScaled = true,
		Parent = banner,
	})
	Ui.label({
		Position = UDim2.fromOffset(134, 72),
		Size = UDim2.new(1, -146, 0, 18),
		Text = def.rarity,
		Font = Ui.FONT_BOLD,
		TextSize = 15,
		TextColor3 = rarityColor,
		Parent = banner,
	})
	Ui.label({
		Position = UDim2.fromOffset(134, 94),
		Size = UDim2.new(1, -146, 0, 22),
		Text = `Discovery bonus: +{Format.feathers(bonus)} feathers`,
		Font = Ui.FONT_BOLD,
		TextSize = 15,
		TextColor3 = Ui.COLORS.good,
		Parent = banner,
	})

	banner.Visible = true
	banner.Position = UDim2.new(0.5, 0, 0, -220)
	TweenService:Create(
		banner,
		TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Position = UDim2.new(0.5, 0, 0, 130) }
	):Play()
	task.wait(4.2)
	local out = TweenService:Create(
		banner,
		TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Position = UDim2.new(0.5, 0, 0, -220) }
	)
	out:Play()
	out.Completed:Wait()
	banner.Visible = false
end

function Toasts.discovery(birdId: string, bonus: number)
	table.insert(queue, { birdId = birdId, bonus = bonus })
	if pumping then
		return
	end
	pumping = true
	task.spawn(function()
		while #queue > 0 do
			local item = table.remove(queue, 1)
			if item then
				playBanner(item.birdId, item.bonus)
			end
		end
		pumping = false
	end)
end

------------------------------------------------------------------------------
-- "+feathers" popup over the bird
------------------------------------------------------------------------------

function Toasts.reward(position: Vector3, amount: number, birdId: string)
	local def = Birds.get(birdId)
	local anchor = Ui.new("Part", {
		Name = "RewardAnchor",
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Transparency = 1,
		Size = Vector3.new(0.2, 0.2, 0.2),
		Position = position,
		Parent = fxFolder,
	})
	local gui = Ui.new("BillboardGui", {
		Size = UDim2.fromOffset(200, 64),
		AlwaysOnTop = true,
		MaxDistance = 140,
		LightInfluence = 0,
		StudsOffsetWorldSpace = Vector3.zero,
		Parent = anchor,
	})
	local amountLabel = Ui.label({
		Size = UDim2.new(1, 0, 0.62, 0),
		Text = "+" .. Format.feathers(amount),
		Font = Ui.FONT,
		TextScaled = true,
		TextColor3 = Ui.COLORS.gold,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.2,
		Parent = gui,
	})
	local nameLabel = Ui.label({
		Position = UDim2.fromScale(0, 0.62),
		Size = UDim2.new(1, 0, 0.34, 0),
		Text = if def then def.name else "",
		Font = Ui.FONT_BOLD,
		TextScaled = true,
		TextColor3 = if def then Config.RARITY_COLORS[def.rarity] else Ui.COLORS.text,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.3,
		Parent = gui,
	})

	TweenService:Create(
		gui,
		TweenInfo.new(2.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ StudsOffsetWorldSpace = Vector3.new(0, 4.5, 0) }
	):Play()
	local fade = TweenInfo.new(0.9, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 1.3)
	TweenService:Create(amountLabel, fade, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	TweenService:Create(nameLabel, fade, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(anchor, 2.6)
end

-- Routes a server Notice to the right effect.
function Toasts.handle(notice: Types.Notice)
	if notice.kind == "toast" and notice.text then
		Toasts.show(notice.text, notice.color)
	elseif notice.kind == "reward" and notice.position and notice.amount and notice.birdId then
		Toasts.reward(notice.position, notice.amount, notice.birdId)
	elseif notice.kind == "discovery" and notice.birdId and notice.bonus then
		Toasts.discovery(notice.birdId, notice.bonus)
	end
end

return Toasts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Ui</string>
            <string name="Source"><![CDATA[--!strict
-- Small helpers so the interface can be built in code without a wall of boilerplate.

local Ui = {}

Ui.COLORS = {
	bg = Color3.fromRGB(28, 48, 40),
	panel = Color3.fromRGB(42, 70, 58),
	panelLight = Color3.fromRGB(58, 94, 78),
	row = Color3.fromRGB(36, 60, 50),
	text = Color3.fromRGB(246, 250, 242),
	muted = Color3.fromRGB(176, 202, 186),
	gold = Color3.fromRGB(255, 208, 82),
	good = Color3.fromRGB(104, 208, 116),
	bad = Color3.fromRGB(236, 96, 96),
	disabled = Color3.fromRGB(86, 100, 92),
}

Ui.FONT = Enum.Font.FredokaOne
Ui.FONT_BODY = Enum.Font.GothamMedium
Ui.FONT_BOLD = Enum.Font.GothamBold

-- Instance.new + properties + children in one call. `Parent` is applied last.
function Ui.new(className: string, props: { [string]: any }?, children: any?): any
	local inst = Instance.new(className)
	local parent: Instance? = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children :: { Instance } do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

-- (these return `any` so they can be mixed freely in a children list)
function Ui.corner(radius: number): any
	return Ui.new("UICorner", { CornerRadius = UDim.new(0, radius) })
end

function Ui.stroke(color: Color3, thickness: number, transparency: number?): any
	return Ui.new("UIStroke", {
		Color = color,
		Thickness = thickness,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Ui.padding(px: number): any
	return Ui.new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
	})
end

function Ui.label(props: { [string]: any }): TextLabel
	local merged: { [string]: any } = {
		BackgroundTransparency = 1,
		Font = Ui.FONT_BODY,
		TextColor3 = Ui.COLORS.text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Text = "",
	}
	for k, v in props do
		merged[k] = v
	end
	return Ui.new("TextLabel", merged)
end

function Ui.button(props: { [string]: any }): TextButton
	local merged: { [string]: any } = {
		AutoButtonColor = true,
		BackgroundColor3 = Ui.COLORS.panelLight,
		Font = Ui.FONT,
		TextColor3 = Ui.COLORS.text,
		TextSize = 18,
		Text = "",
	}
	for k, v in props do
		merged[k] = v
	end
	local button = Ui.new("TextButton", merged)
	Ui.corner(10).Parent = button
	return button
end

-- Dims and disables a button (and restores it) based on `enabled`.
function Ui.setEnabled(button: TextButton, enabled: boolean, enabledColor: Color3)
	button.Active = enabled
	button.AutoButtonColor = enabled
	button.BackgroundColor3 = if enabled then enabledColor else Ui.COLORS.disabled
	button.TextTransparency = if enabled then 0 else 0.4
end

return Ui
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Viewport</string>
            <string name="Source"><![CDATA[--!strict
-- Shows a 3D model inside a ViewportFrame (used for seed and bird previews).

local Viewport = {}

function Viewport.mount(frame: ViewportFrame, model: Model, lookFrom: Vector3?)
	frame.BackgroundTransparency = 1
	frame.Ambient = Color3.fromRGB(190, 190, 195)
	frame.LightColor = Color3.fromRGB(255, 252, 240)
	frame.LightDirection = Vector3.new(-0.6, -1, -0.5)

	for _, child in frame:GetChildren() do
		if child:IsA("Model") or child:IsA("Camera") then
			child:Destroy()
		end
	end
	model.Parent = frame

	local center, size = model:GetBoundingBox()
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	-- distance at which the model's bounding sphere just fits the frame
	local radius = size.Magnitude / 2
	local distance = radius / math.sin(math.rad(camera.FieldOfView / 2)) * 0.92
	-- birds face -Z, so look from the -Z side to see their faces
	local direction = (lookFrom or Vector3.new(0.55, 0.25, -1)).Unit
	camera.CFrame = CFrame.lookAt(center.Position + direction * distance, center.Position)
	camera.Parent = frame
	frame.CurrentCamera = camera
end

return Viewport
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>