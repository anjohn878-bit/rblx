			<Item class="ModuleScript" referent="RBXFAEAD9A4414F4D67AD69452B6180957C">
				<Properties>
					<string name="Name">Config</string>
					<ProtectedString name="Source"><![CDATA[-- Game-wide tuning. Everything a designer is likely to tweak lives here.

local Config = {}

Config.GameName = "Become a Delivery Driver"
Config.CompanyName = "Speedy Parcel Co."
Config.CityName = "Parcelton"

Config.Colors = {
	Brand = Color3.fromRGB(255, 140, 26),
	BrandDark = Color3.fromRGB(204, 98, 0),
	Navy = Color3.fromRGB(22, 28, 45),
	NavyLight = Color3.fromRGB(38, 48, 74),
	White = Color3.fromRGB(245, 245, 245),
	Money = Color3.fromRGB(92, 220, 120),
	Danger = Color3.fromRGB(235, 80, 80),
	Muted = Color3.fromRGB(150, 160, 185),
}

-- The city is a square grid of blocks with roads between them. Keep BlocksPerSide odd so the
-- depot block sits exactly at the origin, where the place's SpawnLocation already is.
Config.City = {
	BlocksPerSide = 7,
	BlockSize = 130,
	RoadWidth = 32,
	SidewalkWidth = 6,
	LaneOffset = 8, -- distance from the road centre line to the middle of a lane
}
Config.City.CellSize = Config.City.BlockSize + Config.City.RoadWidth
-- Centre line of the outermost road, measured from the origin.
Config.City.Extent = (Config.City.BlocksPerSide / 2) * Config.City.CellSize

-- Ranks are earned by completed deliveries and boost every payout.
Config.Ranks = {
	{ Name = "Trainee", Deliveries = 0, PayMultiplier = 1.0, Color = Color3.fromRGB(190, 196, 210) },
	{ Name = "Delivery Driver", Deliveries = 5, PayMultiplier = 1.1, Color = Color3.fromRGB(255, 160, 60) },
	{ Name = "Senior Driver", Deliveries = 25, PayMultiplier = 1.25, Color = Color3.fromRGB(90, 170, 255) },
	{ Name = "Route Master", Deliveries = 75, PayMultiplier = 1.4, Color = Color3.fromRGB(100, 220, 130) },
	{ Name = "Express Expert", Deliveries = 150, PayMultiplier = 1.6, Color = Color3.fromRGB(190, 120, 255) },
	{ Name = "Logistics Legend", Deliveries = 300, PayMultiplier = 2.0, Color = Color3.fromRGB(255, 215, 70) },
}

export type VehicleInfo = {
	Id: string,
	Name: string,
	Description: string,
	Price: number,
	Rank: number, -- index into Config.Ranks needed to buy it
	TopSpeed: number, -- studs per second
	Acceleration: number, -- studs per second squared
	TurnRate: number, -- radians per second at full lock
	Capacity: number, -- packages per trip
}

Config.Vehicles = {
	{
		Id = "Bike",
		Name = "Delivery Bike",
		Description = "Every courier starts somewhere.",
		Price = 0,
		Rank = 1,
		TopSpeed = 34,
		Acceleration = 30,
		TurnRate = 2.6,
		Capacity = 1,
	},
	{
		Id = "Moped",
		Name = "City Moped",
		Description = "Zippy, cheap and fits two parcels.",
		Price = 400,
		Rank = 1,
		TopSpeed = 50,
		Acceleration = 34,
		TurnRate = 2.4,
		Capacity = 2,
	},
	{
		Id = "Hatchback",
		Name = "Compact Car",
		Description = "A proper car with a roomy boot.",
		Price = 1500,
		Rank = 2,
		TopSpeed = 62,
		Acceleration = 36,
		TurnRate = 2.1,
		Capacity = 3,
	},
	{
		Id = "Van",
		Name = "Delivery Van",
		Description = "The classic. Five parcels at a time.",
		Price = 5000,
		Rank = 3,
		TopSpeed = 68,
		Acceleration = 32,
		TurnRate = 1.9,
		Capacity = 5,
	},
	{
		Id = "Truck",
		Name = "Box Truck",
		Description = "Slow to turn, but carries a whole route.",
		Price = 15000,
		Rank = 4,
		TopSpeed = 62,
		Acceleration = 26,
		TurnRate = 1.6,
		Capacity = 8,
	},
	{
		Id = "Supercar",
		Name = "Express Supercar",
		Description = "Absolutely not company policy.",
		Price = 40000,
		Rank = 5,
		TopSpeed = 115,
		Acceleration = 60,
		TurnRate = 2.3,
		Capacity = 3,
	},
} :: { VehicleInfo }

export type PackageKind = {
	Id: string,
	Name: string,
	Weight: number, -- relative chance of being picked
	PayMultiplier: number,
	TimeMultiplier: number,
	Color: Color3,
}

Config.PackageKinds = {
	{
		Id = "Standard",
		Name = "Standard",
		Weight = 75,
		PayMultiplier = 1,
		TimeMultiplier = 1,
		Color = Color3.fromRGB(205, 160, 110),
	},
	{
		Id = "Express",
		Name = "Express",
		Weight = 20,
		PayMultiplier = 1.75,
		TimeMultiplier = 0.65,
		Color = Color3.fromRGB(255, 110, 70),
	},
	{
		Id = "VIP",
		Name = "VIP",
		Weight = 5,
		PayMultiplier = 3,
		TimeMultiplier = 0.85,
		Color = Color3.fromRGB(255, 210, 60),
	},
} :: { PackageKind }

Config.Economy = {
	StartingCash = 0,
	BasePay = 20,
	PayPerStud = 0.15, -- per stud of road distance from the depot
	FastBonus = 0.3, -- +30% when delivered before the timer runs out
	ParBaseSeconds = 30,
	ParSpeedFactor = 0.5, -- the timer assumes you average half your top speed
	ParPerExtraPackage = 20, -- extra seconds for each parcel already ahead of it in the load
	NewDriverDeliveries = 3, -- the first few jobs are short, standard ones
	NewDriverMaxDistance = 380,
	DeliverRadius = 14,
	-- Anti-teleport: nobody legitimately covers road distance faster than this (studs/second).
	MaxTravelSpeed = 160,
}

Config.VehicleSpawnCooldown = 4
Config.CollisionGroups = {
	-- Vehicles don't collide with characters: no ramming other players, and no getting flung
	-- when you hop out of a car.
	Vehicles = "DeliveryVehicles",
	Characters = "DeliveryCharacters",
}
Config.DayLengthMinutes = 12 -- real minutes for a full day/night cycle
Config.DataStoreName = "DeliveryDriver_v1"
Config.AutosaveSeconds = 90

function Config.getVehicle(id: string): VehicleInfo?
	for _, info in Config.Vehicles do
		if info.Id == id then
			return info
		end
	end
	return nil
end

function Config.getRankIndex(deliveries: number): number
	local index = 1
	for i, rank in Config.Ranks do
		if deliveries >= rank.Deliveries then
			index = i
		end
	end
	return index
end

-- Road distance between two points on the grid (roads only run north-south and east-west).
function Config.roadDistance(a: Vector3, b: Vector3): number
	return math.abs(a.X - b.X) + math.abs(a.Z - b.Z)
end

return Config
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXE8663F1F020A4A919EE732F5C612E61A">
				<Properties>
					<string name="Name">Format</string>
					<ProtectedString name="Source"><![CDATA[-- Text formatting helpers shared by the server (notifications) and the client (HUD).

local Format = {}

local STUDS_TO_METRES = 0.28
local STUDS_PER_SECOND_TO_MPH = STUDS_TO_METRES * 2.23694

function Format.commas(n: number): string
	local s = tostring(math.floor(math.abs(n)))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return (if n < 0 then "-" else "") .. out
end

function Format.money(n: number): string
	return "$" .. Format.commas(n)
end

function Format.distance(studs: number): string
	local metres = studs * STUDS_TO_METRES
	if metres >= 1000 then
		return string.format("%.1f km", metres / 1000)
	end
	return string.format("%d m", math.floor(metres + 0.5))
end

function Format.speed(studsPerSecond: number): string
	return string.format("%d", math.floor(math.abs(studsPerSecond) * STUDS_PER_SECOND_TO_MPH + 0.5))
end

function Format.clock(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

return Format
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXB349AAA67B7E4AF88D73147C20272064">
				<Properties>
					<string name="Name">Remotes</string>
					<ProtectedString name="Source"><![CDATA[-- Creates the remotes on the server and waits for them on the client, so both sides can simply
-- `require` this module and index remotes by name.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"StateChanged", -- server -> client: full player state snapshot
	"Notify", -- server -> client: (text, kind)
	"OpenShop", -- server -> client: open the garage window
	"SpawnVehicle", -- client -> server
	"DeliverPackage", -- client -> server: (jobId)
}

local FUNCTIONS = {
	"GetState", -- client -> server: returns the state snapshot once data has loaded
	"BuyVehicle", -- client -> server: (vehicleId) -> (ok, message)
	"EquipVehicle", -- client -> server: (vehicleId) -> (ok, message)
}

local folder: Instance
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("Remotes") or Instance.new("Folder")
	folder.Name = "Remotes"
	for _, name in EVENTS do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	for _, name in FUNCTIONS do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
	end
	folder.Parent = ReplicatedStorage
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end

local Remotes = {
	StateChanged = folder:WaitForChild("StateChanged") :: RemoteEvent,
	Notify = folder:WaitForChild("Notify") :: RemoteEvent,
	OpenShop = folder:WaitForChild("OpenShop") :: RemoteEvent,
	SpawnVehicle = folder:WaitForChild("SpawnVehicle") :: RemoteEvent,
	DeliverPackage = folder:WaitForChild("DeliverPackage") :: RemoteEvent,
	GetState = folder:WaitForChild("GetState") :: RemoteFunction,
	BuyVehicle = folder:WaitForChild("BuyVehicle") :: RemoteFunction,
	EquipVehicle = folder:WaitForChild("EquipVehicle") :: RemoteFunction,
}

return Remotes
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXE7B6544AE1504193B568FF128FE6304C">
				<Properties>
					<string name="Name">VehicleModels</string>
					<ProtectedString name="Source"><![CDATA[-- Builds the delivery vehicles out of plain parts. Shared so the server can spawn them and the
-- client can show the same model in the garage preview.
--
-- Local space for every design: origin on the ground under the middle of the vehicle, -Z is
-- forward, +Y is up. The invisible "Chassis" part is the PrimaryPart; its PivotOffset puts the
-- model's pivot back on the ground, so `model:PivotTo(groundCFrame)` parks it correctly.

local Config = require(script.Parent.Config)

local VehicleModels = {}

local PAINT = Config.Colors.Brand
local WHITE = Color3.fromRGB(240, 240, 240)
local DARK = Color3.fromRGB(45, 45, 52)
local BLACK = Color3.fromRGB(25, 25, 28)
local TIRE = Color3.fromRGB(28, 28, 30)
local HUB = Color3.fromRGB(190, 190, 196)
local GLASS = Color3.fromRGB(120, 170, 210)
local HEADLIGHT = Color3.fromRGB(255, 247, 210)
local TAILLIGHT = Color3.fromRGB(230, 40, 40)

type PartSpec = {
	Name: string,
	Size: Vector3,
	CFrame: CFrame,
	Color: Color3,
	Material: Enum.Material?,
	Shape: Enum.PartType?,
	Transparency: number?,
	Label: string?,
	Hidden: boolean?, -- invisible collision helper
}

type Design = {
	ChassisSize: Vector3,
	ChassisY: number,
	SeatSize: Vector3,
	SeatPosition: Vector3,
	Parts: { PartSpec },
}

local function box(name: string, size: Vector3, position: Vector3, color: Color3, material: Enum.Material?): PartSpec
	return { Name = name, Size = size, CFrame = CFrame.new(position), Color = color, Material = material }
end

-- A thin rod running from `a` to `b`.
local function tube(name: string, a: Vector3, b: Vector3, thickness: number, color: Color3): PartSpec
	return {
		Name = name,
		Size = Vector3.new(thickness, thickness, (b - a).Magnitude),
		CFrame = CFrame.lookAt((a + b) / 2, b),
		Color = color,
		Material = Enum.Material.Metal,
	}
end

local function glass(name: string, size: Vector3, position: Vector3): PartSpec
	local spec = box(name, size, position, GLASS, Enum.Material.Glass)
	spec.Transparency = 0.45
	return spec
end

local function neon(name: string, size: Vector3, position: Vector3, color: Color3): PartSpec
	return box(name, size, position, color, Enum.Material.Neon)
end

-- Cylinders point along X, which is exactly the axle direction, so no rotation is needed.
local function addWheel(parts: { PartSpec }, position: Vector3, radius: number, width: number)
	table.insert(parts, {
		Name = "Wheel",
		Size = Vector3.new(width, radius * 2, radius * 2),
		CFrame = CFrame.new(position),
		Color = TIRE,
		Material = Enum.Material.SmoothPlastic,
		Shape = Enum.PartType.Cylinder,
	})
	table.insert(parts, {
		Name = "Hub",
		Size = Vector3.new(width + 0.06, radius, radius),
		CFrame = CFrame.new(position),
		Color = HUB,
		Material = Enum.Material.Metal,
		Shape = Enum.PartType.Cylinder,
	})
end

-- Two-wheelers rest on a pair of invisible side wheels so they never tip over while parked.
local function addOutriggers(parts: { PartSpec }, halfWidth: number, radius: number)
	for _, side in { -1, 1 } do
		table.insert(parts, {
			Name = "Outrigger",
			Size = Vector3.new(0.4, radius * 2, radius * 2),
			CFrame = CFrame.new(side * halfWidth, radius, 0),
			Color = BLACK,
			Shape = Enum.PartType.Cylinder,
			Transparency = 1,
			Hidden = true,
		})
	end
end

local DESIGNS: { [string]: Design } = {}

do -- Delivery Bike
	local parts: { PartSpec } = {}
	addWheel(parts, Vector3.new(0, 1.3, -2.2), 1.3, 0.35)
	addWheel(parts, Vector3.new(0, 1.3, 2.2), 1.3, 0.35)
	local crank = Vector3.new(0, 1.5, 0.2)
	local head = Vector3.new(0, 3.0, -1.8)
	table.insert(parts, tube("TopTube", Vector3.new(0, 3.0, 0.7), head, 0.3, PAINT))
	table.insert(parts, tube("DownTube", crank, head, 0.3, PAINT))
	table.insert(parts, tube("SeatTube", crank, Vector3.new(0, 3.0, 0.7), 0.3, PAINT))
	table.insert(parts, tube("ChainStay", crank, Vector3.new(0, 1.3, 2.2), 0.25, PAINT))
	table.insert(parts, tube("SeatStay", Vector3.new(0, 3.0, 0.7), Vector3.new(0, 1.3, 2.2), 0.25, PAINT))
	table.insert(parts, tube("Fork", Vector3.new(0, 3.4, -1.85), Vector3.new(0, 1.3, -2.2), 0.3, DARK))
	table.insert(parts, tube("Stem", Vector3.new(0, 3.4, -1.85), Vector3.new(0, 3.9, -1.9), 0.25, DARK))
	table.insert(parts, box("Handlebar", Vector3.new(2.2, 0.25, 0.25), Vector3.new(0, 3.9, -1.9), BLACK))
	table.insert(parts, box("Rack", Vector3.new(1.4, 0.2, 2.2), Vector3.new(0, 2.6, 2.3), DARK, Enum.Material.Metal))
	table.insert(parts, box("CargoBox", Vector3.new(2, 1.8, 2), Vector3.new(0, 3.6, 2.4), PAINT))
	table.insert(parts, box("CargoLid", Vector3.new(2.06, 0.3, 2.06), Vector3.new(0, 4.4, 2.4), WHITE))
	table.insert(parts, neon("Headlight", Vector3.new(0.5, 0.5, 0.3), Vector3.new(0, 3.5, -2.1), HEADLIGHT))
	addOutriggers(parts, 1.5, 0.7)
	DESIGNS.Bike = {
		ChassisSize = Vector3.new(1.5, 1, 5),
		ChassisY = 1.6,
		SeatSize = Vector3.new(1, 0.4, 1.4),
		SeatPosition = Vector3.new(0, 3.0, 0.6),
		Parts = parts,
	}
end

do -- City Moped
	local parts: { PartSpec } = {}
	addWheel(parts, Vector3.new(0, 1.1, -2.3), 1.1, 0.55)
	addWheel(parts, Vector3.new(0, 1.1, 2.3), 1.1, 0.55)
	table.insert(parts, box("Floor", Vector3.new(1.4, 0.4, 3.0), Vector3.new(0, 1.3, 0.2), WHITE))
	table.insert(parts, box("Cowl", Vector3.new(1.6, 1.4, 2.2), Vector3.new(0, 2.1, 1.6), PAINT))
	table.insert(parts, box("LegShield", Vector3.new(1.4, 2.4, 0.4), Vector3.new(0, 2.3, -1.4), PAINT))
	table.insert(parts, tube("Fork", Vector3.new(0, 3.6, -1.7), Vector3.new(0, 1.1, -2.3), 0.35, DARK))
	table.insert(parts, box("Handlebar", Vector3.new(2.2, 0.3, 0.3), Vector3.new(0, 3.7, -1.7), BLACK))
	table.insert(parts, neon("Headlight", Vector3.new(0.8, 0.6, 0.3), Vector3.new(0, 3.35, -1.95), HEADLIGHT))
	table.insert(parts, box("Rack", Vector3.new(1.6, 0.2, 2.2), Vector3.new(0, 3.1, 3.2), DARK, Enum.Material.Metal))
	table.insert(parts, box("CargoBox", Vector3.new(2.2, 2, 2.2), Vector3.new(0, 4.2, 3.2), PAINT))
	table.insert(parts, box("CargoLid", Vector3.new(2.26, 0.3, 2.26), Vector3.new(0, 5.1, 3.2), WHITE))
	table.insert(parts, neon("Taillight", Vector3.new(0.8, 0.3, 0.2), Vector3.new(0, 2.4, 2.75), TAILLIGHT))
	addOutriggers(parts, 1.5, 0.7)
	DESIGNS.Moped = {
		ChassisSize = Vector3.new(1.5, 1, 5),
		ChassisY = 1.5,
		SeatSize = Vector3.new(1.3, 0.5, 2),
		SeatPosition = Vector3.new(0, 3.05, 1.0),
		Parts = parts,
	}
end

do -- Compact Car
	local parts: { PartSpec } = {}
	for _, x in { -2.7, 2.7 } do
		for _, z in { -3.6, 3.6 } do
			addWheel(parts, Vector3.new(x, 1.25, z), 1.25, 0.8)
		end
	end
	table.insert(parts, box("Body", Vector3.new(6, 1.8, 11), Vector3.new(0, 2.0, 0), PAINT))
	table.insert(parts, box("Stripe", Vector3.new(6.06, 0.4, 9), Vector3.new(0, 2.4, 0), WHITE))
	table.insert(parts, glass("Cabin", Vector3.new(5.6, 3.0, 5.6), Vector3.new(0, 4.4, 0.6)))
	table.insert(parts, box("Roof", Vector3.new(5.8, 0.4, 5.8), Vector3.new(0, 6.1, 0.6), WHITE))
	table.insert(parts, box("FrontBumper", Vector3.new(6.2, 0.7, 0.6), Vector3.new(0, 1.4, -5.6), DARK))
	table.insert(parts, box("RearBumper", Vector3.new(6.2, 0.7, 0.6), Vector3.new(0, 1.4, 5.6), DARK))
	for _, x in { -2.0, 2.0 } do
		table.insert(parts, neon("Headlight", Vector3.new(1.2, 0.5, 0.2), Vector3.new(x, 2.4, -5.55), HEADLIGHT))
		table.insert(parts, neon("Taillight", Vector3.new(1.2, 0.5, 0.2), Vector3.new(x, 2.4, 5.55), TAILLIGHT))
	end
	DESIGNS.Hatchback = {
		ChassisSize = Vector3.new(5, 1, 10),
		ChassisY = 1.6,
		SeatSize = Vector3.new(2, 0.4, 2),
		SeatPosition = Vector3.new(-1.3, 2.0, 0.8),
		Parts = parts,
	}
end

do -- Delivery Van
	local parts: { PartSpec } = {}
	for _, x in { -2.9, 2.9 } do
		for _, z in { -4.8, 4.6 } do
			addWheel(parts, Vector3.new(x, 1.4, z), 1.4, 0.9)
