		<Item class="Script" referent="RBXF3D41401BAB94AD19802B3A3E93D3A76">
			<Properties>
				<string name="Name">Server</string>
				<token name="RunContext">0</token>
				<ProtectedString name="Source"><![CDATA[-- Become a Delivery Driver: server entry point.
-- Builds the town, then wires up saving, characters, vehicles and parcel jobs.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local CityBuilder = require(script.CityBuilder)
local Characters = require(script.Characters)
local Jobs = require(script.Jobs)
local PlayerData = require(script.PlayerData)
local Vehicles = require(script.Vehicles)

local registry = CityBuilder.build()

PlayerData.init(registry.Depot.Counter)
Characters.init()
Vehicles.init(registry)
Jobs.init(registry)

-- Day and night: the street lights come on after sunset, and nights pass twice as fast as days
-- (12 daylight hours at 1x plus 12 night hours at 2x = 18 "day-speed" hours per cycle).
Lighting.ClockTime = 9
task.spawn(function()
	local dayRate = 18 / (Config.DayLengthMinutes * 60) -- in-game hours per real second
	local lightsOn: boolean? = nil
	while true do
		local dt = task.wait(0.5)
		local night = Lighting.ClockTime >= 18.25 or Lighting.ClockTime < 6.25
		local rate = if night then dayRate * 2 else dayRate
		Lighting.ClockTime = (Lighting.ClockTime + dt * rate) % 24
		if night ~= lightsOn then
			lightsOn = night
			for _, bulb in registry.StreetLights do
				bulb.Material = if night then Enum.Material.Neon else Enum.Material.SmoothPlastic
				local light = bulb:FindFirstChildOfClass("PointLight")
				if light then
					light.Enabled = night
				end
			end
		end
	end
end)

print(string.format("[%s] %s is open for business: %d addresses to deliver to.", Config.GameName, Config.CityName, #registry.Addresses))
]]></ProtectedString>
			</Properties>
			<Item class="ModuleScript" referent="RBX0698AC37622542499300D5D826758263">
				<Properties>
					<string name="Name">Characters</string>
					<ProtectedString name="Source"><![CDATA[-- Character dressing: collision group (so vehicles pass through people), a rank nametag, and a
-- parcel in the player's hands while they are carrying deliveries on foot.

local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local PlayerData = require(script.Parent.PlayerData)

local Characters = {}

local GROUPS = Config.CollisionGroups

local function registerGroups()
	for _, name in { GROUPS.Vehicles, GROUPS.Characters } do
		if not PhysicsService:IsCollisionGroupRegistered(name) then
			PhysicsService:RegisterCollisionGroup(name)
		end
	end
	PhysicsService:CollisionGroupSetCollidable(GROUPS.Vehicles, GROUPS.Characters, false)
end

local function setGroup(instance: Instance)
	if instance:IsA("BasePart") then
		instance.CollisionGroup = GROUPS.Characters
	end
end

local function updateNametag(session: PlayerData.Session)
	local character = session.Player.Character
	local head = character and character:FindFirstChild("Head")
	if not head then
		return
	end
	local rank = Config.Ranks[PlayerData.rankIndex(session)]
	local tag = head:FindFirstChild("RankTag") :: BillboardGui?
	if not tag then
		local gui = Instance.new("BillboardGui")
		gui.Name = "RankTag"
		gui.Size = UDim2.fromOffset(200, 46)
		gui.StudsOffset = Vector3.new(0, 2.6, 0)
		gui.MaxDistance = 70
		gui.LightInfluence = 0

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Name = "PlayerName"
		nameLabel.BackgroundTransparency = 1
		nameLabel.Size = UDim2.fromScale(1, 0.55)
		nameLabel.Font = Enum.Font.FredokaOne
		nameLabel.TextScaled = true
		nameLabel.TextColor3 = Color3.new(1, 1, 1)
		nameLabel.TextStrokeTransparency = 0.5
		nameLabel.Text = session.Player.DisplayName
		nameLabel.Parent = gui

		local rankLabel = Instance.new("TextLabel")
		rankLabel.Name = "Rank"
		rankLabel.BackgroundTransparency = 1
		rankLabel.Position = UDim2.fromScale(0, 0.55)
		rankLabel.Size = UDim2.fromScale(1, 0.45)
		rankLabel.Font = Enum.Font.GothamBold
		rankLabel.TextScaled = true
		rankLabel.TextStrokeTransparency = 0.5
		rankLabel.Parent = gui

		gui.Parent = head
		tag = gui
	end
	local rankLabel = (tag :: BillboardGui):FindFirstChild("Rank") :: TextLabel
	rankLabel.Text = rank.Name
	rankLabel.TextColor3 = rank.Color
end

local function updateCarry(session: PlayerData.Session)
	local character = session.Player.Character
	if not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local parcel = character:FindFirstChild("CarriedParcel")
	local shouldCarry = #session.Jobs > 0 and root ~= nil and humanoid ~= nil and humanoid.SeatPart == nil

	if shouldCarry and not parcel and root then
		local part = Instance.new("Part")
		part.Name = "CarriedParcel"
		part.Size = Vector3.new(1.8, 1.4, 1.4)
		part.Color = Config.PackageKinds[1].Color
		part.Material = Enum.Material.Cardboard
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Massless = true
		part.CFrame = root.CFrame * CFrame.new(0, 0.1, -1.2)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = part
		part.Parent = character
	elseif not shouldCarry and parcel then
		parcel:Destroy()
	end
end

local function onCharacter(player: Player, character: Model)
	for _, descendant in character:GetDescendants() do
		setGroup(descendant)
	end
	character.DescendantAdded:Connect(setGroup)

	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	character:WaitForChild("Head", 10)
	character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or player.Character ~= character then
		return
	end
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None

	local session = PlayerData.waitFor(player, 20)
	if not session or player.Character ~= character then
		return
	end
	updateNametag(session)
	updateCarry(session)
	humanoid:GetPropertyChangedSignal("SeatPart"):Connect(function()
		local current = PlayerData.get(player)
		if current then
			updateCarry(current)
		end
	end)
end

local function onPlayer(player: Player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
end

function Characters.init()
	registerGroups()
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	PlayerData.onChanged(function(session)
		updateNametag(session)
		updateCarry(session)
	end)
end

return Characters
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXC50C61E46E8B429DA027A79E4E87475C">
				<Properties>
					<string name="Name">CityBuilder</string>
					<ProtectedString name="Source"><![CDATA[-- Generates the town of Parcelton at server start: a grid of roads, the parcel depot in the
-- middle, downtown offices around it and houses everywhere else. A fixed random seed means the
-- streets look the same in every server, so players can learn their routes.
--
-- Returns a registry the gameplay code uses: every deliverable address and the depot's
-- interactive bits.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)

local CityBuilder = {}

export type Address = {
	Id: number,
	Name: string?, -- business name, nil for houses
	Address: string, -- "312 Maple St"
	Kind: string, -- "House" | "Business"
	Position: Vector3, -- where the parcel is handed over
	Facing: Vector3, -- direction the front door faces
	DepotDistance: number,
}

export type Registry = {
	Addresses: { Address },
	Depot: {
		Counter: Vector3,
		LoadPrompt: ProximityPrompt,
		ShopPrompt: ProximityPrompt,
		SpawnPrompt: ProximityPrompt,
		ParkingSpots: { CFrame },
		Bounds: { Min: Vector3, Max: Vector3 },
	},
	StreetLights: { BasePart },
}

local CITY = Config.City
local ROAD_TOP = 0.05
local CURB_TOP = 0.45
local LAWN_TOP = 0.5

local STREET_NAMES = { "Maple", "Oak", "Cedar", "Pine", "Elm", "Birch", "Willow", "Aspen" }

local BUSINESSES = {
	"Bean Brew Cafe",
	"Pixel Pizza",
	"Blocky Burgers",
	"Starlight Cinema",
	"Brick Bakery",
	"Neon Arcade",
	"Stud Fitness",
	"Builder's Hardware",
	"Happy Paws Vet",
	"Sunny Side Books",
	"Glow Gadgets",
	"Fresh Mart",
	"Cozy Furniture",
	"Turbo Toys",
	"Rocket Realty",
	"Sushi Spin",
	"Taco Tower",
	"Spark Electric",
	"Green Leaf Florist",
	"Gold Coin Jewelers",
	"Moonlight Hotel",
	"Cloud Nine Offices",
	"Igloo Ice Cream",
	"Paint Splash Studio",
	"Bright Smile Dental",
	"Quick Fix Repairs",
	"City Library",
	"Parcelton Times",
	"Lucky Noodle",
	"Pebble Pharmacy",
	"Orbit Software",
	"Velvet Theater",
}

local HOUSE_COLORS = {
	Color3.fromRGB(240, 222, 180),
	Color3.fromRGB(182, 210, 232),
	Color3.fromRGB(232, 190, 190),
	Color3.fromRGB(200, 226, 190),
	Color3.fromRGB(248, 244, 236),
	Color3.fromRGB(214, 184, 152),
	Color3.fromRGB(196, 192, 220),
	Color3.fromRGB(244, 208, 140),
}
local ROOF_COLORS = {
	Color3.fromRGB(128, 62, 52),
	Color3.fromRGB(72, 72, 82),
	Color3.fromRGB(96, 64, 44),
	Color3.fromRGB(62, 92, 116),
}
local DOOR_COLORS = {
	Color3.fromRGB(112, 72, 42),
	Color3.fromRGB(42, 72, 112),
	Color3.fromRGB(142, 42, 42),
	Color3.fromRGB(42, 102, 62),
}
local OFFICE_COLORS = {
	Color3.fromRGB(200, 200, 205),
	Color3.fromRGB(222, 212, 190),
	Color3.fromRGB(160, 170, 185),
	Color3.fromRGB(190, 160, 140),
	Color3.fromRGB(120, 130, 150),
}

local rng = Random.new(2026)

local function pick<T>(list: { T }): T
	return list[rng:NextInteger(1, #list)]
end

local function newPart(parent: Instance, props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		(part :: any)[key] = value
	end
	part.Parent = parent
	return part
end

local function addSign(part: BasePart, face: Enum.NormalId, text: string, textColor: Color3, maxDistance: number?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0.3
	gui.MaxDistance = maxDistance or 0
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = textColor
	label.Text = text
	label.Parent = gui
	gui.Parent = part
end

local function addPrompt(part: BasePart, name: string, action: string, object: string, hold: number): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.HoldDuration = hold
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = part
	return prompt
end

-- Grid helpers -------------------------------------------------------------------------------

-- Centre of block (bx, bz), indices 0 .. BlocksPerSide-1.
local function blockCenter(bx: number, bz: number): Vector3
	local offset = (CITY.BlocksPerSide - 1) / 2
	return Vector3.new((bx - offset) * CITY.CellSize, 0, (bz - offset) * CITY.CellSize)
end

-- Centre line of road k (0 .. BlocksPerSide) along either axis.
local function roadLine(k: number): number
	return -CITY.Extent + k * CITY.CellSize
end

-- Scenery ------------------------------------------------------------------------------------

local function buildTree(parent: Instance, position: Vector3, scale: number)
	local trunkHeight = 6 * scale
	newPart(parent, {
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(trunkHeight, 1.4 * scale, 1.4 * scale),
		CFrame = CFrame.new(position + Vector3.new(0, trunkHeight / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(110, 76, 50),
		Material = Enum.Material.Wood,
	})
	local leaves = Color3.fromRGB(rng:NextInteger(60, 90), rng:NextInteger(130, 165), rng:NextInteger(55, 80))
	newPart(parent, {
		Name = "Leaves",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 8 * scale,
		Position = position + Vector3.new(0, trunkHeight + 2 * scale, 0),
		Color = leaves,
		Material = Enum.Material.Grass,
	})
	newPart(parent, {
		Name = "Leaves",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 5.5 * scale,
		Position = position + Vector3.new(1.5 * scale, trunkHeight + 5 * scale, 0.8 * scale),
		Color = leaves:Lerp(Color3.new(1, 1, 1), 0.08),
		Material = Enum.Material.Grass,
	})
end

local function buildStreetLight(parent: Instance, position: Vector3, toward: Vector3, lights: { BasePart })
	local model = Instance.new("Model")
	model.Name = "StreetLight"
	local poleTop = position + Vector3.new(0, 14, 0)
	newPart(model, {
		Name = "Pole",
		Size = Vector3.new(0.6, 14, 0.6),
		Position = position + Vector3.new(0, 7, 0),
		Color = Color3.fromRGB(60, 62, 70),
		Material = Enum.Material.Metal,
	})
	local direction = Vector3.new(toward.X - position.X, 0, toward.Z - position.Z).Unit
	local lampPosition = poleTop + direction * 3.5
	newPart(model, {
		Name = "Arm",
		Size = Vector3.new(0.4, 0.4, 3.6),
		CFrame = CFrame.lookAt((poleTop + lampPosition) / 2, lampPosition),
		Color = Color3.fromRGB(60, 62, 70),
		Material = Enum.Material.Metal,
	})
	local bulb = newPart(model, {
		Name = "Bulb",
		Size = Vector3.new(1.6, 0.6, 1.6),
		Position = lampPosition - Vector3.new(0, 0.4, 0),
		Color = Color3.fromRGB(255, 236, 190),
		CastShadow = false,
	})
	local light = Instance.new("PointLight")
	light.Range = 32
	light.Brightness = 1.6
	light.Color = Color3.fromRGB(255, 220, 170)
	light.Enabled = false
	light.Parent = bulb
	table.insert(lights, bulb)
	model.Parent = parent
end

-- Roads --------------------------------------------------------------------------------------

local function buildRoads(parent: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "Roads"
	local size = CITY.Extent * 2 + CITY.RoadWidth
	newPart(folder, {
		Name = "Asphalt",
		Size = Vector3.new(size, 1, size),
		Position = Vector3.new(0, ROAD_TOP - 0.5, 0),
		Color = Color3.fromRGB(58, 60, 66),
		Material = Enum.Material.Asphalt,
	})

	-- A yellow centre line on every stretch of road between two intersections.
	local yellow = Color3.fromRGB(245, 200, 60)
	local segment = CITY.BlockSize
	for k = 0, CITY.BlocksPerSide do
		local line = roadLine(k)
		for b = 0, CITY.BlocksPerSide - 1 do
			local mid = blockCenter(b, b).X
			newPart(folder, {
				Name = "CenterLine",
				Size = Vector3.new(0.6, 0.2, segment - 4),
				Position = Vector3.new(line, ROAD_TOP - 0.05, mid),
				Color = yellow,
				CanCollide = false,
				CastShadow = false,
			})
			newPart(folder, {
				Name = "CenterLine",
				Size = Vector3.new(segment - 4, 0.2, 0.6),
				Position = Vector3.new(mid, ROAD_TOP - 0.05, line),
				Color = yellow,
				CanCollide = false,
				CastShadow = false,
			})
		end
	end
	folder.Parent = parent
end

-- Blocks -------------------------------------------------------------------------------------

local function buildBlockBase(parent: Instance, center: Vector3, topColor: Color3?, topMaterial: Enum.Material?)
	newPart(parent, {
		Name = "Sidewalk",
		Size = Vector3.new(CITY.BlockSize, 1, CITY.BlockSize),
		Position = Vector3.new(center.X, CURB_TOP - 0.5, center.Z),
		Color = Color3.fromRGB(196, 196, 200),
		Material = Enum.Material.Concrete,
	})
	if topColor then
		local inner = CITY.BlockSize - CITY.SidewalkWidth * 2
		newPart(parent, {
			Name = "Ground",
			Size = Vector3.new(inner, 1, inner),
			Position = Vector3.new(center.X, LAWN_TOP - 0.5, center.Z),
			Color = topColor,
			Material = topMaterial or Enum.Material.Grass,
		})
	end
end

local function streetFor(bz: number, facingNorth: boolean): string
	-- A building on the north edge of block bz faces road bz; on the south edge, road bz + 1.
	local roadIndex = if facingNorth then bz else bz + 1
	return STREET_NAMES[roadIndex + 1] .. " St"
end

local function houseNumber(bx: number, slot: number, facingNorth: boolean): number
	-- Even numbers on the south side of a street, odd numbers on the north side.
	return (bx + 1) * 100 + 10 + slot * 20 + (if facingNorth then 0 else 1)
end

local function buildHouse(parent: Instance, cf: CFrame, number: number, street: string): Vector3
	local model = Instance.new("Model")
	model.Name = number .. " " .. street

	local width, depth, height = 24, 18, 11
	local wallColor = pick(HOUSE_COLORS)
	local function at(x: number, y: number, z: number): CFrame
		return cf * CFrame.new(x, y, z)
	end

	newPart(model, {
		Name = "Walls",
		Size = Vector3.new(width, height, depth),
		CFrame = at(0, height / 2, 0),
		Color = wallColor,
		Material = if rng:NextNumber() < 0.3 then Enum.Material.Brick else Enum.Material.SmoothPlastic,
	})
	-- A square beam rolled 45 degrees: the top half pokes out as a gable roof, the bottom half
	-- hides inside the walls. Works without relying on wedge orientation.
	local roofSide = (depth / 2 + 1) * math.sqrt(2)
	newPart(model, {
		Name = "Roof",
		Size = Vector3.new(width - 0.2, roofSide, roofSide),
		CFrame = at(0, height, 0) * CFrame.Angles(math.rad(45), 0, 0),
		Color = pick(ROOF_COLORS),
	})
	if rng:NextNumber() < 0.5 then
		newPart(model, {
			Name = "Chimney",
			Size = Vector3.new(2, 7, 2),
			CFrame = at(width / 2 - 4, height + 5, 4),
			Color = Color3.fromRGB(150, 80, 64),
			Material = Enum.Material.Brick,
		})
	end

	local front = -depth / 2
	newPart(model, {
		Name = "Door",
		Size = Vector3.new(4.5, 7.5, 0.4),
		CFrame = at(0, 3.75, front - 0.1),
		Color = pick(DOOR_COLORS),
		Material = Enum.Material.Wood,
	})
	for _, x in { -7, 7 } do
		newPart(model, {
			Name = "Window",
			Size = Vector3.new(5, 4, 0.3),
			CFrame = at(x, 6, front - 0.1),
			Color = Color3.fromRGB(170, 210, 235),
			Material = Enum.Material.Glass,
			Reflectance = 0.15,
		})
	end
	local plaque = newPart(model, {
		Name = "NumberPlaque",
		Size = Vector3.new(2.6, 1.2, 0.2),
		CFrame = at(3.8, 8.6, front - 0.15),
		Color = Color3.fromRGB(40, 40, 46),
	})
	addSign(plaque, Enum.NormalId.Front, tostring(number), Color3.new(1, 1, 1), 150)

	newPart(model, {
		Name = "Porch",
		Size = Vector3.new(9, 0.5, 4),
		CFrame = at(0, 0.25, front - 2),
		Color = Color3.fromRGB(176, 172, 166),
		Material = Enum.Material.Concrete,
	})
	local yard = 14 -- distance from the front wall to the sidewalk
	newPart(model, {
		Name = "Path",
		Size = Vector3.new(3, 0.2, yard - 4),
		CFrame = at(0, 0.05, front - 4 - (yard - 4) / 2),
		Color = Color3.fromRGB(176, 172, 166),
		Material = Enum.Material.Concrete,
		CanCollide = false,
	})
	newPart(model, {
		Name = "MailboxPost",
		Size = Vector3.new(0.4, 3.4, 0.4),
		CFrame = at(3.6, 1.7, front - yard + 1.2),
		Color = Color3.fromRGB(110, 76, 50),
		Material = Enum.Material.Wood,
	})
	newPart(model, {
		Name = "Mailbox",
		Size = Vector3.new(1.1, 1.1, 1.8),
		CFrame = at(3.6, 3.7, front - yard + 1.2),
		Color = Color3.fromRGB(50, 90, 160),
		Material = Enum.Material.Metal,
	})

	model.Parent = parent
	-- Hand-over spot on the path just in front of the porch.
	return (cf * CFrame.new(0, 3, front - 6.5)).Position
end

local function buildOffice(parent: Instance, cf: CFrame, name: string): Vector3
	local model = Instance.new("Model")
	model.Name = name

	local width, depth = 46, 40
	local height = pick({ 36, 48, 60, 72, 84 })
	local function at(x: number, y: number, z: number): CFrame
		return cf * CFrame.new(x, y, z)
	end

	newPart(model, {
		Name = "Tower",
		Size = Vector3.new(width, height, depth),
		CFrame = at(0, height / 2, 0),
		Color = pick(OFFICE_COLORS),
		Material = Enum.Material.Concrete,
	})
	local windowColor = Color3.fromRGB(70, 110, 150):Lerp(Color3.fromRGB(120, 170, 200), rng:NextNumber())
	local floors = math.floor((height - 14) / 12)
	for floor = 0, floors - 1 do
		newPart(model, {
			Name = "Windows",
			Size = Vector3.new(width + 0.3, 5, depth + 0.3),
			CFrame = at(0, 17 + floor * 12, 0),
			Color = windowColor,
			Material = Enum.Material.Glass,
			Reflectance = 0.2,
		})
	end
	newPart(model, {
		Name = "Cornice",
		Size = Vector3.new(width + 1.5, 1.5, depth + 1.5),
		CFrame = at(0, height + 0.75, 0),
		Color = Color3.fromRGB(80, 82, 90),
	})
	newPart(model, {
		Name = "RoofUnit",
		Size = Vector3.new(8, 3, 6),
		CFrame = at(rng:NextNumber(-12, 12), height + 3, rng:NextNumber(-10, 10)),
		Color = Color3.fromRGB(150, 152, 158),
		Material = Enum.Material.Metal,
	})

	local front = -depth / 2
	newPart(model, {
		Name = "Entrance",
		Size = Vector3.new(8, 9, 0.4),
		CFrame = at(0, 4.5, front - 0.15),
		Color = Color3.fromRGB(40, 60, 80),
		Material = Enum.Material.Glass,
		Reflectance = 0.25,
	})
	newPart(model, {
		Name = "Awning",
		Size = Vector3.new(14, 0.6, 5),
		CFrame = at(0, 10.5, front - 2.5),
		Color = Color3.fromHSV(rng:NextNumber(), 0.6, 0.85),
	})
	local sign = newPart(model, {
		Name = "Sign",
		Size = Vector3.new(26, 3.2, 0.4),
		CFrame = at(0, 13.4, front - 0.3),
		Color = Color3.fromRGB(30, 32, 40),
	})
	addSign(sign, Enum.NormalId.Front, name, Color3.fromRGB(255, 236, 200), 400)

	model.Parent = parent
	return (cf * CFrame.new(0, 3, front - 4)).Position
end

local function buildResidentialBlock(parent: Instance, bx: number, bz: number, addresses: { Address })
	local center = blockCenter(bx, bz)
	local folder = Instance.new("Folder")
	folder.Name = string.format("Block_%d_%d", bx, bz)
	buildBlockBase(folder, center, Color3.fromRGB(100, 160, 80))

	local inner = CITY.BlockSize / 2 - CITY.SidewalkWidth -- lawn half-size (59)
	local frontYard = 14
	local depth = 18
	for _, facingNorth in { true, false } do
		local sign = if facingNorth then -1 else 1
		local z = center.Z + sign * (inner - frontYard - depth / 2)
		local street = streetFor(bz, facingNorth)
		for slot = 0, 2 do
			local x = center.X + (slot - 1) * 40
			local position = Vector3.new(x, LAWN_TOP, z)
			local cf = CFrame.lookAt(position, position + Vector3.new(0, 0, sign))
			local number = houseNumber(bx, slot, facingNorth)
			local drop = buildHouse(folder, cf, number, street)
			table.insert(addresses, {
				Id = #addresses + 1,
				Address = number .. " " .. street,
				Kind = "House",
				Position = drop,
				Facing = Vector3.new(0, 0, sign),
				DepotDistance = 0,
			})
		end
	end

	-- Backyard trees.
	for _ = 1, rng:NextInteger(2, 4) do
		local offset = Vector3.new(rng:NextNumber(-50, 50), 0, rng:NextNumber(-14, 14))
		buildTree(folder, Vector3.new(center.X, LAWN_TOP, center.Z) + offset, rng:NextNumber(0.8, 1.2))
	end

	folder.Parent = parent
end

local businessIndex = 0
local function buildDowntownBlock(parent: Instance, bx: number, bz: number, addresses: { Address })
	local center = blockCenter(bx, bz)
	local folder = Instance.new("Folder")
	folder.Name = string.format("Block_%d_%d", bx, bz)
	buildBlockBase(folder, center, Color3.fromRGB(176, 170, 162), Enum.Material.Pavement)

	local inner = CITY.BlockSize / 2 - CITY.SidewalkWidth
	for _, facingNorth in { true, false } do
		local sign = if facingNorth then -1 else 1
		local z = center.Z + sign * (inner - 6 - 20)
		local street = streetFor(bz, facingNorth)
		for slot, xOffset in { -31, 31 } do
			businessIndex += 1
			local name = BUSINESSES[(businessIndex - 1) % #BUSINESSES + 1]
			local position = Vector3.new(center.X + xOffset, LAWN_TOP, z)
			local cf = CFrame.lookAt(position, position + Vector3.new(0, 0, sign))
			local drop = buildOffice(folder, cf, name)
			local number = (bx + 1) * 100 + slot * 40 - 20 + (if facingNorth then 0 else 1)
			table.insert(addresses, {
				Id = #addresses + 1,
				Name = name,
				Address = number .. " " .. street,
				Kind = "Business",
				Position = drop,
				Facing = Vector3.new(0, 0, sign),
				DepotDistance = 0,
			})
		end
	end

	folder.Parent = parent
end

local function buildPark(parent: Instance, bx: number, bz: number)
	local center = blockCenter(bx, bz)
	local folder = Instance.new("Folder")
	folder.Name = string.format("Park_%d_%d", bx, bz)
	buildBlockBase(folder, center, Color3.fromRGB(92, 168, 84))

	newPart(folder, {
		Name = "Pond",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 44, 44),
		CFrame = CFrame.new(center.X + 14, LAWN_TOP + 0.02, center.Z - 10) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(70, 140, 200),
		Material = Enum.Material.Glass,
		Transparency = 0.15,
		Reflectance = 0.2,
		CanCollide = false,
	})
	local pathColor = Color3.fromRGB(196, 180, 150)
	newPart(folder, {
		Name = "Path",
		Size = Vector3.new(4, 0.2, 118),
		Position = Vector3.new(center.X - 22, LAWN_TOP, center.Z),
		Color = pathColor,
		Material = Enum.Material.Sand,
		CanCollide = false,
	})
	newPart(folder, {
		Name = "Path",
		Size = Vector3.new(118, 0.2, 4),
		Position = Vector3.new(center.X, LAWN_TOP, center.Z + 24),
		Color = pathColor,
		Material = Enum.Material.Sand,
		CanCollide = false,
	})
	for _, offset in { Vector3.new(-30, 0, 32), Vector3.new(-14, 0, 32), Vector3.new(-36, 0, -10) } do
		local seat = Instance.new("Seat")
		seat.Name = "Bench"
		seat.Size = Vector3.new(6, 1, 2)
		seat.Anchored = true
		seat.Color = Color3.fromRGB(130, 90, 60)
		seat.Material = Enum.Material.Wood
		seat.TopSurface = Enum.SurfaceType.Smooth
		seat.Position = Vector3.new(center.X, LAWN_TOP + 1.5, center.Z) + offset
		seat.Parent = folder
	end
	for _ = 1, 9 do
		local spot = Vector3.new(rng:NextNumber(-52, 52), 0, rng:NextNumber(-52, 52))
		if (spot - Vector3.new(14, 0, -10)).Magnitude > 28 then
			buildTree(folder, Vector3.new(center.X, LAWN_TOP, center.Z) + spot, rng:NextNumber(0.9, 1.4))
		end
	end
	folder.Parent = parent
end

-- Depot --------------------------------------------------------------------------------------

local function buildDepot(parent: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "Depot"
	local base = LAWN_TOP -- top of the parking lot surface
	local brand = Config.Colors.Brand

	buildBlockBase(folder, Vector3.zero, Color3.fromRGB(72, 74, 80), Enum.Material.Asphalt)

	-- Warehouse with its open loading bay facing south, towards the spawn.
	newPart(folder, {
		Name = "Warehouse",
		Size = Vector3.new(96, 24, 40),
		Position = Vector3.new(0, base + 12, -38),
		Color = Color3.fromRGB(226, 228, 232),
		Material = Enum.Material.Concrete,
	})
	newPart(folder, {
		Name = "WarehouseStripe",
		Size = Vector3.new(96.3, 3, 40.3),
		Position = Vector3.new(0, base + 19, -38),
		Color = brand,
	})
	newPart(folder, {
		Name = "WarehouseRoof",
		Size = Vector3.new(98, 1.5, 42),
		Position = Vector3.new(0, base + 24.75, -38),
		Color = Color3.fromRGB(70, 72, 80),
	})
	for _, x in { -34, 34 } do
		newPart(folder, {
			Name = "RollerDoor",
			Size = Vector3.new(16, 14, 0.4),
			Position = Vector3.new(x, base + 7, -17.9),
			Color = Color3.fromRGB(96, 100, 110),
			Material = Enum.Material.CorrodedMetal,
		})
	end
	local roofSign = newPart(folder, {
		Name = "CompanySign",
		Size = Vector3.new(56, 8, 1),
		Position = Vector3.new(0, base + 29.5, -19),
		Color = brand,
	})
	addSign(roofSign, Enum.NormalId.Back, string.upper(Config.CompanyName), Color3.new(1, 1, 1))
	addSign(roofSign, Enum.NormalId.Front, string.upper(Config.CompanyName), Color3.new(1, 1, 1))

	-- Loading canopy and package counter.
	newPart(folder, {
		Name = "Canopy",
		Size = Vector3.new(36, 1, 14),
		Position = Vector3.new(0, base + 13, -11),
		Color = brand,
	})
	for _, x in { -17.5, 17.5 } do
		newPart(folder, {
			Name = "CanopyPillar",
			Size = Vector3.new(1, 13, 1),
			Position = Vector3.new(x, base + 6.5, -4.5),
			Color = Color3.fromRGB(70, 72, 80),
			Material = Enum.Material.Metal,
		})
	end
	local counter = newPart(folder, {
		Name = "Counter",
		Size = Vector3.new(16, 3.6, 3),
		Position = Vector3.new(0, base + 1.8, -12),
		Color = Color3.fromRGB(240, 240, 240),
	})
	newPart(folder, {
		Name = "CounterTop",
		Size = Vector3.new(16.4, 0.4, 3.4),
		Position = Vector3.new(0, base + 3.8, -12),
		Color = brand,
	})
	local counterSign = newPart(folder, {
		Name = "CounterSign",
		Size = Vector3.new(16, 2.6, 0.4),
		Position = Vector3.new(0, base + 10.8, -5),
		Color = Color3.fromRGB(30, 32, 40),
	})
	addSign(counterSign, Enum.NormalId.Back, "PICK UP PACKAGES HERE", Color3.fromRGB(255, 220, 160))

	local boxColor = Color3.fromRGB(205, 160, 110)
	for _ = 1, 14 do
		local size = Vector3.new(rng:NextNumber(1.6, 3), rng:NextNumber(1.4, 2.6), rng:NextNumber(1.6, 3))
		newPart(folder, {
			Name = "Parcel",
			Size = size,
			CFrame = CFrame.new(rng:NextNumber(-14, 14), base + size.Y / 2, rng:NextNumber(-17, -14.5))
				* CFrame.Angles(0, rng:NextNumber(-0.4, 0.4), 0),
			Color = boxColor:Lerp(Color3.new(0, 0, 0), rng:NextNumber(0, 0.2)),
			Material = Enum.Material.Cardboard,
		})
	end
	for _, x in { -5, -1.5, 2.5, 5.5 } do
		newPart(folder, {
			Name = "Parcel",
			Size = Vector3.new(2, 1.6, 2),
			CFrame = CFrame.new(x, base + 4.8, -12) * CFrame.Angles(0, rng:NextNumber(-0.3, 0.3), 0),
			Color = boxColor,
			Material = Enum.Material.Cardboard,
		})
	end
	local loadPrompt = addPrompt(counter, "LoadPrompt", "Load Packages", "Package Counter", 0.5)
	loadPrompt.KeyboardKeyCode = Enum.KeyCode.E

	-- Garage kiosk (opens the vehicle shop) and vehicle pick-up post.
	local kiosk = newPart(folder, {
		Name = "GarageKiosk",
		Size = Vector3.new(7, 7, 4),
		Position = Vector3.new(-30, base + 3.5, -8),
		Color = Color3.fromRGB(38, 48, 74),
	})
	local kioskSign = newPart(folder, {
		Name = "GarageSign",
		Size = Vector3.new(7, 1.8, 0.3),
		Position = Vector3.new(-30, base + 8, -6.2),
		Color = brand,
	})
	addSign(kioskSign, Enum.NormalId.Back, "VEHICLE SHOP", Color3.new(1, 1, 1))
	local shopPrompt = addPrompt(kiosk, "ShopPrompt", "Open Garage", "Vehicle Shop", 0)

	local post = newPart(folder, {
		Name = "PickupPost",
		Size = Vector3.new(7, 7, 4),
		Position = Vector3.new(30, base + 3.5, -8),
		Color = Color3.fromRGB(38, 48, 74),
	})
	local postSign = newPart(folder, {
		Name = "PickupSign",
		Size = Vector3.new(7, 1.8, 0.3),
		Position = Vector3.new(30, base + 8, -6.2),
		Color = brand,
	})
	addSign(postSign, Enum.NormalId.Back, "GET YOUR VEHICLE", Color3.new(1, 1, 1))
	local spawnPrompt = addPrompt(post, "SpawnPrompt", "Get Vehicle", "Vehicle Pick-up", 0)

	-- Parking bays along the south edge, facing the street so you can drive straight out.
	local spots = {}
	local white = Color3.fromRGB(235, 235, 235)
	for _, x in { -56, -40, -24, -8, 8, 24, 40, 56 } do
		newPart(folder, {
			Name = "BayLine",
			Size = Vector3.new(0.5, 0.1, 18),
			Position = Vector3.new(x, base + 0.03, 44),
			Color = white,
			CanCollide = false,
			CastShadow = false,
		})
	end
	for _, x in { -48, -32, -16, 16, 32, 48 } do
		table.insert(spots, CFrame.lookAt(Vector3.new(x, base, 44), Vector3.new(x, base, 50)))
	end

	-- Flagpole and some cones for a bit of life.
	newPart(folder, {
		Name = "Flagpole",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(30, 0.6, 0.6),
		CFrame = CFrame.new(-56, base + 15, 20) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(200, 200, 205),
		Material = Enum.Material.Metal,
	})
	newPart(folder, {
		Name = "Flag",
		Size = Vector3.new(0.2, 4, 7),
		Position = Vector3.new(-56, base + 27.5, 23.6),
		Color = brand,
		Material = Enum.Material.Fabric,
	})
	for i = 0, 5 do
		newPart(folder, {
			Name = "Cone",
			Size = Vector3.new(1, 1.6, 1),
			Position = Vector3.new(-6 + i * 2.4, base + 0.8, 30),
			Color = Color3.fromRGB(255, 120, 30),
		})
	end

	-- Reuse the place's SpawnLocation so players appear facing the counter.
	local spawn = Workspace:FindFirstChildOfClass("SpawnLocation") or Instance.new("SpawnLocation")
	spawn.Name = "DepotSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(0, base + 0.5, 14)
	spawn.Color = brand
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = Workspace

	folder.Parent = parent

	local half = CITY.BlockSize / 2
	return {
		Counter = Vector3.new(0, base + 3, -9), -- standing spot in front of the counter
		LoadPrompt = loadPrompt,
		ShopPrompt = shopPrompt,
		SpawnPrompt = spawnPrompt,
		ParkingSpots = spots,
		Bounds = { Min = Vector3.new(-half, -10, -half), Max = Vector3.new(half, 50, half) },
	}
end

-- Entry point --------------------------------------------------------------------------------

function CityBuilder.build(): Registry
	local existing = Workspace:FindFirstChild("City")
	if existing then
		existing:Destroy()
	end
	local city = Instance.new("Folder")
	city.Name = "City"

	-- Turn the default grid baseplate into countryside around the town.
	local baseplate = Workspace:FindFirstChild("Baseplate")
	if baseplate and baseplate:IsA("BasePart") then
		baseplate.Color = Color3.fromRGB(96, 150, 76)
		baseplate.Material = Enum.Material.Grass
		for _, child in baseplate:GetChildren() do
			if child:IsA("Texture") or child:IsA("Decal") then
				child:Destroy()
			end
		end
	end

	buildRoads(city)

	local addresses: { Address } = {}
	local lights: { BasePart } = {}
	local depot
	local middle = (CITY.BlocksPerSide - 1) / 2
	local parks = { [string.format("%d,%d", middle - 2, middle + 2)] = true, [string.format("%d,%d", middle + 2, middle - 2)] = true }

	local blocks = Instance.new("Folder")
	blocks.Name = "Blocks"
	for bx = 0, CITY.BlocksPerSide - 1 do
		for bz = 0, CITY.BlocksPerSide - 1 do
			local ring = math.max(math.abs(bx - middle), math.abs(bz - middle))
			if ring == 0 then
				depot = buildDepot(city)
			elseif parks[bx .. "," .. bz] then
				buildPark(blocks, bx, bz)
			elseif ring == 1 then
				buildDowntownBlock(blocks, bx, bz, addresses)
			else
				buildResidentialBlock(blocks, bx, bz, addresses)
			end

			-- Street lights on two opposite corners of every block.
			local center = blockCenter(bx, bz)
			local corner = CITY.BlockSize / 2 - 2
			for _, dir in { Vector3.new(1, 0, -1), Vector3.new(-1, 0, 1) } do
				local position = Vector3.new(center.X + dir.X * corner, CURB_TOP, center.Z + dir.Z * corner)
				buildStreetLight(blocks, position, position + dir * 10, lights)
			end
		end
	end
	blocks.Parent = city

	-- A ring of trees around the town.
	local outskirts = Instance.new("Folder")
	outskirts.Name = "Outskirts"
	local edge = CITY.Extent + CITY.RoadWidth
	for _ = 1, 90 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local radius = rng:NextNumber(edge + 20, edge + 260)
		local position = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
		if math.max(math.abs(position.X), math.abs(position.Z)) > edge + 10 then
			buildTree(outskirts, position, rng:NextNumber(1, 1.8))
		end
	end
	outskirts.Parent = city

	for _, address in addresses do
		address.DepotDistance = Config.roadDistance(depot.Counter, address.Position)
	end

	city.Parent = Workspace

	return {
		Addresses = addresses,
		Depot = depot,
		StreetLights = lights,
	}
end

-- Exposed for vehicle spawning: lane centre lines are the same grid the builder used.
CityBuilder.roadLine = roadLine

return CityBuilder
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXF6158CF52C204D7B8E9E595C9C933FDF">
				<Properties>
					<string name="Name">Jobs</string>
					<ProtectedString name="Source"><![CDATA[-- Hands out parcels at the depot counter and pays players when they hand them over at the door.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local PlayerData = require(script.Parent.PlayerData)

local Jobs = {}

local ECON = Config.Economy
local rng = Random.new()
local nextJobId = 0
local registry
local parcelFolder: Folder

local function getKind(id: string): Config.PackageKind
	for _, kind in Config.PackageKinds do
		if kind.Id == id then
			return kind
		end
	end
	return Config.PackageKinds[1]
end

local function rollKind(newDriver: boolean): Config.PackageKind
	if newDriver then
		return Config.PackageKinds[1]
	end
	local total = 0
	for _, kind in Config.PackageKinds do
		total += kind.Weight
	end
	local roll = rng:NextNumber(0, total)
	for _, kind in Config.PackageKinds do
		roll -= kind.Weight
		if roll <= 0 then
			return kind
		end
	end
	return Config.PackageKinds[1]
end

function Jobs.loadPackages(player: Player)
	local session = PlayerData.get(player)
	if not session then
		return
	end

	local capacity = PlayerData.capacity(session)
	local free = capacity - #session.Jobs
	if free <= 0 then
		PlayerData.notify(player, "You're fully loaded! Deliver your packages first.", "error")
		return
	end

	local newDriver = session.Data.Deliveries < ECON.NewDriverDeliveries
	local taken = {}
	for _, job in session.Jobs do
		taken[job.AddressId] = true
	end
	local candidates = {}
	for _, address in registry.Addresses do
		if not taken[address.Id] and (not newDriver or address.DepotDistance <= ECON.NewDriverMaxDistance) then
			table.insert(candidates, address)
		end
	end

	local vehicle = Config.getVehicle(session.Data.Equipped) or Config.Vehicles[1]
	local payMultiplier = Config.Ranks[PlayerData.rankIndex(session)].PayMultiplier
	local now = Workspace:GetServerTimeNow()
	local loaded = 0

	for _ = 1, free do
		if #candidates == 0 then
			break
		end
		local address = table.remove(candidates, rng:NextInteger(1, #candidates))
		local kind = rollKind(newDriver)
		local distance = address.DepotDistance
		local ahead = #session.Jobs
		local parTime = (
			ECON.ParBaseSeconds
			+ distance / (vehicle.TopSpeed * ECON.ParSpeedFactor)
			+ ahead * ECON.ParPerExtraPackage
		) * kind.TimeMultiplier
		local reward = math.floor((ECON.BasePay + distance * ECON.PayPerStud) * kind.PayMultiplier * payMultiplier + 0.5)

		nextJobId += 1
		table.insert(session.Jobs, {
			Id = nextJobId,
			AddressId = address.Id,
			Name = address.Name,
			Address = address.Address,
			Position = address.Position,
			Kind = kind.Id,
			Reward = reward,
			Deadline = now + parTime,
			LoadedAt = now,
		})
		loaded += 1
	end

	PlayerData.changed(session)
	if session.Data.Deliveries == 0 and loaded > 0 then
		PlayerData.notify(player, "Follow the beacon to the address, then press E at the door!", "success")
	else
		PlayerData.notify(player, string.format("Loaded %d package%s.", loaded, if loaded == 1 then "" else "s"), "success")
	end
end

-- Leave a parcel on the doorstep for a while so everyone can see the delivery.
local function dropParcel(position: Vector3, kind: Config.PackageKind)
	local parcel = Instance.new("Part")
	parcel.Name = "DeliveredParcel"
	parcel.Size = Vector3.new(1.8, 1.4, 1.8)
	parcel.CFrame = CFrame.new(position - Vector3.new(0, 2.3, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0)
	parcel.Color = kind.Color
	parcel.Material = Enum.Material.Cardboard
	parcel.Anchored = true
	parcel.CanCollide = false
	parcel.CanQuery = false
	parcel.Parent = parcelFolder
	Debris:AddItem(parcel, 30)
end

function Jobs.deliver(player: Player, jobId: any)
	if typeof(jobId) ~= "number" then
		return
	end
	local session = PlayerData.get(player)
	if not session then
		return
	end

	local index, job
	for i, candidate in session.Jobs do
		if candidate.Id == jobId then
			index, job = i, candidate
			break
		end
	end
	if not job then
		return
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	if humanoid.SeatPart then
		PlayerData.notify(player, "Hop out of your vehicle to hand over the package!", "error")
		return
	end
	local offset = root.Position - job.Position
	if Vector3.new(offset.X, 0, offset.Z).Magnitude > ECON.DeliverRadius or math.abs(offset.Y) > 12 then
		PlayerData.notify(player, "Walk up to the door to deliver.", "error")
		return
	end

	local now = Workspace:GetServerTimeNow()
	local minimumTime = Config.roadDistance(registry.Depot.Counter, job.Position) / ECON.MaxTravelSpeed
	if now - job.LoadedAt < minimumTime then
		PlayerData.notify(player, "Whoa, that was impossibly fast! Try driving there.", "error")
		return
	end

	table.remove(session.Jobs, index)
	local onTime = now <= job.Deadline
	local bonus = if onTime then math.floor(job.Reward * ECON.FastBonus + 0.5) else 0
	local payout = job.Reward + bonus

	local oldRank = PlayerData.rankIndex(session)
	session.Data.Cash += payout
	session.Data.Earned += payout
	session.Data.Deliveries += 1
	local newRank = PlayerData.rankIndex(session)
	PlayerData.changed(session)

	local kind = getKind(job.Kind)
	dropParcel(job.Position, kind)

	local text = string.format("Delivered to %s! +%s", job.Name or job.Address, Format.money(payout))
	if onTime then
		text ..= string.format(" (incl. %s speed bonus)", Format.money(bonus))
	end
	Remotes.Notify:FireClient(player, text, "delivered", job.Position)

	if newRank > oldRank then
		local rank = Config.Ranks[newRank]
		local unlocked = {}
		for _, vehicle in Config.Vehicles do
			if vehicle.Rank == newRank then
				table.insert(unlocked, vehicle.Name)
			end
		end
		local message = if newRank == 2
			then "You've officially become a Delivery Driver!"
			else "Promoted to " .. rank.Name .. "!"
		if #unlocked > 0 then
			message ..= " Unlocked: " .. table.concat(unlocked, ", ")
		end
		PlayerData.notify(player, message, "rank")
	end
end

function Jobs.init(cityRegistry)
	registry = cityRegistry

	parcelFolder = Instance.new("Folder")
	parcelFolder.Name = "DeliveredParcels"
	parcelFolder.Parent = Workspace

	registry.Depot.LoadPrompt.Triggered:Connect(Jobs.loadPackages)
	Remotes.DeliverPackage.OnServerEvent:Connect(Jobs.deliver)
end

return Jobs
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX080BE9E5214048B5B875E6ABB7A334E9">
				<Properties>
					<string name="Name">PlayerData</string>
					<ProtectedString name="Source"><![CDATA[-- Owns each player's session: saved progress (cash, deliveries, vehicles), the parcels they
-- are carrying, leaderstats, and the state snapshot sent to their client.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local PlayerData = {}

export type SavedData = {
	Cash: number,
	Deliveries: number,
	Earned: number,
	Owned: { [string]: boolean },
	Equipped: string,
}

export type Job = {
	Id: number,
	AddressId: number,
	Name: string?,
	Address: string,
	Position: Vector3,
	Kind: string,
	Reward: number,
	Deadline: number,
	LoadedAt: number,
}

export type Session = {
	Player: Player,
	Data: SavedData,
	CanSave: boolean,
	Jobs: { Job },
	LastSpawn: number,
	Stats: { Cash: IntValue, Deliveries: IntValue, Rank: StringValue },
}

local sessions: { [Player]: Session } = {}
local changedCallbacks: { (Session) -> () } = {}
local depotPosition = Vector3.zero

local store: DataStore? = nil
do
	local ok, result = pcall(DataStoreService.GetDataStore, DataStoreService, Config.DataStoreName)
	if ok then
		store = result
	else
		warn("[PlayerData] DataStores unavailable, progress will not be saved:", result)
	end
end

local function defaultData(): SavedData
	return {
		Cash = Config.Economy.StartingCash,
		Deliveries = 0,
		Earned = 0,
		Owned = { [Config.Vehicles[1].Id] = true },
		Equipped = Config.Vehicles[1].Id,
	}
end

-- Fill in anything missing from older saves and drop vehicles that no longer exist.
local function reconcile(saved: any): SavedData
	local data = defaultData()
	if type(saved) ~= "table" then
		return data
	end
	if type(saved.Cash) == "number" then
		data.Cash = math.max(0, math.floor(saved.Cash))
	end
	if type(saved.Deliveries) == "number" then
		data.Deliveries = math.max(0, math.floor(saved.Deliveries))
	end
	if type(saved.Earned) == "number" then
		data.Earned = math.max(0, math.floor(saved.Earned))
	end
	if type(saved.Owned) == "table" then
		for id, owned in saved.Owned do
			if owned == true and Config.getVehicle(id) then
				data.Owned[id] = true
			end
		end
	end
	if type(saved.Equipped) == "string" and data.Owned[saved.Equipped] then
		data.Equipped = saved.Equipped
	end
	return data
end

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

local function load(player: Player): (SavedData, boolean)
	if not store then
		return defaultData(), false
	end
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return (store :: DataStore):GetAsync(keyFor(player))
		end)
		if ok then
			return reconcile(result), true
		end
		warn(string.format("[PlayerData] Load attempt %d failed for %s: %s", attempt, player.Name, tostring(result)))
		if RunService:IsStudio() then
			-- Usually "Studio access to API services" is switched off; retrying won't help.
			break
		end
		task.wait(attempt)
	end
	-- Never overwrite a real save with defaults just because loading failed.
	return defaultData(), false
end

local function save(session: Session)
	if not store or not session.CanSave then
		return
	end
	local snapshot = table.clone(session.Data)
	snapshot.Owned = table.clone(session.Data.Owned)
	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync(keyFor(session.Player), function()
			return snapshot
		end)
	end)
	if not ok then
		warn("[PlayerData] Save failed for " .. session.Player.Name .. ": " .. tostring(err))
	end
end

function PlayerData.rankIndex(session: Session): number
	return Config.getRankIndex(session.Data.Deliveries)
end

function PlayerData.capacity(session: Session): number
	local vehicle = Config.getVehicle(session.Data.Equipped)
	return if vehicle then vehicle.Capacity else 1
end

function PlayerData.buildState(session: Session)
	local data = session.Data
	local rankIndex = PlayerData.rankIndex(session)
	local rank = Config.Ranks[rankIndex]
	local nextRank = Config.Ranks[rankIndex + 1]

	local jobs = {}
	for _, job in session.Jobs do
		table.insert(jobs, {
			Id = job.Id,
			Name = job.Name,
			Address = job.Address,
			Position = job.Position,
			Kind = job.Kind,
			Reward = job.Reward,
			Deadline = job.Deadline,
		})
	end

	return {
		Cash = data.Cash,
		Deliveries = data.Deliveries,
		RankIndex = rankIndex,
		RankName = rank.Name,
		RankFloor = rank.Deliveries,
		NextRankName = if nextRank then nextRank.Name else nil,
		NextRankAt = if nextRank then nextRank.Deliveries else nil,
		Owned = table.clone(data.Owned),
		Equipped = data.Equipped,
		Capacity = PlayerData.capacity(session),
		Jobs = jobs,
		Depot = depotPosition,
	}
end

-- Push the latest state to the client and refresh leaderstats.
function PlayerData.changed(session: Session)
	local data = session.Data
	session.Stats.Cash.Value = data.Cash
	session.Stats.Deliveries.Value = data.Deliveries
	session.Stats.Rank.Value = Config.Ranks[PlayerData.rankIndex(session)].Name
	for _, callback in changedCallbacks do
		task.spawn(callback, session)
	end
	Remotes.StateChanged:FireClient(session.Player, PlayerData.buildState(session))
end

function PlayerData.onChanged(callback: (Session) -> ())
	table.insert(changedCallbacks, callback)
end

function PlayerData.get(player: Player): Session?
	return sessions[player]
end

function PlayerData.waitFor(player: Player, timeout: number): Session?
	local started = os.clock()
	while not sessions[player] and player.Parent and os.clock() - started < timeout do
		task.wait(0.1)
	end
	return sessions[player]
end

function PlayerData.all(): { [Player]: Session }
	return sessions
end

function PlayerData.notify(player: Player, text: string, kind: string?)
	Remotes.Notify:FireClient(player, text, kind or "info")
end

local function makeStats(player: Player)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local cash = Instance.new("IntValue")
	cash.Name = "Cash"
	cash.Parent = folder
	local deliveries = Instance.new("IntValue")
	deliveries.Name = "Deliveries"
	deliveries.Parent = folder
	local rank = Instance.new("StringValue")
	rank.Name = "Rank"
	rank.Parent = folder
	folder.Parent = player
	return { Cash = cash, Deliveries = deliveries, Rank = rank }
end

local function onPlayerAdded(player: Player)
	local data, canSave = load(player)
	if not player.Parent then
		return
	end
	local session: Session = {
		Player = player,
		Data = data,
		CanSave = canSave,
		Jobs = {},
		LastSpawn = -math.huge,
		Stats = makeStats(player),
	}
	sessions[player] = session
	PlayerData.changed(session)
	if not canSave then
		if RunService:IsStudio() then
			PlayerData.notify(player, "Saving is off in Studio. Enable API Services to test it.", "info")
		else
			PlayerData.notify(player, "Couldn't load your save. Progress this session won't be saved.", "error")
		end
	end
end

function PlayerData.init(depot: Vector3)
	depotPosition = depot

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		local session = sessions[player]
		if session then
			sessions[player] = nil
			save(session)
		end
	end)

	Remotes.GetState.OnServerInvoke = function(player)
		local session = PlayerData.waitFor(player, 20)
		return if session then PlayerData.buildState(session) else nil
	end

	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for _, session in sessions do
				task.spawn(save, session)
			end
		end
	end)

	game:BindToClose(function()
		if not store then
			return
		end
		local pending = 0
		for _, session in sessions do
			pending += 1
			task.spawn(function()
				save(session)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.2)
		end
	end)
end

return PlayerData
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX01442D975424403F9A8810609243C964">
				<Properties>
					<string name="Name">Vehicles</string>
					<ProtectedString name="Source"><![CDATA[-- Spawns each player's delivery vehicle, keeps strangers out of it, and runs the garage shop.
--
-- Vehicles are "arcade" style: one invisible chassis part carries a LinearVelocity (forward
-- speed, no sideways slip) and an AngularVelocity (steering and staying upright). The driver's
-- client sets both every frame (see client/Driving.luau); while parked the server's values of
-- zero hold the vehicle still.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local CityBuilder = require(script.Parent.CityBuilder)
local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local VehicleModels = require(ReplicatedStorage.Shared.VehicleModels)
local PlayerData = require(script.Parent.PlayerData)

local Vehicles = {}

local CHASSIS_MASS = 40
local DRIVER_MASS_ALLOWANCE = 15
local ROAD_TOP = 0.05
local SPAWN_LIFT = 0.4

local registry
local folder: Folder
local active: { [Player]: Model } = {}

local function setOwner(part: BasePart, player: Player?)
	-- Fails harmlessly if the part was destroyed or anchored in the meantime.
	pcall(part.SetNetworkOwner, part, player)
end

local function getHumanoid(player: Player): (Humanoid?, BasePart?)
	local character = player.Character
	if not character then
		return nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
		return humanoid, root
	end
	return nil, nil
end

-- Put a character down beside the vehicle's driver door.
local function placeBeside(model: Model, character: Model)
	local chassis = model.PrimaryPart
	local seat = model:FindFirstChild("DriverSeat") :: BasePart?
	if not chassis or not seat then
		return
	end
	local halfWidth = model:GetExtentsSize().X / 2
	local seatOffset = chassis.CFrame:PointToObjectSpace(seat.Position)
	local spot = chassis.CFrame * CFrame.new(-(halfWidth + 2.5), 0, seatOffset.Z)
	local look = chassis.CFrame.LookVector
	character:PivotTo(CFrame.lookAt(spot.Position + Vector3.new(0, 2, 0), spot.Position + Vector3.new(look.X, 2, look.Z)))
end

local function addNameplate(chassis: BasePart, height: number, text: string)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Nameplate"
	gui.Size = UDim2.fromOffset(220, 26)
	gui.StudsOffsetWorldSpace = Vector3.new(0, height + 1.5, 0)
	gui.MaxDistance = 90
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.4
	label.Text = text
	label.Parent = gui
	gui.Parent = chassis
end

-- Turn a freshly built (anchored, local-space) model into a drivable vehicle owned by `owner`.
local function rig(model: Model, info: Config.VehicleInfo, owner: Player)
	local chassis = model.PrimaryPart :: BasePart
	local seat = model:FindFirstChild("DriverSeat") :: VehicleSeat

	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CollisionGroup = Config.CollisionGroups.Vehicles
			if part ~= chassis then
				part.Massless = true
				-- Near-frictionless contacts: the constraints do the driving, not the tyres.
				part.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0, 0, 100, 1)
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = chassis
				weld.Part1 = part
				weld.Parent = part
			end
		end
	end

	local volume = chassis.Size.X * chassis.Size.Y * chassis.Size.Z
	chassis.CustomPhysicalProperties = PhysicalProperties.new(math.clamp(CHASSIS_MASS / volume, 0.01, 100), 0, 0, 100, 1)
	chassis.RootPriority = 127

	local attachment = Instance.new("Attachment")
	attachment.Name = "DriveAttachment"
	attachment.Parent = chassis

	local drive = Instance.new("LinearVelocity")
	drive.Name = "Drive"
	drive.Attachment0 = attachment
	drive.RelativeTo = Enum.ActuatorRelativeTo.Attachment0
	drive.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	drive.PrimaryTangentAxis = Vector3.new(0, 0, -1) -- forward
	drive.SecondaryTangentAxis = Vector3.new(1, 0, 0) -- sideways (held at zero: no drifting)
	drive.PlaneVelocity = Vector2.zero
	drive.MaxForce = (CHASSIS_MASS + DRIVER_MASS_ALLOWANCE) * 160
	drive.Parent = chassis

	local steer = Instance.new("AngularVelocity")
	steer.Name = "Steer"
	steer.Attachment0 = attachment
	steer.RelativeTo = Enum.ActuatorRelativeTo.World
	steer.AngularVelocity = Vector3.zero
	steer.MaxTorque = 60000
	steer.Parent = chassis

	-- Only the Drive prompt (or spawning) seats you, so walking through a car never grabs you.
	seat.CanTouch = false
	seat:SetAttribute("DeliveryVehicle", true)
	seat:SetAttribute("TopSpeed", info.TopSpeed)
	seat:SetAttribute("Acceleration", info.Acceleration)
	seat:SetAttribute("TurnRate", info.TurnRate)
	model:SetAttribute("OwnerUserId", owner.UserId)
	model.Name = owner.Name .. "_" .. info.Id
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic

	local extents = model:GetExtentsSize()
	addNameplate(chassis, extents.Y, owner.DisplayName .. "'s " .. info.Name)

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "DrivePrompt"
	prompt.ActionText = "Drive"
	prompt.ObjectText = info.Name
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = math.max(10, extents.X / 2 + 6)
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.F
	prompt.Parent = seat

	prompt.Triggered:Connect(function(player)
		if player ~= owner then
			PlayerData.notify(player, "That's " .. owner.DisplayName .. "'s vehicle.", "error")
			return
		end
		local humanoid = getHumanoid(player)
		if humanoid and not seat.Occupant then
			seat:Sit(humanoid)
		end
	end)

	local driver: Humanoid? = nil
	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local humanoid = seat.Occupant
		if humanoid then
			local rider = Players:GetPlayerFromCharacter(humanoid.Parent)
			if rider ~= owner then
				local weld = seat:FindFirstChild("SeatWeld")
				if weld then
					weld:Destroy()
				end
				task.defer(placeBeside, model, humanoid.Parent :: Model)
				if rider then
					PlayerData.notify(rider, "That's " .. owner.DisplayName .. "'s vehicle.", "error")
				end
				return
			end
			driver = humanoid
			prompt.Enabled = false
			setOwner(chassis, owner)
		else
			prompt.Enabled = true
			setOwner(chassis, nil)
			local leaving = driver
			driver = nil
			if leaving and leaving.Parent and leaving.Health > 0 then
				task.defer(placeBeside, model, leaving.Parent :: Model)
			end
		end
	end)
end

-- Is there room for a vehicle of `size` at `cf` (ground-level pivot)?
local function isClear(cf: CFrame, size: Vector3): boolean
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { folder }
	local parts = Workspace:GetPartBoundsInBox(cf * CFrame.new(0, size.Y / 2, 0), size + Vector3.new(2, 0, 2), params)
	return #parts == 0
end

local function nearestRoadLine(value: number): number
	local k = math.floor((value + Config.City.Extent) / Config.City.CellSize + 0.5)
	return CityBuilder.roadLine(math.clamp(k, 0, Config.City.BlocksPerSide))
end

-- Pick a spot in the right-hand lane of the road closest to `position`.
local function roadSpot(position: Vector3, size: Vector3): CFrame?
	local extent = Config.City.Extent
	local lane = Config.City.LaneOffset
	local lineX = nearestRoadLine(position.X)
	local lineZ = nearestRoadLine(position.Z)
	local base, step, facing
	if math.abs(position.X - lineX) <= math.abs(position.Z - lineZ) then
		-- North-south road. The east lane heads north, the west lane heads south.
		local side = if position.X >= lineX then 1 else -1
		base = Vector3.new(lineX + side * lane, ROAD_TOP + SPAWN_LIFT, math.clamp(position.Z, -extent, extent))
		step = Vector3.new(0, 0, 1)
		facing = Vector3.new(0, 0, -side)
	else
		-- East-west road. The south lane heads east, the north lane heads west.
		local side = if position.Z >= lineZ then 1 else -1
		base = Vector3.new(math.clamp(position.X, -extent, extent), ROAD_TOP + SPAWN_LIFT, lineZ + side * lane)
		step = Vector3.new(1, 0, 0)
		facing = Vector3.new(side, 0, 0)
	end
	for i = 0, 8 do
		for _, direction in { 1, -1 } do
			local spot = base + step * direction * i * (size.Z + 4)
			local cf = CFrame.lookAt(spot, spot + facing)
			if isClear(cf, size) then
				return cf
			end
		end
	end
	return nil
end

local function findSpawn(position: Vector3, size: Vector3): CFrame?
	local bounds = registry.Depot.Bounds
	local inDepot = position.X > bounds.Min.X
		and position.X < bounds.Max.X
		and position.Z > bounds.Min.Z
		and position.Z < bounds.Max.Z
	if inDepot then
		for _, spot in registry.Depot.ParkingSpots do
			local cf = spot + Vector3.new(0, SPAWN_LIFT, 0)
			if isClear(cf, size) then
				return cf
			end
		end
	end
	return roadSpot(position, size)
end

function Vehicles.despawn(player: Player)
	local model = active[player]
	active[player] = nil
	if model then
		model:Destroy()
	end
end

function Vehicles.spawn(player: Player)
	local session = PlayerData.get(player)
	if not session then
		return
	end
	local humanoid, root = getHumanoid(player)
	if not humanoid or not root then
		return
	end
	if os.clock() - session.LastSpawn < Config.VehicleSpawnCooldown then
		PlayerData.notify(player, "Your vehicle is on its way, hang on a second.", "error")
		return
	end
	session.LastSpawn = os.clock()

	local info = Config.getVehicle(session.Data.Equipped) or Config.Vehicles[1]
	if humanoid.SeatPart then
		humanoid.Sit = false
	end
	Vehicles.despawn(player)

	local model = VehicleModels.build(info.Id)
	local size = model:GetExtentsSize()
	local cf = findSpawn(root.Position, size)
	if not cf then
		model:Destroy()
		PlayerData.notify(player, "No room to park here. Try somewhere else.", "error")
		return
	end

	rig(model, info, player)
	model:PivotTo(cf)
	model.Parent = folder
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = false
		end
	end
	local chassis = model.PrimaryPart :: BasePart
	setOwner(chassis, nil)

	active[player] = model
	chassis.AncestryChanged:Connect(function()
		-- Fell off the world or was otherwise destroyed.
		if active[player] == model and not chassis:IsDescendantOf(Workspace) then
			Vehicles.despawn(player)
		end
	end)

	local seat = model:FindFirstChild("DriverSeat") :: VehicleSeat
	local character = player.Character :: Model
	character:PivotTo(seat.CFrame * CFrame.new(0, 3, 0))
	seat:Sit(humanoid)
end

local function buy(player: Player, id: any): (boolean, string)
	local session = PlayerData.get(player)
	local info = if typeof(id) == "string" then Config.getVehicle(id) else nil
	if not session or not info then
		return false, "Unknown vehicle."
	end
	if session.Data.Owned[info.Id] then
		return false, "You already own this."
	end
	if PlayerData.rankIndex(session) < info.Rank then
		return false, "Reach " .. Config.Ranks[info.Rank].Name .. " rank first."
	end
	if session.Data.Cash < info.Price then
		return false, "You need " .. Format.money(info.Price - session.Data.Cash) .. " more."
	end
	session.Data.Cash -= info.Price
	session.Data.Owned[info.Id] = true
	session.Data.Equipped = info.Id
	PlayerData.changed(session)
	PlayerData.notify(player, "You bought the " .. info.Name .. "!", "success")
	return true, "Purchased"
end

local function equip(player: Player, id: any): (boolean, string)
	local session = PlayerData.get(player)
	if not session or typeof(id) ~= "string" or not session.Data.Owned[id] then
		return false, "You don't own that vehicle."
	end
	session.Data.Equipped = id
	PlayerData.changed(session)
	return true, "Equipped"
end

function Vehicles.init(cityRegistry)
	registry = cityRegistry

	folder = Instance.new("Folder")
	folder.Name = "Vehicles"
	folder.Parent = Workspace

	registry.Depot.SpawnPrompt.Triggered:Connect(Vehicles.spawn)
	registry.Depot.ShopPrompt.Triggered:Connect(function(player)
		Remotes.OpenShop:FireClient(player)
	end)
	Remotes.SpawnVehicle.OnServerEvent:Connect(Vehicles.spawn)
	Remotes.BuyVehicle.OnServerInvoke = buy
	Remotes.EquipVehicle.OnServerInvoke = equip

	Players.PlayerRemoving:Connect(Vehicles.despawn)
end

return Vehicles
